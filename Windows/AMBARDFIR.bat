if not exist "!log_drv!:\" (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Drive not found: !log_drv!:!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Unidad no encontrada: !log_drv!:!C_RESET!
    call :WAIT 2
    goto ADQ_LOG_DRIVES
)
set "LOG_SRC=!log_drv!:\"
goto ADQ_LOG_NAV

:ADQ_LOG_FULLPATH
if exist "!log_drv!\" (
    set "LOG_SRC=!log_drv!\"
    set "LOG_SRC_TYPE=FOLDER"
    goto ADQ_LOG_NAV
)
if exist "!log_drv!" (
    set "LOG_SRC=!log_drv!"
    set "LOG_SRC_TYPE=FILE"
    goto ADQ_LOG_CONFIRM
)
if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Path not found: !log_drv!!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Ruta no encontrada: !log_drv!!C_RESET!
call :WAIT 2
goto ADQ_LOG_DRIVES

