:ADQ_LOGICO_DRIVE_ASK
set "drive="
if /i "!FORENSIC_LANG!"=="EN" set /p drive="!C_PROMPT!Source drive letter (Ex: C:, 0=cancel): !C_RESET!"
if /i not "!FORENSIC_LANG!"=="EN" set /p drive="!C_PROMPT!Letra de unidad origen (Ej: C:, 0=cancelar): !C_RESET!"
if "!drive!"=="0" goto MENU_ADQUISICION
if "!drive!"=="" goto ADQ_LOGICO
set "drive=!drive:"=!"
call :VALIDATE_SRC_DRIVE "!drive!"
if not "!_VS_OK!"=="1" goto ADQ_LOGICO_DRIVE_ASK
:: :VALIDATE_SRC_DRIVE acepta C, C: y C:\ pero solo mira la letra. Sin normalizar,
:: "C" daba \\.\C y "C:\" daba \\.\C:\ (la RAIZ del sistema de archivos, no el
:: volumen): rutas que las herramientas de imaging no pueden abrir.
set "drive=!drive:~0,1!:"
set "DRV_PATH=\\.\!drive!"
:: dc3dd es Cygwin: \\.\E: con echo pierde un backslash -> \.\E: (inválido).
:: Para volúmenes lógicos Cygwin acepta //./E: (forward slashes, sin escape).
set "CYG_DEV=//./!drive!"
set "DRV_LETTER=!drive:~0,1!"
goto ADQ_DESTINO

