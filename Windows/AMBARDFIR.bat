echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] To use it: open!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Para usarlo: abra!C_RESET!
echo !C_TEXT!    "!VMWC_EVIDENCE!\VM\!VMWC_VMXNAME!"!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT!    in VMware, choose "I Copied It" when asked ^(avoids conflict of!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT!    en VMware, elija "I Copied It" cuando lo pregunte ^(evita conflicto de!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT!    UUID with the original^), and from the Snapshot Manager use "Go to" on!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT!    UUID con el original^), y desde el Snapshot Manager use "Go to" sobre!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT!    the desired snapshot: VMware will load its .vmsn/.vmem automatically and!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT!    el snapshot deseado: VMware cargara su .vmsn/.vmem automáticamente y!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT!    the VM will resume with the real RAM of that moment.!C_RESET!
