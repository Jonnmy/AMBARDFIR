echo !C_BORDER!!SUBLINE!!C_RESET!
:: La verificacion de cifrado va ANTES de imagenar, no despues: si el volumen
:: esta cifrado cambia el orden de adquisicion. SWGDE 17-F-002 v2.1: "To obtain
:: encryption keys, examiners may need to capture memory prior to obtaining a
:: disk image, and attempt to decrypt later". Por eso figura en este menu.
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT!4. Check storage peripheral encryption
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT!4. Verificar cifrado del periférico de almacenamiento
if /i "!FORENSIC_LANG!"=="EN" echo 0. Back to Main Menu!C_RESET!
