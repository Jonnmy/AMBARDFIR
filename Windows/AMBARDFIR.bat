:ADQ_LOG_DRIVES
cls
echo !C_BORDER!!LINE!!C_RESET!
call :HDR TITLE "SELECT SOURCE - Available drives" "SELECCIONAR ORIGEN - Unidades disponibles"
echo !C_BORDER!!LINE!!C_RESET!
echo.
:: Asignar el RESULTADO de un "if" ($x = if(...){a}else{b}) es sintaxis de
:: PowerShell 3.0 en adelante. Windows 7 trae PowerShell 2.0 de fabrica, donde eso
:: es un error de parseo: el listado de unidades no imprimia NADA y el operador se
:: quedaba sin saber que letras tenia el equipo. Se usa la forma equivalente de
:: 2.0 -inicializar y sobrescribir con un if como sentencia-, que funciona igual en
:: 2.0 y en 5.1. Sin PowerShell se cae a wmic, y sin ninguno de los dos se dice.
if defined PS_AVAILABLE if !PS_VER! GEQ 3 powershell -NoProfile -Command "Get-CimInstance Win32_LogicalDisk | ForEach-Object { $id=$_.DeviceID; $lb='(Sin etiqueta)'; if($_.VolumeName){$lb=$_.VolumeName}; $sz='(desconocido)'; if($_.Size){$sz=[math]::Round($_.Size/1GB,1).ToString('F1')+' GB'}; Write-Host (\"    $id    [$lb]    $sz\") }" 2>nul
if defined PS_AVAILABLE if !PS_VER! LSS 3 powershell -NoProfile -Command "Get-WmiObject Win32_LogicalDisk | ForEach-Object { $id=$_.DeviceID; $lb='(Sin etiqueta)'; if($_.VolumeName){$lb=$_.VolumeName}; $sz='(desconocido)'; if($_.Size){$sz=[math]::Round($_.Size/1GB,1).ToString('F1')+' GB'}; Write-Host (\"    $id    [$lb]    $sz\") }" 2>nul
if not defined PS_AVAILABLE if defined HAS_WMIC wmic logicaldisk get DeviceID,VolumeName,Size 2>nul
if not defined PS_AVAILABLE if not defined HAS_WMIC (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN!    [i] Drives cannot be listed here: neither PowerShell nor WMIC on this host.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN!    [i] No se pueden listar las unidades: este equipo no tiene PowerShell ni WMIC.!C_RESET!
    if /i "!FORENSIC_LANG!"=="EN" echo !C_DIM!    [i] Type the drive letter or the full path anyway.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_DIM!    [i] Escriba igualmente la letra de unidad o la ruta completa.!C_RESET!
)
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_DIM!  Type the drive letter (Ex: C) or a full path (Ex: C:\Users\Juan)!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_DIM!  Escribe la letra de unidad (Ej: C) o una ruta completa (Ej: C:\Users\Juan)!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_DIM!  0 to cancel!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_DIM!  0 para cancelar!C_RESET!
echo.
set "log_drv="
if /i "!FORENSIC_LANG!"=="EN" set /p log_drv="!C_PROMPT!Drive or path: !C_RESET!"
if /i not "!FORENSIC_LANG!"=="EN" set /p log_drv="!C_PROMPT!Unidad o ruta: !C_RESET!"
if defined log_drv set "log_drv=!log_drv:"=!"
if "!log_drv!"=="0" goto MENU_ADQUISICION
if "!log_drv!"=="" goto ADQ_LOG_DRIVES

:: Si es ruta completa: carácter en posición 2 es \ (Ej: C:\algo)
if "!log_drv:~2,1!"=="\" goto ADQ_LOG_FULLPATH

:: Normalizar letra de unidad
set "log_drv=!log_drv::=!"
