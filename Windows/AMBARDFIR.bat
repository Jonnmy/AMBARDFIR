:: Generar script PowerShell temporal para el menu de selección interactiva
:: Nombres con GUID, no fijos: dos instancias del framework a la vez se pisaban
:: el .ps1 y la eleccion de target, la misma clase de fallo ya corregida en el
:: Write Blocker y en los listados de discos.
call :NEWGUID _km_guid
set "_km_ps1=%TEMP%\kape_menu_!_km_guid!.ps1"
set "_km_out=%TEMP%\kape_target_!_km_guid!.txt"
if exist "!_km_out!" del "!_km_out!"

:: Enumerar miembros sobre una COLECCION -(Get-ChildItem ...).BaseName- es
:: sintaxis de PowerShell 3.0 en adelante, y $targets.Count sobre un resultado de
:: un solo elemento tampoco existe en 2.0. Windows 7 trae PowerShell 2.0 de
:: fabrica: alli el menu de targets de KAPE salia VACIO. Se proyecta el nombre con
:: ForEach-Object y se fuerza array con @(...), que es la forma valida en 2.0 y
:: sigue siendo correcta en 5.1.
:: El texto del Read-Host va SIN tilde a proposito: este archivo lo escribe "echo >"
:: con la consola en UTF-8 y PowerShell lee un .ps1 sin BOM como ANSI, de modo que
:: cualquier acento saldria como mojibake en el propio prompt. Es un limite del
:: cruce cmd/PowerShell, no del idioma, y afecta solo a este archivo generado.
:: El literal del Read-Host SI se desdobla por idioma: era el unico texto que el
:: operador en ingles recibia en espanol dentro de un menu interactivo. Las dos
:: ramas van DENTRO del bloque redirigido -comprobado: el if condiciona el echo y
:: la redireccion sigue aplicandose- y sus parentesis estan balanceados, que es lo
:: que permite escribirlos sin escapar aqui dentro.
:: El "^" del ancla de la expresion regular se DUPLICA: dentro de este bloque cmd
:: se come un "^" y el .ps1 salia con '\d+$', sin ancla de inicio, de modo que una
:: entrada como "abc12" pasaba la comprobacion de digitos.
(
echo $targets = @^(Get-ChildItem -Path '!BASE_PATH!\Triaje\kape\Targets' -Recurse -Filter *.tkape ^| ForEach-Object { $_.BaseName }^)
echo $i = 1
echo $targets ^| ForEach-Object {
echo     Write-Host ^("{0,3}. {1,-30}" -f $i, $_^) -NoNewline
echo     if ^($i %% 3 -eq 0^) { Write-Host "" }
echo     $i++
echo }
echo Write-Host "`n"
if /i "!FORENSIC_LANG!"=="EN" echo $sel = Read-Host "Type the NUMBER of the Target you want to use (0 to go back)"
if /i not "!FORENSIC_LANG!"=="EN" echo $sel = Read-Host "Escribe el NUMERO del Target que deseas utilizar (0 para volver)"
echo if ^($sel -match '^^\d+$' -and $sel -gt 0 -and $sel -le $targets.Count^) {
echo     [IO.File]::WriteAllText^("$env:TEMP\kape_target_!_km_guid!.txt", $targets[$sel-1]^)
echo }
) > "!_km_ps1!"

:: Ejecutar el script (muestra el menu en pantalla interactiva). -NoProfile como en
:: el resto del framework: un perfil del host no debe ejecutarse en este proceso.
powershell -NoProfile -ExecutionPolicy Bypass -File "!_km_ps1!"

:: Recuperar la selección
set "TARGET="
if exist "!_km_out!" (
    set /p TARGET=<"!_km_out!"
    del "!_km_out!"
)

:: Limpiar el script temporal
if exist "!_km_ps1!" del "!_km_ps1!"

if "!TARGET!"=="" goto MENU_ARTEFACTOS
goto CONFIG_EJECUCION

:CONFIG_EJECUCION
:: --- Verificación del Binario de KAPE ---
if not exist "!KAPE!" (
    echo.
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] ERROR: kape.exe was not found at the path:
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] ERROR: No se encontró kape.exe en la ruta:
    echo     !KAPE!
    if /i "!FORENSIC_LANG!"=="EN" echo     Verify that the KAPE folder exists inside the Windows folder.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo     Verifica que la carpeta KAPE exista dentro de la carpeta Windows.!C_RESET!
    pause
    goto MENU_ARTEFACTOS
)

:: --- Privilegios: KAPE se niega a trabajar sin Administrador y AUN ASI DEVUELVE 0 ---
:: Medido sobre kape.exe 1.3.0.2: sin elevacion imprime "Administrator privileges not
:: found! Exiting!!" y termina con codigo 0. El wrapper mapea 0 a exito, asi que el
:: modulo declaraba "Extraccion completada exitosamente" y lo escribia en el diario
:: habiendo recogido CERO artefactos. Se comprueba antes de pedir origen y destino: es
:: una limitacion real del sistema (control de cuentas de usuario), se informa y no se
:: intenta nada que no pueda funcionar.
if not defined IS_ADMIN (
    echo.
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] KAPE requires Administrator privileges and this session does NOT have them.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] KAPE exige privilegios de Administrador y esta sesión NO los tiene.!C_RESET!
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] Without them kape.exe refuses to run AND still returns exit code 0, so a!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] Sin ellos kape.exe se niega a ejecutarse Y AUN ASÍ devuelve código 0, de!C_RESET!
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] run would look successful while collecting nothing. Not attempted.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] modo que parecería exitoso sin recoger nada. No se intenta.!C_RESET!
    if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Re-run the framework as Administrator to use this module.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Vuelva a abrir el framework como Administrador para usar este módulo.!C_RESET!
    call :LOG_EVENT "Triaje KAPE NO ejecutado: la sesion no tiene privilegios de Administrador. kape.exe se niega a ejecutarse sin elevacion y devuelve codigo 0 de todas formas, asi que ejecutarlo habria producido una entrada de exito sin ningun artefacto recogido. Limitacion del entorno, no de la herramienta."
    echo.
    pause
    goto MENU_ARTEFACTOS
)

:: --- Configuración de Origen ---
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Drives available on the system:!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Unidades disponibles en el sistema:!C_RESET!
if !PS_VER! GEQ 3 powershell -NoProfile -Command "Get-CimInstance Win32_LogicalDisk | Select-Object DeviceID,@{N='Etiqueta';E={if($_.VolumeName){$_.VolumeName}else{'(Sin etiqueta)'}}} | Format-Table -AutoSize" 2>nul
if !PS_VER! LSS 3 powershell -NoProfile -Command "Get-WmiObject Win32_LogicalDisk | Select-Object DeviceID,@{N='Etiqueta';E={if($_.VolumeName){$_.VolumeName}else{'(Sin etiqueta)'}}} | Format-Table -AutoSize" 2>nul
echo.
:KAPE_SRC_ASK
set "SRC=C:"
if /i "!FORENSIC_LANG!"=="EN" set /p SRC="!C_PROMPT!Enter the source drive (default C:): !C_RESET!"
if /i not "!FORENSIC_LANG!"=="EN" set /p SRC="!C_PROMPT!Introduce la unidad de origen (por defecto C:): !C_RESET!"
set "SRC=!SRC:"=!"
if "!SRC!"=="" set "SRC=C:"
call :VALIDATE_SRC_DRIVE "!SRC!"
if not "!_VS_OK!"=="1" goto KAPE_SRC_ASK
:: Misma normalizacion que en particion logica: C o C:\ se reducen a C:.
set "SRC=!SRC:~0,1!:"

:: --- Configuración de Destino ---
echo.
:KAPE_DEST_ASK
:: El "0" ya se aceptaba, pero el prompt no lo decia: quien no lo supiera de
:: memoria no tenia forma de saber que existia una salida. Mismo formato que las
:: demas vias del framework.
set "DEST=!DEFAULT_DEST!"
if /i "!FORENSIC_LANG!"=="EN" set /p DEST="!C_PROMPT!Destination path [Enter = !DEFAULT_DEST!] (0=cancel): !C_RESET!"
if /i not "!FORENSIC_LANG!"=="EN" set /p DEST="!C_PROMPT!Ruta de destino [Enter = !DEFAULT_DEST!] (0=cancelar): !C_RESET!"
set "DEST=!DEST:"=!"
if "!DEST!"=="0" set "DEST=" & goto MENU_ARTEFACTOS
if "!DEST!"=="" set "DEST=!DEFAULT_DEST!"
call :VALIDATE_DEST_DIR "!DEST!"
if not "!_VD_OK!"=="1" goto KAPE_DEST_ASK
:: El triaje tampoco puede escribir en el volumen que lee: el destino por defecto
:: vive bajo la carpeta del script, y con el script en C: pulsar Enter dejaba
:: --tsource C: --tdest C:\...\Evidencias (visto en un ConsoleLog real), que
:: sobrescribe espacio no asignado del origen. Se reutiliza la comprobacion de
:: discos en su rama de particion logica; DRV_LETTER/DRV_PATH se guardan y se
:: restauran para no dejar estado residual en el modulo de discos.
set "_k_sv_dl=!DRV_LETTER!"
set "_k_sv_dp=!DRV_PATH!"
set "DRV_LETTER=!SRC:~0,1!"
set "DRV_PATH=!SRC!"
call :ADQ_CHECK_DEST_NOT_SOURCE
set "DRV_LETTER=!_k_sv_dl!"
set "DRV_PATH=!_k_sv_dp!"
if "!_ADQ_DVS_OK!"=="0" goto KAPE_DEST_ASK

:: Timestamp ISO 8601 (necesario antes del menu para usar como nombre por defecto)
for /f "usebackq delims=" %%T in (`powershell -NoProfile -Command "Get-Date -Format 'yyyyMMdd_HHmmss'"`) do set "KAPE_DATE=%%T"
if "!KAPE_DATE!"=="" set "KAPE_DATE=%DATE:~-4%%DATE:~3,2%%DATE:~0,2%"

:: --- Formato de contenedor para la evidencia ---
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT!Container format for the evidence:
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT!Formato de contenedor para la evidencia:
if /i "!FORENSIC_LANG!"=="EN" echo 1. Virtual Disk (.vhdx)
if /i not "!FORENSIC_LANG!"=="EN" echo 1. Disco Virtual (.vhdx)
if /i "!FORENSIC_LANG!"=="EN" echo 2. Compressed File (.zip)
if /i not "!FORENSIC_LANG!"=="EN" echo 2. Archivo Comprimido (.zip)
if /i "!FORENSIC_LANG!"=="EN" echo 0. Cancel!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo 0. Cancelar!C_RESET!
:KAPE_FMT_ASK
:: Sin el "0" este menu era un bucle cerrado: no acepta Enter y no aceptaba nada
:: que no fuera 1 o 2, asi que el operador que llegaba aqui por error no tenia
:: forma de volver salvo CTRL+C.
set "K_FMT="
set "fmt_opt="
if /i "!FORENSIC_LANG!"=="EN" set /p fmt_opt="!C_PROMPT!Option [1-2, 0=cancel]: !C_RESET!"
if /i not "!FORENSIC_LANG!"=="EN" set /p fmt_opt="!C_PROMPT!Opción [1-2, 0=cancelar]: !C_RESET!"
if "!fmt_opt!"=="0" set "DEST=" & goto MENU_ARTEFACTOS
if "!fmt_opt!"=="1" set "K_FMT=--vhdx"
if "!fmt_opt!"=="2" set "K_FMT=--zip"
if "!K_FMT!"=="" (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Invalid option. Enter 1 or 2.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Opción inválida. Ingrese 1 o 2.!C_RESET!
    goto KAPE_FMT_ASK
)

set "EVID_NAME=!COMPUTERNAME!_!KAPE_DATE!"
if /i "!FORENSIC_LANG!"=="EN" set /p EVID_NAME="!C_PROMPT!Container file name [!COMPUTERNAME!_!KAPE_DATE!]: !C_RESET!"
if /i not "!FORENSIC_LANG!"=="EN" set /p EVID_NAME="!C_PROMPT!Nombre del archivo contenedor [!COMPUTERNAME!_!KAPE_DATE!]: !C_RESET!"
if defined EVID_NAME set "EVID_NAME=!EVID_NAME:"=!"
if "!EVID_NAME!"=="" set "EVID_NAME=!COMPUTERNAME!_!KAPE_DATE!"

:: Crear directorio destino con estructura organizada
set "DEST=!DEST!\KAPE\!COMPUTERNAME!_!KAPE_DATE!"
if not exist "!DEST!" mkdir "!DEST!"

:: --- Ejecución de KAPE ---
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Starting extraction with KAPE...!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Iniciando extracción con KAPE...!C_RESET!
call :LOG_EVENT "Iniciando extraccion KAPE. Origen: !SRC!, Destino: !DEST!, Target: !TARGET!"
echo !C_TEXT![*] Target  : !TARGET!
if /i "!FORENSIC_LANG!"=="EN" echo [*] Source      : !SRC!
if /i not "!FORENSIC_LANG!"=="EN" echo [*] Origen  : !SRC!
if /i "!FORENSIC_LANG!"=="EN" echo [*] Destination : !DEST!
if /i not "!FORENSIC_LANG!"=="EN" echo [*] Destino : !DEST!
if /i "!FORENSIC_LANG!"=="EN" echo [*] Format  : !K_FMT! -- !EVID_NAME!!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo [*] Formato : !K_FMT! -- !EVID_NAME!!C_RESET!
echo.

:: Copias de sombra (VSS): es precisamente lo que reduce la inconsistencia de un
:: triaje EN VIVO y ademas recupera versiones anteriores de los artefactos. No se
:: ofrecia. Requiere privilegios de Administrador, asi que solo se plantea si los hay.
set "K_VSS="
set "K_VSS_TXT=NO"
if not defined IS_ADMIN goto KAPE_VSS_DONE
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Include Volume Shadow Copies (--vss)? On a live system this reduces!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] ¿Incluir copias de sombra (--vss)? En un sistema vivo reduce la!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] inconsistency of the collection and recovers earlier versions of the!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] inconsistencia de la recolección y recupera versiones anteriores de!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] artefacts. It takes longer and produces more data.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] los artefactos. Tarda más y produce más datos.!C_RESET!
set "_kape_vss="
if /i "!FORENSIC_LANG!"=="EN" set /p _kape_vss="!C_PROMPT!Include shadow copies? [Y/N]: !C_RESET!"
if /i not "!FORENSIC_LANG!"=="EN" set /p _kape_vss="!C_PROMPT!¿Incluir copias de sombra? [S/N]: !C_RESET!"
:: El prompt en ingles ofrece [Y/N]; se acepta Y como S.
if /i "!_kape_vss!"=="Y" set "_kape_vss=S"
if /I not "!_kape_vss!"=="S" goto KAPE_VSS_DONE
set "K_VSS=--vss"
set "K_VSS_TXT=SI"
:KAPE_VSS_DONE

:: Estado del origen y TARGET usado quedan en el diario. Un triaje es una coleccion
:: SELECTIVA de artefactos, no una imagen: sin saber que target se aplico -y que los
:: .tkape cambian entre versiones de KAPE- un tercero no puede repetir la recoleccion.
call :LOG_EVENT "Triaje KAPE sobre SISTEMA EN EJECUCION (origen !SRC!). Coleccion SELECTIVA de artefactos, NO una imagen: el contenido refleja distintos instantes dentro de la ventana de ejecucion y NO es un estado point-in-time. Target=!TARGET! VSS=!K_VSS_TXT!. LIMITACION DE REPRODUCIBILIDAD: la definicion del target vive en los archivos .tkape de esta instalacion de KAPE y cambia entre versiones, asi que el nombre del target por si solo no determina que se recogio."

:: Ejecución vía :ACQUIRE: CTRL+C muestra dialogo de confirmación y permite abortar.
call :NEWGUID ACQ_GUID
set "ACQ_CMD=!TEMP!\forensic_cmd_!ACQ_GUID!.tmp"
>"!ACQ_CMD!" echo "!KAPE!" --tsource "!SRC!" --target !TARGET! --tdest "!DEST!" !K_FMT! "!EVID_NAME!" !K_VSS! --quiet
set "ACQ_TOOL_VER=kape - no interrogada: sin elevacion solo imprime que le faltan privilegios; identificacion por SHA-256 en Herramientas_SHA256.txt"
:: KAPE escribe su <fecha>_ConsoleLog.txt en SU PROPIA carpeta, no en --tdest. Se
:: acumulaban ahi los de todos los casos -con equipo, usuario y rutas de cada uno-:
:: contaminacion cruzada entre casos y un log que no viajaba con su evidencia. Se
:: anotan los que ya existen y, al terminar, solo los NUEVOS se mueven al destino.
set "_kape_dir=!BASE_PATH!\Triaje\kape"
set "_kape_prev=!TEMP!\forensic_kapelogs_!ACQ_GUID!.txt"
dir /b "!_kape_dir!\*_ConsoleLog.txt" > "!_kape_prev!" 2>nul
call :ACQUIRE "KAPE_Triaje" "!ACQ_CMD!"
set "_kape_el=!errorlevel!"
for %%L in ("!_kape_dir!\*_ConsoleLog.txt") do findstr /x /i /c:"%%~nxL" "!_kape_prev!" >nul 2>&1 || move /Y "%%~fL" "!DEST!\" >nul 2>&1
del "!_kape_prev!" >nul 2>&1
if exist "!DEST!\*_ConsoleLog.txt" call :LOG_EVENT "ConsoleLog de KAPE de esta ejecucion movido junto a la evidencia, en !DEST!."

if "!_kape_el!"=="2" (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![ABORT] KAPE extraction aborted by the user.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![ABORT] Extracción KAPE abortada por el usuario.!C_RESET!
    call :LOG_EVENT "Extraccion KAPE abortada por el usuario (CTRL+C)."
    pause
    goto MENU_PRINCIPAL
)
if !_kape_el! equ 0 (
    echo.
    rem Localizar el contenedor real (KAPE antepone timestamp; si eligio VHDX puede comprimir a ZIP)
    set "_kape_hash_file="
    for %%F in ("!DEST!\*.zip")  do set "_kape_hash_file=%%~fF"
    if not defined _kape_hash_file (
        for %%F in ("!DEST!\*.vhdx") do set "_kape_hash_file=%%~fF"
    )
    set "_kape_hash_rep=!DEST!\hashes_kape.txt"
    rem El codigo 0 de kape.exe NO prueba que se haya recogido nada: la herramienta
    rem sale 0 tambien cuando se niega a arrancar. En este modulo el contenedor
    rem (--vhdx o --zip) es obligatorio, asi que su ausencia significa que no hay
    rem adquisicion. Antes se anunciaba y se registraba "completada exitosamente"
    rem ANTES de mirar si existia el contenedor, y el aviso posterior hablaba solo de
    rem "no se puede calcular hash". El exito se declara ahora sobre el artefacto.
    if not defined _kape_hash_file (
        if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] KAPE returned 0 but produced NO container in:!C_RESET!
        if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] KAPE devolvió 0 pero NO produjo ningún contenedor en:!C_RESET!
        echo     !DEST!
        if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] This is NOT a successful acquisition. Nothing is hashed and nothing is!C_RESET!
        if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] Esto NO es una adquisición exitosa. No se hashea nada ni se declara!C_RESET!
        if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] declared. Check the KAPE console log inside the destination folder.!C_RESET!
        if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] nada. Revise el ConsoleLog de KAPE en la carpeta de destino.!C_RESET!
        call :LOG_EVENT "Triaje KAPE: kape.exe termino con codigo 0 pero NO existe contenedor .zip ni .vhdx en !DEST!. NO se declara adquisicion: el codigo 0 de esta herramienta no acredita que se haya recogido nada. Target=!TARGET!."
    ) else (
        if /i "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Extraction completed successfully at:
        if /i not "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Extracción completada exitosamente en:
        echo     !DEST!!C_RESET!
        call :LOG_EVENT "Extraccion KAPE completada. Contenedor producido: !_kape_hash_file!"
        call :HASH_EVIDENCE FILE "!_kape_hash_file!" "*" "!_kape_hash_rep!" "KAPE_Triaje"
    )
) else (
    echo.
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] There were errors during KAPE execution or the process was interrupted.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Hubo errores durante la ejecución de KAPE o el proceso fue interrumpido.!C_RESET!
    call :LOG_EVENT "Error: Fallo durante la extraccion KAPE."
)

echo.
pause
goto MENU_PRINCIPAL

:: ===========================================================================
:: EVALUACION PREVIA A LA ADQUISICION - Identificacion de cifrado
::
:: ALCANCE: fase de IDENTIFICACION de ISO/IEC 27037, cuyo primer proceso es el
:: reconocimiento de las fuentes potenciales de evidencia. NIST SP 800-86 situa
:: en Examination lo que se ejecuta sobre "the collected data"; aqui NADA se ha
:: recolectado todavia, de modo que el modulo no invade esa fase.
::
:: NO descifra, NO extrae claves, NO monta sistemas de archivos, NO recorre MFT
:: ni Registro, NO enumera programas y NO decide nada: solo recomienda.
::
:: POR QUE LA LECTURA PROFUNDA ES UNA DECISION DEL OPERADOR Y NO AUTOMATICA:
:: se midio que "qemu-img dd" ignora el parametro skip en esta distribucion
:: -devuelve 0 bytes con skip>=1, tambien sobre RAW plano-, asi que la unica
:: lectura fiable es un prefijo desde el offset 0. Y el tamano de bloque domina:
:: 601 MiB tardan 71 s con bs=512 y 10 s con bs=1M. Un prefijo de 2 MiB alcanza
:: MBR, GPT y la particion que empiece en LBA 2048, y cuesta menos de un segundo;
:: llegar a la particion del sistema de un Windows tipico cuesta unos 10 s y un
:: temporal de 600 MB. Ese coste lo asume el perito a sabiendas, no la herramienta.
:: ===========================================================================
:: --- Requisitos comunes ---------------------------------------------------
:: Antes habia aqui un menu intermedio que volvia a preguntar "del host o de un
:: disco virtual". Sobraba: el contexto de entrada ya lo determina. Desde
:: Adquisicion solo cabe un disco fisico o periferico; desde Maquinas Virtuales,
:: solo un disco virtual. Un nivel de menu que repite la pregunta que el operador
:: ya respondio al elegir el modulo es friccion, no informacion.
:PREACQ_REQS
set "_PA_REQ=0"
if not exist "!PREACQ_PS1!" (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Engine not found: !PREACQ_PS1!!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] No se encuentra el motor: !PREACQ_PS1!!C_RESET!
    call :LOG_EVENT "Evaluacion Previa no disponible: falta !PREACQ_PS1!"
    pause
    exit /b 0
)
if !PS_VER! LSS 3 (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] This module requires PowerShell 3.0 or newer ^(detected: !PS_VER!^).!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Este módulo requiere PowerShell 3.0 o superior ^(detectado: !PS_VER!^).!C_RESET!
    call :LOG_EVENT "Evaluacion Previa no disponible: PS_VER=!PS_VER!, se requiere 3 o superior."
    pause
    exit /b 0
)
set "_PA_REQ=1"
exit /b 0

:PREACQ_CABECERA
echo !C_BORDER!!LINE!!C_RESET!
call :HDR TITLE "PRE-ACQUISITION ASSESSMENT" "EVALUACIÓN PREVIA A LA ADQUISICIÓN"
echo !C_BORDER!!LINE!!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_DIM!  Identification phase. Read-only. Generates recommendations;!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_DIM!  Fase de identificación. Solo lectura. Genera recomendaciones;!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_DIM!  it never decides. It does NOT decrypt nor extract any key.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_DIM!  nunca decide. NO descifra ni extrae ninguna clave.!C_RESET!
echo !C_BORDER!!SUBLINE!!C_RESET!
exit /b 0

:: --- Carpeta de destino comun a las dos vias ------------------------------
:PREACQ_DEST
set "_PA_OK=0"
set "pa_dest="
if /i "!FORENSIC_LANG!"=="EN" set /p pa_dest="!C_PROMPT!Destination folder [Enter = !DEFAULT_DEST!] (0=cancel): !C_RESET!"
if /i not "!FORENSIC_LANG!"=="EN" set /p pa_dest="!C_PROMPT!Carpeta destino [Enter = !DEFAULT_DEST!] (0=cancelar): !C_RESET!"
if "!pa_dest!"=="0" exit /b 0
if defined pa_dest set "pa_dest=!pa_dest:"=!"
if not defined pa_dest set "pa_dest=!DEFAULT_DEST!"
call :VALIDATE_DEST_DIR "!pa_dest!"
if not "!_VD_OK!"=="1" exit /b 0
set "PA_EVID=!pa_dest!\EvaluacionPrevia"
call :ENSURE_DIR "!PA_EVID!"
if not "!_ED_OK!"=="1" exit /b 0
call :UTCNOW _pa_ts COMPACT
set "_PA_OK=1"
exit /b 0

:: --- 1. HOST --------------------------------------------------------------
:: --- Cifrado de los volumenes conectados (disco fisico o periferico) -------
:: Punto de entrada desde MENU_ADQUISICION. Se llega DIRECTAMENTE, sin menu
:: intermedio: quien viene de "Adquisicion (Discos/Particiones)" ya ha dicho que
:: va a imagenar un soporte fisico.
:PREACQ_HOST
set "PA_VOLVER=MENU_ADQUISICION"
call :PREACQ_REQS
if not "!_PA_REQ!"=="1" goto MENU_ADQUISICION
cls
call :PREACQ_CABECERA
if /i "!FORENSIC_LANG!"=="EN" echo !C_TITLE!  Encryption of the connected volumes^: physical disk or peripheral!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TITLE!  Cifrado de los volúmenes conectados^: disco físico o periférico!C_RESET!
echo.
rem Se dice EXACTAMENTE que se enumera. Win32_EncryptableVolume devuelve TODOS
rem los volumenes que Windows reconoce, lo que incluye el periferico incautado y
rem tambien el volumen de sistema del propio equipo del perito. Presentarlo como
rem "el periferico" a secas haria que el informe listara un volumen que el
rem operador no esperaba y sembraria una duda innecesaria sobre el alcance.
if /i "!FORENSIC_LANG!"=="EN" echo !C_DIM!  Lists EVERY volume Windows can see: the seized peripheral and also this!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_DIM!  Enumera TODOS los volúmenes que Windows reconoce: el periférico incautado y!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_DIM!  examiner machine's own system volume. Identify yours in the report.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_DIM!  también el volumen del sistema del equipo del perito. Identifique el suyo.!C_RESET!
echo.
if not defined IS_ADMIN (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] Not elevated. Win32_EncryptableVolume returns "Access denied" without!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] Sin elevación. Win32_EncryptableVolume devuelve "Acceso denegado" sin!C_RESET!
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] Administrator rights ^(verified empirically^). The report will say so:!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] privilegios de Administrador ^(verificado empíricamente^). El informe lo dirá:!C_RESET!
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] "could not be determined" is NOT the same as "no encryption".!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] "no se pudo determinar" NO es lo mismo que "no hay cifrado".!C_RESET!
    echo.
)
call :PREACQ_DEST
if not "!_PA_OK!"=="1" goto MENU_ADQUISICION
set "PA_REP=!PA_EVID!\EvaluacionPrevia_Periferico_!_pa_ts!.txt"
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Querying Win32_EncryptableVolume...!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Consultando Win32_EncryptableVolume...!C_RESET!
echo.
powershell -NoProfile -ExecutionPolicy Bypass -File "!PREACQ_PS1!" -Modo Host -Informe "!PA_REP!"
set "_pa_el=!errorlevel!"
call :LOG_EVENT "Evaluacion Previa (HOST) ejecutada. Consulta de solo lectura a Win32_EncryptableVolume; no se modifico ninguna configuracion del host. Codigo de salida: !_pa_el!. Informe: !PA_REP!"
goto PREACQ_FIN

:: --- Cifrado de un disco virtual ------------------------------------------
:: Punto de entrada desde MENU_VM. Tambien se llega DIRECTAMENTE: quien viene de
:: "Maquinas Virtuales" ya ha dicho que el soporte es un contenedor virtual.
:PREACQ_DISCO
set "PA_VOLVER=MENU_VM"
call :PREACQ_REQS
if not "!_PA_REQ!"=="1" goto MENU_VM
cls
call :PREACQ_CABECERA
if /i "!FORENSIC_LANG!"=="EN" echo !C_TITLE!  Encryption of a VIRTUAL DISK ^(VMware, VirtualBox, Hyper-V^)!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TITLE!  Cifrado de un DISCO VIRTUAL ^(VMware, VirtualBox, Hyper-V^)!C_RESET!
echo.
if not exist "!QEMU_IMG!" (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] qemu-img not found: it is required to read the container.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] No se encuentra qemu-img: es necesario para leer el contenedor.!C_RESET!
    pause
    goto MENU_VM
)
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Reads MBR, GPT and the Volume Boot Record of the reachable partitions.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Lee MBR, GPT y el Volume Boot Record de las particiones alcanzables.!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Detects BitLocker ^(3 variants^), LUKS, CoreStorage, APFS and VeraCrypt/TrueCrypt MBR.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Detecta BitLocker ^(3 variantes^), LUKS, CoreStorage, APFS y VeraCrypt/TrueCrypt MBR.!C_RESET!
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] Reading a disk of a RUNNING VM is possible but the image would NOT be!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] Leer el disco de una VM ENCENDIDA es posible, pero la imagen NO sería!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] even crash-consistent. Only static structures are read here, which do!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] ni siquiera crash-consistent. Aquí solo se leen estructuras estáticas, que!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] not change after formatting. This is NOT acquisition and must be recorded so.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] no cambian tras el formateo. Esto NO es adquisición y debe constar así.!C_RESET!
echo.
rem Enumeracion de los discos de las tres plataformas para elegir por numero.
rem Antes habia que teclear la ruta completa a mano, que es donde mas se falla:
rem un .vmdk de VMware vive en Documentos, un .vdi en el perfil y un .vhdx en el
rem almacen de Hyper-V, y ademas hay que saber cual de la cadena es el que la VM
rem usa de verdad. El listador es de SOLO LECTURA y no invoca VBoxManage, que
rem arrancaria VBoxSVC y podria reescribir VirtualBox.xml.
set "PD_LISTA=!BASE_PATH!\Utilidades\Listar-DiscosVM.ps1"
set "pd_n=0"
if not exist "!PD_LISTA!" goto PD_PEDIR_RUTA
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Locating virtual disks...!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Localizando discos virtuales...!C_RESET!
call :NEWGUID _pd_g
set "_pd_tmp=!TEMP!\ambar_discos_!_pd_g!.txt"
:: El proveedor Hyper-V (Get-VM, Get-VHD...) SOLO existe registrado para el
:: host de PowerShell de 64 bits. Si este .bat se lanzo desde un cmd.exe de
:: 32 bits, "powershell" a secas resuelve al SysWOW64 de 32 bits: alli
:: "Import-Module Hyper-V" lanza excepcion, el try/catch del listador cae en
:: catch (0 VMs), pero el barrido de huerfanos NO depende de que el try haya
:: tenido exito -solo de estar elevado- asi que sigue corriendo igual y
:: encuentra los mismos discos de siempre sin ninguna VM que los reclame:
:: exactamente "0 maquinas, todo huerfano" con una Hyper-V Manager que
:: muestra VMs reales. Mismo diagnostico y misma solucion que ya existe en
:: la conversion de saved state a RAW (ver comentario alli, "resuelve a
:: SysWOW64"): PROCESSOR_ARCHITEW6432 solo esta definida en un proceso de 32
:: bits sobre un Windows de 64, y Sysnative es la puerta a los binarios
:: nativos desde ahi.
set "_pdps_exe=powershell"
if defined PROCESSOR_ARCHITEW6432 if exist "!SystemRoot!\Sysnative\WindowsPowerShell\v1.0\powershell.exe" set "_pdps_exe=!SystemRoot!\Sysnative\WindowsPowerShell\v1.0\powershell.exe"
"!_pdps_exe!" -NoProfile -ExecutionPolicy Bypass -File "!PD_LISTA!" > "!_pd_tmp!" 2>nul
echo.
rem El listador ya no emite una lista plana: emite un ARBOL con registros
rem tipados en el primer campo, y aqui solo se pinta.
rem   #PLAT|plataforma|n_maquinas|n_discos|n_huerfanos   cabecera de plataforma
rem   #VM|maquina|estado de registro                     cabecera de maquina
rem   #D|idx|ROL|fmt|MB|observacion|ruta                  disco seleccionable
rem   #NOTA|texto / #VACIO|texto
rem Las variables %%a..%%g se expanden en TIEMPO DE EJECUCION, despues de que
rem cmd haya parseado el bloque, asi que un ")" dentro de un rol como
rem "BASE (padre de la cadena)" o de una observacion NO cierra el parentesis
rem del for. Por eso se pueden imprimir tal cual sin escaparlos.
rem
rem Colores por CONTENIDO del campo, no por plataforma ni por posicion: se
rem prueba con el truco de sustitucion "!var:BUSCADO=!" (si el resultado
rem difiere de la variable original, BUSCADO estaba presente). HUERFANO y
rem AUSENTE se comprueban SIEMPRE primero y ganan sobre cualquier otro color:
rem son la senal mas grave y "NO REGISTRADA" contiene la palabra
rem "REGISTRADA", asi que si el verde se probara antes coloriaria de verde
rem justo el caso que tiene que salir en rojo.
for /f "usebackq tokens=1-7 delims=|" %%a in ("!_pd_tmp!") do (
    if "%%a"=="#PLAT" (
        echo.
        echo !C_BORDER!!LINE!!C_RESET!
        call :HDR TITLE "%%b" "%%b"
        call :HDR DIM "Maquinas: %%c !PIPE! Discos: %%d !PIPE! Huerfanos: %%e" "Maquinas: %%c !PIPE! Discos: %%d !PIPE! Huerfanos: %%e"
        echo !C_BORDER!!LINE!!C_RESET!
    ) else if "%%a"=="#VM" (
        set "_vm_nom=%%b"
        set "_vm_est=%%c"
        set "_vm_c=!C_TEXT!"
        set "_vm_nc=!C_OK!"
        if not "!_vm_est:NO REGISTRADA=!"=="!_vm_est!" set "_vm_c=!C_ERR!"
        if not "!_vm_est:AUSENTE=!"=="!_vm_est!" set "_vm_c=!C_ERR!"
        if /i "!_vm_nom!"=="DISCOS HUERFANOS" (set "_vm_c=!C_ERR!" & set "_vm_nc=!C_ERR!")
        if "!_vm_c!"=="!C_TEXT!" if not "!_vm_est:REGISTRADA=!"=="!_vm_est!" set "_vm_c=!C_OK!"
        echo.
        echo     !_vm_nc!* !_vm_nom!!C_RESET!  !_vm_c![!_vm_est!]!C_RESET!
    ) else if "%%a"=="#D" (
        set "PD_RUTA_%%b=%%g"
        set "PD_FMT_%%b=%%d"
        set "pd_n=%%b"
        set "_pd_obs=%%f"
        set "_pd_rol=%%c"
        set "_pd_rc=!C_TEXT!"
        if not "!_pd_rol:HUERFANO=!"=="!_pd_rol!" set "_pd_rc=!C_ERR!"
        if not "!_pd_rol:AUSENTE=!"=="!_pd_rol!" set "_pd_rc=!C_ERR!"
        if "!_pd_rc!"=="!C_TEXT!" if not "!_pd_rol:SNAPSHOT=!"=="!_pd_rol!" set "_pd_rc=!C_WARN!"
        if "!_pd_rc!"=="!C_TEXT!" if not "!_pd_rol:DIFERENCIAL=!"=="!_pd_rol!" set "_pd_rc=!C_WARN!"
        if "!_pd_rc!"=="!C_TEXT!" if not "!_pd_rol:CHECKPOINT=!"=="!_pd_rol!" set "_pd_rc=!C_WARN!"
        echo        !C_WARN!%%b.!C_RESET! !_pd_rc![!_pd_rol!]!C_RESET!  !C_DIM!%%d  %%e MB!C_RESET!
        echo           !C_DIM!%%g!C_RESET!
        if not "!_pd_obs!"=="-" echo           !C_DIM!%%f!C_RESET!
    ) else if "%%a"=="#NOTA" (
        echo.
        echo   !C_INFO![i] %%b!C_RESET!
    ) else if "%%a"=="#VACIO" (
        echo   !C_WARN![-] %%b!C_RESET!
    )
)
del "!_pd_tmp!" >nul 2>&1
echo.
set "pd_disk="
set "pd_sel="
if !pd_n! GTR 0 (
    if /i "!FORENSIC_LANG!"=="EN" set /p pd_sel="!C_PROMPT!Disk number, or R to type a path (0=cancel): !C_RESET!"
    if /i not "!FORENSIC_LANG!"=="EN" set /p pd_sel="!C_PROMPT!Número de disco, o R para escribir una ruta (0=cancelar): !C_RESET!"
)
if "!pd_sel!"=="0" goto MENU_VM
if /i "!pd_sel!"=="R" goto PD_PEDIR_RUTA
if defined pd_sel (
    for /f "delims=0123456789" %%z in ("!pd_sel!") do goto PD_PEDIR_RUTA
    call :NORM_SEL pd_sel
    for %%N in (!pd_sel!) do (
        set "pd_disk=!PD_RUTA_%%N!"
    )
)
if defined pd_disk goto PD_TIENE_RUTA

:PD_PEDIR_RUTA
set "pd_disk="
if /i "!FORENSIC_LANG!"=="EN" set /p pd_disk="!C_PROMPT!Path to the virtual disk (0=cancel): !C_RESET!"
if /i not "!FORENSIC_LANG!"=="EN" set /p pd_disk="!C_PROMPT!Ruta del disco virtual (0=cancelar): !C_RESET!"
if "!pd_disk!"=="0" goto MENU_VM
if not defined pd_disk goto MENU_VM
set "pd_disk=!pd_disk:"=!"

:PD_TIENE_RUTA
if not exist "!pd_disk!" (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] The file does not exist.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] El archivo no existe.!C_RESET!
    pause
    goto PREACQ_DISCO
)
rem El formato se deduce de la extension y ya NO se pide confirmar: qemu-img
rem exige -f, pero la extension lo determina sin ambiguedad en todos los
rem formatos que este modulo acepta, y preguntarlo solo anadia una pulsacion
rem que el operador respondia siempre con Enter. Si la extension no es
rem reconocible se pide la ruta de nuevo (mas abajo), que es el unico caso en
rem que la respuesta del operador aportaba algo.
set "pd_fmt="
for %%X in ("!pd_disk!") do set "_pd_ext=%%~xX"
if /i "!_pd_ext!"==".vhdx" set "pd_fmt=vhdx"
if /i "!_pd_ext!"==".vhd"  set "pd_fmt=vpc"
if /i "!_pd_ext!"==".avhdx" set "pd_fmt=vhdx"
if /i "!_pd_ext!"==".vdi"  set "pd_fmt=vdi"
if /i "!_pd_ext!"==".vmdk" set "pd_fmt=vmdk"
if /i "!_pd_ext!"==".qcow2" set "pd_fmt=qcow2"
if /i "!_pd_ext!"==".img"  set "pd_fmt=raw"
if /i "!_pd_ext!"==".raw"  set "pd_fmt=raw"
if /i "!_pd_ext!"==".dd"   set "pd_fmt=raw"
echo.
if defined pd_fmt (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Format inferred from the extension: !pd_fmt!!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Formato deducido de la extensión: !pd_fmt!!C_RESET!
)
if not defined pd_fmt (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Unrecognised extension: the format cannot be inferred.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Extensión no reconocida: no se puede deducir el formato.!C_RESET!
    pause
    goto PREACQ_DISCO
)
rem El prefijo tampoco se pregunta: se pasa 0, que el motor interpreta como
rem AUTOMATICO. Alli se lee primero el minimo (la tabla de particiones cabe
rem siempre en 2 MiB), se MIDE en que offset empieza la particion mas lejana
rem que declara la propia tabla del disco, y se relee justo lo necesario para
rem alcanzarla. Es un dato medido, no la estimacion "700 MiB suele bastar" que
rem se le ofrecia antes al operador. Lo que quede fuera del tope del motor
rem se sigue informando como NO INSPECCIONADA, nunca como limpia.
set "pd_mib=0"
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Prefix: AUTOMATIC (measured from the disk partition table).!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Prefijo: AUTOMÁTICO ^(medido sobre la tabla de particiones del disco^).!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_DIM!  Partitions beyond the prefix are reported as NOT INSPECTED, never as clean.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_DIM!  Las particiones fuera del prefijo se informan como NO INSPECCIONADAS, nunca como limpias.!C_RESET!
call :PREACQ_DEST
if not "!_PA_OK!"=="1" goto MENU_VM
for %%X in ("!pd_disk!") do set "_pd_base=%%~nX"
call :SANITIZE_NAME "!_pd_base!"
set "PA_REP=!PA_EVID!\EvaluacionPrevia_Disco_!_SN_OUT!_!_pa_ts!.txt"
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Reading the disk prefix ^(size measured automatically^)...!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Leyendo el prefijo del disco ^(tamaño medido automáticamente^)...!C_RESET!
echo.
powershell -NoProfile -ExecutionPolicy Bypass -File "!PREACQ_PS1!" -Modo Disco -Disco "!pd_disk!" -Formato "!pd_fmt!" -QemuImg "!QEMU_IMG!" -PrefijoMiB !pd_mib! -TempDir "!TEMP!" -Informe "!PA_REP!"
set "_pa_el=!errorlevel!"
call :LOG_EVENT "Evaluacion Previa (FIRMAS EN DISCO) sobre !pd_disk! (formato !pd_fmt! deducido de la extension, prefijo AUTOMATICO medido sobre la tabla de particiones del propio disco; el tamano exacto empleado consta en el informe). Lectura de SOLO LECTURA de estructuras estaticas: no se modifico el contenido del contenedor ni su sello de escritura. NO constituye adquisicion. Codigo de salida: !_pa_el!. Informe: !PA_REP!"
goto PREACQ_FIN

:: --- Cierre comun: hash del informe y decision del operador ---------------
:PREACQ_FIN
echo.
if not "!_pa_el!"=="0" (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![-] The engine returned code !_pa_el!. Review the output above.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![-] El motor devolvió código !_pa_el!. Revise la salida anterior.!C_RESET!
)
if exist "!PA_REP!" (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Report saved: !PA_REP!!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Informe guardado: !PA_REP!!C_RESET!
    set "DEST=!PA_EVID!"
    call :HASH_EVIDENCE FILE "!PA_REP!" "" "!PA_EVID!\hashes.sha256" "EvaluacionPrevia"
)
rem NO se pide al operador que teclee su decision. El diario ya registra QUE se
rem evaluo, CUANDO y con QUE resultado, que es lo acreditable por la herramienta.
rem El criterio del perito y su justificacion van en el informe pericial, fuera
rem del script. Un campo de texto libre en consola no aporta trazabilidad que el
rem diario no tenga ya, y obligaba a pulsar una tecla mas en cada pasada.
echo.
pause
if /i "!PA_VOLVER!"=="MENU_ADQUISICION" goto MENU_ADQUISICION
goto MENU_VM

:MENU_VM
set "HE_MODO="
cls
echo !C_BORDER!!LINE!!C_RESET!
call :HDR TITLE "VIRTUAL MACHINES" "MÁQUINAS VIRTUALES"
echo !C_BORDER!!LINE!!C_RESET!
:: Etiquetas de disponibilidad, mismo patron que las del menu principal. Cada
:: linea lleva su propia condicion completa: con "set A & if ... set B" el "&" NO
:: queda sujeto al if previo y la segunda asignacion se ejecutaria siempre,
:: mezclando los idiomas. Antes estas tres solo existian en espanol, asi que el
:: menu en ingles decia "VMware (no detectado)".
set "_tgVM=!C_DIM! (no detectado)!C_RESET!"
set "_tgVB=!C_DIM! (no detectado)!C_RESET!"
set "_tgHV=!C_DIM! (no detectado)!C_RESET!"
if /i "!FORENSIC_LANG!"=="EN" set "_tgVM=!C_DIM! (not detected)!C_RESET!"
if /i "!FORENSIC_LANG!"=="EN" set "_tgVB=!C_DIM! (not detected)!C_RESET!"
if /i "!FORENSIC_LANG!"=="EN" set "_tgHV=!C_DIM! (not detected)!C_RESET!"
if defined HAS_VMWARE set "_tgVM=!C_OK! (disponible)!C_RESET!"
if defined HAS_VBOX set "_tgVB=!C_OK! (disponible)!C_RESET!"
if defined HAS_HYPERV set "_tgHV=!C_OK! (disponible)!C_RESET!"
if /i "!FORENSIC_LANG!"=="EN" if defined HAS_VMWARE set "_tgVM=!C_OK! (available)!C_RESET!"
if /i "!FORENSIC_LANG!"=="EN" if defined HAS_VBOX set "_tgVB=!C_OK! (available)!C_RESET!"
if /i "!FORENSIC_LANG!"=="EN" if defined HAS_HYPERV set "_tgHV=!C_OK! (available)!C_RESET!"
echo !C_TEXT!1. VMware!_tgVM!
echo !C_TEXT!2. VirtualBox!_tgVB!
echo !C_TEXT!3. Hyper-V!_tgHV!
echo !C_BORDER!!SUBLINE!!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT!4. Convert Disk to RAW/IMG (QEMU)
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT!4. Convertir Disco a RAW/IMG (QEMU)
if /i "!FORENSIC_LANG!"=="EN" echo 0. Back to Main Menu!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo 0. Volver al Menú Principal!C_RESET!
echo !C_BORDER!!LINE!!C_RESET!
set "vm_opt="
if /i "!FORENSIC_LANG!"=="EN" set /p vm_opt="!C_PROMPT!Select an option: !C_RESET!"
if /i not "!FORENSIC_LANG!"=="EN" set /p vm_opt="!C_PROMPT!Selecciona una opción: !C_RESET!"

for /f "delims=0123456789" %%a in ("!vm_opt!") do (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Invalid option.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Opción inválida.!C_RESET!
    call :WAIT 2
    goto MENU_VM
)

if "!vm_opt!"=="0" goto MENU_PRINCIPAL
if "!vm_opt!"=="1" goto MENU_VM_VMWARE
if "!vm_opt!"=="2" goto MENU_VM_VBOX
if "!vm_opt!"=="3" (
    if not defined HAS_HYPERV (
        if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![-] Hyper-V is not available on this system.!C_RESET!
        if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![-] Hyper-V no esta disponible en este sistema.!C_RESET!
        if /i "!FORENSIC_LANG!"=="EN" echo !C_DIM!    Requires Windows 8+ Pro/Enterprise with the Hyper-V role enabled and PowerShell.!C_RESET!
        if /i not "!FORENSIC_LANG!"=="EN" echo !C_DIM!    Requiere Windows 8+ Pro/Enterprise con el rol Hyper-V habilitado y PowerShell.!C_RESET!
        pause
        goto MENU_VM
    )
    rem Los cmdlets de Hyper-V se ENUMERAN sin privilegios (Get-Command no los
    rem necesita) pero CONSULTAR falla: Get-VM devuelve "You do not have the
    rem required permission" por stderr, que el modulo redirigia a nul, y el
    rem operador leia "No se encontraron maquinas virtuales en Hyper-V". Medido
    rem en un host con el rol instalado y vmms en RUNNING sin elevar. Se corta
    rem aqui con el motivo real en vez de mentir mas adelante.
    if not defined IS_ADMIN (
        if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Hyper-V requires Administrator privileges to query the virtual machines.!C_RESET!
        if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Hyper-V requiere privilegios de Administrador para consultar las máquinas virtuales.!C_RESET!
        if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] Without elevation Get-VM fails with a permission error and the module!C_RESET!
        if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] Sin elevacion Get-VM falla por permisos y el modulo no puede distinguir!C_RESET!
        if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] cannot tell that apart from a host with no virtual machines at all.!C_RESET!
        if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] eso de un host que realmente no tiene ninguna máquina virtual.!C_RESET!
        if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Re-launch the framework as Administrator, or add your user to!C_RESET!
        if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Vuelva a lanzar el framework como Administrador, o anada su usuario al!C_RESET!
        if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT!    the "Hyper-V Administrators" local group.!C_RESET!
        if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT!    grupo local "Hyper-V Administrators".!C_RESET!
        call :LOG_EVENT "Modulo Hyper-V no iniciado: el proceso no esta elevado (IS_ADMIN no definido). Get-VM no puede consultarse sin privilegios."
        pause
        goto MENU_VM
    )
    goto MENU_HYPERV
)
if "!vm_opt!"=="4" goto MENU_QEMU

if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Invalid option.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Opción inválida.!C_RESET!
call :WAIT 2
goto MENU_VM

:MENU_VM_VMWARE
set "HE_MODO="
cls
echo !C_BORDER!!LINE!!C_RESET!
call :HDR TITLE "VMWARE - VIRTUAL MACHINES" "VMWARE - MÁQUINAS VIRTUALES"
echo !C_BORDER!!LINE!!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT!1. RAM Memory Dump (.vmem, .vmss, .vmsn)
