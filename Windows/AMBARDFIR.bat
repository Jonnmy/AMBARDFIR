:: --- VIRTUALBOX: RESOLUCIÓN DE VBoxManage --------------------------------
:: VBoxManage NO es portable. Salvo "--version", TODO subcomando instancia el
:: servidor COM VBoxSVC/VBoxSDS, que tiene que estar INSTALADO y REGISTRADO en
:: el host y ser de la MISMA version. Antes se probaba PRIMERO la copia del
:: arbol empaquetado -que setup-tools.bat pide copiar "desde tu instalacion de
:: VirtualBox"-: en cuanto el examinador la copiaba, esa copia ganaba a la
:: instalacion real y el subsistema entero devolvia codigo 1 con la salida
:: estandar VACIA, que el framework interpretaba como "no hay VMs".
:: Medido en este equipo (VirtualBox 7.2.12 instalado): la copia empaquetada
:: falla con "Completely failed to instantiate CLSID_VirtualBox:
:: ERROR_FILE_NOT_FOUND/0x80070002". Por eso el orden es: instalacion real
:: (%VBOX_MSI_INSTALL_PATH% -> registro -> %ProgramFiles% -> PATH) y la copia
:: empaquetada SOLO como ultimo recurso.
:: :VBOX_RESOLVE_CORE es SILENCIOSA y no falla nunca (deja VBOX_EXE vacia si no
:: encuentra nada): la comparte la deteccion de capacidades del arranque, que
:: no puede imprimir errores. Se resuelve UNA sola vez por sesion.
:: Salidas: !VBOX_EXE!, !VBOX_FROM! (INSTALL|PATH|BUNDLED), !VBOX_VER!,
::          !VBOX_VER_MAJOR!, !VBOX_CLONE_SUBCMD!
:: -----------------------------------------------------------------------
:VBOX_RESOLVE_CORE
if "!VBOX_RESOLVED!"=="1" exit /b 0
set "VBOX_RESOLVED=1"
set "VBOX_EXE="
set "VBOX_FROM="
set "VBOX_INSTALL_DIR="
if defined VBOX_MSI_INSTALL_PATH if exist "!VBOX_MSI_INSTALL_PATH!VBoxManage.exe" set "VBOX_INSTALL_DIR=!VBOX_MSI_INSTALL_PATH!"
if not defined VBOX_INSTALL_DIR call :VBOX_READ_REG "HKLM\SOFTWARE\Oracle\VirtualBox"
if not defined VBOX_INSTALL_DIR call :VBOX_READ_REG "HKLM\SOFTWARE\Wow6432Node\Oracle\VirtualBox"
if not defined VBOX_INSTALL_DIR if exist "%ProgramFiles%\Oracle\VirtualBox\VBoxManage.exe" set "VBOX_INSTALL_DIR=%ProgramFiles%\Oracle\VirtualBox\"
if not defined VBOX_INSTALL_DIR if exist "%ProgramFiles(x86)%\Oracle\VirtualBox\VBoxManage.exe" set "VBOX_INSTALL_DIR=%ProgramFiles(x86)%\Oracle\VirtualBox\"
if defined VBOX_INSTALL_DIR set "VBOX_EXE=!VBOX_INSTALL_DIR!VBoxManage.exe" & set "VBOX_FROM=INSTALL"
if not defined VBOX_EXE for %%P in (VBoxManage.exe) do if not "%%~$PATH:P"=="" set "VBOX_EXE=%%~$PATH:P" & set "VBOX_FROM=PATH"
if not defined VBOX_EXE if exist "!BASE_PATH!\Virtualizacion\VirtualBox\VBoxManage.exe" set "VBOX_EXE=!BASE_PATH!\Virtualizacion\VirtualBox\VBoxManage.exe" & set "VBOX_FROM=BUNDLED"
set "VBOX_VER="
set "VBOX_VER_MAJOR="
set "VBOX_CLONE_SUBCMD=clonemedium"
if not defined VBOX_EXE exit /b 0
rem "--version" es el UNICO subcomando que no inicializa COM: se lee incluso con
rem VBoxSVC caido (medido en este equipo, codigo 0 mientras "list vms" da 1).
for /f "usebackq tokens=1 delims=r" %%V in (`""!VBOX_EXE!" --version 2^>nul"`) do if not defined VBOX_VER set "VBOX_VER=%%V"
if defined VBOX_VER for /f "tokens=1 delims=." %%M in ("!VBOX_VER!") do set "VBOX_VER_MAJOR=%%M"
rem "clonemedium" no existe antes de VirtualBox 5.0: entonces el subcomando se
rem llamaba "clonehd" (en 7.2 sigue vivo como alias, comprobado en su ayuda).
rem Sin esta compuerta, en el objetivo XP/Vista -donde la ultima version
rem soportada es la 4.3- la clonacion fallaba con un error de subcomando
rem desconocido en lugar de funcionar con el nombre que esa version si entiende.
if defined VBOX_VER_MAJOR if !VBOX_VER_MAJOR! lss 5 set "VBOX_CLONE_SUBCMD=clonehd"
exit /b 0

:: -----------------------------------------------------------------------
:: VBOX_READ_REG - %1 = clave del registro. Deja la carpeta de instalacion en
:: !VBOX_INSTALL_DIR! SOLO si ahi existe de verdad VBoxManage.exe. reg.exe
:: viene de serie desde Windows XP, asi que no rompe el objetivo de
:: compatibilidad; si no existe, el for no itera y se sigue a la cascada.
:: -----------------------------------------------------------------------
:VBOX_READ_REG
set "_vbrr_dir="
for /f "tokens=2,*" %%A in ('reg query "%~1" /v InstallDir 2^>nul ^| findstr /I "InstallDir"') do set "_vbrr_dir=%%B"
if not defined _vbrr_dir exit /b 0
if not "!_vbrr_dir:~-1!"=="\" set "_vbrr_dir=!_vbrr_dir!\"
if exist "!_vbrr_dir!VBoxManage.exe" set "VBOX_INSTALL_DIR=!_vbrr_dir!"
set "_vbrr_dir="
exit /b 0

:: -----------------------------------------------------------------------
:: RESOLVE_VBOX - envoltorio que SI informa. Devuelve 1 si no hay VBoxManage.
:: -----------------------------------------------------------------------
:RESOLVE_VBOX
call :VBOX_RESOLVE_CORE
if not defined VBOX_EXE (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] VBoxManage.exe not found.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] No se encontró VBoxManage.exe.!C_RESET!
    if /i "!FORENSIC_LANG!"=="EN" echo !C_DIM!    Searched: %%VBOX_MSI_INSTALL_PATH%%, registry ^(Oracle\VirtualBox\InstallDir^),!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_DIM!    Buscado en: %%VBOX_MSI_INSTALL_PATH%%, registro ^(Oracle\VirtualBox\InstallDir^),!C_RESET!
    if /i "!FORENSIC_LANG!"=="EN" echo !C_DIM!    %%ProgramFiles%%\Oracle\VirtualBox, PATH and the bundled tree.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_DIM!    %%ProgramFiles%%\Oracle\VirtualBox, PATH y el arbol empaquetado.!C_RESET!
    exit /b 1
)
if "!VBOX_REPORTED!"=="1" exit /b 0
set "VBOX_REPORTED=1"
call :LOG_EVENT "Herramienta VirtualBox resuelta: VBoxManage = !VBOX_EXE! (origen=!VBOX_FROM! version=!VBOX_VER! subcomando de clonado=!VBOX_CLONE_SUBCMD!)"
if not "!VBOX_FROM!"=="BUNDLED" exit /b 0
:: La copia empaquetada es el ultimo recurso y hay que decir por que puede
:: fallar: sin la instalacion correspondiente el COM no se instancia y todos
:: los subcomandos devuelven error con salida vacia.
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] Using the BUNDLED copy of VBoxManage: no VirtualBox installation was found.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] Se usa la copia EMPAQUETADA de VBoxManage: no se encontró instalacion de VirtualBox.!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] VBoxManage is NOT portable: without the matching installed and registered!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] VBoxManage NO es portable: sin la instalacion equivalente registrada en!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] VBoxSVC/VBoxSDS service every subcommand will fail with empty output.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] este host (VBoxSVC/VBoxSDS) todo subcomando fallara con salida vacia.!C_RESET!
call :LOG_EVENT "LIMITACION: se usa la copia empaquetada de VBoxManage (!VBOX_EXE!) porque no hay instalacion de VirtualBox en este host. VBoxManage no es portable: requiere el servidor COM VBoxSVC/VBoxSDS de la misma version instalado y registrado."
exit /b 0

:: -----------------------------------------------------------------------
:: VBOX_PROBE - Distingue los TRES casos que antes se confundian en uno.
:: "list vms" con el COM caido devuelve codigo 1 y CERO bytes en la salida
:: estandar (medido en este equipo: 0 bytes en stdout, 315 en stderr), que es
:: exactamente lo mismo que "hay cero VMs registradas". Todos los for /f del
:: subsistema hacian "2>nul" y solo contaban lineas de stdout, asi que un
:: fallo de servicio se le presentaba al operador como el hecho -falso- de que
:: no hay maquinas virtuales, ocultandole la causa real.
:: Se captura stdout Y stderr a archivo y se guarda el errorlevel de inmediato.
:: Salidas: !VBOX_PROBE_OK! (1=hay VMs y se pueden listar), !VBOX_VMS_FILE!
:: (archivo con la salida de "list vms"; lo borra el llamador) y
:: !VBOX_PROBE_REASON! (COM|EMPTY|OK).
:: -----------------------------------------------------------------------
:VBOX_PROBE
set "VBOX_PROBE_OK=0"
set "VBOX_PROBE_REASON="
call :NEWGUID _vbp_guid
set "VBOX_VMS_FILE=!TEMP!\forensic_vbvms_!_vbp_guid!.tmp"
set "_vbp_errfile=!TEMP!\forensic_vberr_!_vbp_guid!.tmp"
"!VBOX_EXE!" list vms >"!VBOX_VMS_FILE!" 2>"!_vbp_errfile!"
set "_vbp_el=!errorlevel!"
set "_vbp_lines=0"
for /f "usebackq eol= delims=" %%L in ("!VBOX_VMS_FILE!") do set /a _vbp_lines+=1
if not "!_vbp_el!"=="0" goto VBOX_PROBE_COM
if !_vbp_lines! equ 0 goto VBOX_PROBE_EMPTY
set "VBOX_PROBE_OK=1"
set "VBOX_PROBE_REASON=OK"
del "!_vbp_errfile!" >nul 2>&1
exit /b 0

:VBOX_PROBE_COM
set "VBOX_PROBE_REASON=COM"
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] VirtualBox is installed but its service/COM is not responding.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] VirtualBox esta instalado pero su servicio/COM no responde.!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] "VBoxManage list vms" returned code !_vbp_el!. This is NOT "there are no VMs":!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] "VBoxManage list vms" devolvio código !_vbp_el!. Esto NO es "no hay VMs":!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] the inventory could not be read at all. Literal error reported:!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] el inventario no se pudo leer en absoluto. Error literal recibido:!C_RESET!
for /f "usebackq eol= delims=" %%E in ("!_vbp_errfile!") do echo !C_DIM!    %%E!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Usual causes: VBoxSVC/VBoxSDS cannot be instantiated, kernel modules from a!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Causas habituales: VBoxSVC/VBoxSDS no instanciable, modulos de kernel de!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] a different version, or a copied VBoxManage that is not registered.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] otra version, o un VBoxManage copiado que no esta registrado.!C_RESET!
call :LOG_EVENT "ABORTADO: VirtualBox instalado pero su servicio/COM no responde. 'VBoxManage list vms' codigo !_vbp_el! con salida estandar vacia. NO se afirma que no haya VMs: el inventario no se pudo leer. Binario: !VBOX_EXE! (origen=!VBOX_FROM! version=!VBOX_VER!)"
del "!_vbp_errfile!" >nul 2>&1
exit /b 0

:VBOX_PROBE_EMPTY
set "VBOX_PROBE_REASON=EMPTY"
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![-] There are no virtual machines registered in VirtualBox on this host.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![-] No hay máquinas virtuales registradas en VirtualBox en este host.!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_DIM!    ^("VBoxManage list vms" returned code 0 with no entries: the inventory IS readable.^)!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_DIM!    ^("VBoxManage list vms" devolvio código 0 y ninguna entrada: el inventario SI se pudo leer.^)!C_RESET!
call :LOG_EVENT "VirtualBox: inventario legible (codigo 0) y CERO VMs registradas en !COMPUTERNAME!."
del "!_vbp_errfile!" >nul 2>&1
exit /b 0

:: -----------------------------------------------------------------------
:: VBOX_PARSE_VM_LINE - %1 = linea de "VBoxManage list vms", con el formato
:: fijo  "NOMBRE" {UUID}  donde UUID es siempre canonico de 36 caracteres.
:: Antes se cortaba con delims={ y el nombre se partia por el PRIMER "{": un
:: nombre de VM que contenga "{" truncaba el nombre y corrompia el UUID. Aqui
:: se recorta por LONGITUD desde el final -sufijo fijo de 40 caracteres:
:: comilla + espacio + "{" + 36 + "}"-, que es inmune a llaves en el nombre.
:: Salidas: !_VBPL_NAME!, !_VBPL_UUID! (vacias si la linea no encaja).
:: -----------------------------------------------------------------------
:VBOX_PARSE_VM_LINE
set "_vbpl_in=%~1"
:: Entrada por variable (el llamador deja la linea en _vbpl_in): es la que hay que
:: usar con lineas que traen comillas propias, como las de "list vms".
:VBOX_PARSE_VM_LINE_IN
set "_VBPL_NAME="
set "_VBPL_UUID="
if not defined _vbpl_in exit /b 0
if not "!_vbpl_in:~-1!"=="}" exit /b 0
set "_vbpl_uuid=!_vbpl_in:~-37,36!"
set "_vbpl_name=!_vbpl_in:~0,-40!"
rem Se quitan TODAS las comillas en vez de comparar el primer caracter contra
rem una comilla: ese if es una de las formas mas faciles de desbalancear el
rem pareo de comillas de cmd.exe, y el resultado es el mismo.
set "_vbpl_name=!_vbpl_name:"=!"
if not defined _vbpl_name exit /b 0
set "_VBPL_NAME=!_vbpl_name!"
set "_VBPL_UUID=!_vbpl_uuid!"
exit /b 0

:: -----------------------------------------------------------------------
:: VBOX_ENUM_VMS - Probe + enumeracion de las VMs registradas, en UN solo
:: sitio. Antes los tres modulos de VirtualBox repetian el mismo for /f con
:: "2>nul" y "delims={", asi que cualquier arreglo habia que hacerlo tres
:: veces y los tres confundian "el COM no responde" con "no hay VMs".
:: Rellena !vb_count! y los arrays !VB_UUID_i! / !VB_NAME_i!.
:: Devuelve 1 si el llamador debe volver al menu, 0 si hay lista utilizable.
:: -----------------------------------------------------------------------
:VBOX_ENUM_VMS
set "vb_count=0"
call :VBOX_PROBE
if not "!VBOX_PROBE_OK!"=="1" (
    del "!VBOX_VMS_FILE!" >nul 2>&1
    exit /b 1
)
for /f "usebackq eol= delims=" %%L in ("!VBOX_VMS_FILE!") do (
    rem La linea viaja por VARIABLE, no como argumento: ya trae comillas propias
    rem ("Mi VM" {uuid}) y al envolverla en otras el argumento de call se partia en
    rem el primer espacio del nombre. Comprobado: una VM "Windows 10" llegaba como
    rem ["Windows] y desaparecia del listado sin aviso.
    set "_vbpl_in=%%L"
    call :VBOX_PARSE_VM_LINE_IN
    if defined _VBPL_UUID (
        set /a vb_count+=1
        set "VB_UUID_!vb_count!=!_VBPL_UUID!"
        set "VB_NAME_!vb_count!=!_VBPL_NAME!"
    )
)
del "!VBOX_VMS_FILE!" >nul 2>&1
if !vb_count! equ 0 (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] The inventory was read but no entry could be parsed.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Se leyó el inventario pero no se pudo interpretar ninguna entrada.!C_RESET!
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] "list vms" returned lines in an unexpected format. NOT claiming there are no VMs.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] "list vms" devolvio lineas con un formato inesperado. NO se afirma que no haya VMs.!C_RESET!
    call :LOG_EVENT "ABORTADO: 'VBoxManage list vms' devolvio codigo 0 y lineas con formato no reconocido. NO se afirma un recuento de VMs que no se pudo interpretar."
    exit /b 1
)
exit /b 0

:: --- VMWARE: RESOLUCIÓN DE vmrun Y vmware-vdiskmanager -------------------
:: Misma cascada que :RESOLVE_VBOX (empaquetado -> instalacion -> PATH).
:: POR QUE: la deteccion de capacidades marca HAS_VMWARE tambien cuando vmrun
:: esta en el PATH, asi que el menu podia anunciar VMware "disponible" mientras
:: el subsistema entero degradaba EN SILENCIO por probar solo la ruta del arbol
:: empaquetado, que en una instalacion normal no existe. Y si hay VMs es porque
:: hay Workstation/Player instalado: ahi viven los dos binarios.
:: Consecuencias medidas de no resolverlo: estado real de cada VM no mostrado,
:: listSnapshots nunca ejecutado, congelacion con snapshot no ofrecida y los
:: modos de snapshot inalcanzables.
:: NO falla nunca ni imprime nada: deja las variables VACIAS y cada punto de uso
:: decide (todos ellos ya usan "if exist"). Se resuelve UNA vez por sesion.
:: Salidas: !VMRUN_EXE!, !VMDK_EXE!, !VMW_TOOLS_RESOLVED!
:: -----------------------------------------------------------------------
:RESOLVE_VMWARE
if "!VMW_TOOLS_RESOLVED!"=="1" exit /b 0
set "VMW_TOOLS_RESOLVED=1"
set "VMRUN_EXE="
set "VMDK_EXE="
if exist "!BASE_PATH!\Virtualizacion\VMware\vmrun\vmrun.exe" set "VMRUN_EXE=!BASE_PATH!\Virtualizacion\VMware\vmrun\vmrun.exe"
if not defined VMRUN_EXE if exist "%ProgramFiles%\VMware\VMware Workstation\vmrun.exe" set "VMRUN_EXE=%ProgramFiles%\VMware\VMware Workstation\vmrun.exe"
if not defined VMRUN_EXE if exist "%ProgramFiles(x86)%\VMware\VMware Workstation\vmrun.exe" set "VMRUN_EXE=%ProgramFiles(x86)%\VMware\VMware Workstation\vmrun.exe"
if not defined VMRUN_EXE if exist "%ProgramFiles%\VMware\VMware Player\vmrun.exe" set "VMRUN_EXE=%ProgramFiles%\VMware\VMware Player\vmrun.exe"
if not defined VMRUN_EXE if exist "%ProgramFiles(x86)%\VMware\VMware Player\vmrun.exe" set "VMRUN_EXE=%ProgramFiles(x86)%\VMware\VMware Player\vmrun.exe"
rem Instalaciones antiguas de Workstation dejaban vmrun en el paquete VIX.
if not defined VMRUN_EXE if exist "%ProgramFiles%\VMware\VMware VIX\vmrun.exe" set "VMRUN_EXE=%ProgramFiles%\VMware\VMware VIX\vmrun.exe"
if not defined VMRUN_EXE if exist "%ProgramFiles(x86)%\VMware\VMware VIX\vmrun.exe" set "VMRUN_EXE=%ProgramFiles(x86)%\VMware\VMware VIX\vmrun.exe"
if not defined VMRUN_EXE for %%P in (vmrun.exe) do if not "%%~$PATH:P"=="" set "VMRUN_EXE=%%~$PATH:P"
if exist "!BASE_PATH!\Virtualizacion\VMware\vdiskmanager\bin\vmware-vdiskmanager.exe" set "VMDK_EXE=!BASE_PATH!\Virtualizacion\VMware\vdiskmanager\bin\vmware-vdiskmanager.exe"
if not defined VMDK_EXE if exist "%ProgramFiles%\VMware\VMware Workstation\vmware-vdiskmanager.exe" set "VMDK_EXE=%ProgramFiles%\VMware\VMware Workstation\vmware-vdiskmanager.exe"
if not defined VMDK_EXE if exist "%ProgramFiles(x86)%\VMware\VMware Workstation\vmware-vdiskmanager.exe" set "VMDK_EXE=%ProgramFiles(x86)%\VMware\VMware Workstation\vmware-vdiskmanager.exe"
if not defined VMDK_EXE if exist "%ProgramFiles%\VMware\VMware Player\vmware-vdiskmanager.exe" set "VMDK_EXE=%ProgramFiles%\VMware\VMware Player\vmware-vdiskmanager.exe"
if not defined VMDK_EXE if exist "%ProgramFiles(x86)%\VMware\VMware Player\vmware-vdiskmanager.exe" set "VMDK_EXE=%ProgramFiles(x86)%\VMware\VMware Player\vmware-vdiskmanager.exe"
if not defined VMDK_EXE for %%P in (vmware-vdiskmanager.exe) do if not "%%~$PATH:P"=="" set "VMDK_EXE=%%~$PATH:P"
if defined VMRUN_EXE call :LOG_EVENT "Herramienta VMware resuelta: vmrun = !VMRUN_EXE!"
if not defined VMRUN_EXE call :LOG_EVENT "vmrun.exe NO encontrado (buscado en !BASE_PATH!\Virtualizacion\VMware\vmrun\, %ProgramFiles%\VMware\VMware Workstation|Player|VIX\ y PATH)."
if defined VMDK_EXE call :LOG_EVENT "Herramienta VMware resuelta: vmware-vdiskmanager = !VMDK_EXE!"
if not defined VMDK_EXE call :LOG_EVENT "vmware-vdiskmanager.exe NO encontrado (buscado en !BASE_PATH!\Virtualizacion\VMware\vdiskmanager\bin\, %ProgramFiles%\VMware\VMware Workstation|Player\ y PATH)."
exit /b 0

:: -----------------------------------------------------------------------
:: VMWARE_TOOLS_REPORT
:: Imprime UNA vez, tras resolver, que herramientas hay y que se pierde sin
:: ellas. Antes el operador no tenia forma de saber por que el subsistema se
:: comportaba de otra manera: no habia ni un mensaje.
:: -----------------------------------------------------------------------
:VMWARE_TOOLS_REPORT
if defined VMRUN_EXE exit /b 0
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] vmrun.exe not found: VM state, snapshot enumeration and freezing!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] No se encontró vmrun.exe: el estado de la VM, la enumeracion de!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] with a snapshot are unavailable. Everything else keeps working.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] snapshots y la congelacion con snapshot no estan disponibles.!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_DIM!    Searched: bundled tree, %%ProgramFiles%%\VMware\VMware Workstation^|Player^|VIX and PATH.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_DIM!    Buscado en: arbol empaquetado, %%ProgramFiles%%\VMware\VMware Workstation^|Player^|VIX y PATH.!C_RESET!
exit /b 0

:: -----------------------------------------------------------------------
:: VBOX_GET_VMSTATE
:: %1 = UUID de la VM. Lee la propiedad OFICIAL VMState de
:: "showvminfo --machinereadable" y la deja CRUDA en !VBOX_VMSTATE!.
:: POR QUE no se usa "list runningvms": ese comando solo reporta los estados
:: ONLINE (running, paused, teleporting, livesnapshotting, teleportingpausedvm).
:: Todo lo demas -stuck (guru meditation), starting, stopping, saving,
:: restoring, snapshotting, onlinesnapshotting, deletingsnapshotonline,
:: settingup, aborted, aborted-saved e inaccesible- NO aparece ahi, y antes se
:: etiquetaba por defecto como "Apagada" y ATRAVESABA la puerta de seguridad:
:: el flujo llegaba a clonar contra una VM con los medios bloqueados o en
:: transicion y fallaba con el error generico "Error al clonar el disco".
:: Ademas "aborted" (terminacion sucia sin estado guardado) y "aborted-saved"
:: (terminacion sucia CON .sav) son hechos materiales del caso: llamarlos
:: "Apagada" oculta informacion que cambia la interpretacion del disco.
:: Cadena vacia = no se pudo determinar (y entonces NO se adquiere).
:: -----------------------------------------------------------------------
:VBOX_GET_VMSTATE
set "VBOX_VMSTATE="
for /f "tokens=1,* delims==" %%A in ('""!VBOX_EXE!" showvminfo "%~1" --machinereadable 2^>nul ^| findstr /I "^VMState=""') do set "VBOX_VMSTATE=%%B"
if defined VBOX_VMSTATE set "VBOX_VMSTATE=!VBOX_VMSTATE:"=!"
exit /b 0

:: -----------------------------------------------------------------------
:: VBOX_STATE_CLASS
:: %1 = literal de VMState. Clasifica en lo UNICO que importa para decidir:
::   OK        -> poweroff: adquirible sin reservas
::   OK_SAV    -> saved / aborted-saved: adquirible, pero hay RAM en un .sav
::   OK_ABORT  -> aborted: adquirible, terminacion sucia sin estado guardado
::   ONLINE    -> running / paused: hay que apagarla o cancelar
::   BAD       -> cualquier otro, incluido vacio/desconocido: NO se adquiere
:: Resultado en !VBOX_SCLASS!.
:: -----------------------------------------------------------------------
:VBOX_STATE_CLASS
set "VBOX_SCLASS=BAD"
if /I "%~1"=="poweroff" set "VBOX_SCLASS=OK"
if /I "%~1"=="saved" set "VBOX_SCLASS=OK_SAV"
if /I "%~1"=="aborted-saved" set "VBOX_SCLASS=OK_SAV"
if /I "%~1"=="aborted" set "VBOX_SCLASS=OK_ABORT"
if /I "%~1"=="running" set "VBOX_SCLASS=ONLINE"
if /I "%~1"=="paused" set "VBOX_SCLASS=ONLINE"
exit /b 0

:: -----------------------------------------------------------------------
:: VBOX_STATE_LABEL
:: %1 = literal de VMState. Deja en !_vb_state! la etiqueta coloreada y
:: BILINGUE. Antes estas etiquetas estaban en español fijo y se imprimian
:: igual con FORENSIC_LANG=EN, dentro del listado de seleccion de VM que ven
:: los tres modulos de VirtualBox. Los estados que no tienen etiqueta propia
:: se muestran con su LITERAL entre parentesis: no se puede maquillar como
:: "Apagada" algo que el hipervisor no ha dicho que este apagado.
:: -----------------------------------------------------------------------
:VBOX_STATE_LABEL
call :VBOX_STATE_CLASS "%~1"
if "!VBOX_SCLASS!"=="OK" if /i "!FORENSIC_LANG!"=="EN" set "_vb_state=!C_DIM!Powered off!C_RESET!"
if "!VBOX_SCLASS!"=="OK" if /i not "!FORENSIC_LANG!"=="EN" set "_vb_state=!C_DIM!Apagada!C_RESET!"
if /I "%~1"=="saved" if /i "!FORENSIC_LANG!"=="EN" set "_vb_state=!C_WARN!Saved state (RAM on disk)!C_RESET!"
if /I "%~1"=="saved" if /i not "!FORENSIC_LANG!"=="EN" set "_vb_state=!C_WARN!Suspendida (RAM en disco)!C_RESET!"
if /I "%~1"=="aborted-saved" if /i "!FORENSIC_LANG!"=="EN" set "_vb_state=!C_ERR!Aborted WITH saved state!C_RESET!"
if /I "%~1"=="aborted-saved" if /i not "!FORENSIC_LANG!"=="EN" set "_vb_state=!C_ERR!Abortada CON estado guardado!C_RESET!"
if /I "%~1"=="aborted" if /i "!FORENSIC_LANG!"=="EN" set "_vb_state=!C_ERR!Aborted (dirty termination)!C_RESET!"
if /I "%~1"=="aborted" if /i not "!FORENSIC_LANG!"=="EN" set "_vb_state=!C_ERR!Abortada (terminacion sucia)!C_RESET!"
if /I "%~1"=="running" if /i "!FORENSIC_LANG!"=="EN" set "_vb_state=!C_OK!Running!C_RESET!"
if /I "%~1"=="running" if /i not "!FORENSIC_LANG!"=="EN" set "_vb_state=!C_OK!Encendida!C_RESET!"
if /I "%~1"=="paused" if /i "!FORENSIC_LANG!"=="EN" set "_vb_state=!C_WARN!Paused!C_RESET!"
if /I "%~1"=="paused" if /i not "!FORENSIC_LANG!"=="EN" set "_vb_state=!C_WARN!Pausada!C_RESET!"
if not "!VBOX_SCLASS!"=="BAD" exit /b 0
if "%~1"=="" if /i "!FORENSIC_LANG!"=="EN" set "_vb_state=!C_ERR!State could not be read!C_RESET!"
if "%~1"=="" if /i not "!FORENSIC_LANG!"=="EN" set "_vb_state=!C_ERR!Estado no legible!C_RESET!"
if not "%~1"=="" if /i "!FORENSIC_LANG!"=="EN" set "_vb_state=!C_ERR!Transient/unknown state (%~1)!C_RESET!"
if not "%~1"=="" if /i not "!FORENSIC_LANG!"=="EN" set "_vb_state=!C_ERR!Estado transitorio/desconocido (%~1)!C_RESET!"
exit /b 0

:: -----------------------------------------------------------------------
:: VBOX_GET_VM_STATE_LABEL
:: %1 = UUID de la VM. Lee el estado y devuelve la etiqueta lista para
:: mostrar en !_vb_state!, y el literal en !VBOX_VMSTATE! por si el llamador
:: lo necesita para la cadena de custodia.
:: -----------------------------------------------------------------------
:VBOX_GET_VM_STATE_LABEL
call :VBOX_GET_VMSTATE "%~1"
call :VBOX_STATE_LABEL "!VBOX_VMSTATE!"
exit /b 0

:: --- VIRTUALBOX: ADQUISICIÓN DE DISCO ---
:VBOX_DISK
call :RESOLVE_VBOX
if !errorlevel! neq 0 (
    pause
    goto MENU_VM_VBOX
)
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] VirtualBox Disk Acquisition!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Adquisición de Disco de VirtualBox!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Detecting VirtualBox virtual machines...!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Detectando máquinas virtuales de VirtualBox...!C_RESET!
echo.

:: Listar VMs (probe + enumeracion compartida: distingue COM caido de 0 VMs)
call :VBOX_ENUM_VMS
if !errorlevel! neq 0 (
    pause
    goto MENU_VM_VBOX
)

if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT!Virtual Machines detected in VirtualBox:!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT!Máquinas Virtuales detectadas en VirtualBox:!C_RESET!
for /L %%i in (1,1,!vb_count!) do (
    call :VBOX_GET_VM_STATE_LABEL "!VB_UUID_%%i!"
    echo  %%i. !VB_NAME_%%i! [!VB_UUID_%%i!] - !_vb_state!
)
echo.

:PROMPT_VB_DISK_SEL
set "vb_sel="
if /i "!FORENSIC_LANG!"=="EN" set /p vb_sel="!C_PROMPT!Select the VM [1-!vb_count!, 0=cancel]: !C_RESET!"
if /i not "!FORENSIC_LANG!"=="EN" set /p vb_sel="!C_PROMPT!Seleccione la VM [1-!vb_count!, 0=cancelar]: !C_RESET!"
if "!vb_sel!"=="0" goto MENU_VM_VBOX
if not defined vb_sel goto PROMPT_VB_DISK_SEL
for /f "delims=0123456789" %%a in ("!vb_sel!") do (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Please enter a valid number.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Por favor, ingrese un número válido.!C_RESET!
    goto PROMPT_VB_DISK_SEL
)
if !vb_sel! lss 1 goto PROMPT_VB_DISK_SEL
if !vb_sel! gtr !vb_count! goto PROMPT_VB_DISK_SEL

call :NORM_SEL vb_sel
set "VB_SEL_UUID=!VB_UUID_%vb_sel%!"
set "VB_SEL_NAME=!VB_NAME_%vb_sel%!"
call :LOG_CTX "VIRTUALBOX" "!VB_SEL_NAME!" "!VB_SEL_UUID!"
if not defined VB_SEL_UUID goto PROMPT_VB_DISK_SEL

:: Verificar que la VM NO este en ejecución - si lo esta, ofrecer apagarla
:: automáticamente (ACPI, apagado normal) o que el operador lo haga manual.
call :VBOX_HANDLE_VM_RUNNING "!VB_SEL_UUID!" "!VB_SEL_NAME!"
if "!VBXR_ABORT!"=="1" goto MENU_VM_VBOX

:: Detectar snapshots ANTES de buscar discos (comando oficial: VBoxManage
:: snapshot list) y preguntar al operador como proceder.
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Verifying snapshots of !VB_SEL_NAME!...!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Verificando snapshots de !VB_SEL_NAME!...!C_RESET!
:: El recuento por si solo NO distingue "esta VM no tiene snapshots" de "no se
:: pudo consultar la VM": el 2>nul se traga el error de VBoxManage y el contador
:: se queda en 0 en los dos casos. Se confirma aparte que la VM es consultable
:: con showvminfo, del que solo se usa el CODIGO DE SALIDA: nada de depender del
:: texto -que VirtualBox traduce- ni del codigo de "snapshot list", que devuelve
:: error tambien cuando legitimamente no hay ninguno. showvminfo sin flags existe
:: en todas las versiones de VBoxManage.
:: El recuento se hacia con "snapshot list | findstr /I Name:" sobre la salida
:: HUMANA: la DESCRIPCION de un snapshot que contuviera "Name:" inflaba el
:: recuento, y ademas convivia con el recuento machine-readable de
:: :VBOX_LIST_SNAPSHOTS (VBS_COUNT) sin que nadie detectara si discrepaban. Se
:: cuenta UNA sola vez, siempre con --machinereadable y clave anclada
:: (^SnapshotName), que es lo que ya hace esa rutina.
set "vb_snap_count=0"
set "vb_snap_enum_ok=0"
"!VBOX_EXE!" showvminfo "!VB_SEL_UUID!" >nul 2>&1
set "_vb_svi_el=!errorlevel!"
if "!_vb_svi_el!"=="0" set "vb_snap_enum_ok=1"
call :VBOX_LIST_SNAPSHOTS "!VB_SEL_UUID!"
set "vb_snap_count=!VBS_COUNT!"
rem Si se listo al menos uno, la enumeracion evidentemente funciono.
if !vb_snap_count! gtr 0 set "vb_snap_enum_ok=1"

set "VB_SNAP_MODE=1"
set "VB_CHOSEN_SNAP_UUID="
set "VB_CHOSEN_SNAP_NAME="
if "!vb_snap_enum_ok!"=="0" goto VB_SNAP_ENUM_FAILED
if !vb_snap_count! equ 0 (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_OK![+] No snapshots detected.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_OK![+] No se detectaron snapshots.!C_RESET!
    goto VB_SNAP_MODE_DONE
)
call :ASK_VBOX_SNAPSHOT_MODE !vb_snap_count!
call :LOG_EVENT "VirtualBox snapshots detectados: !vb_snap_count! (modo=!VB_SNAP_MODE!) - !VB_SEL_NAME!"
if "!VB_SNAP_MODE!"=="0" goto MENU_VM_VBOX
if "!VB_SNAP_MODE!"=="1" if /i "!FORENSIC_LANG!"=="EN" echo !C_OK![+] The full disk will be acquired ^(current state, snapshots applied^).!C_RESET!
if "!VB_SNAP_MODE!"=="1" if /i not "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Se adquirira el disco completo ^(estado actual, snapshots aplicados^).!C_RESET!
if "!VB_SNAP_MODE!"=="2" if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] Snapshots will be excluded. Only the base disk will be acquired.!C_RESET!
if "!VB_SNAP_MODE!"=="2" if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] Los snapshots serán excluidos. Solo se adquirira el disco base.!C_RESET!
if "!VB_SNAP_MODE!"=="4" (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_OK![+] The original disk will be acquired first; when it ends you will be asked to!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Se adquirira el disco original primero; al terminar se le pedira!C_RESET!
    if /i "!FORENSIC_LANG!"=="EN" echo !C_OK![+] to choose the specific snapshot as a separate second deliverable.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_OK![+] elegir el snapshot específico como segundo entregable separado.!C_RESET!
)
:: El modo 3 (SOLO snapshot) y el modo 4 (disco original + snapshot como
:: segundo entregable) necesitan elegir el snapshot específico aquí; los
:: demas modos no.
set "_vb_need_snap_pick=0"
if "!VB_SNAP_MODE!"=="3" set "_vb_need_snap_pick=1"
if "!VB_SNAP_MODE!"=="4" set "_vb_need_snap_pick=1"
if not "!_vb_need_snap_pick!"=="1" goto VB_SNAP_MODE_DONE

:: NOTA: esta selección se mantiene a nivel superior (sin envolver en un
:: bloque "if (...)") a propósito - un label con bucle de reintento anidado
:: dentro de parentesis es una fuente conocida de bugs de parseo en cmd.exe
:: ya vista en otras partes de este script.
call :VBOX_LIST_SNAPSHOTS "!VB_SEL_UUID!"
if !VBS_COUNT! equ 0 (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Could not enumerate the named snapshots.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] No se pudieron enumerar los snapshots con nombre.!C_RESET!
    pause
    goto MENU_VM_VBOX
)
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_TITLE!Available snapshots:!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TITLE!Snapshots disponibles:!C_RESET!
echo.
for /L %%i in (1,1,!VBS_COUNT!) do echo  !C_WARN!%%i. !VBS_NAME_%%i!!C_RESET!
echo.
:PROMPT_VB_SNAP_SEL
set "vbs_sel="
if /i "!FORENSIC_LANG!"=="EN" set /p vbs_sel="!C_PROMPT!Select the snapshot to acquire [1-!VBS_COUNT!, 0=cancel]: !C_RESET!"
if /i not "!FORENSIC_LANG!"=="EN" set /p vbs_sel="!C_PROMPT!Seleccione el snapshot a adquirir [1-!VBS_COUNT!, 0=cancelar]: !C_RESET!"
if "!vbs_sel!"=="0" goto MENU_VM_VBOX
if not defined vbs_sel goto PROMPT_VB_SNAP_SEL
for /f "delims=0123456789" %%a in ("!vbs_sel!") do (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Enter a valid number.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Ingrese un número válido.!C_RESET!
    goto PROMPT_VB_SNAP_SEL
)
if !vbs_sel! lss 1 goto PROMPT_VB_SNAP_SEL
if !vbs_sel! gtr !VBS_COUNT! goto PROMPT_VB_SNAP_SEL
call :NORM_SEL vbs_sel
set "VB_CHOSEN_SNAP_UUID=!VBS_UUID_%vbs_sel%!"
set "VB_CHOSEN_SNAP_NAME=!VBS_NAME_%vbs_sel%!"
if not defined VB_CHOSEN_SNAP_UUID goto PROMPT_VB_SNAP_SEL
if /i "!FORENSIC_LANG!"=="EN" echo !C_OK![+] ONLY the snapshot will be acquired: !VB_CHOSEN_SNAP_NAME!!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Se adquirira SOLO el snapshot: !VB_CHOSEN_SNAP_NAME!!C_RESET!
goto VB_SNAP_MODE_DONE

:VB_SNAP_ENUM_FAILED
:: No se pudo consultar la VM: no se afirma un recuento de snapshots que no se
:: ha medido. Seguir adelante decidiria sobre una cadena diferencial sin saber
:: si existe, y eso no se puede sostener en un informe.
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Could not enumerate the snapshots of !VB_SEL_NAME!.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] No se pudieron enumerar los snapshots de !VB_SEL_NAME!.!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] VBoxManage could not query the VM (code !_vb_svi_el!). Possible causes: the!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] VBoxManage no pudo consultar la VM (código !_vb_svi_el!). Causas posibles: el!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] VBoxSVC service is down, or the VM is no longer registered in the inventory.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] servicio VBoxSVC esta caido, o la VM ya no esta registrada en el inventario.!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] The acquisition is NOT continued: the snapshot chain could not be verified.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] NO se continua la adquisición: no se pudo comprobar la cadena de snapshots.!C_RESET!
call :LOG_EVENT "ABORTADO: no se pudo enumerar los snapshots de VirtualBox (showvminfo codigo !_vb_svi_el!) - !VB_SEL_NAME! - no se afirma un recuento que no se pudo medir"
pause
goto MENU_VM_VBOX

:VB_SNAP_MODE_DONE

:: Buscar UUID del disco
echo.
rem Marcador de progreso: en el resto del framework va en C_TITLE, no en C_TEXT.
if /i "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Searching disks of !VB_SEL_NAME!...!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Buscando discos de !VB_SEL_NAME!...!C_RESET!
:: Limpiar resultados de una VM anterior: sin esto, si esta VM no reporta
:: discos, se clonaria por error el disco de la ejecución previa.
set "VB_DISK_UUID_1="
set "VB_DISK_PATH_1="
set "VB_DISK_FMT_1="
set "vb_disk_count=0"
:: Se carga PRIMERO el inventario de DISCOS DUROS registrados ("list hdds", que
:: por definicion no lista DVD ni floppy) con su ruta y su formato reales.
call :VBOX_LOAD_HDDS
:: BUG REAL detectado en auditoría dinamica (confirmado contra VirtualBox
:: real: VM con disco adjunto reportaba "no se encontraron discos"):
:: "--machinereadable" usa "=" como separador clave/valor (clave="valor"),
:: NUNCA ":". Con delims=: no hay delimitador en la línea, %%B (el valor)
:: siempre queda vacio y el UUID nunca se detecta, sin importar que el
:: disco exista.
:: SEGUNDO BUG, medido en una VM real de este equipo (win.final): el bucle
:: aceptaba cualquier clave que contuviera "ImageUUID", sin distinguir disco
:: duro de DVD o floppy. Esa VM tiene un ISO adjunto en la MISMA controladora
:: SATA y DECLARADO ANTES del disco duro, asi que el UUID del ISO podia quedar
:: como VB_DISK_UUID_1 y "clonemedium" fallaba sobre el; y si no quedaba
:: primero, el recuento igual quedaba inflado. Ahora cada UUID se cruza contra
:: el inventario de discos duros: si no esta ahi, no es un disco duro.
for /f "tokens=1,* delims==" %%A in ('""!VBOX_EXE!" showvminfo "!VB_SEL_UUID!" --machinereadable 2^>nul"') do (
    set "vb_key=%%A"
    set "vb_val=%%B"
    if defined vb_key (
        echo !vb_key! | findstr /i "ImageUUID" >nul 2>&1
        if !errorlevel! equ 0 (
            set "vb_val=!vb_val:"=!"
            if defined vb_val (
                call :VBOX_HDD_LOOKUP "!vb_val!"
                if "!_VHL_OK!"=="1" (
                    set /a vb_disk_count+=1
                    set "VB_DISK_UUID_!vb_disk_count!=!vb_val!"
                    set "VB_DISK_PATH_!vb_disk_count!=!_VHL_LOC!"
                    set "VB_DISK_FMT_!vb_disk_count!=!_VHL_FMT!"
                )
            )
        )
    )
)

if !vb_disk_count! equ 0 (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![-] No hard disks associated with this VM were found.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![-] No se encontraron discos duros asociados a esta VM.!C_RESET!
    if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Trying to search by disk path...!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Intentando buscar por ruta de disco...!C_RESET!
    rem BUG REAL adicional: findstr sin /R hace coincidencia LITERAL - el
    rem patron anterior ("\.vdi\^> ...") buscaba un backslash-punto seguido
    rem de un carácter ">" que no existe en el valor real (termina en
    rem comilla, ej. ...Proyecto.Final.vdi").
    rem Y el patron "corregido" tampoco valia: ".vdi .vmdk .vhd" se evalua en
    rem modo REGEX -el de por defecto-, donde el punto es un comodin, asi que
    rem casaba "Xvdi"; y al aplicarse sobre TODAS las lineas de showvminfo, una
    rem VM llamada por ejemplo "Ubuntu-vdi-test" hacia que la linea
    rem name="Ubuntu-vdi-test" se tomara por una ruta de disco. Ahora el punto
    rem va escapado y la extension tiene que estar AL FINAL del valor.
    for /f "tokens=1,* delims==" %%A in ('""!VBOX_EXE!" showvminfo "!VB_SEL_UUID!" --machinereadable 2^>nul ^| findstr /R /I "\.vdi.$ \.vmdk.$ \.vhd.$""') do (
        set "vb_disk_path=%%B"
        set "vb_disk_path=!vb_disk_path:"=!"
        rem Comprobacion decisiva y barata: una ruta de disco EXISTE como
        rem archivo; el nombre de una VM, no. Cierra del todo el falso positivo.
        if defined vb_disk_path if exist "!vb_disk_path!" (
            set /a vb_disk_count+=1
            set "VB_DISK_PATH_!vb_disk_count!=!vb_disk_path!"
            rem El UUID y el formato de ESTE indice se limpian a proposito: esta
            rem via no los conoce, y si quedara el valor de una VM consultada
            rem antes en la misma sesion se clonaria el disco EQUIVOCADO.
            set "VB_DISK_UUID_!vb_disk_count!="
            set "VB_DISK_FMT_!vb_disk_count!="
        )
    )
)

:: El aborto por "no se pudo identificar el disco" ocurria DESPUES de pedir el
:: destino, crear VirtualBox\<VM>\Disks y preguntar el formato: quedaba un arbol
:: de evidencia vacio que en un expediente parece una adquisicion fallida o
:: anulada. Se aborta aqui, antes de tocar el disco del examinador.
if !vb_disk_count! equ 0 (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Could not identify any disk of this VM. Acquisition NOT started.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] No se pudo identificar ningún disco de esta VM. NO se inicia la adquisición.!C_RESET!
    call :LOG_EVENT "ABORTADO antes de crear nada: no se pudo identificar ningun disco duro de la VM VirtualBox !VB_SEL_NAME!."
    pause
    goto MENU_VM_VBOX
)

:: Con 2 o mas discos duros habia una incompletitud SILENCIOSA: se detectaban
:: todos, se usaba solo VB_DISK_UUID_1 y al operador no se le decia nunca que
:: habia mas (ISO/IEC 27037, completitud de la adquisicion). Ahora se listan y
:: la eleccion es explicita, y los NO adquiridos quedan en el diario.
set "VB_DISK_PICK=1"
if !vb_disk_count! equ 1 goto VB_DISK_PICKED
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![CAUTION] This VM has !vb_disk_count! hard disks. THIS acquisition covers ONE of them.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![ATENCIÓN] Esta VM tiene !vb_disk_count! discos duros. ESTA adquisición cubre UNO de ellos.!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] Acquire the rest in additional passes: an incomplete acquisition that!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] Adquiera los demás en pasadas adicionales: una adquisición incompleta que!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] is not declared as such is an acquisition that cannot be sustained.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] no se declara como tal es una adquisición que no se puede sostener.!C_RESET!
echo.
for /L %%i in (1,1,!vb_disk_count!) do echo  !C_TEXT!%%i. [!VB_DISK_FMT_%%i!] !VB_DISK_PATH_%%i!!C_RESET!
echo.
:PROMPT_VB_DISK_PICK
set "_vbdp="
if /i "!FORENSIC_LANG!"=="EN" set /p _vbdp="!C_PROMPT!Which disk do you acquire now [1-!vb_disk_count!, 0=cancel]: !C_RESET!"
if /i not "!FORENSIC_LANG!"=="EN" set /p _vbdp="!C_PROMPT!Qué disco adquiere ahora [1-!vb_disk_count!, 0=cancelar]: !C_RESET!"
if "!_vbdp!"=="0" goto MENU_VM_VBOX
if not defined _vbdp goto PROMPT_VB_DISK_PICK
for /f "delims=0123456789" %%a in ("!_vbdp!") do (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Please enter a valid number.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Por favor, ingrese un número válido.!C_RESET!
    goto PROMPT_VB_DISK_PICK
)
if !_vbdp! lss 1 goto PROMPT_VB_DISK_PICK
if !_vbdp! gtr !vb_disk_count! goto PROMPT_VB_DISK_PICK
call :NORM_SEL _vbdp
set "VB_DISK_PICK=!_vbdp!"
call :LOG_EVENT "VirtualBox !VB_SEL_NAME!: se detectaron !vb_disk_count! discos duros y el operador eligio el numero !VB_DISK_PICK!. Los demas NO se adquieren en esta pasada: la adquisicion de esta VM queda INCOMPLETA hasta que se hagan las pasadas restantes."

:VB_DISK_PICKED
:: El resto del flujo trabaja siempre con el disco elegido en la posicion 1.
set "VB_DISK_UUID_1=!VB_DISK_UUID_%VB_DISK_PICK%!"
set "VB_DISK_PATH_1=!VB_DISK_PATH_%VB_DISK_PICK%!"
set "VB_DISK_FMT_1=!VB_DISK_FMT_%VB_DISK_PICK%!"

:: Destino
:ASK_VB_DEST
set "vb_dest="
if /i "!FORENSIC_LANG!"=="EN" set /p vb_dest="!C_PROMPT!Destination folder path [Enter = !DEFAULT_DEST!] (0=cancel): !C_RESET!"
if /i not "!FORENSIC_LANG!"=="EN" set /p vb_dest="!C_PROMPT!Ruta de la carpeta destino [Enter = !DEFAULT_DEST!] (0=cancelar): !C_RESET!"
if "!vb_dest!"=="0" goto MENU_VM_VBOX
if defined vb_dest set "vb_dest=!vb_dest:"=!"
if not defined vb_dest (
    set "vb_dest=!DEFAULT_DEST!"
    if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Using default destination: !DEFAULT_DEST!!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Usando destino por defecto: !DEFAULT_DEST!!C_RESET!
)
call :VALIDATE_DEST_DIR "!vb_dest!"
if not "!_VD_OK!"=="1" goto ASK_VB_DEST

:: Crear carpeta organizada
call :SANITIZE_NAME "!VB_SEL_NAME!"
set "VB_FOLDER=!_SN_OUT!"
set "VB_EVIDENCE=!vb_dest!\VirtualBox\!VB_FOLDER!"
set "DEST=!VB_EVIDENCE!"
call :ENSURE_DIR "!VB_EVIDENCE!\Disks"
if not "!_ED_OK!"=="1" goto MENU_VM_VBOX

:: Extension REAL del medio origen, resuelta antes de preguntar el formato: con
:: la opcion 1 ("mismo formato que el origen") la extension se forzaba a .vdi y
:: solo se corregia "if defined VB_DISK_PATH_1", que unicamente estaba definida
:: en la via de RESERVA. En el camino normal (UUID detectado) quedaba vacia, asi
:: que una VM respaldada por .vmdk o .vhd producia un archivo llamado VM.vdi con
:: contenido VMDK/VHD: un peritaje que confie en la extension analiza mal la
:: evidencia. Ahora la ruta y el formato salen de "list hdds" (VBOX_LOAD_HDDS).
set "vb_src_ext="
if defined VB_DISK_PATH_1 for %%F in ("!VB_DISK_PATH_1!") do set "vb_src_ext=%%~xF"
if not defined vb_src_ext if /I "!VB_DISK_FMT_1!"=="VDI" set "vb_src_ext=.vdi"
if not defined vb_src_ext if /I "!VB_DISK_FMT_1!"=="VMDK" set "vb_src_ext=.vmdk"
if not defined vb_src_ext if /I "!VB_DISK_FMT_1!"=="VHD" set "vb_src_ext=.vhd"
if not defined vb_src_ext if /I "!VB_DISK_FMT_1!"=="RAW" set "vb_src_ext=.raw"

:: --- Formato de salida del clon ---
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT!Output format of the cloned disk:
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT!Formato de salida del disco clonado:
if defined vb_src_ext if /i "!FORENSIC_LANG!"=="EN" echo 1. Original (same format as the source disk: !VB_DISK_FMT_1! -^> !vb_src_ext!)
if defined vb_src_ext if /i not "!FORENSIC_LANG!"=="EN" echo 1. Original (mismo formato que el disco fuente: !VB_DISK_FMT_1! -^> !vb_src_ext!)
if not defined vb_src_ext if /i "!FORENSIC_LANG!"=="EN" echo 1. Original (NOT AVAILABLE: the source format could not be determined)
if not defined vb_src_ext if /i not "!FORENSIC_LANG!"=="EN" echo 1. Original (NO DISPONIBLE: no se pudo determinar el formato del origen)
echo 2. VDI  (VirtualBox)
echo 3. VMDK (VMware / Autopsy / FTK)
echo 4. VHD  (Hyper-V / Windows)
if /i "!FORENSIC_LANG!"=="EN" echo 5. RAW  (raw .raw - universal forensic analysis)
if /i not "!FORENSIC_LANG!"=="EN" echo 5. RAW  (crudo .raw - análisis forense universal)
if /i "!FORENSIC_LANG!"=="EN" echo 0. Cancel!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo 0. Cancelar!C_RESET!
:VB_FMT_ASK
:: Falta el "0" y hacia falta: cuando el formato del origen NO se pudo determinar,
:: la opcion 1 se rechaza y el bucle solo admite 2-5. Un operador que no quiera
:: elegir un formato distinto al original se quedaba sin salida.
set "vb_fmt_opt="
if /i "!FORENSIC_LANG!"=="EN" set /p vb_fmt_opt="!C_PROMPT!Option [1-5, Enter = 1] (0=cancel): !C_RESET!"
if /i not "!FORENSIC_LANG!"=="EN" set /p vb_fmt_opt="!C_PROMPT!Opción [1-5, Enter = 1] (0=cancelar): !C_RESET!"
if "!vb_fmt_opt!"=="" set "vb_fmt_opt=1"
if "!vb_fmt_opt!"=="0" (
    call :LOG_EVENT "Clonado de disco de VirtualBox CANCELADO por el operador en la eleccion de formato de salida."
    goto MENU_VM_VBOX
)
set "VB_FMT_FLAG="
set "vb_fmt_ext="
:: La opcion 1 solo se acepta si el formato del origen se pudo determinar de
:: verdad. Antes se asumia .vdi a ciegas; si no se sabe, el operador tiene que
:: elegir un formato explicito en vez de recibir evidencia mal etiquetada.
if "!vb_fmt_opt!"=="1" if defined vb_src_ext goto VB_FMT_OK
if "!vb_fmt_opt!"=="1" (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] The source format could not be determined: choose an explicit format (2-5).!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] No se pudo determinar el formato del origen: elija un formato explícito (2-5).!C_RESET!
    goto VB_FMT_ASK
)
if "!vb_fmt_opt!"=="2" set "VB_FMT_FLAG=--format VDI"  & set "vb_fmt_ext=.vdi"
if "!vb_fmt_opt!"=="3" set "VB_FMT_FLAG=--format VMDK" & set "vb_fmt_ext=.vmdk"
if "!vb_fmt_opt!"=="4" set "VB_FMT_FLAG=--format VHD"  & set "vb_fmt_ext=.vhd"
if "!vb_fmt_opt!"=="5" set "VB_FMT_FLAG=--format RAW"  & set "vb_fmt_ext=.raw"
if not defined VB_FMT_FLAG (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Invalid option. Enter 1 to 5.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Opción inválida. Ingrese 1 a 5.!C_RESET!
    goto VB_FMT_ASK
)
:VB_FMT_OK

:: Determinar extensión del disco de salida
set "vb_disk_ext=!vb_src_ext!"
:: Si el operador eligio un formato distinto al original, manda su extensión
if defined vb_fmt_ext set "vb_disk_ext=!vb_fmt_ext!"
:: El nombre de ARCHIVO usaba !VB_SEL_NAME! en CRUDO, no la version saneada que
:: si se aplicaba a la carpeta: un nombre de VM con caracteres invalidos hacia
:: fallar clonemedium con un error opaco. Se usa la misma version saneada.
set "vb_dest=!VB_EVIDENCE!\Disks\!VB_FOLDER!!vb_disk_ext!"

:: Un destino que YA existe hacia fallar clonemedium con el error generico
:: "Error al clonar el disco", y ademas su UUID podia seguir dado de alta en el
:: registro de medios del host incluso tras borrar el archivo. Se comprueba
:: ANTES y se ofrece un nombre alternativo fechado.
if exist "!vb_dest!" (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] The destination file already exists: !vb_dest!!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] El archivo de destino ya existe: !vb_dest!!C_RESET!
    call :UTCNOW _vbd_ts COMPACT
    set "vb_dest=!VB_EVIDENCE!\Disks\!VB_FOLDER!_!_vbd_ts!!vb_disk_ext!"
    if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] A timestamped name will be used: !vb_dest!!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Se usara un nombre con marca de tiempo: !vb_dest!!C_RESET!
    call :LOG_EVENT "El destino de la adquisicion ya existia; se usa nombre alternativo con marca de tiempo: !vb_dest!"
)

echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Cloning disk of !VB_SEL_NAME!...!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Clonando disco de !VB_SEL_NAME!...!C_RESET!
:: El VMState del origen es metadato esencial de cadena de custodia (ISO/IEC
:: 27037): distinguir poweroff de saved o de aborted cambia por completo la
:: interpretacion del disco. Antes se registraban snapshots, formato y modo,
:: pero nunca el estado de la VM.
call :LOG_EVENT "Adquisicion VirtualBox disco: !VB_SEL_NAME! (formato: !vb_disk_ext! modo=!VB_SNAP_MODE! VMState del origen: !VBOX_ACQ_VMSTATE! disco !VB_DISK_PICK! de !vb_disk_count! formato del origen: !VB_DISK_FMT_1! ruta del origen: !VB_DISK_PATH_1!)"

if "!VB_SNAP_MODE!"=="3" (
    rem Modo "solo un snapshot específico": no se clona el disco actualmente
    rem adjunto, se resuelve vía clonevm --snapshot (ver VBOX_CLONE_SNAPSHOT_DISK).
    call :VBOX_CLONE_SNAPSHOT_DISK "!VB_SEL_UUID!" "!VB_CHOSEN_SNAP_UUID!" "!vb_dest!" "!VB_FMT_FLAG!"
    if not "!VBCS_OK!"=="1" (
        if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Error extracting the disk from snapshot "!VB_CHOSEN_SNAP_NAME!".!C_RESET!
        if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Error al extraer el disco del snapshot "!VB_CHOSEN_SNAP_NAME!".!C_RESET!
        call :LOG_EVENT "Error: Fallo al extraer disco de snapshot VirtualBox !VB_CHOSEN_SNAP_NAME!."
        pause
        goto MENU_VM_VBOX
    )
    if /i "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Disk of snapshot "!VB_CHOSEN_SNAP_NAME!" extracted to: !vb_dest!!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Disco del snapshot "!VB_CHOSEN_SNAP_NAME!" extraido en: !vb_dest!!C_RESET!
    call :LOG_EVENT "Disco de snapshot VirtualBox extraido: !vb_dest! (snapshot=!VB_CHOSEN_SNAP_NAME!)"
) else (
    rem Modo 1 (completo/actual), 2 (base) o 4 (base + snapshot como segundo
    rem entregable): elegir la fuente y clonar vía :ACQUIRE (CTRL+C
    rem cancelable). Modo 2 y 4 primero suben la cadena de discos
    rem diferenciales hasta la raiz (VBOX_FIND_BASE_UUID) - modo 4 quiere el
    rem disco original INTACTO, igual que modo 2.
    if !vb_disk_count! equ 0 (
        if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Could not identify the VM disk.!C_RESET!
        if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] No se pudo identificar el disco de la VM.!C_RESET!
        call :LOG_EVENT "Error: No se pudo identificar disco VirtualBox."
        pause
        goto MENU_VM_VBOX
    )
    set "_vb_clone_src="
    set "_vb_want_base=0"
    if "!VB_SNAP_MODE!"=="2" set "_vb_want_base=1"
    if "!VB_SNAP_MODE!"=="4" set "_vb_want_base=1"
    if defined VB_DISK_UUID_1 (
        set "_vb_clone_src=!VB_DISK_UUID_1!"
        if "!_vb_want_base!"=="1" (
            call :VBOX_FIND_BASE_UUID "!VB_DISK_UUID_1!"
            set "_vb_clone_src=!VBOX_BASE_UUID!"
            if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Using the BASE disk UUID ^(no snapshots^): !VBOX_BASE_UUID!!C_RESET!
            if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Usando UUID del disco BASE ^(sin snapshots^): !VBOX_BASE_UUID!!C_RESET!
        ) else (
            if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Using disk UUID: !VB_DISK_UUID_1!!C_RESET!
            if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Usando UUID del disco: !VB_DISK_UUID_1!!C_RESET!
        )
    ) else if defined VB_DISK_PATH_1 (
        set "_vb_clone_src=!VB_DISK_PATH_1!"
        if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Using disk path: !VB_DISK_PATH_1!!C_RESET!
        if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Usando ruta del disco: !VB_DISK_PATH_1!!C_RESET!
    )
    if not defined _vb_clone_src (
        if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Could not identify the VM disk.!C_RESET!
        if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] No se pudo identificar el disco de la VM.!C_RESET!
        pause
        goto MENU_VM_VBOX
    )

    call :NEWGUID ACQ_GUID
    set "ACQ_CMD=!TEMP!\forensic_cmd_!ACQ_GUID!.tmp"
    rem El posicional "disk" iba PRIMERO; la sintaxis documentada de 7.2 es
    rem "clonemedium <origen> <destino> [disk|dvd|floppy]", con la palabra de
    rem tipo TERCERA. Se OMITE: es opcional en todas las versiones que tienen
    rem el subcomando, el tipo por defecto es "disk" y el origen ya es un UUID
    rem de disco duro cruzado contra "list hdds". Asi la orden es valida tanto
    rem si el parser espera el tipo primero como si lo espera tercero.
    rem !VBOX_CLONE_SUBCMD! es "clonemedium" o "clonehd" segun la version.
    >"!ACQ_CMD!" echo "!VBOX_EXE!" !VBOX_CLONE_SUBCMD! "!_vb_clone_src!" "!vb_dest!" !VB_FMT_FLAG!
    call :ACQ_VER TOOLVER_VBOX "!VBOX_EXE!" "--version" "VBoxManage"
    call :ACQUIRE "VirtualBox_CloneDisk" "!ACQ_CMD!"
    set "_vbd_el=!errorlevel!"
    if "!_vbd_el!"=="2" (
        if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![ABORT] Cloning aborted by the user.!C_RESET!
        if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![ABORT] Clonado abortado por el usuario.!C_RESET!
        call :LOG_EVENT "Clonado VirtualBox abortado por el usuario (CTRL+C)."
        pause
        goto MENU_VM_VBOX
    )
    if !_vbd_el! neq 0 (
        if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Error cloning the disk.!C_RESET!
        if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Error al clonar el disco.!C_RESET!
        call :LOG_EVENT "Error: Fallo al clonar disco VirtualBox."
        pause
        goto MENU_VM_VBOX
    )

    if /i "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Disk cloned successfully to: !vb_dest!!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Disco clonado exitosamente en: !vb_dest!!C_RESET!
    call :LOG_EVENT "Disco VirtualBox clonado: !vb_dest!"
    call :VBOX_CLOSEMEDIUM "!vb_dest!"
)

:: Modo 4 (disco original + snapshot específico como SEGUNDO entregable):
:: el disco original ya se cloneo arriba intacto; ahora se clona ademas el
:: snapshot elegido a un archivo INDEPENDIENTE, mismo mecanismo de solo-
:: lectura que el modo 3 (VBOX_CLONE_SNAPSHOT_DISK: clona la VM completa en
:: ese punto y extrae su disco - el snapshot y el original NUNCA se tocan).
if "!VB_SNAP_MODE!"=="4" (
    echo.
    if /i "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Original disk acquired. Also cloning the snapshot!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Disco original adquirido. Clonando ademas el snapshot!C_RESET!
    if /i "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] chosen "!VB_CHOSEN_SNAP_NAME!" as second deliverable...!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] elegido "!VB_CHOSEN_SNAP_NAME!" como segundo entregable...!C_RESET!
    rem Nombre de VM y de snapshot SANEADOS, como el primer entregable: aqui se
    rem usaba el nombre crudo de la VM y solo se cambiaban / y : del snapshot, asi
    rem que un snapshot llamado "Antes del malware?" daba un nombre invalido.
    set "_sn_in=!VB_CHOSEN_SNAP_NAME!"
    call :SANITIZE_NAME_IN
    set "vb_snap2_dest=!VB_EVIDENCE!\Disks\!VB_FOLDER!_!_SN_OUT!!vb_disk_ext!"
    call :VBOX_CLONE_SNAPSHOT_DISK "!VB_SEL_UUID!" "!VB_CHOSEN_SNAP_UUID!" "!vb_snap2_dest!" "!VB_FMT_FLAG!"
    if not "!VBCS_OK!"=="1" (
        if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Error extracting the disk from snapshot "!VB_CHOSEN_SNAP_NAME!" ^(second deliverable^).!C_RESET!
        if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Error al extraer el disco del snapshot "!VB_CHOSEN_SNAP_NAME!" ^(segundo entregable^).!C_RESET!
        call :LOG_EVENT "Error: Fallo al extraer disco de snapshot VirtualBox !VB_CHOSEN_SNAP_NAME! (modo 4, segundo entregable)."
    ) else (
        if /i "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Snapshot disk "!VB_CHOSEN_SNAP_NAME!" extracted to: !vb_snap2_dest!!C_RESET!
        if /i not "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Disco del snapshot "!VB_CHOSEN_SNAP_NAME!" extraido en: !vb_snap2_dest!!C_RESET!
        call :LOG_EVENT "Disco de snapshot VirtualBox extraido (modo 4, segundo entregable): !vb_snap2_dest!"
        call :HASH_EVIDENCE FILE "!vb_snap2_dest!" "" "!DEST!\hashes_snapshot.sha256" "VirtualBox_Disco_Snapshot"
    )
)

:: Verificación de integridad OPCIONAL (decisión del operador)
call :HASH_EVIDENCE FILE "!vb_dest!" "" "!DEST!\hashes.sha256" "VirtualBox_Disco"

:: Preservar también el archivo de CONFIGURACIÓN .vbox (XML) - sin el,
:: VirtualBox no puede registrar/abrir esta VM después (equivalente al .vmx
:: de VMware). Se ubica vía VBoxManage showvminfo, propiedad oficial CfgFile.
set "vb_cfgfile="
for /f "tokens=1,* delims==" %%A in ('""!VBOX_EXE!" showvminfo "!VB_SEL_UUID!" --machinereadable 2^>nul ^| findstr /I "^CfgFile=""') do set "vb_cfgfile=%%B"
if defined vb_cfgfile set "vb_cfgfile=!vb_cfgfile:~1,-1!"
if defined vb_cfgfile if exist "!vb_cfgfile!" (
    if not exist "!VB_EVIDENCE!\Config" mkdir "!VB_EVIDENCE!\Config"
    copy /y "!vb_cfgfile!" "!VB_EVIDENCE!\Config\" >nul
    if /i "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Configuration ^(.vbox^) preserved at: !VB_EVIDENCE!\Config!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Configuración ^(.vbox^) preservada en: !VB_EVIDENCE!\Config!C_RESET!
    call :LOG_EVENT "Configuracion VirtualBox preservada: !VB_EVIDENCE!\Config (origen: !vb_cfgfile!)"
    call :HASH_EVIDENCE FOLDER "!VB_EVIDENCE!\Config" "*.vbox" "!VB_EVIDENCE!\Config\hashes.sha256" "VirtualBox_Configuracion"
) else (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] Could not locate the .vbox configuration file.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] No se pudo localizar el archivo .vbox de configuración.!C_RESET!
)

:: Si el operador eligio el disco completo (modo 1), preservar (solo copia,
:: sin alterar) los archivos de disco diferencial de cada snapshot desde la
:: carpeta de snapshots de la VM (VBoxManage showvminfo --machinereadable,
:: propiedad oficial SnapshotFolder).
:: Sin robocopy no hay copia valida de la carpeta de snapshots. La adquisicion
:: del disco ya hecha SI es valida -VBoxManage no depende de robocopy-, asi que
:: se declara la limitacion y se sigue en vez de abortar el modulo. Cada linea
:: repite las tres condiciones: son "if" encadenados, no un bloque.
if "!VB_SNAP_MODE!"=="1" if !vb_snap_count! gtr 0 if not defined HAS_ROBOCOPY if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Snapshot files NOT preserved: robocopy.exe is missing on this host.!C_RESET!
if "!VB_SNAP_MODE!"=="1" if !vb_snap_count! gtr 0 if not defined HAS_ROBOCOPY if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Archivos de snapshots NO preservados: falta robocopy.exe en este equipo.!C_RESET!
if "!VB_SNAP_MODE!"=="1" if !vb_snap_count! gtr 0 if not defined HAS_ROBOCOPY call :LOG_EVENT "Snapshots VirtualBox NO preservados: robocopy.exe no esta disponible en este host (no viene en Windows XP). La cadena diferencial y los estados guardados .sav de los snapshots NO quedan en la evidencia. NO se sustituye por xcopy: no preserva ACL ni las tres marcas de tiempo. El disco adquirido SI es valido."
if "!VB_SNAP_MODE!"=="1" if !vb_snap_count! gtr 0 if defined HAS_ROBOCOPY (
    echo.
    if /i "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Preserving associated snapshot files...!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Preservando archivos de snapshots asociados...!C_RESET!
    set "vb_snap_folder="
    for /f "tokens=1,* delims==" %%A in ('""!VBOX_EXE!" showvminfo "!VB_SEL_UUID!" --machinereadable 2^>nul ^| findstr /I "^SnapshotFolder=""') do set "vb_snap_folder=%%B"
    if defined vb_snap_folder set "vb_snap_folder=!vb_snap_folder:~1,-1!"
    if defined vb_snap_folder if exist "!vb_snap_folder!" (
        rem El filtro era "*.vdi *.vmdk *.vhd": en la VM real de este equipo eso
        rem copiaba el disco diferencial de 13 MB y DESCARTABA un .sav de
        rem 537.006.356 bytes con la RAM y el estado de dispositivos del
        rem snapshot. El propio framework trata los equivalentes de Hyper-V
        rem (.bin/.vsv/.vmrs) como evidencia critica, asi que la incoherencia
        rem era interna. Se anaden el estado guardado, las dos copias del XML de
        rem configuracion y el log de la VM.
        call :ENSURE_DIR "!VB_EVIDENCE!\Snapshots"
        robocopy "!vb_snap_folder!" "!VB_EVIDENCE!\Snapshots" *.vdi *.vmdk *.vhd *.sav *.vbox *.vbox-prev VBox.log /NFL /NDL /NJH /NJS >nul
        rem Mismo criterio que :VMWS_COPY_ONE: el exito NO se deduce del codigo de
        rem robocopy -0 significa tambien "no habia nada que coincidiera con el
        rem filtro"-, se cuenta lo que esta de verdad en el destino. Sin esto un
        rem fallo silencioso (robocopy ausente en XP, origen en unidad de red que
        rem se cae, permisos denegados sobre el arbol de VirtualBox, destino sin
        rem espacio) dejaba una carpeta vacia junto a un asiento de cadena de
        rem custodia que afirmaba que la RAM del invitado quedaba preservada.
        rem Se excluye hashes.sha256: lo escribe :HASH_EVIDENCE en esta misma
        rem carpeta y en una readquisicion contaria como evidencia copiada.
        set "_vbs_n=0"
        for %%F in ("!VB_EVIDENCE!\Snapshots\*.*") do if /i not "%%~nxF"=="hashes.sha256" set /a _vbs_n+=1
        if !_vbs_n! gtr 0 (
            if /i "!FORENSIC_LANG!"=="EN" echo !C_OK![+] !_vbs_n! snapshot file^(s^) preserved in: !VB_EVIDENCE!\Snapshots!C_RESET!
            if /i not "!FORENSIC_LANG!"=="EN" echo !C_OK![+] !_vbs_n! archivo^(s^) de snapshots preservados en: !VB_EVIDENCE!\Snapshots!C_RESET!
            call :LOG_EVENT "Snapshots VirtualBox preservados: !_vbs_n! archivos en !VB_EVIDENCE!\Snapshots (origen: !vb_snap_folder!). Se incluyen los estados guardados .sav, que contienen la RAM del invitado y el estado de dispositivos de cada snapshot."
            call :HASH_EVIDENCE FOLDER "!VB_EVIDENCE!\Snapshots" "*.vdi,*.vmdk,*.vhd,*.sav,*.vbox,*.vbox-prev" "!VB_EVIDENCE!\Snapshots\hashes.sha256" "VirtualBox_Snapshots"
        ) else (
            if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] NO snapshot file could be preserved in: !VB_EVIDENCE!\Snapshots!C_RESET!
            if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] NO se pudo preservar ningún archivo de snapshots en: !VB_EVIDENCE!\Snapshots!C_RESET!
            if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] The differential chain and the .sav saved states are NOT in the evidence. Verify it manually.!C_RESET!
            if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] La cadena diferencial y los estados guardados .sav NO están en la evidencia. Verifíquelo manualmente.!C_RESET!
            call :LOG_EVENT "FALLO: la preservacion de snapshots VirtualBox NO se pudo acreditar. La carpeta !VB_EVIDENCE!\Snapshots quedo vacia (origen: !vb_snap_folder!). NO se hashea nada y NO se afirma que la cadena diferencial ni los estados guardados .sav queden preservados. El disco adquirido SI es valido."
        )
    ) else (
        if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![-] Could not determine the snapshot folder of the VM.!C_RESET!
        if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![-] No se pudo determinar la carpeta de snapshots de la VM.!C_RESET!
        call :LOG_EVENT "Advertencia: No se pudo determinar SnapshotFolder para !VB_SEL_NAME!"
    )
)

:: Ofrecer conversión QEMU
if not exist "!QEMU_IMG!" goto VB_SKIP_QEMU
set "vb_qemu_ask="
if /i "!FORENSIC_LANG!"=="EN" set /p vb_qemu_ask="!C_PROMPT!Convert the disk to forensic RAW/IMG format (QEMU)? [Y/N]: !C_RESET!"
if /i not "!FORENSIC_LANG!"=="EN" set /p vb_qemu_ask="!C_PROMPT!¿Convertir el disco a formato RAW/IMG forense (QEMU)? [S/N]: !C_RESET!"
:: El prompt en ingles ofrece [Y/N]; se acepta Y como S.
if /i "!vb_qemu_ask!"=="Y" set "vb_qemu_ask=S"
if /I "!vb_qemu_ask!"=="S" (
    call :QEMU_CONVERT "!vb_dest!" "!DEST!" "!VB_FOLDER!_forense"
)
:VB_SKIP_QEMU
pause
goto MENU_VM_VBOX

:: --- VIRTUALBOX: VOLCADO DE MEMORIA ---
:VBOX_MEM
call :RESOLVE_VBOX
if !errorlevel! neq 0 (
    pause
    goto MENU_VM_VBOX
)
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] VirtualBox RAM Memory Dump!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Volcado de Memoria RAM de VirtualBox!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Running/paused VM: live dump with debugvm dumpvmcore.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] VM encendida/pausada: volcado en vivo con debugvm dumpvmcore.!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Saved VM: the guest RAM is ALREADY on disk in a .sav file and is!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] VM suspendida: la RAM del invitado YA está en disco en un .sav y es!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] acquirable by plain copy - no need to power the VM on.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] adquirible por simple copia, sin necesidad de encender la VM.!C_RESET!
echo.

:: Antes este modulo solo listaba "runningvms": a una VM en estado saved o
:: aborted-saved le decia "Para volcar la memoria, la VM debe estar
:: ejecutandose" cuando su RAM estaba YA en disco, en un .sav, y era adquirible
:: por copia (en la VM real de este equipo, 537.006.356 bytes). El propio
:: framework trata los equivalentes de Hyper-V (.bin/.vsv/.vmrs) como evidencia
:: critica, asi que la incoherencia era interna. Ahora se enumeran las dos
:: clases y cada entrada lleva su modo de adquisicion.
call :VBOX_ENUM_VMS
if !errorlevel! neq 0 (
    pause
    goto MENU_VM_VBOX
)
set "vbr_count=0"
for /L %%i in (1,1,!vb_count!) do (
    call :VBOX_GET_VMSTATE "!VB_UUID_%%i!"
    call :VBOX_STATE_CLASS "!VBOX_VMSTATE!"
    if "!VBOX_SCLASS!"=="ONLINE" (
        set /a vbr_count+=1
        set "VBR_UUID_!vbr_count!=!VB_UUID_%%i!"
        set "VBR_NAME_!vbr_count!=!VB_NAME_%%i!"
        set "VBR_MODE_!vbr_count!=DUMP"
        set "VBR_STATE_!vbr_count!=!VBOX_VMSTATE!"
    )
    if "!VBOX_SCLASS!"=="OK_SAV" (
        set /a vbr_count+=1
        set "VBR_UUID_!vbr_count!=!VB_UUID_%%i!"
        set "VBR_NAME_!vbr_count!=!VB_NAME_%%i!"
        set "VBR_MODE_!vbr_count!=SAV"
        set "VBR_STATE_!vbr_count!=!VBOX_VMSTATE!"
    )
)

if !vbr_count! equ 0 (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![-] No VM with acquirable memory: none is running, paused or saved.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![-] Ninguna VM con memoria adquirible: no hay encendidas, pausadas ni suspendidas.!C_RESET!
    if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] A powered-off VM keeps no guest RAM anywhere: there is nothing to acquire.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Una VM apagada no conserva RAM del invitado en ningún sitio: no hay nada que adquirir.!C_RESET!
    call :LOG_EVENT "VirtualBox memoria: ninguna VM en estado running/paused/saved/aborted-saved. No hay memoria de invitado adquirible en este host."
    pause
    goto MENU_VM_VBOX
)

if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT!VMs with acquirable memory:!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT!VMs con memoria adquirible:!C_RESET!
for /L %%i in (1,1,!vbr_count!) do (
    call :VBOX_STATE_LABEL "!VBR_STATE_%%i!"
    if "!VBR_MODE_%%i!"=="DUMP" echo  !C_OK!%%i. !VBR_NAME_%%i!!C_RESET! [!VBR_UUID_%%i!] - !_vb_state! -^> dumpvmcore
    if "!VBR_MODE_%%i!"=="SAV" echo  !C_WARN!%%i. !VBR_NAME_%%i!!C_RESET! [!VBR_UUID_%%i!] - !_vb_state! -^> .sav
)
echo.

:PROMPT_VB_MEM_SEL
set "vbr_sel="
if /i "!FORENSIC_LANG!"=="EN" set /p vbr_sel="!C_PROMPT!Select the VM [1-!vbr_count!, 0=cancel]: !C_RESET!"
if /i not "!FORENSIC_LANG!"=="EN" set /p vbr_sel="!C_PROMPT!Seleccione la VM [1-!vbr_count!, 0=cancelar]: !C_RESET!"
if "!vbr_sel!"=="0" goto MENU_VM_VBOX
if not defined vbr_sel goto PROMPT_VB_MEM_SEL
for /f "delims=0123456789" %%a in ("!vbr_sel!") do (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Please enter a valid number.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Por favor, ingrese un número válido.!C_RESET!
    goto PROMPT_VB_MEM_SEL
)
if !vbr_sel! lss 1 goto PROMPT_VB_MEM_SEL
if !vbr_sel! gtr !vbr_count! goto PROMPT_VB_MEM_SEL

call :NORM_SEL vbr_sel
set "VBR_SEL_UUID=!VBR_UUID_%vbr_sel%!"
set "VBR_SEL_NAME=!VBR_NAME_%vbr_sel%!"
set "VBR_SEL_MODE=!VBR_MODE_%vbr_sel%!"
set "VBR_SEL_STATE=!VBR_STATE_%vbr_sel%!"
if not defined VBR_SEL_UUID goto PROMPT_VB_MEM_SEL

:ASK_VB_MEM_DEST
set "vb_mem_dest="
if /i "!FORENSIC_LANG!"=="EN" set /p vb_mem_dest="!C_PROMPT!Destination folder path [Enter = !DEFAULT_DEST!] (0=cancel): !C_RESET!"
if /i not "!FORENSIC_LANG!"=="EN" set /p vb_mem_dest="!C_PROMPT!Ruta de la carpeta destino [Enter = !DEFAULT_DEST!] (0=cancelar): !C_RESET!"
if "!vb_mem_dest!"=="0" goto MENU_VM_VBOX
if defined vb_mem_dest set "vb_mem_dest=!vb_mem_dest:"=!"
if not defined vb_mem_dest (
    set "vb_mem_dest=!DEFAULT_DEST!"
    if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Using default destination: !DEFAULT_DEST!!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Usando destino por defecto: !DEFAULT_DEST!!C_RESET!
)
call :VALIDATE_DEST_DIR "!vb_mem_dest!"
if not "!_VD_OK!"=="1" goto ASK_VB_MEM_DEST

:: Crear carpeta organizada
call :SANITIZE_NAME "!VBR_SEL_NAME!"
set "VBM_FOLDER=!_SN_OUT!"
set "VBM_EVIDENCE=!vb_mem_dest!\VirtualBox\!VBM_FOLDER!"
set "DEST=!VBM_EVIDENCE!"
:: El nombre llevaba SOLO el nombre de la VM: "dumpvmcore" NO sobrescribe, asi
:: que un segundo volcado de la misma VM al mismo destino fallaba con el error
:: generico "Error al volcar la memoria". Con marca de tiempo cada volcado es un
:: archivo propio y ademas queda fechado, que es lo que pide la custodia.
:: La extension es .elf porque dumpvmcore produce un ELF Core Dump, NO RAW.
call :UTCNOW _vbm_ts COMPACT
set "vb_mem_dest=!VBM_EVIDENCE!\Memory\!VBM_FOLDER!_!_vbm_ts!.elf"
call :ENSURE_DIR "!VBM_EVIDENCE!\Memory"
if not "!_ED_OK!"=="1" goto MENU_VM_VBOX
if "!VBR_SEL_MODE!"=="SAV" goto VB_MEM_SAV

echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Dumping memory of !VBR_SEL_NAME!...!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Volcando memoria de !VBR_SEL_NAME!...!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] This may take a while depending on the assigned RAM size.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] Esto puede tardar dependiendo del tamaño de la RAM asignada.!C_RESET!
:: Fuente VIVA. Esto no es un detalle de forma: el invitado SIGUE EJECUTANDOSE
:: mientras se escribe el volcado, asi que la imagen es inconsistente por
:: construccion (smear) y NO existe hash del origen contra el que verificarla.
:: El modulo de VMware documenta este mismo matiz; aqui faltaba.
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![LIVE SOURCE] The guest keeps RUNNING during the dump: memory changes while!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![FUENTE VIVA] El invitado SIGUE EJECUTANDOSE durante el volcado: la memoria!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] it is being read. The image is inconsistent by construction ^(smear^) and!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] cambia mientras se lee. La imagen es inconsistente por construccion ^(smear^)!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] there is NO source hash to verify it against. The only hash that can be!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] y NO hay hash del origen contra el que verificarla. El único hash que se!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] sustained is the one of the RESULTING file. Record this limitation.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] puede sostener es el del archivo RESULTANTE. Registre esta limitacion.!C_RESET!
echo.
:: El archivo lo escribe el PROCESO DE LA VM, no VBoxManage. Si el framework
:: corre elevado y la VM corre en la sesion del usuario, un destino escribible
:: solo por administradores hace fallar el volcado sin decir por que.
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Note: the file is written by the VM process, not by VBoxManage. The!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Nota: el archivo lo escribe el proceso de la VM, no VBoxManage. El!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] destination must be writable by the user that owns that process.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] destino debe ser escribible por el usuario propietario de ese proceso.!C_RESET!
call :LOG_EVENT "Volcado de memoria VirtualBox: !VBR_SEL_NAME! (VMState en el momento de la adquisicion: !VBR_SEL_STATE!). FUENTE VIVA: el invitado sigue ejecutandose durante el volcado, la imagen es inconsistente por construccion y no existe hash del origen. Solo es sostenible el hash del archivo resultante."

call :NEWGUID ACQ_GUID
set "ACQ_CMD=!TEMP!\forensic_cmd_!ACQ_GUID!.tmp"
>"!ACQ_CMD!" echo "!VBOX_EXE!" debugvm "!VBR_SEL_UUID!" dumpvmcore --filename "!vb_mem_dest!"
call :ACQ_VER TOOLVER_VBOX "!VBOX_EXE!" "--version" "VBoxManage"
call :ACQUIRE "VirtualBox_DumpMemoria" "!ACQ_CMD!"
set "_vbmem_el=!errorlevel!"
if "!_vbmem_el!"=="2" (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![ABORT] Dump aborted by the user.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![ABORT] Volcado abortado por el usuario.!C_RESET!
    call :LOG_EVENT "Volcado VirtualBox abortado por el usuario (CTRL+C)."
    pause
    goto MENU_VM_VBOX
)
if !_vbmem_el! neq 0 (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Error dumping the memory.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Error al volcar la memoria.!C_RESET!
    call :LOG_EVENT "Error: Fallo al volcar memoria VirtualBox."
    pause
    goto MENU_VM_VBOX
)

if /i "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Memory dumped successfully to: !vb_mem_dest!!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Memoria volcada exitosamente en: !vb_mem_dest!!C_RESET!
call :LOG_EVENT "Memoria VirtualBox volcada: !vb_mem_dest!"

:: AVISO CRÍTICO: formato ELF, no RAW
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![FORMAT] The generated file is ELF Core Dump, NOT RAW memory.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![FORMATO] El archivo generado es ELF Core Dump, NO memoria RAW.!C_RESET!
:: "vol.py -f archivo [profile] vboxelf" NO es una invocacion valida: vboxelf no
:: es un plugin, es el ESPACIO DE DIRECCIONES, y se reconoce por la cabecera ELF64.
:: Ademas la guia estaba escrita en sintaxis de Volatility 2 (--profile=), y lo que
:: este framework DISTRIBUYE es Volatility 3 (Sistema\herramientas\volatility3-develop),
:: donde --profile no existe: el analista recibia instrucciones que no funcionan con la
:: herramienta suministrada. Se documenta la 3 primero, que es la incluida, y la 2 como
:: equivalencia por si el analista trabaja con ella.
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Volatility 3 ^(the one shipped here^) detects the ELF64 core dump by itself:!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Volatility 3 ^(la que se distribuye aquí^) detecta el core dump ELF64 sola:!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i]     vol.py -f "!vb_mem_dest!" windows.info    ^(no --profile in Vol3^)!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i]     vol.py -f "!vb_mem_dest!" windows.info    ^(en Vol3 no hay --profile^)!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Documentation saved in FORMAT_NOTE.txt in the Memory folder.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Documentación guardada en FORMAT_NOTE.txt en la carpeta Memory.!C_RESET!
(
echo FORMATO: ELF Core Dump ^(NO RAW memory dump^)
echo GENERADO POR: VBoxManage debugvm dumpvmcore
echo VMState de la VM en el momento del volcado: !VBR_SEL_STATE!
echo.
echo LIMITACIÓN DE LA FUENTE ^(no es opcional documentarla^):
echo   El invitado SEGUIA EJECUTANDOSE durante el volcado. La imagen es
echo   inconsistente por construccion ^(smear^): distintas paginas corresponden
echo   a instantes distintos. NO existe hash del origen contra el que
echo   verificarla; el unico hash sostenible es el de este archivo.
echo.
echo ANÁLISIS CON VOLATILITY 3 ^(la version que distribuye este framework, en
echo Sistema\herramientas\volatility3-develop^):
echo   vol.py -f "!vb_mem_dest!" windows.info
echo   El formato se detecta AUTOMATICAMENTE: Volatility 3 apila su Elf64Layer al
echo   reconocer la cabecera ELF64. NO se indica "vboxelf" como plugin, porque no
echo   es un plugin sino el espacio de direcciones, y en Volatility 3 NO existe la
echo   opcion --profile: los simbolos se resuelven solos desde el propio volcado.
echo.
echo EQUIVALENCIA EN VOLATILITY 2 ^(NO se distribuye aqui^):
echo   vol.py -f "!vb_mem_dest!" --profile=^<perfil del invitado^> ^<plugin^>
echo   Alli el espacio de direcciones se llama vboxelf y tambien se detecta por la
echo   cabecera. Si usa esta via, hagalo constar: es una herramienta distinta de la
echo   que acompaña a esta evidencia.
echo.
echo CONVERSIÓN A RAW:
echo   No se recomienda con "objcopy -I elf64-x86-64 -O binary": objcopy
echo   concatena los segmentos PT_LOAD sin respetar los huecos del espacio
echo   fisico ^(MMIO, agujeros de memoria^), asi que el resultado NO es una
echo   RAW fiel y desplaza todos los desplazamientos posteriores al primer
echo   hueco. Una conversion correcta exige respetar el mapa de segmentos
echo   ^(direccion fisica de cada PT_LOAD^) y rellenar los huecos.
) > "!VBM_EVIDENCE!\Memory\FORMAT_NOTE.txt"

:: Verificación de integridad OPCIONAL (decisión del operador)
call :HASH_EVIDENCE FILE "!vb_mem_dest!" "" "!DEST!\hashes.sha256" "VirtualBox_Memoria"

pause
goto MENU_VM_VBOX

:: -----------------------------------------------------------------------
:: VB_MEM_SAV - La VM esta en saved / aborted-saved: la RAM del invitado y el
:: estado de dispositivos ya estan EN DISCO, en el .sav de la carpeta de
:: snapshots. No hay que encender nada: se copia y se hashea. A diferencia del
:: volcado en vivo, aqui la fuente NO esta mutando, asi que el hash del origen
:: si es comparable con el de la copia.
:: -----------------------------------------------------------------------
:VB_MEM_SAV
:: Esta rama copia el .sav ya en disco: sin robocopy no hay via valida. El
:: volcado en vivo, que es la otra rama del modulo, no depende de robocopy.
if not defined HAS_ROBOCOPY call :ROBOCOPY_MISSING "VirtualBox - copia del estado guardado .sav"
if not defined HAS_ROBOCOPY goto MENU_VM_VBOX
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Acquiring the SAVED STATE (.sav) of !VBR_SEL_NAME!...!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Adquiriendo el ESTADO GUARDADO (.sav) de !VBR_SEL_NAME!...!C_RESET!
set "vb_sav_folder="
for /f "tokens=1,* delims==" %%A in ('""!VBOX_EXE!" showvminfo "!VBR_SEL_UUID!" --machinereadable 2^>nul ^| findstr /I "^SnapshotFolder=""') do set "vb_sav_folder=%%B"
if defined vb_sav_folder set "vb_sav_folder=!vb_sav_folder:"=!"
if not defined vb_sav_folder goto VB_MEM_SAV_NOFOLDER
if not exist "!vb_sav_folder!" goto VB_MEM_SAV_NOFOLDER
call :NEWGUID ACQ_GUID
set "ACQ_CMD=!TEMP!\forensic_cmd_!ACQ_GUID!.tmp"
>"!ACQ_CMD!" echo robocopy "!vb_sav_folder!" "!VBM_EVIDENCE!\Memory" *.sav /COPY:DAT /R:1 /W:1 /NFL /NDL ^& if errorlevel 8 (exit 1) else (exit 0)
set "ACQ_TOOL_VER=robocopy in-box de !WIN_NAME! build !WIN_BUILD! - no publica version propia: su identidad es la build del SO"
call :ACQUIRE "VirtualBox_EstadoGuardado_SAV" "!ACQ_CMD!"
set "_vbsav_el=!errorlevel!"
if "!_vbsav_el!"=="2" (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![ABORT] Copy aborted by the user.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![ABORT] Copia abortada por el usuario.!C_RESET!
    call :LOG_EVENT "Copia de estado guardado VirtualBox abortada por el usuario (CTRL+C)."
    pause
    goto MENU_VM_VBOX
)
if !_vbsav_el! neq 0 (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Error copying the saved state.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Error al copiar el estado guardado.!C_RESET!
    call :LOG_EVENT "Error: fallo al copiar el estado guardado (.sav) de !VBR_SEL_NAME!."
    pause
    goto MENU_VM_VBOX
)
set "_vbsav_found=0"
for %%S in ("!VBM_EVIDENCE!\Memory\*.sav") do set "_vbsav_found=1"
if "!_vbsav_found!"=="0" (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] No .sav file was found in the VM snapshot folder.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] No se encontró ningún .sav en la carpeta de snapshots de la VM.!C_RESET!
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] VirtualBox reports state "!VBR_SEL_STATE!" but the file is not there.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] VirtualBox informa estado "!VBR_SEL_STATE!" pero el archivo no esta ahi.!C_RESET!
    call :LOG_EVENT "Advertencia: VMState=!VBR_SEL_STATE! para !VBR_SEL_NAME! pero no se encontro ningun .sav en !vb_sav_folder!. No se afirma haber adquirido memoria."
    pause
    goto MENU_VM_VBOX
)
if /i "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Saved state copied to: !VBM_EVIDENCE!\Memory!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Estado guardado copiado en: !VBM_EVIDENCE!\Memory!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![FORMAT] .sav is VirtualBox's PROPRIETARY saved-state format, NOT RAW memory.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![FORMATO] El .sav es el formato PROPIETARIO de estado guardado de VirtualBox, NO memoria RAW.!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Reading it requires conversion: no memory analysis tool ingests it directly.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Su lectura exige conversión: ninguna herramienta de análisis lo ingiere directamente.!C_RESET!
call :LOG_EVENT "Estado guardado VirtualBox (.sav) adquirido de !VBR_SEL_NAME! (VMState=!VBR_SEL_STATE!, origen: !vb_sav_folder!). Contiene la RAM del invitado y el estado de dispositivos. Formato propietario, NO RAW: requiere conversion para analizarse."
(
echo FORMATO: .sav - estado guardado PROPIETARIO de VirtualBox ^(NO RAW^)
echo ORIGEN: !vb_sav_folder!
echo VMState de la VM en el momento de la adquisicion: !VBR_SEL_STATE!
echo.
echo CONTENIDO: RAM del invitado + estado de los dispositivos virtuales en el
echo   instante en que se suspendio la VM. La fuente NO estaba mutando durante
echo   la copia, asi que el hash del origen y el de la copia son comparables.
echo.
echo LIMITACION: ninguna herramienta de analisis de memoria ingiere este formato
echo   directamente. Requiere conversion. No se documenta aqui una receta de
echo   conversion concreta porque este framework no la ha verificado.
) > "!VBM_EVIDENCE!\Memory\FORMAT_NOTE.txt"
call :HASH_EVIDENCE FOLDER "!VBM_EVIDENCE!\Memory" "*.sav" "!DEST!\hashes.sha256" "VirtualBox_EstadoGuardado"
pause
goto MENU_VM_VBOX

:VB_MEM_SAV_NOFOLDER
if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Could not determine the VM snapshot folder: the .sav cannot be located.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] No se pudo determinar la carpeta de snapshots de la VM: no se puede localizar el .sav.!C_RESET!
call :LOG_EVENT "Error: no se pudo determinar SnapshotFolder de !VBR_SEL_NAME!; el estado guardado (.sav) no se pudo localizar ni adquirir."
pause
goto MENU_VM_VBOX

:: -----------------------------------------------------------------------
:: VBOX_HANDLE_VM_RUNNING
:: %1 = UUID de la VM, %2 = nombre a mostrar. Usa !VBOX_EXE! ya definido.
:: Si la VM esta en ejecución, ofrece apagarla automáticamente desde el
:: script (ACPI power button = apagado normal, equivalente a "vmrun stop
:: soft" de VMware, NO forzado) o que el operador lo haga manualmente y
:: reintente. Bucle hasta que la VM este apagada o el operador cancele.
:: Resultado en !VBXR_ABORT! (1=cancelar; 0=la VM esta apagada, continuar).
:: -----------------------------------------------------------------------
:VBOX_HANDLE_VM_RUNNING
:: La decision se toma sobre el literal VMState, NO sobre "list runningvms".
:: Antes bastaba con no aparecer en runningvms para pasar la puerta, asi que
:: stuck, starting, stopping, saving, restoring, snapshotting,
:: deletingsnapshotonline, settingup, aborted, aborted-saved e inaccesible la
:: ATRAVESABAN etiquetados como "Apagada". Ahora hay tabla explicita y el
:: estado se REGISTRA: distinguir poweroff de saved o de aborted cambia por
:: completo la interpretacion del disco (ISO/IEC 27037, metadato de custodia).
:: NOTA: a diferencia de VMware ("vmrun stop soft", que usa VMware Tools para
:: invocar directamente el script de apagado del SO invitado, sin pasar por
:: el entorno de escritorio), "VBoxManage acpipowerbutton" es una señal ACPI
:: real cuya respuesta depende de como el SO invitado la maneje. Verificado
:: en pruebas reales: GNOME puede interceptarla y mostrar un dialogo de
:: confirmación ("Goodbye, que deseas hacer?") que requiere interaccion
:: manual DENTRO de la VM - VBoxManage no tiene forma de forzar eso desde el
:: host. Por eso este framework NO intenta apagar automáticamente: no se
:: puede garantizar que el apagado se complete, y un apagado forzado
:: ("poweroff") dejaria el sistema de archivos en estado sucio. Se le pide
:: al operador que apague la VM el mismo, y se reintenta la verificación.
set "_vbxr_uuid=%~1"
set "_vbxr_name=%~2"
set "VBXR_ABORT=0"

:VBXR_CHECK
call :VBOX_GET_VMSTATE "!_vbxr_uuid!"
set "VBOX_ACQ_VMSTATE=!VBOX_VMSTATE!"
call :VBOX_STATE_CLASS "!VBOX_VMSTATE!"
if "!VBOX_SCLASS!"=="OK" goto VBXR_STATE_OK
if "!VBOX_SCLASS!"=="OK_SAV" goto VBXR_STATE_SAV
if "!VBOX_SCLASS!"=="OK_ABORT" goto VBXR_STATE_ABORT
if "!VBOX_SCLASS!"=="BAD" goto VBXR_STATE_BAD

echo.
rem Una VM PAUSADA no esta "en ejecucion": antes se le decia al operador que lo
rem estaba porque la puerta se decidia con "list runningvms", que tambien
rem reporta paused. El mensaje ahora dice el estado que realmente hay.
if /I "!VBOX_VMSTATE!"=="paused" if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] The VM "!_vbxr_name!" is PAUSED (its media are still held by the VM process).!C_RESET!
if /I "!VBOX_VMSTATE!"=="paused" if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] La VM "!_vbxr_name!" esta PAUSADA (sus medios siguen retenidos por el proceso de la VM).!C_RESET!
if not "!VBOX_VMSTATE!"=="paused" if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] The VM "!_vbxr_name!" is running.!C_RESET!
if not "!VBOX_VMSTATE!"=="paused" if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] La VM "!_vbxr_name!" esta en ejecución.!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] It must be powered off to guarantee forensic integrity.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] Debe estar apagada para garantizar la integridad forense.!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] Shut it down yourself from inside the VM ^(this framework cannot!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] Apaguela usted mismo desde dentro de la VM ^(este framework no puede!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] guarantee an automatic shutdown in VirtualBox: the guest OS may!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] garantizar un apagado automático en VirtualBox: el SO invitado puede!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] require manual confirmation on the ACPI signal^).!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] requerir confirmación manual ante la señal ACPI^).!C_RESET!
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![1] Already powered it off - retry verification
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![1] Ya la apague - reintentar verificación
if /i "!FORENSIC_LANG!"=="EN" echo [0] Cancel!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo [0] Cancelar!C_RESET!
:VBXR_ASK
set "_vbxr_opt="
if /i "!FORENSIC_LANG!"=="EN" set /p _vbxr_opt="!C_PROMPT!Option: !C_RESET!"
if /i not "!FORENSIC_LANG!"=="EN" set /p _vbxr_opt="!C_PROMPT!Opción: !C_RESET!"
if "!_vbxr_opt!"=="0" (
    set "VBXR_ABORT=1"
    call :LOG_EVENT "Adquisicion VirtualBox cancelada: VM en ejecucion - !_vbxr_name!"
    exit /b 0
)
if "!_vbxr_opt!"=="1" goto VBXR_CHECK
if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Invalid option. Enter 0 or 1.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Opción inválida. Ingrese 0 o 1.!C_RESET!
goto VBXR_ASK

:VBXR_STATE_OK
call :LOG_EVENT "Estado de la VM VirtualBox en el momento de la adquisicion: VMState=poweroff (!_vbxr_name!)"
exit /b 0

:VBXR_STATE_SAV
:: saved / aborted-saved: el disco esta congelado y es adquirible, pero existe
:: un .sav con la RAM y el estado de dispositivos del invitado. Callarlo seria
:: dejar fuera del informe memoria que esta en disco y es adquirible por copia.
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] The VM "!_vbxr_name!" is in state "!VBOX_VMSTATE!": the disk is frozen and!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] La VM "!_vbxr_name!" esta en estado "!VBOX_VMSTATE!": el disco esta congelado y!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] acquirable, but there IS guest RAM saved to disk in a .sav file.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] es adquirible, pero SI hay RAM del invitado guardada en disco en un .sav.!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Acquire it from the RAM Memory Dump option of this same menu.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Adquiéralo desde la opción de Volcado de Memoria RAM de este mismo menu.!C_RESET!
call :LOG_EVENT "Estado de la VM VirtualBox en el momento de la adquisicion: VMState=!VBOX_VMSTATE! (!_vbxr_name!). Existe estado guardado (.sav) con la RAM del invitado: se avisa al operador para que lo adquiera aparte."
exit /b 0

:VBXR_STATE_ABORT
:: aborted: el proceso de la VM murio sin apagado ordenado y SIN estado
:: guardado. El disco es adquirible, pero el sistema de archivos del invitado
:: quedo sucio y eso hay que decirlo, no descubrirlo despues en el analisis.
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] The VM "!_vbxr_name!" is in state "aborted": the VM process died without an!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] La VM "!_vbxr_name!" esta en estado "aborted": el proceso de la VM murio sin!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] orderly shutdown and with NO saved state. The guest filesystem is dirty.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] apagado ordenado y SIN estado guardado. El sistema de archivos esta sucio.!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] The disk is acquirable. Record this in the chain of custody.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] El disco es adquirible. Regístrelo en la cadena de custodia.!C_RESET!
call :LOG_EVENT "Estado de la VM VirtualBox en el momento de la adquisicion: VMState=aborted (!_vbxr_name!). Terminacion sucia sin estado guardado: el sistema de archivos del invitado NO quedo cerrado limpiamente."
exit /b 0

:VBXR_STATE_BAD
:: Estado transitorio, bloqueado o ilegible. Aqui NO se adquiere: los medios
:: pueden estar bloqueados o mutando, y seguir adelante producia el error
:: generico "Error al clonar el disco" sin decirle al operador que la causa era
:: el estado de la VM. Se muestra el literal recibido, sin traducirlo.
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] The VM "!_vbxr_name!" is NOT in an acquirable state.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] La VM "!_vbxr_name!" NO esta en un estado adquirible.!C_RESET!
if defined VBOX_VMSTATE if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] VMState reported by VirtualBox: "!VBOX_VMSTATE!"!C_RESET!
if defined VBOX_VMSTATE if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] VMState informado por VirtualBox: "!VBOX_VMSTATE!"!C_RESET!
if not defined VBOX_VMSTATE if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] VMState could not be read at all (VM inaccessible or service down).!C_RESET!
if not defined VBOX_VMSTATE if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] No se pudo leer VMState (VM inaccesible o servicio caido).!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Transient or locked states (stuck, starting, stopping, saving, restoring,!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] En estados transitorios o bloqueados (stuck, starting, stopping, saving,!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] snapshotting, settingup...) the media are locked or changing: cloning!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] restoring, snapshotting, settingup...) los medios estan bloqueados o!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] would fail or produce an image that cannot be sustained in a report.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] mutando: clonar fallaria o daria una imagen insostenible en un informe.!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Wait for the operation to finish, or power the VM off, and try again.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Espere a que termine la operación, o apague la VM, y reintente.!C_RESET!
call :LOG_EVENT "ABORTADO: la VM VirtualBox !_vbxr_name! no esta en un estado adquirible. VMState literal recibido: '!VBOX_VMSTATE!'. No se intenta clonar contra medios bloqueados o en transicion."
set "VBXR_ABORT=1"
pause
exit /b 0

:: =====================================================
:: VIRTUALBOX - CLONAR VM COMPLETA
:: Copia la carpeta COMPLETA de la máquina (config .vbox + discos +
:: carpeta Snapshots con la cadena diferencial + estados guardados .sav si
:: los hay) intacta, sin consolidar nada - igual que la opción equivalente
:: de VMware. Permite reabrirla en VirtualBox (registervm) y usar su propio
:: Snapshot Manager para restaurar cualquier punto con su cadena original.
:: =====================================================
:VBOX_CLONE_FULL
:: El clon completo ES una copia recursiva de la carpeta de la VM.
if not defined HAS_ROBOCOPY call :ROBOCOPY_MISSING "VirtualBox - clon completo de la VM"
if not defined HAS_ROBOCOPY goto MENU_VM_VBOX
call :RESOLVE_VBOX
if !errorlevel! neq 0 (
    pause
    goto MENU_VM_VBOX
)
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Clone Full VM to Open/Restore in VirtualBox!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Clonar VM Completa para Abrir/Restaurar en VirtualBox!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Copies the COMPLETE VM folder ^(.vbox config + disks +!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Copia la carpeta COMPLETA de la VM ^(config .vbox + discos +!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Snapshots folder without consolidating^) to open it in VirtualBox and use!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] carpeta Snapshots sin consolidar^) para abrirla en VirtualBox y usar!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] its own Snapshot Manager, restoring any original point.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] su propio Snapshot Manager, restaurando cualquier punto original.!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] A cloned disk ^(Disk Acquisition option^) is NOT valid for this:!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] Un disco clonado ^(opción Adquisición de Disco^) NO sirve para esto:!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] is a NEW file, with no link to the snapshot chain. That is why!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] es un archivo NUEVO, sin vinculo con la cadena de snapshots. Por eso!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] here the whole folder is copied, without consolidating anything.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] aquí se copia la carpeta completa, sin consolidar nada.!C_RESET!

echo.
call :VBOX_ENUM_VMS
if !errorlevel! neq 0 (
    pause
    goto MENU_VM_VBOX
)
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT!Virtual Machines detected in VirtualBox:!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT!Máquinas Virtuales detectadas en VirtualBox:!C_RESET!
for /L %%i in (1,1,!vb_count!) do (
    call :VBOX_GET_VM_STATE_LABEL "!VB_UUID_%%i!"
    echo  %%i. !VB_NAME_%%i! [!VB_UUID_%%i!] - !_vb_state!
)
echo.
:PROMPT_VBC_SEL
set "vbc_sel="
if /i "!FORENSIC_LANG!"=="EN" set /p vbc_sel="!C_PROMPT!Select the VM [1-!vb_count!, 0=cancel]: !C_RESET!"
if /i not "!FORENSIC_LANG!"=="EN" set /p vbc_sel="!C_PROMPT!Seleccione la VM [1-!vb_count!, 0=cancelar]: !C_RESET!"
if "!vbc_sel!"=="0" goto MENU_VM_VBOX
if not defined vbc_sel goto PROMPT_VBC_SEL
for /f "delims=0123456789" %%a in ("!vbc_sel!") do (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Please enter a valid number.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Por favor, ingrese un número válido.!C_RESET!
    goto PROMPT_VBC_SEL
)
if !vbc_sel! lss 1 goto PROMPT_VBC_SEL
if !vbc_sel! gtr !vb_count! goto PROMPT_VBC_SEL
call :NORM_SEL vbc_sel
set "VBC_UUID=!VB_UUID_%vbc_sel%!"
set "VBC_NAME=!VB_NAME_%vbc_sel%!"
if not defined VBC_UUID goto PROMPT_VBC_SEL

call :VBOX_HANDLE_VM_RUNNING "!VBC_UUID!" "!VBC_NAME!"
if "!VBXR_ABORT!"=="1" goto MENU_VM_VBOX

:: Localizar la carpeta de la máquina vía CfgFile (propiedad oficial de
:: showvminfo --machinereadable): el .vbox esta en la RAIZ de esa carpeta.
set "vbc_cfgfile="
for /f "tokens=1,* delims==" %%A in ('""!VBOX_EXE!" showvminfo "!VBC_UUID!" --machinereadable 2^>nul ^| findstr /I "^CfgFile=""') do set "vbc_cfgfile=%%B"
if defined vbc_cfgfile set "vbc_cfgfile=!vbc_cfgfile:~1,-1!"
if not defined vbc_cfgfile (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Could not locate the VM .vbox file.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] No se pudo localizar el archivo .vbox de la VM.!C_RESET!
    pause
    goto MENU_VM_VBOX
)
for %%F in ("!vbc_cfgfile!") do set "VBC_VMFOLDER=%%~dpF"
if "!VBC_VMFOLDER:~-1!"=="\" set "VBC_VMFOLDER=!VBC_VMFOLDER:~0,-1!"
for %%F in ("!vbc_cfgfile!") do set "VBC_CFGNAME=%%~nxF"

echo.
:ASK_VBC_DEST
set "vbc_dest="
if /i "!FORENSIC_LANG!"=="EN" set /p vbc_dest="!C_PROMPT!Destination folder path [Enter = !DEFAULT_DEST!] (0=cancel): !C_RESET!"
if /i not "!FORENSIC_LANG!"=="EN" set /p vbc_dest="!C_PROMPT!Ruta de la carpeta destino [Enter = !DEFAULT_DEST!] (0=cancelar): !C_RESET!"
if "!vbc_dest!"=="0" goto MENU_VM_VBOX
if defined vbc_dest set "vbc_dest=!vbc_dest:"=!"
if not defined vbc_dest (
    set "vbc_dest=!DEFAULT_DEST!"
    if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Using default destination: !DEFAULT_DEST!!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Usando destino por defecto: !DEFAULT_DEST!!C_RESET!
)
call :VALIDATE_DEST_DIR "!vbc_dest!"
if not "!_VD_OK!"=="1" goto ASK_VBC_DEST

call :SANITIZE_NAME "!VBC_NAME!"
set "VBC_FOLDER=!_SN_OUT!"
set "VBC_EVIDENCE=!vbc_dest!\VirtualBox\!VBC_FOLDER!\Clon_Completo_VirtualBox"
set "DEST=!VBC_EVIDENCE!"
call :ENSURE_DIR "!VBC_EVIDENCE!"
if not "!_ED_OK!"=="1" goto MENU_VM_VBOX

echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Hashing original files before copying ^(integrity verification^)...!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Hasheando archivos originales antes de copiar ^(verificación de integridad^)...!C_RESET!
call :LOG_EVENT "Clon completo VirtualBox iniciado: VM=!VBC_NAME! carpeta=!VBC_VMFOLDER!"
call :HASH_EVIDENCE FOLDER "!VBC_VMFOLDER!" "*.vdi,*.vmdk,*.vhd,*.vbox,*.vbox-prev,*.sav" "!VBC_EVIDENCE!\hashes_originales_PREcopia.sha256" "VirtualBox_Original_PreCopia_ClonCompleto" PREVIO

echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Copying the complete VM ^(config + disks + snapshots^)...!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Copiando VM completa ^(config + discos + snapshots^)...!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] This may take a while depending on the VM size.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] Esto puede tardar según el tamaño de la VM.!C_RESET!
call :NEWGUID ACQ_GUID
set "ACQ_CMD=!TEMP!\forensic_cmd_!ACQ_GUID!.tmp"
>"!ACQ_CMD!" echo robocopy "!VBC_VMFOLDER!" "!VBC_EVIDENCE!\VM" /E /COPY:DAT /R:1 /W:1 /NFL /NDL ^& if errorlevel 8 (exit 1) else (exit 0)
set "ACQ_TOOL_VER=robocopy in-box de !WIN_NAME! build !WIN_BUILD! - no publica version propia: su identidad es la build del SO"
call :ACQUIRE "VirtualBox_ClonCompleto" "!ACQ_CMD!"
set "_vbc_el=!errorlevel!"
if "!_vbc_el!"=="2" (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![ABORT] Cloning aborted by the user.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![ABORT] Clonado abortado por el usuario.!C_RESET!
    call :LOG_EVENT "Clon completo VirtualBox abortado por el usuario (CTRL+C)."
    pause
    goto MENU_VM_VBOX
)
if !_vbc_el! neq 0 (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Error copying the complete VM.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Error al copiar la VM completa.!C_RESET!
    call :LOG_EVENT "Error: Fallo al copiar VM completa para clon VirtualBox."
    pause
    goto MENU_VM_VBOX
)

if /i "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Full VM copied to: !VBC_EVIDENCE!\VM!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_OK![+] VM completa copiada a: !VBC_EVIDENCE!\VM!C_RESET!
call :LOG_EVENT "Clon completo VirtualBox finalizado: !VBC_EVIDENCE!\VM"

:: En VirtualBox el registro de medios es GLOBAL: un .vdi base puede vivir en
:: D:\discos\ y existen discos multi-attach compartidos entre varias VMs. Este
:: modulo copiaba solo la carpeta de la VM y prometia "la carpeta COMPLETA (config
:: + discos + Snapshots)": con un disco fuera de esa carpeta el clon quedaba
:: INCOMPLETO y no se podia registrar ni arrancar, sin un solo aviso.
call :VBOX_COPY_EXTERNAL_MEDIA
call :HASH_EVIDENCE FOLDER "!VBC_EVIDENCE!\VM" "*.vdi,*.vmdk,*.vhd,*.vbox,*.vbox-prev,*.sav" "!VBC_EVIDENCE!\hashes_copia_POSTcopia.sha256" "VirtualBox_Copia_ClonCompleto"

:: El "despues" se tomaba sobre la COPIA y el ORIGEN no se volvia a hashear nunca,
:: mientras la pantalla afirmaba "hash verificado antes y despues de la copia". Lo
:: unico que acredita que el original no cambio es RE-HASHEAR EL ORIGEN al acabar.
:: Se hace aqui y en un tercer archivo, para que la comparacion PRE/POST del origen
:: sea posible con datos y no por afirmacion.
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Re-hashing the ORIGIN after the copy (PRE/POST of the source)...!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Re-hasheando el ORIGEN después de la copia (PRE/POST del origen)...!C_RESET!
call :HASH_EVIDENCE FOLDER "!VBC_VMFOLDER!" "*.vdi,*.vmdk,*.vhd,*.vbox,*.vbox-prev,*.sav" "!VBC_EVIDENCE!\hashes_originales_POSTcopia.sha256" "VirtualBox_Original_PostCopia_ClonCompleto"
:: El texto de abajo se imprimia SIEMPRE, incluso si el operador declino los
:: hashes con la opcion [4] de :HASH_EVIDENCE: entonces afirmaba tres listas que
:: no existian. Se comprueba que los tres archivos esten realmente ahi.
set "_vbc_hash3=0"
if exist "!VBC_EVIDENCE!\hashes_originales_PREcopia.sha256" if exist "!VBC_EVIDENCE!\hashes_copia_POSTcopia.sha256" if exist "!VBC_EVIDENCE!\hashes_originales_POSTcopia.sha256" set "_vbc_hash3=1"
if "!_vbc_hash3!"=="1" call :LOG_EVENT "Clon completo VirtualBox: se registraron TRES listas de hash - origen PRE-copia, copia POST-copia y origen POST-copia. El framework NO las compara automaticamente: la comparacion archivo por archivo la debe hacer el analista y su resultado no puede darse por supuesto."
if not "!_vbc_hash3!"=="1" call :LOG_EVENT "Clon completo VirtualBox SIN VERIFICACION DE INTEGRIDAD por decision del operador: no estan las tres listas de hash (origen PRE-copia, copia POST-copia, origen POST-copia), asi que NO se puede sostener que el original no cambiara durante la copia."

echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![FORENSIC NOTE] This clone is a WORKING COPY for interactive examination,!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![NOTA FORENSE] Este clon es una COPIA OPERATIVA para examen interactivo,!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT!not a read-only image.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT!no una imagen de solo lectura.!C_RESET!
if "!_vbc_hash3!"=="1" if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT!Three hash lists were recorded: SOURCE before copying, COPY after!C_RESET!
if "!_vbc_hash3!"=="1" if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT!Se registraron tres listas de hash: ORIGEN antes de copiar, COPIA!C_RESET!
if "!_vbc_hash3!"=="1" if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT!copying, and SOURCE after copying. Compare them file by file before!C_RESET!
if "!_vbc_hash3!"=="1" if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT!después de copiar y ORIGEN después de copiar. Compárelas archivo por!C_RESET!
if "!_vbc_hash3!"=="1" if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT!relying on this clone: the framework does NOT compare them.!C_RESET!
if "!_vbc_hash3!"=="1" if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT!archivo antes de usar este clon: el framework NO las compara.!C_RESET!
if not "!_vbc_hash3!"=="1" if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR!WITHOUT integrity verification, by operator decision: the three hash!C_RESET!
if not "!_vbc_hash3!"=="1" if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR!SIN verificación de integridad por decisión del operador: no estan las!C_RESET!
if not "!_vbc_hash3!"=="1" if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR!lists are not there, so it CANNOT be sustained that the original did!C_RESET!
if not "!_vbc_hash3!"=="1" if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR!tres listas de hash, asi que NO se puede sostener que el original no!C_RESET!
if not "!_vbc_hash3!"=="1" if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR!not change during the copy.!C_RESET!
if not "!_vbc_hash3!"=="1" if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR!cambiara durante la copia.!C_RESET!
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] To use it: register the copy in VirtualBox with!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Para usarlo: registre la copia en VirtualBox con!C_RESET!
echo !C_TEXT!    VBoxManage registervm "!VBC_EVIDENCE!\VM\!VBC_CFGNAME!"!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT!    and from the Snapshot Manager restore the desired point.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT!    y desde el Snapshot Manager restaure el punto deseado.!C_RESET!
echo.
pause
goto MENU_VM_VBOX

:VM_VMWARE
:: DEST se limpia al ENTRAR al modulo. :LOG_EVENT manda al diario GLOBAL de la
:: sesion todo evento producido sin DEST, pero si el operador ya uso otro modulo
:: en la misma sesion, DEST seguia apuntando a la evidencia ANTERIOR: los eventos
:: de este modulo previos a fijar su propio DEST -eleccion de motor, recuento de
:: snapshots, apagado de la VM, snapshot forense- quedaban escritos en el diario
:: de OTRO caso. Vaciarlo los manda al diario global, que es donde pertenecen
:: hasta que exista carpeta de evidencia propia.
set "DEST="
set "VMW_CHAIN_RECONSTRUCT="
set "_vmw_base_ok=0"
:: Banderas del motor de adquisicion. Se reinician SIEMPRE al entrar: no hay
:: setlocal por rutina, asi que un valor sucio de una ejecucion anterior de la
:: misma sesion del script cambiaria el flujo en silencio.
set "VMW_HOT=0"
set "VMW_FREEZE=0"
set "VMW_ACQ_ABORT=0"
set "VMW_HOT_OK=0"
set "VMW_HOT_IMG="
call :RESOLVE_VMWARE
:: La ausencia de vmware-vdiskmanager.exe ya NO aborta el modulo: la via en
:: CALIENTE solo necesita qemu-img, y este arbol del proyecto puede no traer
:: los binarios de VMware. Queda como bandera; la rama que si lo necesita
:: -consolidacion con la VM apagada- lo revalida en su propio punto de uso,
:: donde el fallo ya era suave (goto VMW_SKIP_QEMU) en lugar de un aborto.
set "VMW_HAS_VDISK=0"
if exist "!VMDK_EXE!" set "VMW_HAS_VDISK=1"
:: Sin NINGUNA de las dos herramientas no hay adquisicion posible de ninguna
:: clase: ese si sigue siendo un aborto legitimo.
if "!VMW_HAS_VDISK!"=="0" if not exist "!QEMU_IMG!" (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Neither vmware-vdiskmanager.exe nor qemu-img.exe were found.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] No se encontró ni vmware-vdiskmanager.exe ni qemu-img.exe.!C_RESET!
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] Disk acquisition needs at least one of the two tools.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] La adquisición de disco necesita al menos una de las dos.!C_RESET!
    pause
    goto MENU_VM_VMWARE
)
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Virtual Disk Acquisition (.vmdk -^> consolidated, or hot RAW image)!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Adquisición de Disco Virtual (.vmdk -^> consolidado, o imagen RAW en caliente)!C_RESET!
call :SELECT_VMWARE_VM
if !errorlevel! neq 0 goto MENU_VM_VMWARE

call :RESOLVE_VMWARE
call :VMWARE_TOOLS_REPORT

:: Composicion de discos del .vmx ANTES de decidir el motor: si hay discos
:: independientes, el snapshot no los congela; si hay alguno nonpersistent,
:: apagar la VM destruye sus escrituras; y si hay mas de uno, esta adquisicion
:: cubre solo el que se elija. Son datos que cambian la decision del operador,
:: asi que se muestran antes de pedirsela.
call :VMWARE_LIST_VMX_DISKS "!SELECTED_VM_VMX!"

:: Si la VM esta ENCENDIDA se pregunta CON QUE MOTOR adquirir. Por defecto
:: (Enter) se adquiere EN CALIENTE con qemu-img y la VM sigue corriendo.
:: Apagar la VM, "la apago yo" y cancelar se conservan como alternativas,
:: pero ninguna es ya la UNICA salida. Con la VM apagada la subrutina no
:: muestra menu y el comportamiento es exactamente el de siempre.
call :ASK_VMWARE_ACQ_ENGINE
if "!VMW_ACQ_ABORT!"=="1" goto MENU_VM_VMWARE
:: Solo la via en frio necesita apagar. Se usan ifs ANIDADOS (no "&") para que
:: la segunda comprobacion dependa tambien de VMW_HOT, y VMW_STOP_ABORT se
:: fuerza a 0 antes porque si no se llama a la subrutina quedaria sucia de una
:: ejecucion anterior de la misma sesion del script.
set "VMW_STOP_ABORT=0"
if "!VMW_HOT!"=="0" if exist "!VMRUN_EXE!" call :VMWARE_CHECK_AND_STOP_IF_RUNNING
if "!VMW_HOT!"=="0" if "!VMW_STOP_ABORT!"=="1" goto MENU_VM_VMWARE

:: Detectar snapshots ANTES de buscar discos (comando oficial: vmrun
:: listSnapshots) y preguntar al operador si desea incluirlos.
:: NOTA: el comando completo va envuelto en un par extra de comillas
:: ("" ... "") porque, al combinar una ruta con espacios entre comillas
:: con un pipe (|) dentro de un for /f, cmd.exe pierde el pareo de
:: comillas del ejecutable y trata de correr "C:\Proyecto" como comando
:: (bug real detectado con datos de un usuario: "Proyecto final\..." con
:: espacio en el nombre de carpeta). Verificado con reproduccion aislada.
:: Centinela: "0" NO puede ser el valor inicial. Medido contra vmrun real:
::   VM consultable, sin snapshots -> imprime "Total snapshots: 0" y devuelve 0
::   .vmx ilegible / servicio caido -> NO imprime esa linea y devuelve 127
:: findstr solo deja pasar la linea del recuento, asi que el centinela sobrevive
:: exactamente cuando la enumeracion NO se pudo hacer. Con "0" inicial los dos
:: casos eran indistinguibles y se afirmaba "no hay snapshots" tras un fallo:
:: una VM con cadena diferencial se adquiriria como si fuera un disco unico.
set "vmw_snap_count=DESCONOCIDO"
set "VMW_SNAP_SRC=vmrun listSnapshots"
if not exist "!VMRUN_EXE!" goto VMW_SNAP_NOVMRUN
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Verifying the snapshots of the VM...!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Verificando snapshots de la VM...!C_RESET!
:: findstr /I "Total snapshots:" es una lista OR de dos terminos ("Total" O
:: "snapshots:"), no una frase: cualquier snapshot cuyo NOMBRE contenga una de
:: las dos palabras pasaba el filtro y, como el for se queda con la ULTIMA
:: coincidencia, pisaba el contador con basura. Con /C: la frase es literal y
:: solo se acepta la PRIMERA linea (vmrun imprime el recuento antes de la lista).
for /f "tokens=3" %%C in ('""!VMRUN_EXE!" listSnapshots "!SELECTED_VM_VMX!" 2^>nul ^| findstr /I /C:"Total snapshots:""') do if "!vmw_snap_count!"=="DESCONOCIDO" set "vmw_snap_count=%%C"
if "!vmw_snap_count!"=="" set "vmw_snap_count=DESCONOCIDO"
goto VMW_SNAP_DETECT_DONE

:VMW_SNAP_NOVMRUN
:: Sin vmrun no se puede preguntar a VMware, pero eso NO autoriza a afirmar que
:: no hay snapshots: se cuenta por CONTENIDO leyendo el parentCID de cada
:: descriptor de la carpeta, exactamente el criterio que ya usa el clon
:: selectivo. Es una medida real y sostenible, aunque solo alcanza a los
:: snapshots cuyos discos viven en la carpeta de la VM.
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] vmrun.exe not available: counting snapshots by disk descriptor content...!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] vmrun.exe no disponible: contando snapshots por contenido de los descriptores...!C_RESET!
call :VMWARE_COUNT_SNAPSHOT_DELTAS "!SELECTED_VM_PATH!"
if "!_VMWCD_COUNT!"=="DESCONOCIDO" goto VMW_SNAP_DETECT_DONE
set "vmw_snap_count=!_VMWCD_COUNT!"
set "VMW_SNAP_SRC=clasificacion de descriptores .vmdk por parentCID (sin vmrun)"
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] Count obtained WITHOUT vmrun, from the !_VMWCD_TOTAL! descriptors present in!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] Recuento obtenido SIN vmrun, sobre los !_VMWCD_TOTAL! descriptores presentes en!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] the VM folder: snapshots whose disks live elsewhere are NOT covered.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] la carpeta de la VM: NO cubre snapshots cuyos discos vivan en otra ruta.!C_RESET!
:VMW_SNAP_DETECT_DONE

set "VMW_SNAP_INCLUDE=0"
if "!vmw_snap_count!"=="DESCONOCIDO" goto VMW_SNAP_ENUM_FAILED
if !vmw_snap_count! equ 0 (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_OK![+] No snapshots detected.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_OK![+] No se detectaron snapshots.!C_RESET!
    goto VMW_SNAP_DECISION_DONE
)

:: Con snapshots presentes, el operador elige entre disco completo, solo
:: el original, o SOLO un snapshot específico (útil si ya adquirio el
:: original antes, o si no lo necesita).
call :ASK_VMWARE_SNAPSHOT_MODE !vmw_snap_count!
call :LOG_EVENT "VMware snapshots detectados: !vmw_snap_count! (modo=!VMW_SNAP_MODE!, metodo de recuento=!VMW_SNAP_SRC!) - !SELECTED_VM_VMX!"
if "!VMW_SNAP_MODE!"=="0" goto MENU_VM_VMWARE
if "!VMW_SNAP_MODE!"=="3" (
    echo.
    if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Redirecting to snapshot rebuild ^(only the snapshot, without the original^)...!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Redirigiendo a reconstrucción de snapshot ^(solo el snapshot, sin el original^)...!C_RESET!
    set "VMW_RECON_SKIP_SELECT=1"
    goto VM_VMWARE_RECONSTRUCT
)
if "!VMW_SNAP_MODE!"=="4" (
    set "VMW_CHAIN_RECONSTRUCT=1"
    echo.
    if /i "!FORENSIC_LANG!"=="EN" echo !C_OK![+] The original disk will be acquired first; when it ends you will be asked to!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Se adquirira el disco original primero; al terminar se le pedira!C_RESET!
    if /i "!FORENSIC_LANG!"=="EN" echo !C_OK![+] to choose the specific snapshot as a separate second deliverable.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_OK![+] elegir el snapshot específico como segundo entregable separado.!C_RESET!
)
if "!VMW_SNAP_MODE!"=="1" (
    set "VMW_SNAP_INCLUDE=1"
    if /i "!FORENSIC_LANG!"=="EN" echo !C_OK![+] The full disk will be acquired: original + !vmw_snap_count! snapshot^(s^).!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Se adquirira el disco completo: original + !vmw_snap_count! snapshot^(s^).!C_RESET!
) else (
    set "VMW_SNAP_INCLUDE=0"
    if not "!VMW_SNAP_MODE!"=="4" if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] Snapshots will be excluded. Only the base disk will be acquired ^(original state^).!C_RESET!
    if not "!VMW_SNAP_MODE!"=="4" if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] Los snapshots serán excluidos. Solo se adquirira el disco base ^(estado original^).!C_RESET!
)
goto VMW_SNAP_DECISION_DONE

:VMW_SNAP_ENUM_FAILED
:: No se pudo enumerar: ni se afirma que no hay snapshots ni se sigue a ciegas.
:: Continuar aqui significaria decidir la inclusion de la cadena diferencial sin
:: saber si existe, y eso es justo lo que no se puede sostener en un informe.
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Could not enumerate the snapshots of this VM.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] No se pudieron enumerar los snapshots de esta VM.!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] Neither vmrun nor the fallback count by descriptor content worked.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] No funciono ni vmrun ni el recuento de respaldo por contenido de descriptores.!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] Causes: VMware services stopped, unreadable .vmx, vmrun.exe missing,!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] Causas: servicios de VMware detenidos, .vmx ilegible, vmrun.exe ausente,!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] or no readable .vmdk descriptor in the VM folder.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] o ningun descriptor .vmdk legible en la carpeta de la VM.!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] The acquisition is NOT continued: it is impossible to decide about a!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] NO se continua la adquisición: no se puede decidir sobre una cadena!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] differential chain whose existence could not be verified.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] diferencial cuya existencia no se ha podido comprobar.!C_RESET!
call :LOG_EVENT "ABORTADO: no se pudo enumerar los snapshots con vmrun listSnapshots - !SELECTED_VM_VMX! - no se afirma un recuento que no se pudo medir"
pause
goto MENU_VM_VMWARE

:VMW_SNAP_DECISION_DONE

:: VMware bloquea CADA ARCHIVO por separado con su propio "<archivo>.lck".
:: El ".vmx.lck" es un bloqueo de CONFIGURACIÓN que Workstation mantiene
:: mientras la VM sigue abierta en su biblioteca (persiste con la VM apagada
:: si la pestana sigue abierta en la app) y NO impide convertir el disco.
:: El bloqueo que SI importa aquí es el de cada ".vmdk.lck" individual: se
:: revisa mas abajo, una vez localizados los discos principales, justo antes
:: de invocar vdiskmanager.

echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Searching for disk descriptors (.vmdk) in the machine...!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Buscando descriptores de disco (.vmdk) en la máquina...!C_RESET!
:: NOTA: solo se descartan aquí los EXTENTS binarios (-sNN.vmdk, -flat.vmdk,
:: -delta.vmdk), que nunca son válidos como origen de vdiskmanager. Los
:: descriptores de snapshot (ej. "-000001.vmdk") SI se conservan en esta
:: etapa: se clasifican por CONTENIDO a continuacion, no se descartan por
:: el nombre.
set "vmdk_count=0"
for %%D in ("!SELECTED_VM_PATH!\*.vmdk") do (
    echo %%~nxD | findstr /R /I /C:"-s[0-9][0-9]*\.vmdk" /C:"-flat\.vmdk" /C:"-delta\.vmdk" >nul
    if !errorlevel! neq 0 (
        set /a vmdk_count+=1
        set "VMDK_FILE_!vmdk_count!=%%~fD"
        set "VMDK_NAME_!vmdk_count!=%%~nxD"
    )
)

if !vmdk_count! equ 0 (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![-] No main .vmdk disks found in the folder.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![-] No se encontraron discos principales .vmdk en la carpeta.!C_RESET!
    pause
    goto MENU_VM_VMWARE
)

:: Clasificar cada descriptor por su CONTENIDO real (campos oficiales del
:: formato VMDK: CID, parentCID, parentFileNameHint - VMware Virtual Disk
:: Format spec), no por el nombre del archivo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Analyzing descriptors ^(CID / parentCID / parentFileNameHint^)...!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Analizando descriptores ^(CID / parentCID / parentFileNameHint^)...!C_RESET!
for /L %%k in (1,1,!vmdk_count!) do (
    call :VMWARE_CLASSIFY_VMDK "!VMDK_FILE_%%k!"
    set "VMDK_ISBASE_%%k=!_VMDK_ISBASE!"
    set "VMDK_PARENT_%%k=!_VMDK_PARENTHINT!"
    set "VMDK_CID_%%k=!_VMDK_CID!"
)

:: Si el operador eligio EXCLUIR snapshots, quedarse solo con los discos
:: base (clasificacion por contenido, no por nombre) antes de mostrar nada.
if not "!VMW_SNAP_INCLUDE!"=="0" goto VMW_FILTER_DONE
set "_vmdk_f=0"
for /L %%k in (1,1,!vmdk_count!) do (
    if "!VMDK_ISBASE_%%k!"=="1" (
        set /a _vmdk_f+=1
        set "VMDK_FILE_F_!_vmdk_f!=!VMDK_FILE_%%k!"
        set "VMDK_NAME_F_!_vmdk_f!=!VMDK_NAME_%%k!"
    )
)
if !_vmdk_f! gtr 0 goto VMW_FILTER_APPLY
:: Cero discos base en la carpeta: el base vive en otra ruta o es un disco
:: compartido. Antes el filtro se SALTABA en silencio y se adquiria justo lo que
:: el operador habia pedido excluir. Se dice y se pide confirmacion.
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Snapshots CANNOT be excluded: there is no base disk in this folder.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] NO se pueden excluir los snapshots: no hay ningun disco base en esta carpeta.!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] Every descriptor found declares a parentCID, so all of them are!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] Todos los descriptores encontrados declaran parentCID, es decir son!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] differentials. The base disk lives somewhere else or is a shared disk.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] diferenciales. El disco base esta en otra ruta o es un disco compartido.!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] If you continue, you will acquire exactly what you asked to exclude.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] Si continua, adquirira exactamente lo que pidio excluir.!C_RESET!
call :LOG_EVENT "El operador pidio EXCLUIR snapshots pero no hay ningun disco base en !SELECTED_VM_PATH!: todos los descriptores declaran parentCID. El filtro NO se aplica y se advierte al operador."
set "_vmdk_fc="
if /i "!FORENSIC_LANG!"=="EN" set /p _vmdk_fc="!C_PROMPT!Continue anyway? [Y/N]: !C_RESET!"
if /i not "!FORENSIC_LANG!"=="EN" set /p _vmdk_fc="!C_PROMPT!¿Continuar de todas formas? [S/N]: !C_RESET!"
if /i "!_vmdk_fc!"=="Y" set "_vmdk_fc=S"
if /I not "!_vmdk_fc!"=="S" goto MENU_VM_VMWARE
call :LOG_EVENT "El operador autorizo continuar sin poder excluir los snapshots - !SELECTED_VM_PATH!"
goto VMW_FILTER_DONE
:VMW_FILTER_APPLY
for /L %%k in (1,1,!_vmdk_f!) do (
    set "VMDK_FILE_%%k=!VMDK_FILE_F_%%k!"
    set "VMDK_NAME_%%k=!VMDK_NAME_F_%%k!"
    set "VMDK_ISBASE_%%k=1"
    set "VMDK_PARENT_%%k="
)
set "vmdk_count=!_vmdk_f!"
:VMW_FILTER_DONE

if not !vmdk_count! equ 1 goto VMDK_MULTI
set "vmdk_src=!VMDK_FILE_1!"
set "vmdk_src_name=!VMDK_NAME_1!"
:: El rotulo "Disco principal - Base Disk" se imprimia sin mirar la clasificacion:
:: si el unico descriptor de la carpeta es un DIFERENCIAL, llamarlo disco base es
:: falso y ademas induce a error sobre lo que contiene la imagen.
if "!VMDK_ISBASE_1!"=="1" if /i "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Source disk selected automatically: !VMDK_NAME_1! ^(Main disk - Base Disk^)!C_RESET!
if "!VMDK_ISBASE_1!"=="1" if /i not "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Disco origen seleccionado automáticamente: !VMDK_NAME_1! ^(Disco principal - Base Disk^)!C_RESET!
if not "!VMDK_ISBASE_1!"=="1" if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![+] Source disk selected automatically: !VMDK_NAME_1!!C_RESET!
if not "!VMDK_ISBASE_1!"=="1" if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![+] Disco origen seleccionado automáticamente: !VMDK_NAME_1!!C_RESET!
if not "!VMDK_ISBASE_1!"=="1" if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN!    It is a DIFFERENTIAL ^(it declares a parentCID^), not the base disk. It only!C_RESET!
if not "!VMDK_ISBASE_1!"=="1" if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN!    Es un DIFERENCIAL ^(declara parentCID^), no el disco base. Solo resuelve!C_RESET!
if not "!VMDK_ISBASE_1!"=="1" if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN!    resolves with its full parent chain, which is NOT in this folder.!C_RESET!
if not "!VMDK_ISBASE_1!"=="1" if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN!    con su cadena de padres completa, que NO esta en esta carpeta.!C_RESET!
if not "!VMDK_ISBASE_1!"=="1" call :LOG_EVENT "Unico descriptor .vmdk en !SELECTED_VM_PATH! es un DIFERENCIAL (declara parentCID): !VMDK_NAME_1!. No se rotula como disco base."
goto VMDK_SEL_DONE
:VMDK_MULTI

:: Marcar la HOJA de la cadena: el descriptor SIN HIJOS es el unico que, al
:: consolidarse, produce "el disco original con los snapshots aplicados". Eso es
:: exactamente lo que promete el modo 1, y sin senalarlo el operador podia elegir
:: el disco base y obtener solo el estado ORIGINAL sin que nada se lo advirtiera.
for /L %%k in (1,1,!vmdk_count!) do set "VMDK_LEAF_%%k=1"
for /L %%k in (1,1,!vmdk_count!) do (
    for /L %%j in (1,1,!vmdk_count!) do (
        if defined VMDK_PARENT_%%j if /I "!VMDK_PARENT_%%j!"=="!VMDK_NAME_%%k!" set "VMDK_LEAF_%%k=0"
    )
)

echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_TITLE!Several VMDK files were detected:!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TITLE!Se detectaron varios archivos VMDK:!C_RESET!
echo.
for /L %%k in (1,1,!vmdk_count!) do (
    if "!VMDK_ISBASE_%%k!"=="1" (
        echo !C_OK! %%k. !VMDK_NAME_%%k!!C_RESET!
        if /i "!FORENSIC_LANG!"=="EN" echo !C_DIM!    Type: Main virtual disk ^(Base Disk^)!C_RESET!
        if /i not "!FORENSIC_LANG!"=="EN" echo !C_DIM!    Tipo: Disco virtual principal ^(Base Disk^)!C_RESET!
    ) else (
        echo !C_WARN! %%k. !VMDK_NAME_%%k!!C_RESET!
        if /i "!FORENSIC_LANG!"=="EN" echo !C_DIM!    Type: Snapshot ^(Delta Disk^)!C_RESET!
        if /i not "!FORENSIC_LANG!"=="EN" echo !C_DIM!    Tipo: Snapshot ^(Delta Disk^)!C_RESET!
        if defined VMDK_PARENT_%%k if /i "!FORENSIC_LANG!"=="EN" echo !C_DIM!    Based on: !VMDK_PARENT_%%k!!C_RESET!
        if defined VMDK_PARENT_%%k if /i not "!FORENSIC_LANG!"=="EN" echo !C_DIM!    Basado en: !VMDK_PARENT_%%k!!C_RESET!
    )
    if "!VMW_SNAP_INCLUDE!"=="1" if "!VMDK_LEAF_%%k!"=="1" if /i "!FORENSIC_LANG!"=="EN" echo !C_ACCENT!    ^<-- END OF THE CHAIN: this is the one that gives "original + snapshots applied".!C_RESET!
    if "!VMW_SNAP_INCLUDE!"=="1" if "!VMDK_LEAF_%%k!"=="1" if /i not "!FORENSIC_LANG!"=="EN" echo !C_ACCENT!    ^<-- FIN DE LA CADENA: es el que da "original + snapshots aplicados".!C_RESET!
    if "!VMW_SNAP_INCLUDE!"=="1" if "!VMDK_LEAF_%%k!"=="0" if /i "!FORENSIC_LANG!"=="EN" echo !C_DIM!        Choosing this one yields ONLY the state up to this point of the chain.!C_RESET!
    if "!VMW_SNAP_INCLUDE!"=="1" if "!VMDK_LEAF_%%k!"=="0" if /i not "!FORENSIC_LANG!"=="EN" echo !C_DIM!        Elegir este da SOLO el estado hasta ese punto de la cadena.!C_RESET!
)
echo.

:: Cadena de snapshots (si se puede reconstruir a partir de parentFileNameHint)
set "_vmdk_haschain="
for /L %%k in (1,1,!vmdk_count!) do if "!VMDK_ISBASE_%%k!"=="0" set "_vmdk_haschain=1"
if defined _vmdk_haschain (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_TITLE!Chain detected:!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_TITLE!Cadena detectada:!C_RESET!
    echo.
    for /L %%k in (1,1,!vmdk_count!) do (
        if "!VMDK_ISBASE_%%k!"=="1" (
            echo !C_OK!!VMDK_NAME_%%k!!C_RESET!
            call :VMDK_PRINT_CHILDREN "!VMDK_NAME_%%k!" 1
        )
    )
    echo.
)

:PROMPT_VMDK_SEL
set "d_sel="
if /i "!FORENSIC_LANG!"=="EN" set /p d_sel="!C_PROMPT!Select the source disk [1-!vmdk_count!, 0=cancel]: !C_RESET!"
if /i not "!FORENSIC_LANG!"=="EN" set /p d_sel="!C_PROMPT!Seleccione el disco origen [1-!vmdk_count!, 0=cancelar]: !C_RESET!"
if "!d_sel!"=="0" goto MENU_VM_VMWARE
if not defined d_sel goto PROMPT_VMDK_SEL

for /f "delims=0123456789" %%a in ("!d_sel!") do (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Enter a valid number.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Ingrese un número válido.!C_RESET!
    goto PROMPT_VMDK_SEL
)
if !d_sel! lss 1 goto PROMPT_VMDK_SEL
if !d_sel! gtr !vmdk_count! goto PROMPT_VMDK_SEL

call :NORM_SEL d_sel
set "vmdk_src=!VMDK_FILE_%d_sel%!"
set "vmdk_src_name=!VMDK_NAME_%d_sel%!"
if not defined vmdk_src goto PROMPT_VMDK_SEL
if "!vmdk_src!"=="" goto PROMPT_VMDK_SEL

:VMDK_SEL_DONE
:ASK_VMDK_DEST
set "vmdk_dest="
if /i "!FORENSIC_LANG!"=="EN" set /p vmdk_dest="!C_PROMPT!Destination folder path [Enter = !DEFAULT_DEST!] (0=cancel): !C_RESET!"
if /i not "!FORENSIC_LANG!"=="EN" set /p vmdk_dest="!C_PROMPT!Ruta de la carpeta destino [Enter = !DEFAULT_DEST!] (0=cancelar): !C_RESET!"
if "!vmdk_dest!"=="0" goto MENU_VM_VMWARE
if defined vmdk_dest set "vmdk_dest=!vmdk_dest:"=!"
if not defined vmdk_dest (
    set "vmdk_dest=!DEFAULT_DEST!"
    if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Using default destination: !DEFAULT_DEST!!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Usando destino por defecto: !DEFAULT_DEST!!C_RESET!
)
call :VALIDATE_DEST_DIR "!vmdk_dest!"
if not "!_VD_OK!"=="1" goto ASK_VMDK_DEST

:: Obtener nombre de la VM para carpeta organizada
for %%F in ("!SELECTED_VM_PATH!") do set "VMW_VMNAME=%%~nxF"
set "VMW_FOLDER=!VMW_VMNAME!"
set "VMW_FOLDER=!VMW_FOLDER:/=_!"
set "VMW_FOLDER=!VMW_FOLDER::=_!"
set "VMW_EVIDENCE=!vmdk_dest!\VMware\!VMW_FOLDER!"
set "DEST=!VMW_EVIDENCE!"
if not exist "!VMW_EVIDENCE!\Disks" mkdir "!VMW_EVIDENCE!\Disks"

:: Destino del vmdk consolidado
set "vmdk_dest=!VMW_EVIDENCE!\Disks\!vmdk_src_name!"

:: Bloqueo real del disco: VMware crea "<archivo>.lck" por cada extent
:: mientras esta en uso (VM encendida/suspendida, o snapshot en proceso).
:: Se revisa el disco concreto seleccionado, no el .vmx (que puede quedar
:: bloqueado por la app aunque la VM este apagada y el disco este libre).
::
:: En modo CALIENTE esta compuerta se SALTA a proposito: el ".lck" es un
:: candado cooperativo de VMware -una carpeta junto al archivo-, no un bloqueo
:: del sistema operativo, y qemu-img abre el descriptor igualmente. Exigir que
:: el candado desaparezca dejaria el flujo caliente sin ninguna salida.
:: VMWL_ABORT y VMWL_FROZEN se fuerzan a 0 ANTES: si no se llama a la subrutina
:: quedarian sucias de una ejecucion anterior de la misma sesion del script, y un
:: VMWL_FROZEN sucio haria que el informe en caliente declarase un snapshot que
:: no se tomo para ESTE disco.
set "VMWL_ABORT=0"
set "VMWL_FROZEN=0"
set "VMWL_QUIESCED=0"
if not "!VMW_HOT!"=="1" call :VMWARE_HANDLE_DISK_LOCKED "!vmdk_src!" "!vmdk_src_name!"
if "!VMWL_ABORT!"=="1" goto MENU_VM_VMWARE

:: Desvio a la rama en caliente. La rama en frio sigue de largo hacia la
:: consolidacion con vmware-vdiskmanager.exe, sin cambios.
if "!VMW_HOT!"=="1" goto VMW_ACQ_HOT

echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Consolidating virtual disks...!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Consolidando discos virtuales...!C_RESET!
call :LOG_EVENT "Iniciando consolidacion de disco VMWARE: Origen !vmdk_src!, Destino !vmdk_dest!"
call :RESOLVE_VMWARE
if not exist "!VMDK_EXE!" (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] vmware-vdiskmanager.exe not found in the expected path.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] No se encontró vmware-vdiskmanager.exe en la ruta esperada.!C_RESET!
    call :LOG_EVENT "Error: vmware-vdiskmanager.exe no disponible al consolidar."
    goto VMW_SKIP_QEMU
)
call :NEWGUID ACQ_GUID
set "ACQ_CMD=!TEMP!\forensic_cmd_!ACQ_GUID!.tmp"
>"!ACQ_CMD!" echo "!VMDK_EXE!" -r "!vmdk_src!" -t 0 "!vmdk_dest!"
call :ACQ_VER TOOLVER_VMDK "!VMDK_EXE!" ""
call :ACQUIRE "VMware_ConsolidarDisco" "!ACQ_CMD!"
set "_vmw_el=!errorlevel!"
if "!_vmw_el!"=="2" (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![ABORT] Consolidation aborted by the user.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![ABORT] Consolidación abortada por el usuario.!C_RESET!
    call :LOG_EVENT "Consolidacion VMware abortada por el usuario (CTRL+C)."
    goto VMW_SKIP_QEMU
)
if !_vmw_el! neq 0 (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] There was an error consolidating the disk.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Hubo un error al consolidar el disco.!C_RESET!
    call :LOG_EVENT "Error: Fallo al consolidar disco VMware."
    goto VMW_SKIP_QEMU
)

if /i "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Disk consolidation completed.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Consolidación de disco completada.!C_RESET!
call :LOG_EVENT "Consolidacion de disco VMware completada exitosamente."
echo.

for %%X in ("!vmdk_dest!") do set "vmdk_out_name=%%~nxX"
:: Verificación de integridad OPCIONAL (decisión del operador)
call :HASH_EVIDENCE FOLDER "!DEST!" "!vmdk_out_name!" "!DEST!\!vmdk_out_name!_Hashes.txt" "VMware_Disco"
if /i "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Process fully completed.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Proceso terminado por completo.!C_RESET!
set "_vmw_base_ok=1"
echo.
goto VMW_ACQ_POST

:: ---------------------------------------------------------------------------
:: RAMA EN CALIENTE (VM ENCENDIDA). El descriptor .vmdk se lee con qemu-img,
:: que NO implementa el protocolo de candado cooperativo de VMware y por tanto
:: abre el archivo mientras vmware-vmx.exe lo mantiene con FILE_SHARE_READ.
:: vmware-vdiskmanager.exe NO sirve aqui: exige un candado EXCLUSIVO sobre el
:: origen y falla siempre con la VM encendida ("FileIO_Lock ... failed").
:: ---------------------------------------------------------------------------
:VMW_ACQ_HOT
:: %%~nX quita SOLO la ultima extension: "Ubuntu.final.vmdk" -> "Ubuntu.final".
for %%X in ("!vmdk_src_name!") do set "vmw_hot_base=%%~nX"
call :LOG_EVENT "Adquisicion VMware con qemu-img sobre fuente en uso (estado medido de la VM: !VMW_VMSTATE!) - origen !vmdk_src!"
call :VMWARE_HOT_ACQUIRE "!vmdk_src!" "!VMW_EVIDENCE!\Disks" "!vmw_hot_base!"
if not "!VMW_HOT_OK!"=="1" goto VMW_SKIP_QEMU
:: _vmw_base_ok es la bandera que consume el modo 4 de snapshots (dos
:: entregables separados) al final del modulo: sin ponerla a 1 tambien aqui, el
:: segundo entregable se perderia en silencio en la via caliente.
set "_vmw_base_ok=1"
echo.

:VMW_ACQ_POST
:: Preservar también los archivos de CONFIGURACIÓN (.vmx/.vmxf/.vmsd/
:: .nvram): pequenos, pero sin ellos VMware no puede abrir el disco
:: consolidado después (el .vmx es el que referencia el hardware virtual).
:: Se copian siempre -no dependen de la inclusion/exclusion de snapshots-,
:: quedan disponibles por si el operador decide montar el disco después.
:: Sin robocopy no hay copia valida de la configuracion, pero la adquisicion del
:: disco SI puede seguir -qemu-img no depende de robocopy-, asi que se declara
:: que la configuracion NO queda preservada en vez de abortar el modulo. Tramo
:: PLANO con etiquetas: el mensaje generico "no se encontro .vmx" seria falso.
if not defined HAS_ROBOCOPY goto VMW_ACQ_CFG_NORBC
if not exist "!DEST!\Config" mkdir "!DEST!\Config"
robocopy "!SELECTED_VM_PATH!" "!DEST!\Config" *.vmx *.vmxf *.vmsd *.nvram /NFL /NDL /NJH /NJS >nul
if exist "!DEST!\Config\*.vmx" (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Configuration ^(.vmx/.vmxf/.vmsd/.nvram^) preserved in: !DEST!\Config!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Configuración ^(.vmx/.vmxf/.vmsd/.nvram^) preservada en: !DEST!\Config!C_RESET!
    call :LOG_EVENT "Configuracion VMware preservada: !DEST!\Config (origen: !SELECTED_VM_PATH!)"
    call :HASH_EVIDENCE FOLDER "!DEST!\Config" "*.vmx,*.vmxf,*.vmsd,*.nvram" "!DEST!\Config\hashes.sha256" "VMware_Configuracion"
) else (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] No .vmx found in the VM folder ^(could not preserve!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] No se encontró .vmx en la carpeta de la VM ^(no se pudo preservar!C_RESET!
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] the configuration^).!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] la configuración^).!C_RESET!
)
goto VMW_ACQ_CFG_DONE
:VMW_ACQ_CFG_NORBC
if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Configuration ^(.vmx/.vmxf/.vmsd/.nvram^) NOT preserved: robocopy.exe!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Configuración ^(.vmx/.vmxf/.vmsd/.nvram^) NO preservada: robocopy.exe!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] is missing on this host ^(not shipped with Windows XP^). The disk image is!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] no está en este equipo ^(no viene en Windows XP^). La imagen de disco sí!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] still valid, but VMware will not reopen it without the .vmx.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] es válida, pero VMware no la reabrirá sin el .vmx.!C_RESET!
call :LOG_EVENT "Configuracion VMware NO preservada: robocopy.exe no esta disponible en este host. La adquisicion del disco continua porque no depende de robocopy. NO se sustituye por xcopy: no preserva ACL ni las tres marcas de tiempo. El expediente queda SIN .vmx/.vmxf/.vmsd/.nvram y eso hay que tenerlo en cuenta para reabrir el disco."
:VMW_ACQ_CFG_DONE
echo.

:: Si el operador eligio incluir los snapshots, preservar (solo copia, sin
:: consolidar ni alterar) los archivos de disco diferencial de cada snapshot
:: (-delta.vmdk, descriptores -NNNNNN.vmdk y sus extents -NNNNNN-sNNN.vmdk), los
:: .vmsn (estado de dispositivos) y los .vmem (RAM de cada snapshot).
:: La seleccion la hace :VMWARE_PRESERVE_SNAPSHOT_FILES: los comodines de
:: robocopy no sirven aqui (ver la cabecera de esa subrutina).
:: Tramo PLANO (sin bloque entre parentesis): hay saltos a etiqueta para separar
:: el caso "se copio algo" del caso "no llego nada", y saltar a una etiqueta desde
:: dentro de un bloque aborta el bloque de formas que dependen del parser.
set "_vmws_do=0"
if "!VMW_SNAP_INCLUDE!"=="1" if !vmw_snap_count! gtr 0 set "_vmws_do=1"
if "!_vmws_do!"=="0" goto VMW_SNAPPRES_DONE
:: Sin robocopy la subrutina de preservacion no copia ni un archivo: se entra
:: directamente al tramo de fallo para no anunciar una copia que no ocurre.
set "_VMWS_COPIED=0"
if not defined HAS_ROBOCOPY goto VMW_SNAPPRES_EMPTY
if /i "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Preserving associated snapshot files...!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Preservando archivos de snapshots asociados...!C_RESET!
call :VMWARE_PRESERVE_SNAPSHOT_FILES "!SELECTED_VM_PATH!" "!DEST!\Snapshots"
if "!_VMWS_COPIED!"=="0" goto VMW_SNAPPRES_EMPTY
if /i "!FORENSIC_LANG!"=="EN" echo !C_OK![+] !_VMWS_COPIED! snapshot file^(s^) preserved in: !DEST!\Snapshots!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_OK![+] !_VMWS_COPIED! archivo^(s^) de snapshots preservados en: !DEST!\Snapshots!C_RESET!
call :LOG_EVENT "Snapshots VMware preservados: !_VMWS_COPIED! archivos en !DEST!\Snapshots (origen: !SELECTED_VM_PATH!)"
call :HASH_EVIDENCE FOLDER "!DEST!\Snapshots" "*.vmdk,*.vmsn,*.vmem" "!DEST!\Snapshots\hashes.sha256" "VMware_Snapshots"
echo.
goto VMW_SNAPPRES_DONE
:VMW_SNAPPRES_EMPTY
rem "Archivos de snapshots preservados" se imprimia sin comprobar que hubiera
rem llegado ni uno: con la carpeta vacia la evidencia quedaba sin la cadena
rem diferencial y el operador leia que si estaba.
if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] NO snapshot file could be preserved in: !DEST!\Snapshots!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] NO se pudo preservar ningun archivo de snapshots en: !DEST!\Snapshots!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] The differential chain is NOT in the evidence. Verify it manually.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] La cadena diferencial NO esta en la evidencia. Verifiquelo manualmente.!C_RESET!
if not defined HAS_ROBOCOPY if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] Reason: robocopy.exe is missing on this host ^(not shipped with Windows XP^).!C_RESET!
if not defined HAS_ROBOCOPY if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] Motivo: falta robocopy.exe en este equipo ^(no viene en Windows XP^).!C_RESET!
if not defined HAS_ROBOCOPY call :LOG_EVENT "Snapshots VMware NO preservados: robocopy.exe no esta disponible en este host. NO se sustituye por xcopy: no preserva ACL ni las tres marcas de tiempo. La cadena diferencial NO queda en la evidencia."
if defined HAS_ROBOCOPY call :LOG_EVENT "FALLO: no se copio ningun archivo de snapshots a !DEST!\Snapshots (origen: !SELECTED_VM_PATH!). La cadena diferencial NO queda preservada."
echo.
:VMW_SNAPPRES_DONE

:: Ofrecer conversión QEMU
:: En modo CALIENTE la lectura con qemu-img YA se ejecuto en :VMW_ACQ_HOT.
:: Volver a ofrecerla convertiria otra vez la misma imagen ya RAW: no aporta nada
:: y duplicaria la documentacion de la adquisicion en caliente.
if "!VMW_HOT!"=="1" goto VMW_SKIP_QEMU
if not exist "!QEMU_IMG!" goto VMW_SKIP_QEMU
set "vmw_qemu_ask="
if /i "!FORENSIC_LANG!"=="EN" set /p vmw_qemu_ask="!C_PROMPT!Convert the disk to forensic RAW/IMG format (QEMU)? [Y/N]: !C_RESET!"
if /i not "!FORENSIC_LANG!"=="EN" set /p vmw_qemu_ask="!C_PROMPT!¿Convertir el disco a formato RAW/IMG forense (QEMU)? [S/N]: !C_RESET!"
:: El prompt en ingles ofrece [Y/N]; se acepta Y como S.
if /i "!vmw_qemu_ask!"=="Y" set "vmw_qemu_ask=S"
if /I "!vmw_qemu_ask!"=="S" (
    call :QEMU_CONVERT "!vmdk_dest!" "!DEST!" "!vmdk_src_name!_forense"
)
:VMW_SKIP_QEMU
pause
if "!VMW_CHAIN_RECONSTRUCT!"=="1" if "!_vmw_base_ok!"=="1" (
    set "VMW_CHAIN_RECONSTRUCT="
    echo.
    if /i "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Original disk acquired. Now choose the specific snapshot!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Disco original adquirido. Ahora elija el snapshot específico!C_RESET!
    if /i "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] to rebuild as a second deliverable...!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] a reconstruir como segundo entregable...!C_RESET!
    set "VMW_RECON_SKIP_SELECT=1"
    goto VM_VMWARE_RECONSTRUCT
)
set "VMW_CHAIN_RECONSTRUCT="
goto MENU_VM_VMWARE

:VM_VMWARE_MEM
:: El volcado se obtiene COPIANDO los .vmem/.vmss/.vmsn: sin robocopy no hay
:: via valida, y suspender la VM sin poder copiar solo alteraria el origen.
if not defined HAS_ROBOCOPY call :ROBOCOPY_MISSING "VMware - volcado de memoria (.vmem/.vmss/.vmsn)"
if not defined HAS_ROBOCOPY goto MENU_VM_VMWARE
:: DEST se limpia al ENTRAR al modulo. :LOG_EVENT manda al diario GLOBAL de la
:: sesion todo evento producido sin DEST, pero si el operador ya uso otro modulo
:: en la misma sesion, DEST seguia apuntando a la evidencia ANTERIOR: los eventos
:: de este modulo previos a fijar su propio DEST -eleccion de motor, recuento de
:: snapshots, apagado de la VM, snapshot forense- quedaban escritos en el diario
:: de OTRO caso. Vaciarlo los manda al diario global, que es donde pertenecen
:: hasta que exista carpeta de evidencia propia.
set "DEST="
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] VMware Memory Extraction!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Extracción de Memoria de VMware!C_RESET!
call :SELECT_VMWARE_VM
if !errorlevel! neq 0 goto MENU_VM_VMWARE
set "vm_dir=!SELECTED_VM_PATH!"
set "vm_vmx=!SELECTED_VM_VMX!"

:ASK_VM_DEST
set "vm_dest="
if /i "!FORENSIC_LANG!"=="EN" set /p vm_dest="!C_PROMPT!Destination folder path [Enter = !DEFAULT_DEST!] (0=cancel): !C_RESET!"
if /i not "!FORENSIC_LANG!"=="EN" set /p vm_dest="!C_PROMPT!Ruta de la carpeta destino [Enter = !DEFAULT_DEST!] (0=cancelar): !C_RESET!"
if "!vm_dest!"=="0" goto MENU_VM_VMWARE
if defined vm_dest set "vm_dest=!vm_dest:"=!"
if not defined vm_dest (
    set "vm_dest=!DEFAULT_DEST!"
    if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Using default destination: !DEFAULT_DEST!!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Usando destino por defecto: !DEFAULT_DEST!!C_RESET!
)
call :VALIDATE_DEST_DIR "!vm_dest!"
if not "!_VD_OK!"=="1" goto ASK_VM_DEST

:: Obtener nombre de la VM para carpeta organizada
for %%F in ("!vm_dir!") do set "VMW_MEM_NAME=%%~nxF"
set "VMW_MEM_FOLDER=!VMW_MEM_NAME!"
set "VMW_MEM_FOLDER=!VMW_MEM_FOLDER:/=_!"
set "VMW_MEM_FOLDER=!VMW_MEM_FOLDER::=_!"
set "VMW_MEM_EVIDENCE=!vm_dest!\VMware\!VMW_MEM_FOLDER!"
set "DEST=!VMW_MEM_EVIDENCE!"
set "vm_dest=!VMW_MEM_EVIDENCE!\Memory"
if not exist "!vm_dest!" mkdir "!vm_dest!"

:: Capturar el instante ANTES de suspender (referencia UTC): permite luego
:: identificar el volcado "en vivo" por FECHA DE MODIFICACION, no por
:: diferencia de NOMBRES. NOTA IMPORTANTE: VMware puede REUTILIZAR el mismo
:: nombre de archivo .vmss/.vmem entre suspensiones sucesivas de la MISMA
:: VM (el sufijo hash del nombre es estable, verificado en pruebas reales)
:: - un archivo que YA EXISTIA y que VMware sobrescribe con contenido
:: fresco nunca aparece como "nuevo" en un diff por nombre, aunque sea
:: exactamente el volcado que se pidio. Comparar por fecha de modificacion
:: funciona igual en ambos casos (archivo nuevo o archivo reutilizado).
call :NEWGUID _VMWM_GUID
for /f "usebackq delims=" %%T in (`powershell -NoProfile -Command "(Get-Date).ToUniversalTime().ToString('o')"`) do set "_vmwm_cutoff=%%T"

call :RESOLVE_VMWARE
:: El aviso de herramientas ausentes se da AQUI tambien, no solo en la via de
:: disco: sin vmrun este modulo pierde el estado real de la VM y la suspension,
:: y el operador tenia que deducirlo de los sintomas. Solo imprime si falta algo.
call :VMWARE_TOOLS_REPORT
:: Este tramo estaba dentro de un if/else con parentesis y ahora es PLANO: se
:: introduce un set /p de autorizacion y los textos llevan parentesis, la
:: combinacion que cierra bloques antes de tiempo en cmd.exe.
set "VMWM_SUSPEND_OK=0"
set "VMWM_SUSPEND_TXT=NO ACREDITADO"
if not exist "!VMRUN_EXE!" goto VMWM_NO_VMRUN

:: Estado de la VM ANTES de tocar nada. Antes se ejecutaba "vmrun suspend"
:: INCONDICIONALMENTE y cualquier fallo se traducia a "la maquina ya estaba
:: suspendida o apagada", que es una atribucion de causa sin respaldo. Suspender
:: es intrusivo: si la VM ya esta suspendida o apagada NO hay que ejecutarlo, y si
:: esta encendida hay que pedir autorizacion. "vmrun list" reporta solo las
:: ENCENDIDAS, asi que no estar en la lista mas el candado de disco identifica una
:: VM ya suspendida, y la ausencia de las dos senales una VM apagada.
set "_vmwm_running=0"
for /f "skip=1 delims=" %%L in ('"!VMRUN_EXE!" list 2^>nul') do if /I "%%L"=="!vm_vmx!" set "_vmwm_running=1"
if "!_vmwm_running!"=="1" goto VMWM_ASK_SUSPEND
if exist "!vm_dir!\*.vmdk.lck" goto VMWM_ALREADY_SUSPENDED

set "VMWM_SUSPEND_TXT=APAGADA antes de esta actuacion - no se ejecuto vmrun suspend"
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] The VM is NOT powered on and holds no disk lock: it is POWERED OFF.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] La VM NO esta encendida y no retiene candado de disco: esta APAGADA.!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] Nothing is suspended: there is no live RAM to freeze. Any .vmss/.vmem!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] No se suspende nada: no hay RAM viva que congelar. Los .vmss/.vmem que!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] present belongs to an EARLIER, unknown state, not to this action.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] haya son de un estado ANTERIOR desconocido, no de esta actuacion.!C_RESET!
call :LOG_EVENT "Estado medido antes de actuar: la VM !vm_vmx! esta APAGADA (no aparece en 'vmrun list' y no hay candado .vmdk.lck). NO se ejecuto 'vmrun suspend': no se escribio nada en el origen. Cualquier .vmss/.vmem copiado corresponde a un estado ANTERIOR desconocido."
echo.
pause
goto VMWM_SUSPEND_DONE

:VMWM_ALREADY_SUSPENDED
:: Ya suspendida = el mejor escenario y CERO alteracion: no se ejecuta nada.
:: Valor 2 y no 1: "1" significa "esta actuacion la congelo" y el informe lo
:: redacta asi. Declarar 1 aqui afirmaria una escritura sobre el origen que no
:: existio.
set "VMWM_SUSPEND_OK=2"
set "VMWM_SUSPEND_TXT=ya estaba SUSPENDIDA antes de esta actuacion - no se ejecuto vmrun suspend y no se escribio nada en el origen"
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_OK![+] The VM is already SUSPENDED: its RAM is already dumped to .vmss/.vmem.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_OK![+] La VM ya esta SUSPENDIDA: su RAM ya esta volcada en .vmss/.vmem.!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_OK![+] "vmrun suspend" is NOT run: nothing is written to the source folder.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_OK![+] NO se ejecuta "vmrun suspend": no se escribe nada en la carpeta de origen.!C_RESET!
call :LOG_EVENT "Estado medido antes de actuar: la VM !vm_vmx! ya estaba SUSPENDIDA (no aparece en 'vmrun list' y mantiene candado .vmdk.lck). NO se ejecuto 'vmrun suspend': cero alteracion del origen. El .vmss/.vmem corresponde al instante de esa suspension previa, no a esta actuacion."
goto VMWM_SUSPEND_DONE

:VMWM_ASK_SUSPEND
:: Suspender es una alteracion MAYOR e irreversible del estado volatil del sujeto
:: y ESCRIBE archivos nuevos (.vmss/.vmem) DENTRO de la carpeta de la evidencia.
:: Antes se anunciaba y se ejecutaba sin pedir nada, mientras el metodo analogo de
:: Hyper-V (HVM_METHOD_SAVE) si pedia [S/N]. ISO/IEC 27037 5.4.3 y 6.8: autorizada,
:: justificada y registrada.
echo.
echo !C_BORDER!!SUBLINE!!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Without freezing, the RAM keeps changing.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Sin congelar, la RAM sigue cambiando.!C_RESET!
echo !C_BORDER!!SUBLINE!!C_RESET!
set "_vmr_auth="
if /i "!FORENSIC_LANG!"=="EN" set /p _vmr_auth="!C_PROMPT!Do you authorize the suspension? [Y/N]: !C_RESET!"
if /i not "!FORENSIC_LANG!"=="EN" set /p _vmr_auth="!C_PROMPT!¿Autoriza la suspensión? [S/N]: !C_RESET!"
:: El prompt en ingles ofrece [Y/N]; se acepta Y como S.
if /i "!_vmr_auth!"=="Y" set "_vmr_auth=S"
if /I not "!_vmr_auth!"=="S" goto VMWM_SUSPEND_DENIED

echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Suspending the Virtual Machine via vmrun...!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Suspendiendo la Máquina Virtual mediante vmrun...!C_RESET!
call :UTCNOW _VMR_TS1
"!VMRUN_EXE!" suspend "!vm_vmx!" >nul 2>&1
set "_vmr_el=!errorLevel!"
call :UTCNOW _VMR_TS2
call :TOOL_VER_ONCE TOOLVER_VMRUN "!VMRUN_EXE!" ""
call :LOG_CMD "VMware_Suspend" "vmrun suspend ""!vm_vmx!""" "!_vmr_el!" "!_VMR_TS1!" "!_VMR_TS2!" "" "" "!TOOLVER_VMRUN!"
if not "!_vmr_el!"=="0" goto VMWM_SUSPEND_FAILED
set "VMWM_SUSPEND_OK=1"
set "VMWM_SUSPEND_TXT=SUSPENDIDA por esta actuacion (vmrun suspend, codigo 0)"
if /i "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Virtual machine suspended successfully.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Máquina virtual suspendida correctamente.!C_RESET!
call :LOG_EVENT "ESCRITURA SOBRE EL ORIGEN, autorizada por el operador y justificada: 'vmrun suspend' congelo la VM !vm_vmx! y VMware escribio o sobreescribio .vmss/.vmem en el directorio de la maquina de origen. Motivo: sin congelar, la RAM muta durante la lectura y el volcado sale difuminado."
goto VMWM_SUSPEND_DONE

:VMWM_SUSPEND_FAILED
:: NO se puede afirmar la causa. vmrun falla por muchas razones distintas de "ya
:: estaba suspendida": ruta .vmx invalida, VMware mal instalado, permisos, VM
:: ocupada. Y antes esta rama no llamaba a :LOG_EVENT, asi que un suspend fallido
:: no dejaba ningun rastro en el diario.
set "VMWM_SUSPEND_TXT=vmrun suspend devolvio codigo !_vmr_el! - estado de la VM NO acreditado"
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![-] vmrun suspend returned code !_vmr_el!. The cause CANNOT be asserted!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![-] vmrun suspend devolvió código !_vmr_el!. NO se puede afirmar la causa!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![-] ^(already suspended/off, bad .vmx path, permissions, busy VM...^).!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![-] ^(ya suspendida/apagada, ruta .vmx inválida, permisos, VM ocupada...^).!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] The VM MAY STILL BE RUNNING: any RAM copied is NOT a dump of this!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] La VM PUEDE seguir corriendo: la RAM que se copie NO es un volcado!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] instant. Check the state in VMware before continuing.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] de este instante. Verifique el estado en VMware antes de continuar.!C_RESET!
call :LOG_EVENT "ADVERTENCIA: 'vmrun suspend' devolvio !_vmr_el! sobre !vm_vmx!. NO se puede atribuir la causa y el estado de la VM NO queda acreditado. Si la VM sigue en ejecucion, cualquier .vmss/.vmem que se copie corresponde a un estado ANTERIOR desconocido y NO al volcado de esta actuacion."
echo.
pause
goto VMWM_SUSPEND_DONE

:VMWM_SUSPEND_DENIED
set "VMWM_SUSPEND_TXT=suspension NO autorizada por el operador - la VM no se congelo"
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] Suspension not authorised. The VM was NOT frozen: if it is running,!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] Suspensión no autorizada. La VM NO se congeló: si está en ejecución,!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] any .vmss/.vmem present belongs to an earlier unknown state.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] los .vmss/.vmem presentes son de un estado anterior desconocido.!C_RESET!
call :LOG_EVENT "El operador NO autorizo suspender !vm_vmx!. No se escribio nada en el origen por esta via. Cualquier .vmss/.vmem que se copie a continuacion corresponde a un estado ANTERIOR desconocido y NO a un volcado de esta actuacion."
echo.
pause
goto VMWM_SUSPEND_DONE

:VMWM_NO_VMRUN
set "VMWM_SUSPEND_TXT=sin vmrun.exe - suspension manual a cargo del operador"
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![CAUTION] CRITICAL WARNING FOR FORENSIC INTEGRITY [CAUTION]!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![ATENCIÓN] ADVERTENCIA CRÍTICA PARA LA INTEGRIDAD FORENSE [ATENCIÓN]!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT!For the .vmem file to contain the exact memory state and not be locked,!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT!Para que el archivo .vmem contenga el estado exacto de la memoria y no este bloqueado,!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT!the Virtual Machine MUST BE SUSPENDED in VMware before continuing.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT!la Máquina Virtual DEBE ESTAR SUSPENDIDA en VMware antes de continuar.!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT!If the VM is running, suspend the system right now.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT!Si la VM esta en ejecución, suspenda el sistema ahora mismo.!C_RESET!
call :LOG_EVENT "vmrun.exe no disponible: la suspension de !vm_vmx! queda a cargo del operador y el framework NO puede acreditar el estado de la VM."
echo.
pause

:VMWM_SUSPEND_DONE

:: Consultar vía PowerShell cuales .vmem/.vmss fueron MODIFICADOS desde el
:: instante de referencia capturado antes de suspender. Robusto ante los
:: dos casos posibles: VMware crea un archivo nuevo, O sobrescribe uno ya
:: existente con el mismo nombre (ambos actualizan LastWriteTime).
call :NEWGUID _vmwm_ps_guid
set "_vmwm_ps=!TEMP!\forensic_mem_modified_!_vmwm_ps_guid!.ps1"
:: El modificador -File de Get-ChildItem es de PowerShell 3.0 en adelante. En el
:: PowerShell 2.0 de fabrica de Windows 7 la orden falla, la lista sale VACIA y la
:: adquisicion de RAM de VMware no copiaba NADA sin decir por que. Se filtra por
:: PSIsContainer, que es la forma de 2.0 y sigue siendo valida en 5.1.
(
echo $dir = '!vm_dir:'=''!'
echo $cutoff = [datetime]::Parse^('!_vmwm_cutoff!'^).ToUniversalTime^(^)
echo Get-ChildItem -Path ^(Join-Path $dir '*'^) -Include *.vmem,*.vmss -ErrorAction SilentlyContinue ^| Where-Object { -not $_.PSIsContainer -and $_.LastWriteTimeUtc -ge $cutoff } ^| Select-Object -ExpandProperty Name
) > "!_vmwm_ps!"

set "VMWM_LIVE_LIST="
for /f "usebackq delims=" %%F in (`powershell -NoProfile -ExecutionPolicy Bypass -File "!_vmwm_ps!"`) do set "VMWM_LIVE_LIST=!VMWM_LIVE_LIST! "%%F""

:: "vmrun suspend" retorna en cuanto se INICIA la suspension, no cuando
:: VMware termina de volcar toda la RAM a disco: el .vmss ^(estado del
:: dispositivo^) puede quedar escrito ^(fecha actualizada^) antes que el
:: .vmem ^(volcado de RAM^) termine de escribirse. Si la consulta de arriba
:: encontro un .vmss modificado pero su .vmem companero AUN no aparece
:: como modificado, es esa condicion de carrera -no que no vaya a existir-.
:: Se detecta con una variable simple ^(sin bucle anidado dentro de
:: parentesis^) y se espera activamente, reconsultando por fecha cada vez.
set "_vmwm_pending_vmem="
:: PRIMERO se comprueba si ya hay ALGUN .vmem modificado, sin mirar el nombre.
:: El emparejamiento .vmss<->.vmem por nombre base falla en un caso real y comun:
:: el archivo de paginacion de una VM en marcha se llama por el UUID de la VM
:: (verificado en esta maquina: "564dee74-....vmem" junto a "<nombre>.vmss"), de
:: modo que el companero "por nombre" no existe nunca y el flujo se comia 120
:: segundos de espera para acabar afirmando que "solo se copiara el .vmss, SIN la
:: RAM" cuando el .vmem SI estaba en la lista y SI se copiaba. Si ya hay un .vmem
:: no hay nada que esperar.
set "_vmwm_anyvmem=0"
for %%V in (!VMWM_LIVE_LIST!) do (
    set "_vmwm_nf0=%%~V"
    if /I "!_vmwm_nf0:~-5!"==".vmem" set "_vmwm_anyvmem=1"
)
if "!_vmwm_anyvmem!"=="1" goto VMWM_PAIR_DONE
for %%V in (!VMWM_LIVE_LIST!) do (
    set "_vmwm_nf=%%~V"
    if /I "!_vmwm_nf:~-5!"==".vmss" (
        for %%X in ("!_vmwm_nf!") do set "_vmwm_nfbase=%%~nX"
        echo !VMWM_LIVE_LIST!| findstr /I /C:"!_vmwm_nfbase!.vmem" >nul
        if !errorlevel! neq 0 set "_vmwm_pending_vmem=!_vmwm_nfbase!"
    )
)
:VMWM_PAIR_DONE
if defined _vmwm_pending_vmem (
    echo.
    if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Waiting for VMware to finish writing !_vmwm_pending_vmem!.vmem...!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Esperando a que VMware termine de escribir !_vmwm_pending_vmem!.vmem...!C_RESET!
    if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT!    ^(vmrun returns when the suspend STARTS, not when the RAM dump finishes^).!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT!    ^(vmrun retorna al INICIAR la suspension, no al terminar de volcar la RAM^).!C_RESET!
)
:: NOTA: aquí se verifica EXISTENCIA simple del .vmem, no fecha de
:: modificacion. Ya sabemos con certeza que estamos a mitad de suspender
:: la VM en ESTA misma sesión (se acaba de detectar su .vmss companero
:: recien modificado) - en este contexto específico, que el .vmem aparezca
:: durante esta espera activa ya es una señal suficientemente confiable,
:: sin depender de comparar LastWriteTimeUtc (que en la práctica resulto
:: no reflejar con fiabilidad el instante real de escritura de VMware -
:: el .vmem verificadamente EXISTIA pero la comparacion por fecha no lo
:: detectaba).
:: NOTA CRÍTICA: limpiar explicitamente _vmwm_vmem_found aquí - si no se
:: reinicia, un valor "1" que haya quedado de una invocacion ANTERIOR de
:: este mismo flujo (el operador volviendo a usar esta opción del menu
:: para otra VM en la misma sesión del script) se leeria como "encontrado"
:: sin haberlo verificado en ESTA corrida, marcando como exitosa una
:: espera que en realidad fallo (bug real detectado en auditoría).
set "_vmwm_vmem_found="
set "_vmwm_vmem_wait=0"
:VMWM_WAIT_VMEM_LOOP
if not defined _vmwm_pending_vmem goto VMWM_WAIT_VMEM_DONE
if exist "!vm_dir!\!_vmwm_pending_vmem!.vmem" (
    set "_vmwm_vmem_found=1"
    goto VMWM_WAIT_VMEM_DONE
)
call :WAIT 2
set /a _vmwm_vmem_wait+=2
if !_vmwm_vmem_wait! lss 120 goto VMWM_WAIT_VMEM_LOOP
:VMWM_WAIT_VMEM_DONE
if defined _vmwm_pending_vmem (
    if defined _vmwm_vmem_found (
        set "VMWM_LIVE_LIST=!VMWM_LIVE_LIST! "!_vmwm_pending_vmem!.vmem""
        if /i "!FORENSIC_LANG!"=="EN" echo !C_OK![+] !_vmwm_pending_vmem!.vmem detected, it will be included in the copy.!C_RESET!
        if /i not "!FORENSIC_LANG!"=="EN" echo !C_OK![+] !_vmwm_pending_vmem!.vmem detectado, se incluira en la copia.!C_RESET!
        call :LOG_EVENT "Volcado .vmem detectado tras espera de escritura: !vm_dir!\!_vmwm_pending_vmem!.vmem"
    ) else (
        if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![-] !_vmwm_pending_vmem!.vmem did not appear after 120s of waiting.!C_RESET!
        if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![-] !_vmwm_pending_vmem!.vmem no aparecio tras 120s de espera.!C_RESET!
        if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![-] The VM may not produce a full RAM dump ^(e.g. memory not!C_RESET!
        if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![-] Puede que la VM no genere volcado de RAM completo ^(ej. memoria no!C_RESET!
        if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![-] reserved, or VMware Tools/host under load^). No modified .vmem was!C_RESET!
        if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![-] reservada, o VMware Tools/host bajo carga^). NO se detecto ningun .vmem!C_RESET!
        if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![-] detected under ANY name, so what is copied is the .vmss ^(device state,!C_RESET!
        if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![-] modificado con NINGUN nombre, asi que lo que se copia es el .vmss!C_RESET!
        if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![-] WITHOUT the RAM^). Check the VM folder manually before concluding.!C_RESET!
        if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![-] ^(estado del dispositivo, SIN la RAM^). Revise la carpeta manualmente.!C_RESET!
        call :LOG_EVENT "Advertencia: .vmem no aparecio tras 120s de espera - !vm_dir!\!_vmwm_pending_vmem!.vmss"
    )
)
del "!_vmwm_ps!" >nul 2>&1

:: Si nada aparecio como MODIFICADO desde la referencia (la VM ya estaba
:: suspendida antes de entrar aquí, así que "vmrun suspend" no toco nada),
:: se aisla el volcado "en vivo" existente por DESCARTE: cualquier
:: .vmss/.vmem cuyo nombre base NO este referenciado por un snapshot con
:: nombre en el diccionario oficial .vmsd es, por eliminacion, el estado
:: independiente (no un snapshot). Los .vmsn se excluyen siempre de este
:: descarte: por definicion SIEMPRE son artefactos de un snapshot con nombre.
if not defined VMWM_LIVE_LIST (
    echo.
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] No modified files detected on suspend ^(the VM was already!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] No se detectaron archivos modificados al suspender ^(la VM ya estaba!C_RESET!
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] suspended^). Isolating the existing "live" dump by elimination!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] suspendida^). Aislando el volcado "en vivo" existente por descarte!C_RESET!
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] from those belonging to named snapshots ^(.vmsd^)...!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] de los que pertenecen a snapshots con nombre ^(.vmsd^)...!C_RESET!
    for %%F in ("!vm_vmx!") do set "_vmwm_vmsd=%%~dpnF.vmsd"
    set "_vmwm_exclude=!TEMP!\forensic_mem_exclude_!_VMWM_GUID!.tmp"
    type nul > "!_vmwm_exclude!"
    if exist "!_vmwm_vmsd!" (
        for /f "usebackq tokens=1,* delims==" %%K in ("!_vmwm_vmsd!") do (
            set "_vmwm_key=%%K"
            set "_vmwm_keyt=!_vmwm_key: =!"
            rem NOTA: el ancla "$" de fin-de-linea de findstr /R falla cuando
            rem la entrada llega por pipe desde "echo" (verificado con
            rem reproduccion aislada) - se omite; el prefijo "^snapshot
            rem N.filename" ya identifica la clave sin ambiguedad, no existe
            rem otra clave en el formato .vmsd que comparta ese prefijo.
            echo !_vmwm_keyt!| findstr /R /I /C:"^snapshot[0-9]*\.filename" >nul
            if !errorlevel! equ 0 (
                set "_vmwm_val=%%L"
                if "!_vmwm_val:~0,1!"==" " set "_vmwm_val=!_vmwm_val:~1!"
                set "_vmwm_val=!_vmwm_val:"=!"
                for %%X in ("!_vmwm_val!") do >>"!_vmwm_exclude!" echo %%~nX
            )
        )
    )
    for %%E in (vmss vmem) do (
        for %%F in ("!vm_dir!\*.%%E") do (
            set "_vmwm_skip=0"
            findstr /X /I /C:"%%~nF" "!_vmwm_exclude!" >nul 2>&1
            if !errorlevel! equ 0 set "_vmwm_skip=1"
            if "!_vmwm_skip!"=="0" set "VMWM_LIVE_LIST=!VMWM_LIVE_LIST! "%%~nxF""
        )
    )
    del "!_vmwm_exclude!" >nul 2>&1
)

set "VMWM_COPY_ALL=0"
if not defined VMWM_LIVE_LIST (
    echo.
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Could not isolate a distinguishable "live" memory dump.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] No se pudo aislar un volcado de memoria "en vivo" distinguible.!C_RESET!
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] ALL memory files found will be copied ^(including!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] Se copiaran TODOS los archivos de memoria encontrados ^(incluyendo!C_RESET!
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] those of earlier snapshots^): review manually which one corresponds!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] los de snapshots anteriores^): revise manualmente cual corresponde!C_RESET!
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] to the state you need.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] al estado que necesita.!C_RESET!
    set "VMWM_COPY_ALL=1"
)

echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Copying memory files...!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Copiando archivos de memoria...!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] Memory files (.vmem) are the same size as the RAM assigned to the VM.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] Los archivos de memoria (.vmem) son del mismo tamaño que la RAM asignada a la VM.!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] This will take time. 'robocopy' will be used to show real-time progress.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] Esto tomara tiempo. Se usara 'robocopy' para mostrar progreso en tiempo real.!C_RESET!
call :LOG_EVENT "Iniciando extraccion de memoria VMware desde !vm_dir! hacia !vm_dest! (modo=!VMWM_COPY_ALL!)"

set "found_mem=0"
set "_vmem_abort=0"
if "!VMWM_COPY_ALL!"=="1" (
    for %%E in (vmem vmss vmsn) do call :VMW_COPY_MEM_EXT %%E
) else (
    call :VMW_COPY_MEM_LIST
)

if "!_vmem_abort!"=="1" (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![ABORT] Memory copy aborted by the user.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![ABORT] Copia de memoria abortada por el usuario.!C_RESET!
    call :LOG_EVENT "Copia de memoria VMware abortada por el usuario (CTRL+C)."
    pause
    goto MENU_VM_VMWARE
)
if "!found_mem!"=="1" goto FOUND_MEM_FILES

if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![-] No memory files (.vmem, .vmss, .vmsn) were found in the folder.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![-] No se encontraron archivos de memoria (.vmem, .vmss, .vmsn) en la carpeta.!C_RESET!
call :LOG_EVENT "Advertencia: No se encontraron archivos de memoria en la ruta origen."
pause
goto MENU_VM_VMWARE

:FOUND_MEM_FILES
:: "Extraccion completada exitosamente" era una afirmacion sin respaldo: no se
:: validaba NADA del .vmem. Sin comparar con memSize del .vmx no se puede sostener
:: que el .vmem sea la RAM completa del invitado, porque un volcado truncado tiene
:: exactamente el mismo aspecto que uno completo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Memory files copied to the evidence folder.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Archivos de memoria copiados a la carpeta de evidencia.!C_RESET!
echo.
call :VMWM_VALIDATE_AND_REPORT
echo.

:: Verificación de integridad OPCIONAL (decisión del operador)
:: La memoria se copia a !DEST!\Memory, no a !DEST!: apuntar el hash a la
:: carpeta padre con profundidad 0 no encontraba ningun archivo y la evidencia
:: quedaba sin huella. Comprobado: el mismo patron sobre \Memory si la calcula.
call :HASH_EVIDENCE FOLDER "!DEST!\Memory" "*.vmem,*.vmss,*.vmsn" "!DEST!\Memoria_VM_Hashes.txt" "VMware_Memoria"
if /i "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Process fully completed.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Proceso terminado por completo.!C_RESET!
if exist "!VMRUN_EXE!" (
    echo.
    rem Reanudar NO es una accion neutra y el prompt no lo decia: al arrancar,
    rem VMware consume y BORRA el .vmss y vuelve a escribir en el disco. La fuente
    rem de memoria original desaparece en ese momento. Se advierte ANTES.
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] Resuming DESTROYS the suspended state: VMware consumes and deletes the!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] Reanudar DESTRUYE el estado suspendido: VMware consume y borra el .vmss!C_RESET!
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] .vmss and starts writing to the disk again. The original memory source!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] y vuelve a escribir en el disco. La fuente de memoria original deja de!C_RESET!
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] stops existing.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] existir.!C_RESET!
    set "resume_vm="
    if /i "!FORENSIC_LANG!"=="EN" set /p resume_vm="!C_PROMPT!Resume the virtual machine now? [Y/N]: !C_RESET!"
    if /i not "!FORENSIC_LANG!"=="EN" set /p resume_vm="!C_PROMPT!¿Reanudar la máquina virtual ahora? [S/N]: !C_RESET!"
    rem El prompt en ingles ofrece [Y/N]; se acepta Y como S.
    if /i "!resume_vm!"=="Y" set "resume_vm=S"
    if /I "!resume_vm!"=="S" (
        if /i "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Resuming the virtual machine...!C_RESET!
        if /i not "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Reanudando la máquina virtual...!C_RESET!
        call :UTCNOW _VMRS_TS1
        "!VMRUN_EXE!" start "!vm_vmx!" >nul 2>&1
        set "_vmrs_el=!errorlevel!"
        call :UTCNOW _VMRS_TS2
        if /i "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Virtual machine started.!C_RESET!
        if /i not "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Máquina virtual iniciada.!C_RESET!
        call :LOG_EVENT "VM reanudada via vmrun por decision del operador: !vm_vmx!. ALTERACION DEL ORIGEN: al reanudar, VMware consume y elimina el .vmss y el invitado vuelve a escribir en el disco. La fuente de memoria original deja de existir a partir de este instante; lo unico que queda es la copia preservada en la evidencia."
        call :TOOL_VER_ONCE TOOLVER_VMRUN "!VMRUN_EXE!" ""
        call :LOG_CMD "VMware_Resume" "vmrun start ""!vm_vmx!""" "!_vmrs_el!" "!_VMRS_TS1!" "!_VMRS_TS2!" "" "" "!TOOLVER_VMRUN!"
    )
)
pause
goto MENU_VM_VMWARE

:: ---------------------------------------------------------------------------
:: VMWM_VALIDATE_AND_REPORT - Valida la completitud del volcado VMware y emite el
:: informe del modulo. Este camino no producia NINGUN informe: ni estado de la VM,
:: ni si el suspend tuvo exito, ni cual archivo es RAM y cual estado de dispositivo,
:: ni memSize declarado frente a tamano real. Modelado sobre el informe del modulo
:: en caliente, que ya es el patron correcto.
:: Subrutina PLANA por los parentesis de los textos.
:: ---------------------------------------------------------------------------
:VMWM_VALIDATE_AND_REPORT
set "_vmwm_rep=!DEST!\Memoria_VM_informe.txt"
call :UTCNOW _vmwm_rts
:: memsize del .vmx viene en MEBIBYTES y entre comillas: memsize = "2048"
set "_vmwm_memmb="
for /f "usebackq tokens=2 delims==" %%A in (`findstr /I /B /C:"memsize" "!vm_vmx!"`) do set "_vmwm_memmb=%%A"
if defined _vmwm_memmb set "_vmwm_memmb=!_vmwm_memmb: =!"
if defined _vmwm_memmb set "_vmwm_memmb=!_vmwm_memmb:"=!"
>"!_vmwm_rep!" echo ===========================================================================
>>"!_vmwm_rep!" echo  INFORME DE ADQUISICION DE MEMORIA - VMware
>>"!_vmwm_rep!" echo ===========================================================================
>>"!_vmwm_rep!" echo Generado UTC        : !_vmwm_rts!
>>"!_vmwm_rep!" echo Host               : !COMPUTERNAME!    Operador: !USERNAME!
>>"!_vmwm_rep!" echo Maquina de origen  : !vm_vmx!
>>"!_vmwm_rep!" echo Directorio origen  : !vm_dir!
>>"!_vmwm_rep!" echo Destino            : !vm_dest!
>>"!_vmwm_rep!" echo.
>>"!_vmwm_rep!" echo --- ESTADO DE LA VM Y ALTERACION DEL ORIGEN ---
>>"!_vmwm_rep!" echo   Estado: !VMWM_SUSPEND_TXT!
:: Se ramifica con etiquetas y no con "if COND >>archivo echo": la redireccion en
:: una linea condicional se prepara aunque la condicion sea falsa, y mezclarla con
:: textos que llevan parentesis es justo la clase de linea fragil de este proyecto.
if "!VMWM_SUSPEND_OK!"=="2" goto VMWM_REP_PRESUSP
if "!VMWM_SUSPEND_OK!"=="1" goto VMWM_REP_FROZEN
>>"!_vmwm_rep!" echo   ADVERTENCIA: la VM NO quedo congelada por esta actuacion. Si estaba en
>>"!_vmwm_rep!" echo   ejecucion, los .vmss/.vmem copiados corresponden a un estado ANTERIOR
>>"!_vmwm_rep!" echo   DESCONOCIDO y NO a un volcado del instante de esta actuacion.
goto VMWM_REP_MEM
:VMWM_REP_PRESUSP
>>"!_vmwm_rep!" echo   La VM ya estaba SUSPENDIDA al iniciar esta actuacion: se comprobo con
>>"!_vmwm_rep!" echo   'vmrun list' (no figuraba entre las encendidas) y con el candado .vmdk.lck
>>"!_vmwm_rep!" echo   (presente). NO se ejecuto 'vmrun suspend' y NO se escribio nada en el
>>"!_vmwm_rep!" echo   directorio de origen: la alteracion del sujeto por esta actuacion es NULA.
>>"!_vmwm_rep!" echo   El .vmss/.vmem preservado corresponde al instante de esa suspension PREVIA,
>>"!_vmwm_rep!" echo   no a un volcado tomado ahora. Ese instante no lo fija este framework.
goto VMWM_REP_MEM
:VMWM_REP_FROZEN
>>"!_vmwm_rep!" echo   'vmrun suspend' se ejecuto con autorizacion expresa del operador y VMware
>>"!_vmwm_rep!" echo   escribio o sobreescribio .vmss y .vmem DENTRO del directorio de origen. Esa
>>"!_vmwm_rep!" echo   escritura es la contrapartida deliberada de congelar la RAM y PERSISTE.
:VMWM_REP_MEM
>>"!_vmwm_rep!" echo.
>>"!_vmwm_rep!" echo --- COMPLETITUD DEL VOLCADO ---
if defined _vmwm_memmb goto VMWM_REP_MEMOK
>>"!_vmwm_rep!" echo   memSize NO se pudo leer del .vmx: la completitud NO queda contrastada.
goto VMWM_REP_SIZES
:VMWM_REP_MEMOK
>>"!_vmwm_rep!" echo   memSize declarado en el .vmx: !_vmwm_memmb! MiB de RAM asignada al invitado.
:VMWM_REP_SIZES
>>"!_vmwm_rep!" echo   Tamanos reales de los archivos copiados (bytes):
for %%F in ("!vm_dest!\*.vmem") do >>"!_vmwm_rep!" echo     [RAM]    %%~nxF = %%~zF
for %%F in ("!vm_dest!\*.vmss") do >>"!_vmwm_rep!" echo     [ESTADO] %%~nxF = %%~zF
for %%F in ("!vm_dest!\*.vmsn") do >>"!_vmwm_rep!" echo     [ESTADO] %%~nxF = %%~zF
>>"!_vmwm_rep!" echo.
>>"!_vmwm_rep!" echo   Un .vmem cuyo tamano sea sensiblemente menor que memSize esta TRUNCADO. El
>>"!_vmwm_rep!" echo   framework registra las cifras y NO concluye por el analista: la comparacion
>>"!_vmwm_rep!" echo   memSize frente a tamano real debe hacerse antes de dar el volcado por bueno.
>>"!_vmwm_rep!" echo.
>>"!_vmwm_rep!" echo --- QUE CONTIENE CADA ARCHIVO ---
>>"!_vmwm_rep!" echo   .vmem : volcado de la RAM del invitado. Es el artefacto de memoria.
>>"!_vmwm_rep!" echo   .vmss : estado de los DISPOSITIVOS de la VM. NO contiene la RAM.
>>"!_vmwm_rep!" echo   .vmsn : estado de snapshot. NO contiene la RAM por si mismo.
>>"!_vmwm_rep!" echo   Presentar un .vmss o un .vmsn como volcado de memoria seria un error de
>>"!_vmwm_rep!" echo   atribucion: solo el .vmem lo es.
>>"!_vmwm_rep!" echo.
>>"!_vmwm_rep!" echo --- LIMITACIONES DECLARADAS ---
>>"!_vmwm_rep!" echo   1. El hash de estos archivos se calcula sobre la COPIA ya producida. No
>>"!_vmwm_rep!" echo      acredita coincidencia con el original mas alla de esta copia.
>>"!_vmwm_rep!" echo   2. La adquisicion depende de VMware: es VMware quien materializa la RAM en
>>"!_vmwm_rep!" echo      disco. La integridad de esa escritura es una dependencia del metodo.
>>"!_vmwm_rep!" echo   3. Referencias: ISO/IEC 27037 5.4.3, 6.8 y 6.9; ISO/IEC 27041 7;
>>"!_vmwm_rep!" echo      ISO/IEC 27042 7.2; NIST SP 800-86 3.1.1 y 4.3; ACPO principios 2 y 3.
>>"!_vmwm_rep!" echo ===========================================================================
if /i "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Module report written: !_vmwm_rep!!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Informe del módulo escrito: !_vmwm_rep!!C_RESET!
call :LOG_EVENT "Informe de adquisicion de memoria VMware emitido: !_vmwm_rep!. memSize declarado en el .vmx: !_vmwm_memmb! MiB. Estado de la VM: !VMWM_SUSPEND_TXT!. La comparacion memSize frente a tamano real del .vmem queda documentada en el informe, no concluida por el framework."
exit /b 0

:VMW_COPY_MEM_EXT
:: %1 = extensión (vmem/vmss/vmsn). Copia vía :ACQUIRE (CTRL+C cancelable).
:: Robocopy 0-7 = exito; se mapea a 0/1 dentro del comando para el wrapper.
if "!_vmem_abort!"=="1" exit /b
if not exist "!vm_dir!\*.%1" exit /b
if /i "!FORENSIC_LANG!"=="EN" echo [+] Copying .%1 files...
if /i not "!FORENSIC_LANG!"=="EN" echo [+] Copiando archivos .%1...
call :NEWGUID ACQ_GUID
set "ACQ_CMD=!TEMP!\forensic_cmd_!ACQ_GUID!.tmp"
>"!ACQ_CMD!" echo robocopy "!vm_dir!" "!vm_dest!" *.%1 !RBC_J! /R:1 /W:1 /NJH /NJS /NDL /NC /NS ^& if errorlevel 8 (exit 1) else (exit 0)
set "ACQ_TOOL_VER=robocopy in-box de !WIN_NAME! build !WIN_BUILD! - no publica version propia: su identidad es la build del SO"
call :ACQUIRE "VMware_CopiaMemoria" "!ACQ_CMD!"
set "_vmrcpy_el=!errorlevel!"
if "!_vmrcpy_el!"=="2" set "_vmem_abort=1"
if not "!_vmrcpy_el!"=="0" exit /b
:: robocopy devuelve 0 cuando NO copio NADA (sin fallo), y el mapeo del comando
:: convierte 0-7 en exito, asi que found_mem=1 no distinguia "se copio algo" de
:: "no habia nada que copiar" - y de ahi salia "Extraccion completada
:: exitosamente". Se comprueba el DESTINO, que es el hecho, no el codigo.
if not exist "!vm_dest!\*.%1" goto VMWCME_EMPTY
set "found_mem=1"
call :LOG_EVENT "Copiados archivos .%1 al destino !vm_dest!."
exit /b
:VMWCME_EMPTY
call :LOG_EVENT "ADVERTENCIA: robocopy devolvio exito pero no hay ningun archivo .%1 en el destino !vm_dest!. No se copio nada, asi que no se cuenta como memoria obtenida."
exit /b

:VMW_COPY_MEM_LIST
:: Copia SOLO los archivos listados en !VMWM_LIVE_LIST! (nombres entre
:: comillas, separados por espacio - el volcado "en vivo" ya aislado por el
:: llamador, sin arrastrar volcados de snapshots anteriores). Vía :ACQUIRE
:: (CTRL+C cancelable), igual que VMW_COPY_MEM_EXT.
if "!_vmem_abort!"=="1" exit /b
if not defined VMWM_LIVE_LIST exit /b
if /i "!FORENSIC_LANG!"=="EN" echo [+] Copying "live" memory dump: !VMWM_LIVE_LIST!
if /i not "!FORENSIC_LANG!"=="EN" echo [+] Copiando volcado de memoria "en vivo": !VMWM_LIVE_LIST!
call :NEWGUID ACQ_GUID
set "ACQ_CMD=!TEMP!\forensic_cmd_!ACQ_GUID!.tmp"
>"!ACQ_CMD!" echo robocopy "!vm_dir!" "!vm_dest!" !VMWM_LIVE_LIST! !RBC_J! /R:1 /W:1 /NJH /NJS /NDL /NC /NS ^& if errorlevel 8 (exit 1) else (exit 0)
set "ACQ_TOOL_VER=robocopy in-box de !WIN_NAME! build !WIN_BUILD! - no publica version propia: su identidad es la build del SO"
call :ACQUIRE "VMware_CopiaMemoria" "!ACQ_CMD!"
set "_vmrcpy_el=!errorlevel!"
if "!_vmrcpy_el!"=="2" set "_vmem_abort=1"
if not "!_vmrcpy_el!"=="0" exit /b
:: Mismo criterio que en VMW_COPY_MEM_EXT: robocopy 0 puede significar "nada
:: copiado". Se comprueba que al menos uno de los archivos listados llego.
set "_vmwcl_got=0"
for %%V in (!VMWM_LIVE_LIST!) do if exist "!vm_dest!\%%~V" set "_vmwcl_got=1"
if "!_vmwcl_got!"=="0" goto VMWCML_EMPTY
set "found_mem=1"
set "_vmwm_lst=!VMWM_LIVE_LIST:"=!"
call :LOG_EVENT "Copiado volcado de memoria en vivo al destino !vm_dest!: !_vmwm_lst!"
exit /b
:VMWCML_EMPTY
set "_vmwm_lst=!VMWM_LIVE_LIST:"=!"
call :LOG_EVENT "ADVERTENCIA: robocopy devolvio exito pero ninguno de los archivos !_vmwm_lst! aparece en el destino !vm_dest!. No se copio nada, asi que no se cuenta como memoria obtenida."
exit /b

:: =====================================================
:: VMWARE - RECONSTRUIR SNAPSHOT COMO DISCO COMPLETO
:: Genera un VMDK NUEVO que representa el estado consolidado de la VM en
:: el momento de un snapshot específico (disco base + cadena de deltas
:: hasta ese punto), usando vmware-vdiskmanager -r sobre una COPIA de
:: trabajo. La evidencia original NUNCA se toca: se opera siempre sobre
:: la copia, y el resultado se documenta como evidencia DERIVADA con su
:: propio hash, vinculado al hash de los archivos originales.
:: =====================================================
:VM_VMWARE_RECONSTRUCT
:: El primer paso es copiar la cadena completa de discos a un area de trabajo:
:: sin esa copia nunca se opera sobre el original, asi que no hay via valida.
if not defined HAS_ROBOCOPY call :ROBOCOPY_MISSING "VMware - reconstruccion de snapshots"
if not defined HAS_ROBOCOPY goto MENU_VM_VMWARE
:: DEST se limpia al ENTRAR al modulo. :LOG_EVENT manda al diario GLOBAL de la
:: sesion todo evento producido sin DEST, pero si el operador ya uso otro modulo
:: en la misma sesion, DEST seguia apuntando a la evidencia ANTERIOR: los eventos
:: de este modulo previos a fijar su propio DEST -eleccion de motor, recuento de
:: snapshots, apagado de la VM, snapshot forense- quedaban escritos en el diario
:: de OTRO caso. Vaciarlo los manda al diario global, que es donde pertenecen
:: hasta que exista carpeta de evidencia propia.
set "DEST="
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Snapshot Reconstruction as a Full Disk!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Reconstrucción de Snapshot como Disco Completo!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Generates a NEW consolidated VMDK that represents the state of the VM!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Genera un VMDK NUEVO y consolidado que representa el estado de la VM!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] at the moment of a specific snapshot. The original files are NOT!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] en el momento de un snapshot específico. Los archivos originales NO se!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] modified: work is always done on a COPY of the disk chain.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] modifican: se trabaja siempre sobre una COPIA de la cadena de discos.!C_RESET!

:: Si venimos redirigidos desde la opción "solo snapshot" del flujo de
:: adquisición normal, la VM ya fue seleccionada ahi mismo - no se vuelve
:: a preguntar (seria obvio y redundante para el operador).
if "!VMW_RECON_SKIP_SELECT!"=="1" (
    set "VMW_RECON_SKIP_SELECT="
    if /i "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Using the already selected VM: !SELECTED_VM_PATH!!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Usando la VM ya seleccionada: !SELECTED_VM_PATH!!C_RESET!
) else (
    call :SELECT_VMWARE_VM
    if !errorlevel! neq 0 goto MENU_VM_VMWARE
)

call :RESOLVE_VMWARE
if not exist "!VMDK_EXE!" (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] vmware-vdiskmanager.exe was not found.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] No se encontró vmware-vdiskmanager.exe.!C_RESET!
    pause
    goto MENU_VM_VMWARE
)

:: Buscar TODOS los descriptores .vmdk (base + snapshots): aquí el objetivo
:: es justamente elegir CUAL punto de la cadena reconstruir, así que no se
:: excluye nada por inclusion/exclusion de snapshots.
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Searching for disk descriptors (.vmdk)...!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Buscando descriptores de disco (.vmdk)...!C_RESET!
set "vmdk_count=0"
for %%D in ("!SELECTED_VM_PATH!\*.vmdk") do (
    echo %%~nxD | findstr /R /I /C:"-s[0-9][0-9]*\.vmdk" /C:"-flat\.vmdk" /C:"-delta\.vmdk" >nul
    if !errorlevel! neq 0 (
        set /a vmdk_count+=1
        set "VMDK_FILE_!vmdk_count!=%%~fD"
        set "VMDK_NAME_!vmdk_count!=%%~nxD"
    )
)

if !vmdk_count! equ 0 (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![-] No .vmdk disks found in the folder.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![-] No se encontraron discos .vmdk en la carpeta.!C_RESET!
    pause
    goto MENU_VM_VMWARE
)

if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Analyzing descriptors ^(CID / parentCID / parentFileNameHint^)...!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Analizando descriptores ^(CID / parentCID / parentFileNameHint^)...!C_RESET!
for %%F in ("!SELECTED_VM_VMX!") do set "_vmwr_vmsd=%%~dpnF.vmsd"
for /L %%k in (1,1,!vmdk_count!) do (
    call :VMWARE_CLASSIFY_VMDK "!VMDK_FILE_%%k!"
    set "VMDK_ISBASE_%%k=!_VMDK_ISBASE!"
    set "VMDK_PARENT_%%k=!_VMDK_PARENTHINT!"
    set "VMDK_CID_%%k=!_VMDK_CID!"
    set "VMDK_DISPNAME_%%k="
    if "!_VMDK_ISBASE!"=="0" (
        call :VMWARE_FIND_SNAPSHOT_MEMORY "!_vmwr_vmsd!" "!VMDK_NAME_%%k!"
        set "VMDK_DISPNAME_%%k=!_VMSN_DISPLAYNAME!"
    )
)

set "_vmw_snaps=0"
for /L %%k in (1,1,!vmdk_count!) do if "!VMDK_ISBASE_%%k!"=="0" set /a _vmw_snaps+=1

if !_vmw_snaps! equ 0 (
    echo.
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![-] This VM has no snapshots. The base disk is already the full current state.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![-] Esta VM no tiene snapshots. El disco base ya es el estado completo actual.!C_RESET!
    if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Use menu option 1 to acquire it directly.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Use la opción 1 del menú para adquirirlo directamente.!C_RESET!
    pause
    goto MENU_VM_VMWARE
)

echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_TITLE!Disks detected:!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TITLE!Discos detectados:!C_RESET!
echo.
for /L %%k in (1,1,!vmdk_count!) do (
    if "!VMDK_ISBASE_%%k!"=="1" (
        echo !C_OK! %%k. !VMDK_NAME_%%k!!C_RESET!
        if /i "!FORENSIC_LANG!"=="EN" echo !C_DIM!    Type: Main virtual disk ^(Base Disk^)!C_RESET!
        if /i not "!FORENSIC_LANG!"=="EN" echo !C_DIM!    Tipo: Disco virtual principal ^(Base Disk^)!C_RESET!
    ) else (
        if defined VMDK_DISPNAME_%%k (
            echo !C_WARN! %%k. !VMDK_NAME_%%k! - "!VMDK_DISPNAME_%%k!"!C_RESET!
        ) else (
            echo !C_WARN! %%k. !VMDK_NAME_%%k!!C_RESET!
        )
        if /i "!FORENSIC_LANG!"=="EN" echo !C_DIM!    Type: Snapshot ^(Delta Disk^)!C_RESET!
        if /i not "!FORENSIC_LANG!"=="EN" echo !C_DIM!    Tipo: Snapshot ^(Delta Disk^)!C_RESET!
        if defined VMDK_PARENT_%%k if /i "!FORENSIC_LANG!"=="EN" echo !C_DIM!    Based on: !VMDK_PARENT_%%k!!C_RESET!
        if defined VMDK_PARENT_%%k if /i not "!FORENSIC_LANG!"=="EN" echo !C_DIM!    Basado en: !VMDK_PARENT_%%k!!C_RESET!
    )
)
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_TITLE!Chain detected:!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TITLE!Cadena detectada:!C_RESET!
echo.
for /L %%k in (1,1,!vmdk_count!) do (
    if "!VMDK_ISBASE_%%k!"=="1" (
        echo !C_OK!!VMDK_NAME_%%k!!C_RESET!
        call :VMDK_PRINT_CHILDREN "!VMDK_NAME_%%k!" 1
    )
)
echo.

:PROMPT_VMW_RECON_SEL
set "vmw_recon_sel="
if /i "!FORENSIC_LANG!"=="EN" set /p vmw_recon_sel="!C_PROMPT!Select the snapshot to rebuild as a full disk [1-!vmdk_count!, 0=cancel]: !C_RESET!"
if /i not "!FORENSIC_LANG!"=="EN" set /p vmw_recon_sel="!C_PROMPT!Seleccione el snapshot a reconstruir como disco completo [1-!vmdk_count!, 0=cancelar]: !C_RESET!"
if "!vmw_recon_sel!"=="0" goto MENU_VM_VMWARE
if not defined vmw_recon_sel goto PROMPT_VMW_RECON_SEL
for /f "delims=0123456789" %%a in ("!vmw_recon_sel!") do (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Enter a valid number.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Ingrese un número válido.!C_RESET!
    goto PROMPT_VMW_RECON_SEL
)
if !vmw_recon_sel! lss 1 goto PROMPT_VMW_RECON_SEL
if !vmw_recon_sel! gtr !vmdk_count! goto PROMPT_VMW_RECON_SEL

call :NORM_SEL vmw_recon_sel
set "vmw_recon_src_name=!VMDK_NAME_%vmw_recon_sel%!"
:: La comprobacion de nombre vacio estaba DENTRO del if del disco base, asi que
:: solo protegia esa rama. Va antes, para cualquier seleccion.
if not defined vmw_recon_src_name goto PROMPT_VMW_RECON_SEL
if "!VMDK_ISBASE_%vmw_recon_sel%!"=="1" (
    echo.
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] "!vmw_recon_src_name!" is already the base disk ^(complete state, no snapshots applied^).!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] "!vmw_recon_src_name!" ya es el disco base ^(estado completo, sin snapshots aplicados^).!C_RESET!
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] No rebuild required: acquire it directly with option 1 of the menu.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] No requiere reconstrucción: adquieralo directamente con la opción 1 del menú.!C_RESET!
    pause
    goto MENU_VM_VMWARE
)

:: Buscar si este snapshot tiene un estado de MEMORIA asociado (.vmsn/.vmem)
:: mediante el diccionario oficial de snapshots (.vmsd, texto plano, junto
:: al .vmx). Vincula cada entrada de snapshot con su(s) disco(s) y con el
:: archivo de memoria si la VM estaba encendida/suspendida al tomarlo -
:: así el disco reconstruido y la memoria representan el MISMO instante.
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Searching memory state linked to this snapshot ^(.vmsd/.vmsn/.vmem^)...!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Buscando estado de memoria asociado a este snapshot ^(.vmsd/.vmsn/.vmem^)...!C_RESET!
for %%F in ("!SELECTED_VM_VMX!") do set "VMWR_VMSD=%%~dpnF.vmsd"
set "_VMSN_NAME="
if exist "!VMWR_VMSD!" call :VMWARE_FIND_SNAPSHOT_MEMORY "!VMWR_VMSD!" "!vmw_recon_src_name!"
if defined _VMSN_NAME (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Associated memory state detected: !_VMSN_NAME!!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Estado de memoria asociado detectado: !_VMSN_NAME!!C_RESET!
    if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] It will be included with the reconstructed disk ^(same point in time^).!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Se incluira junto con el disco reconstruido ^(mismo punto en el tiempo^).!C_RESET!
) else (
    rem NO se puede concluir "la VM estaba apagada" solo porque el .vmsd no ligue
    rem memoria a ESTE punto de la cadena: en un caso real de esta maquina la
    rem carpeta tiene un .vmsn y un .vmem de 2 GB y esa frase era falsa. Se
    rem distingue "el diccionario no liga memoria a este punto" de "no hay
    rem memoria en la carpeta", y se comprueba lo segundo antes de insinuarlo.
    set "_vmwr_memcount=0"
    for %%M in ("!SELECTED_VM_PATH!\*.vmsn" "!SELECTED_VM_PATH!\*.vmem") do set /a _vmwr_memcount+=1
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] The .vmsd does not link any memory state to THIS point of the chain.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] El .vmsd no liga ningun estado de memoria a ESTE punto de la cadena.!C_RESET!
    if "!_vmwr_memcount!"=="0" if /i "!FORENSIC_LANG!"=="EN" echo !C_DIM!    There is no .vmsn/.vmem in the VM folder either: consistent with a VM that!C_RESET!
    if "!_vmwr_memcount!"=="0" if /i not "!FORENSIC_LANG!"=="EN" echo !C_DIM!    Tampoco hay ningun .vmsn/.vmem en la carpeta de la VM: coherente con una!C_RESET!
    if "!_vmwr_memcount!"=="0" if /i "!FORENSIC_LANG!"=="EN" echo !C_DIM!    was powered off when its snapshots were taken ^(disk state only^).!C_RESET!
    if "!_vmwr_memcount!"=="0" if /i not "!FORENSIC_LANG!"=="EN" echo !C_DIM!    VM apagada al tomar sus snapshots ^(solo estado de disco^).!C_RESET!
    if not "!_vmwr_memcount!"=="0" if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN!    But there ARE !_vmwr_memcount! .vmsn/.vmem file^(s^) in the VM folder: they belong!C_RESET!
    if not "!_vmwr_memcount!"=="0" if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN!    Pero SI hay !_vmwr_memcount! archivo^(s^) .vmsn/.vmem en la carpeta: pertenecen a!C_RESET!
    if not "!_vmwr_memcount!"=="0" if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN!    to OTHER points of the chain, so they are NOT included here. It is NOT!C_RESET!
    if not "!_vmwr_memcount!"=="0" if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN!    OTROS puntos de la cadena y por eso NO se incluyen aquí. NO se afirma que!C_RESET!
    if not "!_vmwr_memcount!"=="0" if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN!    asserted that the VM was powered off. Use the memory module to preserve them.!C_RESET!
    if not "!_vmwr_memcount!"=="0" if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN!    la VM estuviera apagada. Use el modulo de memoria para preservarlos.!C_RESET!
    call :LOG_EVENT "Reconstruccion de !vmw_recon_src_name!: el .vmsd no liga memoria a este punto de la cadena. Archivos .vmsn/.vmem presentes en la carpeta de la VM: !_vmwr_memcount!. No se concluye el estado de la VM al tomar el snapshot."
)

echo.
:ASK_VMW_RECON_DEST
set "vmw_recon_dest="
if /i "!FORENSIC_LANG!"=="EN" set /p vmw_recon_dest="!C_PROMPT!Destination folder path [Enter = !DEFAULT_DEST!] (0=cancel): !C_RESET!"
if /i not "!FORENSIC_LANG!"=="EN" set /p vmw_recon_dest="!C_PROMPT!Ruta de la carpeta destino [Enter = !DEFAULT_DEST!] (0=cancelar): !C_RESET!"
if "!vmw_recon_dest!"=="0" goto MENU_VM_VMWARE
if defined vmw_recon_dest set "vmw_recon_dest=!vmw_recon_dest:"=!"
if not defined vmw_recon_dest (
    set "vmw_recon_dest=!DEFAULT_DEST!"
    if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Using default destination: !DEFAULT_DEST!!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Usando destino por defecto: !DEFAULT_DEST!!C_RESET!
)
call :VALIDATE_DEST_DIR "!vmw_recon_dest!"
if not "!_VD_OK!"=="1" goto ASK_VMW_RECON_DEST

for %%F in ("!SELECTED_VM_PATH!") do set "VMWR_VMNAME=%%~nxF"
set "VMWR_FOLDER=!VMWR_VMNAME!"
set "VMWR_FOLDER=!VMWR_FOLDER:/=_!"
set "VMWR_FOLDER=!VMWR_FOLDER::=_!"
set "VMWR_EVIDENCE=!vmw_recon_dest!\VMware\!VMWR_FOLDER!\Reconstruccion_Snapshots"
set "DEST=!VMWR_EVIDENCE!"

for %%X in ("!vmw_recon_src_name!") do set "vmw_recon_base=%%~nX"
set "VMWR_WORK=!VMWR_EVIDENCE!\_trabajo_!vmw_recon_base!"
set "VMWR_OUT_DIR=!VMWR_EVIDENCE!\Consolidation_!vmw_recon_base!"
if not exist "!VMWR_WORK!" mkdir "!VMWR_WORK!"
if not exist "!VMWR_OUT_DIR!" mkdir "!VMWR_OUT_DIR!"

:: La cadena completa (base + snapshots intermedios) debe estar libre de
:: bloqueo para poder copiarla de forma consistente - se revisa el disco
:: base, que es el que VMware bloquea mientras la VM esta encendida o
:: suspendida (los snapshots intermedios heredan el mismo estado de uso).
call :RESOLVE_VMWARE
for /L %%k in (1,1,!vmdk_count!) do if "!VMDK_ISBASE_%%k!"=="1" set "_vmwr_base_file=!VMDK_FILE_%%k!"
if defined _vmwr_base_file (
    for %%X in ("!_vmwr_base_file!") do set "_vmwr_base_name=%%~nxX"
    call :VMWARE_HANDLE_DISK_LOCKED "!_vmwr_base_file!" "!_vmwr_base_name!"
    if "!VMWL_ABORT!"=="1" goto MENU_VM_VMWARE
)

:: PASO 1: hashear el ORIGEN (solo lectura) y luego copiar TODA la cadena
:: de discos a un area de trabajo. Nunca se opera sobre la evidencia
:: original; vdiskmanager -r se invoca siempre sobre la copia.
call :LOG_EVENT "Reconstruccion snapshot VMware iniciada: origen=!vmw_recon_src_name! VM=!SELECTED_VM_VMX!"
:: El hash de los originales se intenta SOLO si la fuente lo admite: con la VM
:: viva el hash de los extents no es reproducible y el intento tardaba horas para dejar
:: un reporte de errores que la nota forense citaba como prueba de integridad.
call :VMWARE_ORIGINALS_INTEGRITY "!SELECTED_VM_PATH!" "!_vmwr_base_file!" "*.vmdk" "!VMWR_EVIDENCE!\hashes_originales_PREcopia.sha256" "VMware_Original_PreCopia"

echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Copying full disk chain to work area ^(read-only on the original^)...!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Copiando cadena completa de discos a area de trabajo ^(solo lectura sobre el original^)...!C_RESET!
robocopy "!SELECTED_VM_PATH!" "!VMWR_WORK!" *.vmdk /NFL /NDL /NJH /NJS >nul
set "_vmwr_rc=!errorlevel!"
if !_vmwr_rc! geq 8 (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Error copying the disks to the working area ^(robocopy code !_vmwr_rc!^).!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Error al copiar los discos al area de trabajo ^(robocopy código !_vmwr_rc!^).!C_RESET!
    call :LOG_EVENT "Error: robocopy fallo copiando cadena VMware para reconstruccion (codigo !_vmwr_rc!)"
    pause
    goto MENU_VM_VMWARE
)
if /i "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Disk chain copied to: !VMWR_WORK!!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Cadena de discos copiada a: !VMWR_WORK!!C_RESET!

:: PASO 2: consolidar, sobre la COPIA, el snapshot seleccionado
set "vmw_recon_src=!VMWR_WORK!\!vmw_recon_src_name!"
set "vmw_recon_out=!VMWR_OUT_DIR!\!vmw_recon_base!_reconstruido.vmdk"

echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Rebuilding "!vmw_recon_src_name!" as a complete disk...!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Reconstruyendo "!vmw_recon_src_name!" como disco completo...!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_DIM!    vmware-vdiskmanager -r "!vmw_recon_src_name!" -t 0 [output]!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_DIM!    vmware-vdiskmanager -r "!vmw_recon_src_name!" -t 0 [salida]!C_RESET!
call :NEWGUID ACQ_GUID
set "ACQ_CMD=!TEMP!\forensic_cmd_!ACQ_GUID!.tmp"
>"!ACQ_CMD!" echo "!VMDK_EXE!" -r "!vmw_recon_src!" -t 0 "!vmw_recon_out!"
call :ACQ_VER TOOLVER_VMDK "!VMDK_EXE!" ""
call :ACQUIRE "VMware_ReconstruirSnapshot" "!ACQ_CMD!"
set "_vmwr_el=!errorlevel!"
if "!_vmwr_el!"=="2" (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![ABORT] Reconstruction aborted by the user.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![ABORT] Reconstrucción abortada por el usuario.!C_RESET!
    call :LOG_EVENT "Reconstruccion VMware abortada por el usuario (CTRL+C)."
    pause
    goto MENU_VM_VMWARE
)
if !_vmwr_el! neq 0 (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Error rebuilding the snapshot.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Error al reconstruir el snapshot.!C_RESET!
    rem El fallo ya se dijo arriba en C_ERR. Esto es la indicacion de que revisar:
    rem un marcador [i] en color de error era el unico caso en todo el archivo.
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] Verify that the complete parent chain ^(including the base disk^)!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] Verifique que la cadena completa de padres ^(incluido el disco base^)!C_RESET!
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN!    is present in the VM folder.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN!    esté presente en la carpeta de la VM.!C_RESET!
    call :LOG_EVENT "Error: Fallo al reconstruir snapshot VMware !vmw_recon_src_name!."
    pause
    goto MENU_VM_VMWARE
)

if /i "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Snapshot rebuilt successfully as a full disk.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Snapshot reconstruido exitosamente como disco completo.!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_OK![+] File generated: !vmw_recon_out!!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Archivo generado: !vmw_recon_out!!C_RESET!
call :LOG_EVENT "Snapshot VMware reconstruido: !vmw_recon_src_name! -> !vmw_recon_out!"

:: PASO 3: hash del resultado como EVIDENCIA DERIVADA (distinta de la
:: evidencia primaria, cuyo hash preservado quedo en el paso 1).
for %%X in ("!vmw_recon_out!") do set "vmw_recon_out_name=%%~nxX"
call :HASH_EVIDENCE FOLDER "!VMWR_OUT_DIR!" "!vmw_recon_out_name!" "!VMWR_OUT_DIR!\hashes_evidencia_derivada.sha256" "VMware_Snapshot_Reconstruido"

:: PASO 4: preservar (solo copia, sin alterar) el estado de MEMORIA (.vmsn +
:: .vmem) asociado a este snapshot si se detecto en el paso de busqueda -
:: junto al disco reconstruido representan el MISMO instante (RAM + disco).
set "_vmwr_tiene_memoria="
if defined _VMSN_NAME (
    echo.
    if /i "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Preserving associated memory state ^(!_VMSN_NAME!^)...!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Preservando estado de memoria asociado ^(!_VMSN_NAME!^)...!C_RESET!
    rem Carpeta "Memory", no "Memoria": es el nombre que usan los otros dos
    rem subsistemas (VirtualBox en :VBOX_MEM y Hyper-V en :HVM_*), y un conjunto de
    rem evidencia donde la misma clase de artefacto vive en carpetas con nombres
    rem distintos segun el hipervisor obliga a adivinar donde buscar.
    if not exist "!VMWR_OUT_DIR!\Memory" mkdir "!VMWR_OUT_DIR!\Memory"
    for %%X in ("!_VMSN_NAME!") do set "_vmsn_base=%%~nX"
    robocopy "!SELECTED_VM_PATH!" "!VMWR_OUT_DIR!\Memory" "!_VMSN_NAME!" "!_vmsn_base!.vmem" /NFL /NDL /NJH /NJS >nul
    if exist "!VMWR_OUT_DIR!\Memory\!_VMSN_NAME!" if /i "!FORENSIC_LANG!"=="EN" echo !C_OK![+] .vmsn file preserved.!C_RESET!
    if exist "!VMWR_OUT_DIR!\Memory\!_VMSN_NAME!" if /i not "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Archivo .vmsn preservado.!C_RESET!
    if exist "!VMWR_OUT_DIR!\Memory\!_vmsn_base!.vmem" (
        set "_vmwr_tiene_memoria=1"
        if /i "!FORENSIC_LANG!"=="EN" echo !C_OK![+] .vmem file ^(RAM dump^) preserved: it holds the memory!C_RESET!
        if /i not "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Archivo .vmem ^(volcado de RAM^) preservado: contiene la!C_RESET!
        if /i "!FORENSIC_LANG!"=="EN" echo !C_OK!    as it was at the moment the snapshot was taken.!C_RESET!
        if /i not "!FORENSIC_LANG!"=="EN" echo !C_OK!    memoria tal como estaba al tomar el snapshot.!C_RESET!
        call :HASH_EVIDENCE FOLDER "!VMWR_OUT_DIR!\Memory" "*.vmsn,*.vmem" "!VMWR_OUT_DIR!\Memory\hashes_memoria.sha256" "VMware_Snapshot_Memoria"
        call :LOG_EVENT "Memoria de snapshot VMware preservada: !VMWR_OUT_DIR!\Memory\!_vmsn_base!.vmem"
    ) else (
        if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] No .vmem for this snapshot ^(VM powered off when taken^): only disk state available.!C_RESET!
        if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] No hay .vmem para este snapshot ^(VM apagada al tomarlo^): solo estado de disco disponible.!C_RESET!
        call :HASH_EVIDENCE FOLDER "!VMWR_OUT_DIR!\Memory" "*.vmsn" "!VMWR_OUT_DIR!\Memory\hashes_memoria.sha256" "VMware_Snapshot_Memoria"
    )
)

:: PASO 5: preservar también la CONFIGURACIÓN (.vmx/.vmxf/.vmsd/.nvram) -
:: pequeña, pero sin ella VMware no puede abrir este disco reconstruido
:: después; queda disponible por si el operador decide montarlo.
if not exist "!VMWR_OUT_DIR!\Config" mkdir "!VMWR_OUT_DIR!\Config"
robocopy "!SELECTED_VM_PATH!" "!VMWR_OUT_DIR!\Config" *.vmx *.vmxf *.vmsd *.nvram /NFL /NDL /NJH /NJS >nul
if exist "!VMWR_OUT_DIR!\Config\*.vmx" (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Configuration ^(.vmx/.vmxf/.vmsd/.nvram^) preserved.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Configuración ^(.vmx/.vmxf/.vmsd/.nvram^) preservada.!C_RESET!
    call :HASH_EVIDENCE FOLDER "!VMWR_OUT_DIR!\Config" "*.vmx,*.vmxf,*.vmsd,*.nvram" "!VMWR_OUT_DIR!\Config\hashes.sha256" "VMware_Configuracion"
)

echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![FORENSIC NOTE] This VMDK is DERIVED EVIDENCE, not primary evidence.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![NOTA FORENSE] Este VMDK es EVIDENCIA DERIVADA, no evidencia primaria.!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT!It was generated from the original chain via vmware-vdiskmanager -r over a!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT!Se genero a partir de la cadena original mediante vmware-vdiskmanager -r sobre!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT!working copy, without modifying the source files.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT!una copia de trabajo, sin modificar los archivos fuente.!C_RESET!
rem La nota citaba SIEMPRE "hash preservado en hashes_originales_PREcopia.sha256"
rem como vinculo con la evidencia primaria. Con la fuente en uso ese archivo no
rem contiene hashes sino una referencia tamano+mtime, y presentarlo como hash de
rem los originales es exactamente la afirmacion que este proyecto se prohibe.
if "!VMW_ORIG_HASHED!"=="1" if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT!Link to the primary evidence: hashes_originales_PREcopia.sha256.!C_RESET!
if "!VMW_ORIG_HASHED!"=="1" if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT!Vinculo con la evidencia primaria: hashes_originales_PREcopia.sha256.!C_RESET!
if not "!VMW_ORIG_HASHED!"=="1" if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN!The originals were NOT hashed: the source was in use. There is only a!C_RESET!
if not "!VMW_ORIG_HASHED!"=="1" if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN!Los originales NO se hashearon: la fuente estaba en uso. Solo hay una!C_RESET!
if not "!VMW_ORIG_HASHED!"=="1" if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN!NON-REPRODUCIBLE size+mtime reference. Do NOT present it as proof that!C_RESET!
if not "!VMW_ORIG_HASHED!"=="1" if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN!referencia NO REPRODUCIBLE de tamaño+mtime. NO la presente como prueba de!C_RESET!
if not "!VMW_ORIG_HASHED!"=="1" if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN!the originals stayed intact: that link does not exist for this deliverable.!C_RESET!
if not "!VMW_ORIG_HASHED!"=="1" if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN!que los originales quedaron intactos: ese vinculo no existe aquí.!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT!Document it this way in the chain of custody.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT!Documentelo así en la cadena de custodia.!C_RESET!
if defined _vmwr_tiene_memoria (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT!Along with the disk, the RAM ^(.vmem^) was preserved, captured at the same!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT!Junto con el disco se preservo la memoria RAM ^(.vmem^) capturada en el mismo!C_RESET!
    if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT!instant of the snapshot ^(Memory\ folder^), analyzable with Volatility.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT!instante del snapshot ^(carpeta Memory\^), analizable con Volatility.!C_RESET!
)
echo.

:: Ofrecer conversión QEMU del reconstruido
if not exist "!QEMU_IMG!" goto VMWR_SKIP_QEMU
set "vmwr_qemu_ask="
if /i "!FORENSIC_LANG!"=="EN" set /p vmwr_qemu_ask="!C_PROMPT!Convert the rebuilt disk to forensic RAW/IMG format (QEMU)? [Y/N]: !C_RESET!"
if /i not "!FORENSIC_LANG!"=="EN" set /p vmwr_qemu_ask="!C_PROMPT!¿Convertir el disco reconstruido a RAW/IMG forense (QEMU)? [S/N]: !C_RESET!"
:: El prompt en ingles ofrece [Y/N]; se acepta Y como S.
if /i "!vmwr_qemu_ask!"=="Y" set "vmwr_qemu_ask=S"
if /I "!vmwr_qemu_ask!"=="S" (
    call :QEMU_CONVERT "!vmw_recon_out!" "!VMWR_OUT_DIR!" "!vmw_recon_base!_forense"
)
:VMWR_SKIP_QEMU
pause
goto MENU_VM_VMWARE

:: =====================================================
:: VMWARE - CLONAR VM COMPLETA PARA ABRIR/REANUDAR EN VMWARE
:: A diferencia de "Reconstruir Snapshot" (submenu de la opción 1,
:: Adquisición), que genera un VMDK consolidado NUEVO solo apto para
:: ANÁLISIS forense (Autopsy/FTK/
:: Volatility), esta opción copia la VM COMPLETA -.vmx, TODA la cadena de
:: discos sin consolidar, .vmsd, y los .vmsn/.vmem de sus snapshots- tal
:: cual, sin tocar nada. El .vmsn/.vmem quedan vinculados por CID/UUID a
:: ESA cadena exacta de discos (no a un archivo consolidado), así que
:: SOLO copiando todo junto e intacto se puede abrir el clon en VMware y
:: usar su propio "Ir a snapshot" para que la VM REANUDE con la memoria
:: RAM real de ese momento.
:: =====================================================
:VM_VMWARE_CLONE_FULL
:: El clon completo ES una copia de la carpeta de la VM.
if not defined HAS_ROBOCOPY call :ROBOCOPY_MISSING "VMware - clon completo de la VM"
if not defined HAS_ROBOCOPY goto MENU_VM_VMWARE
:: DEST se limpia al ENTRAR al modulo. :LOG_EVENT manda al diario GLOBAL de la
:: sesion todo evento producido sin DEST, pero si el operador ya uso otro modulo
:: en la misma sesion, DEST seguia apuntando a la evidencia ANTERIOR: los eventos
:: de este modulo previos a fijar su propio DEST -eleccion de motor, recuento de
:: snapshots, apagado de la VM, snapshot forense- quedaban escritos en el diario
:: de OTRO caso. Vaciarlo los manda al diario global, que es donde pertenecen
:: hasta que exista carpeta de evidencia propia.
set "DEST="
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Clone Full VM to Open/Resume in VMware!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Clonar VM Completa para Abrir/Reanudar en VMware!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Copies the COMPLETE VM ^(config + disks + snapshots + memory^),!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Copia la VM COMPLETA ^(config + discos + snapshots + memoria^),!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] without consolidating anything, to open it in VMware and use its own!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] sin consolidar nada, para abrirla en VMware y usar su propio!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] "Go to snapshot": the VM resumes with the real RAM from that moment.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] "Ir a snapshot": la VM reanuda con la RAM real de ese momento.!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] A consolidated disk ^(Acquisition option^) does NOT work for this:!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] Un disco consolidado ^(opción Adquisición^) NO sirve para esto:!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] it is a NEW file, with no memory and no link to the chain of!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] es un archivo NUEVO, sin memoria ni vinculo con la cadena de!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] the original snapshots. That is why everything is copied together, intact.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] snapshots original. Por eso aquí se copia todo junto, intacto.!C_RESET!
echo.
call :SELECT_VMWARE_VM
if !errorlevel! neq 0 goto MENU_VM_VMWARE

for %%F in ("!SELECTED_VM_VMX!") do set "VMWC_VMXNAME=%%~nxF"

:: Si hay varios snapshots, dejar elegir CUALES incluir (por defecto: todos,
:: sin cambiar el comportamiento si el operador solo presiona Enter). Los
:: ancestros necesarios para resolver cada snapshot elegido se incluyen
:: siempre automáticamente (VMware necesita la cadena completa).
call :VMWARE_SELECT_CLONE_SNAPSHOTS
if "!VMWC_ABORT!"=="1" goto MENU_VM_VMWARE

:: El clon debe copiar la cadena de discos en un estado consistente - se
:: revisa que el disco base no este bloqueado (VM encendida o suspendida).
call :RESOLVE_VMWARE
:: Mismo aviso que en las otras dos vias del subsistema: sin vmrun no se puede
:: comprobar el estado de la VM antes de clonar. Solo imprime si falta algo.
call :VMWARE_TOOLS_REPORT
:: VMWARE_SELECT_CLONE_SNAPSHOTS sale temprano (sin clasificar VMDK_ISBASE_%%k)
:: cuando la VM tiene un solo .vmdk -sin snapshots-, por lo que ese único
:: disco ES el base por definicion.
set "_vmwc_base_file="
if !vmdk_count! leq 1 (
    if !vmdk_count! equ 1 set "_vmwc_base_file=!VMDK_FILE_1!"
) else (
    for /L %%k in (1,1,!vmdk_count!) do if "!VMDK_ISBASE_%%k!"=="1" set "_vmwc_base_file=!VMDK_FILE_%%k!"
)
if defined _vmwc_base_file (
    for %%X in ("!_vmwc_base_file!") do set "_vmwc_base_name=%%~nxX"
    call :VMWARE_HANDLE_DISK_LOCKED "!_vmwc_base_file!" "!_vmwc_base_name!"
    if "!VMWL_ABORT!"=="1" goto MENU_VM_VMWARE
)

echo.
:ASK_VMW_CLONE_DEST
set "vmwc_dest="
if /i "!FORENSIC_LANG!"=="EN" set /p vmwc_dest="!C_PROMPT!Destination folder path [Enter = !DEFAULT_DEST!] (0=cancel): !C_RESET!"
if /i not "!FORENSIC_LANG!"=="EN" set /p vmwc_dest="!C_PROMPT!Ruta de la carpeta destino [Enter = !DEFAULT_DEST!] (0=cancelar): !C_RESET!"
if "!vmwc_dest!"=="0" goto MENU_VM_VMWARE
if defined vmwc_dest set "vmwc_dest=!vmwc_dest:"=!"
if not defined vmwc_dest (
    set "vmwc_dest=!DEFAULT_DEST!"
    if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Using default destination: !DEFAULT_DEST!!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Usando destino por defecto: !DEFAULT_DEST!!C_RESET!
)
call :VALIDATE_DEST_DIR "!vmwc_dest!"
if not "!_VD_OK!"=="1" goto ASK_VMW_CLONE_DEST

for %%F in ("!SELECTED_VM_PATH!") do set "VMWC_VMNAME=%%~nxF"
set "VMWC_FOLDER=!VMWC_VMNAME!"
set "VMWC_FOLDER=!VMWC_FOLDER:/=_!"
set "VMWC_FOLDER=!VMWC_FOLDER::=_!"
set "VMWC_EVIDENCE=!vmwc_dest!\VMware\!VMWC_FOLDER!\Clon_Completo_VMware"
set "DEST=!VMWC_EVIDENCE!"
if not exist "!VMWC_EVIDENCE!" mkdir "!VMWC_EVIDENCE!"

:: Hash del ORIGEN antes de copiar (verificación de que la copia no lo altero)
call :LOG_EVENT "Clon completo VMware iniciado: VM=!SELECTED_VM_VMX!"
:: Igual que en la reconstruccion: la compuerta es si los extents se pueden abrir
:: negando escritura a terceros, que es lo que acredita que la fuente esta quieta.
call :VMWARE_ORIGINALS_INTEGRITY "!SELECTED_VM_PATH!" "" "*.vmdk,*.vmsn,*.vmem,*.vmx,*.vmxf,*.vmsd,*.nvram" "!VMWC_EVIDENCE!\hashes_originales_PREcopia.sha256" "VMware_Original_PreCopia_ClonCompleto"

echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Copying VM ^(config + disks + snapshots + memory^)...!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Copiando VM ^(config + discos + snapshots + memoria^)...!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] This may take a while depending on the VM size ^(disks + .vmem dumps^).!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] Esto puede tardar según el tamaño de la VM ^(discos + volcados .vmem^).!C_RESET!

if "!VMWC_FILTER_ACTIVE!"=="1" (
    rem Copia SELECTIVA: config siempre completa ^(pequeña^) + solo los
    rem archivos de disco/memoria necesarios para los snapshots elegidos.
    call :NEWGUID ACQ_GUID
    set "ACQ_CMD=!TEMP!\forensic_cmd_!ACQ_GUID!.tmp"
    >"!ACQ_CMD!" echo robocopy "!SELECTED_VM_PATH!" "!VMWC_EVIDENCE!\VM" *.vmx *.vmxf *.vmsd *.nvram /R:1 /W:1 /NFL /NDL ^& if errorlevel 8 (exit 1) else (exit 0)
    set "ACQ_TOOL_VER=robocopy in-box de !WIN_NAME! build !WIN_BUILD! - no publica version propia: su identidad es la build del SO"
    call :ACQUIRE "VMware_ClonCompleto_Config" "!ACQ_CMD!"
    set "_vmwc_el=!errorlevel!"
    if "!_vmwc_el!"=="2" (
        if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![ABORT] Cloning aborted by the user.!C_RESET!
        if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![ABORT] Clonado abortado por el usuario.!C_RESET!
        call :LOG_EVENT "Clon completo VMware abortado por el usuario (CTRL+C)."
        pause
        goto MENU_VM_VMWARE
    )
    if !_vmwc_el! neq 0 (
        if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Error copying the VM configuration.!C_RESET!
        if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Error al copiar la configuración de la VM.!C_RESET!
        call :LOG_EVENT "Error: Fallo al copiar configuracion para clon VMware."
        pause
        goto MENU_VM_VMWARE
    )

    call :NEWGUID ACQ_GUID
    set "ACQ_CMD=!TEMP!\forensic_cmd_!ACQ_GUID!.tmp"
    >"!ACQ_CMD!" echo robocopy "!SELECTED_VM_PATH!" "!VMWC_EVIDENCE!\VM" !VMWC_DISKFILES! !VMWC_MEMFILES! /R:1 /W:1 /NFL /NDL ^& if errorlevel 8 (exit 1) else (exit 0)
    set "ACQ_TOOL_VER=robocopy in-box de !WIN_NAME! build !WIN_BUILD! - no publica version propia: su identidad es la build del SO"
    call :ACQUIRE "VMware_ClonCompleto" "!ACQ_CMD!"
    set "_vmwc_el=!errorlevel!"
    if "!_vmwc_el!"=="2" (
        if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![ABORT] Cloning aborted by the user.!C_RESET!
        if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![ABORT] Clonado abortado por el usuario.!C_RESET!
        call :LOG_EVENT "Clon completo VMware abortado por el usuario (CTRL+C)."
        pause
        goto MENU_VM_VMWARE
    )
    if !_vmwc_el! neq 0 (
        if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Error copying the VM disks/memory.!C_RESET!
        if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Error al copiar los discos/memoria de la VM.!C_RESET!
        call :LOG_EVENT "Error: Fallo al copiar discos/memoria para clon VMware."
        pause
        goto MENU_VM_VMWARE
    )
    call :LOG_EVENT "Clon VMware selectivo: snapshots incluidos=!VMWC_CHOSEN_LIST! (ancestros incluidos automaticamente)"
) else (
    call :NEWGUID ACQ_GUID
    set "ACQ_CMD=!TEMP!\forensic_cmd_!ACQ_GUID!.tmp"
    >"!ACQ_CMD!" echo robocopy "!SELECTED_VM_PATH!" "!VMWC_EVIDENCE!\VM" /E /COPY:DAT /R:1 /W:1 /NFL /NDL ^& if errorlevel 8 (exit 1) else (exit 0)
    set "ACQ_TOOL_VER=robocopy in-box de !WIN_NAME! build !WIN_BUILD! - no publica version propia: su identidad es la build del SO"
    call :ACQUIRE "VMware_ClonCompleto" "!ACQ_CMD!"
    set "_vmwc_el=!errorlevel!"
    if "!_vmwc_el!"=="2" (
        if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![ABORT] Cloning aborted by the user.!C_RESET!
        if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![ABORT] Clonado abortado por el usuario.!C_RESET!
        call :LOG_EVENT "Clon completo VMware abortado por el usuario (CTRL+C)."
        pause
        goto MENU_VM_VMWARE
    )
    if !_vmwc_el! neq 0 (
        if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Error copying the complete VM.!C_RESET!
        if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Error al copiar la VM completa.!C_RESET!
        call :LOG_EVENT "Error: Fallo al copiar VM completa para clon VMware."
        pause
        goto MENU_VM_VMWARE
    )
)

if /i "!FORENSIC_LANG!"=="EN" echo !C_OK![+] VM copied to: !VMWC_EVIDENCE!\VM!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_OK![+] VM copiada a: !VMWC_EVIDENCE!\VM!C_RESET!
call :LOG_EVENT "Clon completo VMware finalizado: !VMWC_EVIDENCE!\VM"

:: Hash de la COPIA (evidencia derivada: DEBERIA coincidir archivo por archivo con
:: el hash del origen tomado antes de copiar, pero nadie lo comprueba aqui).
call :HASH_EVIDENCE FOLDER "!VMWC_EVIDENCE!\VM" "*.vmdk,*.vmsn,*.vmem,*.vmx,*.vmxf,*.vmsd,*.nvram" "!VMWC_EVIDENCE!\hashes_copia_POSTcopia.sha256" "VMware_Copia_ClonCompleto"

:: El "despues" se tomaba sobre la COPIA. El ORIGEN no se volvia a hashear nunca,
:: y aun asi la pantalla afirmaba "hash verificado antes y despues de la copia".
:: Se re-hashea el ORIGEN al terminar, en un tercer archivo, para que la
:: comparacion PRE/POST del origen exista como dato y no como afirmacion.
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Re-hashing the ORIGIN after the copy (PRE/POST of the source)...!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Re-hasheando el ORIGEN después de la copia (PRE/POST del origen)...!C_RESET!
call :HASH_EVIDENCE FOLDER "!SELECTED_VM_PATH!" "*.vmdk,*.vmsn,*.vmem,*.vmx,*.vmxf,*.vmsd,*.nvram" "!VMWC_EVIDENCE!\hashes_originales_POSTcopia.sha256" "VMware_Original_PostCopia_ClonCompleto"
call :LOG_EVENT "Clon completo VMware: se registraron TRES listas de hash - origen PRE-copia, copia POST-copia y origen POST-copia. El framework NO las compara automaticamente: la comparacion archivo por archivo la debe hacer el analista."

