if !PS_VER! GEQ 3 powershell -NoProfile -Command "Get-CimInstance Win32_LogicalDisk | Select-Object DeviceID,@{N='Etiqueta';E={if($_.VolumeName){$_.VolumeName}else{'(Sin etiqueta)'}}},@{N='TamanoGB';E={[math]::Round($_.Size/1GB,1)}},DriveType | Format-Table -AutoSize" 2>nul
if !PS_VER! LSS 3 powershell -NoProfile -Command "Get-WmiObject Win32_LogicalDisk | Select-Object DeviceID,@{N='Etiqueta';E={if($_.VolumeName){$_.VolumeName}else{'(Sin etiqueta)'}}},@{N='TamanoGB';E={[math]::Round($_.Size/1GB,1)}},DriveType | Format-Table -AutoSize" 2>nul
