:: -----------------------------------------------------------------------
:: VMWARE_CHECK_AND_STOP_IF_RUNNING
:: Usa !SELECTED_VM_VMX! y !VMRUN_EXE! ya definidos por el llamador.
:: Detecta con el comando oficial "vmrun list" (sin pipes: se evita así
:: por completo la clase de bug de comillas de rutas-con-espacios+pipe ya
:: corregida en otras partes de este script) si la VM esta encendida. De
:: ser así, pregunta al operador si desea apagarla de forma NORMAL
:: (vmrun stop ... soft = señal ACPI al SO invitado, NO un apagado
:: forzado como "hard") antes de continuar con la adquisición.
:: Resultado en !VMW_STOP_ABORT! (1 = el llamador debe cancelar y volver
:: al menu; 0 = puede continuar, la VM esta apagada).
:: -----------------------------------------------------------------------
:VMWARE_CHECK_AND_STOP_IF_RUNNING
set "VMW_STOP_ABORT=0"
set "_vmwr_is_running="
for /f "skip=1 delims=" %%L in ('"!VMRUN_EXE!" list 2^>nul') do (
    if /I "%%L"=="!SELECTED_VM_VMX!" set "_vmwr_is_running=1"
)
if not defined _vmwr_is_running exit /b 0

echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![CAUTION] This VM is currently POWERED ON.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![ATENCIÓN] Esta VM está actualmente ENCENDIDA.!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT!To acquire the disk forensically, the VM must be powered off!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT!Para adquirir el disco de forma forense, la VM debe estar apagada!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT!^(VMware locks the .vmdk while it is in use^).!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT!^(VMware bloquea el .vmdk mientras esta en uso^).!C_RESET!
echo.
set "_vmwr_stop_ask="
if /i "!FORENSIC_LANG!"=="EN" set /p _vmwr_stop_ask="!C_PROMPT!Shut it down now the NORMAL way ^(guest OS shutdown, NOT forced^)? [Y/N]: !C_RESET!"
if /i not "!FORENSIC_LANG!"=="EN" set /p _vmwr_stop_ask="!C_PROMPT!¿Apagarla ahora de forma NORMAL ^(apagado del SO invitado, NO forzado^)? [S/N]: !C_RESET!"
:: El prompt en ingles ofrece [Y/N]; se acepta Y como S.
if /i "!_vmwr_stop_ask!"=="Y" set "_vmwr_stop_ask=S"
if /I not "!_vmwr_stop_ask!"=="S" (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] Acquisition aborted: the VM must be powered off.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] Adquisición cancelada: la VM debe estar apagada.!C_RESET!
    call :LOG_EVENT "Adquisicion VMware cancelada: VM encendida y operador no autorizo apagado - !SELECTED_VM_VMX!"
    set "VMW_STOP_ABORT=1"
    exit /b 0
)

echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Shutting down the VM normally ^(vmrun stop soft - requires VMware Tools^)...!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Apagando la VM de forma normal ^(vmrun stop soft - requiere VMware Tools^)...!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] "soft" = ACPI shutdown signal to the guest OS, same as the Shut down button!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] "soft" = señal ACPI de apagado al SO invitado, igual que el boton Apagar!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT!    of Windows/Linux. It is NOT a forced shutdown ^(that would be "hard"^).!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT!    de Windows/Linux. NO es un apagado forzado ^(eso seria "hard"^).!C_RESET!
call :UTCNOW _VMWR_STOP_TS1
"!VMRUN_EXE!" stop "!SELECTED_VM_VMX!" soft >nul 2>&1
set "_vmwr_stop_el=!errorLevel!"
call :UTCNOW _VMWR_STOP_TS2
call :TOOL_VER_ONCE TOOLVER_VMRUN "!VMRUN_EXE!" ""
call :LOG_CMD "VMware_StopSoft" "vmrun stop ""!SELECTED_VM_VMX!"" soft" "!_vmwr_stop_el!" "!_VMWR_STOP_TS1!" "!_VMWR_STOP_TS2!" "" "" "!TOOLVER_VMRUN!"

if !_vmwr_stop_el! neq 0 (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Could not power off the VM automatically ^(vmrun stop failed^).!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] No se pudo apagar la VM automáticamente ^(vmrun stop fallo^).!C_RESET!
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] Verify that VMware Tools is installed in the guest, or power it off!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] Verifique que VMware Tools este instalado en el guest, o apaguela!C_RESET!
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] manually from VMware and try again.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] manualmente desde VMware y vuelva a intentar.!C_RESET!
    call :LOG_EVENT "Error: vmrun stop soft fallo para !SELECTED_VM_VMX!"
    set "VMW_STOP_ABORT=1"
    exit /b 0
)

:: El apagado ACPI no es instantaneo (el guest procesa la señal, cierra
:: sesiones, etc.) - se espera hasta 60s reconsultando "vmrun list".
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Waiting for the guest operating system to finish shutting down...!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Esperando a que el sistema operativo invitado termine de apagarse...!C_RESET!
set "_vmwr_wait=0"
:VMWR_STOP_WAIT_LOOP
call :WAIT 3
set "_vmwr_still_running="
for /f "skip=1 delims=" %%L in ('"!VMRUN_EXE!" list 2^>nul') do (
    if /I "%%L"=="!SELECTED_VM_VMX!" set "_vmwr_still_running=1"
)
if not defined _vmwr_still_running goto VMWR_STOP_CONFIRMED
set /a _vmwr_wait+=3
if !_vmwr_wait! lss 60 goto VMWR_STOP_WAIT_LOOP

if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] The VM is still powered on after 60 seconds of waiting.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] La VM sigue encendida tras 60 segundos de espera.!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] ACPI shutdown may require manual confirmation inside the guest!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] El apagado ACPI puede requerir confirmación manual dentro del guest!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] ^(e.g. "save changes" dialogs or applications that block closing^),!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] ^(ej. dialogos de "guardar cambios" o aplicaciones que bloquean el cierre^),!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] or VMware Tools is not responding. Power it off manually and retry.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] o VMware Tools no esta respondiendo. Apaguela manualmente y reintente.!C_RESET!
call :LOG_EVENT "Advertencia: VM sigue encendida tras vmrun stop soft + 60s de espera - !SELECTED_VM_VMX!"
set "VMW_STOP_ABORT=1"
exit /b 0

:VMWR_STOP_CONFIRMED
if /i "!FORENSIC_LANG!"=="EN" echo !C_OK![+] VM powered off successfully.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_OK![+] VM apagada correctamente.!C_RESET!
call :LOG_EVENT "VM apagada via vmrun stop soft: !SELECTED_VM_VMX!"
exit /b 0

:: -----------------------------------------------------------------------
:: VMWARE_HANDLE_DISK_LOCKED
:: %1 = ruta completa al .vmdk base -se le agrega ".lck" para verificar-.
:: %2 = nombre a mostrar al operador (solo el nombre de archivo).
:: Usa !SELECTED_VM_VMX! y !VMRUN_EXE! ya definidos por el llamador.
::
:: El problema real NO es que el archivo no se pueda leer: VMware comparte la
:: lectura y una copia normal del .vmdk funciona con la VM encendida. El
:: problema es que esa copia sale INCONSISTENTE, porque el guest tiene paginas
:: sucias en RAM y el archivo cambia mientras se copia (un "smear").
:: Apagar la VM resuelve la consistencia pero destruye evidencia: el apagado
:: del SO invitado vacia cachés, escribe en los registros de eventos, toca
:: prefetch y borra la RAM.
::
:: La salida forense correcta es congelar el disco SIN detener la VM tomando un
:: snapshot: a partir de ese momento VMware escribe en un disco diferencial
:: ("<disco>-000001.vmdk") y el disco base queda quiescente, ademas de volcar
:: la RAM a .vmsn/.vmem en el mismo instante. Comprobado en Workstation: el
:: base mantiene el mismo SHA-256 entre mediciones separadas mientras la VM
:: sigue corriendo, y la copia en caliente coincide bit a bit con el original.
::
:: OJO: el ".lck" del disco base NO desaparece tras el snapshot, por lo que esa
:: via NO puede volver a :VWL_CHECK (esperaria para siempre).
::
:: Resultado en !VMWL_ABORT! (1=cancelar; 0=se puede continuar) y en
:: !VMWL_FROZEN! (1=se congelo con snapshot, el base es la evidencia valida).
:: -----------------------------------------------------------------------
:VMWARE_HANDLE_DISK_LOCKED
set "_vwl_path=%~1"
set "_vwl_name=%~2"
set "VMWL_ABORT=0"
set "VMWL_FROZEN=0"
set "VMWL_QUIESCED=0"

:: vmrun.exe se comprueba UNA sola vez: las opciones 1 y 2 lo necesitan y
:: ofrecerlas sin tenerlo dejaba al operador atrapado eligiendo algo que
:: siempre falla.
set "_vwl_hasvmrun=0"
if exist "!VMRUN_EXE!" set "_vwl_hasvmrun=1"

:: La opcion 1 no termina en el snapshot: sigue leyendo el base con qemu-img,
:: porque el ".lck" NO desaparece al congelar y vmware-vdiskmanager.exe exige
:: candado EXCLUSIVO. Sin qemu-img esa via tomaria el snapshot -mutando la
:: carpeta de la VM- para despues no poder producir ninguna imagen, asi que se
:: exige tambien qemu-img, igual que hace :ASK_VMWARE_ACQ_ENGINE.
set "_vwl_hasqemu=0"
if exist "!QEMU_IMG!" set "_vwl_hasqemu=1"
set "_vwl_canfreeze=0"
if "!_vwl_hasvmrun!"=="1" if "!_vwl_hasqemu!"=="1" set "_vwl_canfreeze=1"

:VWL_CHECK
if not exist "!_vwl_path!.lck" exit /b 0

:: El candado por si solo NO dice si alguien esta ESCRIBIENDO: VMware lo retiene
:: con la VM suspendida, y tambien puede quedar huerfano tras un cuelgue de
:: VMware o del host. Se mide antes de describir la situacion, porque el texto
:: anterior afirmaba siempre "el guest tiene paginas sucias en RAM y el archivo
:: cambia mientras se lee" - falso con la VM suspendida y falso con un candado
:: obsoleto, que son precisamente los dos casos en que la lectura es consistente.
call :VMWARE_PROBE_QUIESCENT "!_vwl_path!"
set "_vwl_pq=!_VMWQ_QUIESCED!"
set "_vwl_pn=!_VMWQ_PROBED!"

echo.
if "!_vwl_pq!"=="1" goto VWL_DESC_QUIESCENT
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![*] The disk "!_vwl_name!" is in use: the VM is running or suspended.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![*] El disco "!_vwl_name!" esta en uso: la VM esta encendida o suspendida.!C_RESET!
if "!_vwl_pn!"=="0" goto VWL_DESC_NOPROBE
if /i "!FORENSIC_LANG!"=="EN" echo !C_DIM!    Measured: somebody holds the disk extents open FOR WRITING. Copying it!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_DIM!    Medido: alguien mantiene los extents abiertos PARA ESCRIBIR. Copiarlo!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_DIM!    as is would produce an inconsistent image ^(a "smear"^).!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_DIM!    tal cual daria una imagen inconsistente ^(un "smear"^).!C_RESET!
goto VWL_DESC_DONE
:VWL_DESC_NOPROBE
if /i "!FORENSIC_LANG!"=="EN" echo !C_DIM!    The write probe could NOT be run ^(no PowerShell, or no readable extent^):!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_DIM!    La sonda de escritura NO se pudo ejecutar ^(sin PowerShell, o sin extents!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_DIM!    it is NOT asserted whether anything is writing. Assume the worst case.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_DIM!    legibles^): NO se afirma si algo esta escribiendo. Asuma el caso peor.!C_RESET!
goto VWL_DESC_DONE
:VWL_DESC_QUIESCENT
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![*] The disk "!_vwl_name!" keeps its VMware lock, but NOBODY is writing to it.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![*] El disco "!_vwl_name!" mantiene su candado de VMware, pero NADIE escribe en el.!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_OK!    Measured on !_vwl_pn! data file^(s^) of that disk: all of them open with write!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_OK!    Medido sobre !_vwl_pn! archivo^(s^) de datos de ese disco: todos abren negando!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_OK!    denied to third parties. Typical of a SUSPENDED VM or an ORPHAN lock left by!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_OK!    la escritura a terceros. Tipico de una VM SUSPENDIDA o de un candado!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_OK!    a VMware/host crash. In both cases the source is quiescent: reading it!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_OK!    HUERFANO de un cuelgue de VMware o del host. La fuente esta quiescente:!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_OK!    with qemu-img is consistent and needs NO snapshot and NO shutdown.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_OK!    leerla con qemu-img es consistente y no necesita snapshot ni apagado.!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Recommended: cancel with [0] and choose HOT acquisition in the engine menu.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Recomendado: cancele con [0] y elija la adquisición EN CALIENTE en el menu de motor.!C_RESET!
call :LOG_EVENT "Candado VMware retenido sobre !_vwl_path! pero la sonda de escritura sobre !_vwl_pn! extent(s) sale limpia: no hay nadie escribiendo (VM suspendida o candado huerfano). No se afirma smear."
:VWL_DESC_DONE
echo.
if "!_vwl_hasvmrun!"=="0" if /i "!FORENSIC_LANG!"=="EN" echo !C_DIM![i] vmrun.exe was not found: options 1 and 2 are unavailable.!C_RESET!
if "!_vwl_hasvmrun!"=="0" if /i not "!FORENSIC_LANG!"=="EN" echo !C_DIM![i] No se encontró vmrun.exe: las opciones 1 y 2 no estan disponibles.!C_RESET!
if "!_vwl_hasvmrun!"=="1" if "!_vwl_hasqemu!"=="0" if /i "!FORENSIC_LANG!"=="EN" echo !C_DIM![i] qemu-img.exe was not found: option 1 is unavailable.!C_RESET!
if "!_vwl_hasvmrun!"=="1" if "!_vwl_hasqemu!"=="0" if /i not "!FORENSIC_LANG!"=="EN" echo !C_DIM![i] No se encontró qemu-img.exe: la opción 1 no está disponible.!C_RESET!
if "!_vwl_hasvmrun!"=="1" if "!_vwl_hasqemu!"=="0" if /i "!FORENSIC_LANG!"=="EN" echo !C_DIM!    It is the one that reads the frozen base disk.!C_RESET!
if "!_vwl_hasvmrun!"=="1" if "!_vwl_hasqemu!"=="0" if /i not "!FORENSIC_LANG!"=="EN" echo !C_DIM!    Es la que lee el disco base congelado.!C_RESET!
rem "RECOMENDADO" solo cuando la sonda dice que alguien esta escribiendo: con el
rem disco ya quiescente, congelar no aporta nada y si escribe en el origen.
if "!_vwl_pq!"=="1" if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![1] Freeze the disk with a snapshot and acquire it hot  (NOT needed here)!C_RESET!
if "!_vwl_pq!"=="1" if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![1] Congelar el disco con un snapshot y adquirir en caliente  (aquí NO hace falta)!C_RESET!
if not "!_vwl_pq!"=="1" if /i "!FORENSIC_LANG!"=="EN" echo !C_OK![1] Freeze the disk with a snapshot and acquire it hot  (RECOMMENDED)!C_RESET!
if not "!_vwl_pq!"=="1" if /i not "!FORENSIC_LANG!"=="EN" echo !C_OK![1] Congelar el disco con un snapshot y adquirir en caliente  (RECOMENDADO)!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_DIM!    The VM keeps running. Writes move to a differential disk, the base disk!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_DIM!    La VM sigue corriendo. Las escrituras pasan a un disco diferencial, el!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_DIM!    stops changing, and the RAM is written to .vmsn/.vmem at that instant.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_DIM!    base deja de cambiar y la RAM se escribe en .vmsn/.vmem en ese instante.!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![2] Power off the VM from this script ^(vmrun stop soft^)!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![2] Apagar la VM desde este script ^(vmrun stop soft^)!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_DIM!    Consistent, but the guest shutdown destroys RAM and writes to the disk.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_DIM!    Consistente, pero el apagado destruye la RAM y escribe en el disco.!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![3] I will stop it myself - retry the check!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![3] La detengo yo - reintentar la verificación!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![0] Cancel!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![0] Cancelar!C_RESET!
:VWL_ASK
set "_vwl_opt="
if /i "!FORENSIC_LANG!"=="EN" set /p _vwl_opt="!C_PROMPT!Option [1]: !C_RESET!"
if /i not "!FORENSIC_LANG!"=="EN" set /p _vwl_opt="!C_PROMPT!Opción [1]: !C_RESET!"
if not defined _vwl_opt if "!_vwl_canfreeze!"=="1" set "_vwl_opt=1"
if not defined _vwl_opt set "_vwl_opt=3"
if "!_vwl_opt!"=="0" (
    set "VMWL_ABORT=1"
    call :LOG_EVENT "Adquisicion VMware cancelada: disco en uso sin resolver - !_vwl_path!"
    exit /b 0
)
if "!_vwl_opt!"=="1" if "!_vwl_canfreeze!"=="1" goto VWL_SNAPSHOT
if "!_vwl_opt!"=="3" (
    echo.
    if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Stop the VM in VMware and press any key to retry...!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Detenga la VM en VMware y presione una tecla para reintentar...!C_RESET!
    pause
    goto VWL_CHECK
)
if not "!_vwl_opt!"=="2" (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Invalid option. Enter 0, 1, 2 or 3.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Opción inválida. Ingrese 0, 1, 2 o 3.!C_RESET!
    goto VWL_ASK
)

:: --- Opcion 2: apagado (se conserva, pero ya no es la unica salida) -------
if not exist "!VMRUN_EXE!" (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] vmrun.exe was not found to power off automatically.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] No se encontró vmrun.exe para apagar automáticamente.!C_RESET!
    goto VWL_ASK
)
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Powering off the VM normally ^(vmrun stop soft^)...!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Apagando la VM de forma normal ^(vmrun stop soft^)...!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] "soft" = ACPI shutdown signal to the guest OS, same as the Shut Down button.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] "soft" = senal ACPI de apagado al SO invitado, igual que el boton Apagar.!C_RESET!
call :UTCNOW _VWL_TS1
"!VMRUN_EXE!" stop "!SELECTED_VM_VMX!" soft >nul 2>&1
set "_vwl_stop_el=!errorLevel!"
call :UTCNOW _VWL_TS2
call :TOOL_VER_ONCE TOOLVER_VMRUN "!VMRUN_EXE!" ""
call :LOG_CMD "VMware_StopSoft_Lock" "vmrun stop ""!SELECTED_VM_VMX!"" soft" "!_vwl_stop_el!" "!_VWL_TS1!" "!_VWL_TS2!" "" "" "!TOOLVER_VMRUN!"
:: El codigo se capturaba y se REGISTRABA, pero no se comprobaba nunca: un stop
:: que fallo de entrada -caso normal con la VM SUSPENDIDA, porque "vmrun stop"
:: exige la VM encendida- se premiaba con 60 segundos de espera inutil y despues
:: con un diagnostico enganoso sobre ACPI y VMware Tools. Si el comando fallo, se
:: dice y se vuelve al menu de inmediato.
if not "!_vwl_stop_el!"=="0" goto VWL_STOP_FAILED

if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Waiting for the disk to be released...!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Esperando a que se libere el disco...!C_RESET!
set "_vwl_wait=0"
:VWL_WAIT_LOOP
call :WAIT 3
if not exist "!_vwl_path!.lck" exit /b 0
set /a _vwl_wait+=3
if !_vwl_wait! lss 60 goto VWL_WAIT_LOOP

if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] The disk is still locked after 60 seconds of waiting.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] El disco sigue bloqueado tras 60 segundos de espera.!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] ACPI shutdown may require manual confirmation inside the guest!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] El apagado ACPI puede requerir confirmacion manual dentro del guest!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] ^(e.g. "save changes" dialogs^), or VMware Tools is not installed/!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] ^(ej. dialogos de "guardar cambios"^), o VMware Tools no esta instalado/!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] responding inside the guest ^(required for remote ACPI shutdown^).!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] respondiendo dentro del guest ^(requerido para el apagado ACPI remoto^).!C_RESET!
call :LOG_EVENT "Advertencia: disco sigue bloqueado tras vmrun stop soft + 60s de espera - !_vwl_path!"
goto VWL_CHECK

:VWL_STOP_FAILED
if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] "vmrun stop soft" returned code !_vwl_stop_el!: the shutdown was NOT even started.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] "vmrun stop soft" devolvio código !_vwl_stop_el!: el apagado NI SE INICIO.!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] The cause is NOT asserted. The most frequent one: the VM is SUSPENDED,!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] NO se afirma la causa. La mas frecuente: la VM esta SUSPENDIDA, y!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] and "vmrun stop" requires it powered on. Others: invalid .vmx path,!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] "vmrun stop" la exige encendida. Otras: ruta .vmx inválida, servicios!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] VMware services stopped, or an orphan lock with no VM behind it.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] de VMware detenidos, o un candado huerfano sin ninguna VM detras.!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] With the VM suspended, powering it off is NOT the way out: cancel with [0]!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Con la VM suspendida el apagado NO es la salida: cancele con [0] y elija!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] and choose HOT acquisition - a suspended source is already quiescent.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] la adquisición EN CALIENTE: una fuente suspendida ya esta quiescente.!C_RESET!
call :LOG_EVENT "Fallo 'vmrun stop soft' (codigo !_vwl_stop_el!) sobre !SELECTED_VM_VMX!: el apagado no se inicio y NO se espera a que se libere un disco que nadie va a liberar. No se atribuye causa."
echo.
goto VWL_ASK

:: --- Opcion 1: congelar con snapshot y adquirir en caliente ---------------
:VWL_SNAPSHOT
if not exist "!VMRUN_EXE!" (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] vmrun.exe is required to take the snapshot and was not found.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Se necesita vmrun.exe para tomar el snapshot y no se encontró.!C_RESET!
    goto VWL_ASK
)
call :UTCNOW _VWL_SNAPTS COMPACT
set "_vwl_snapname=FORENSE_!_VWL_SNAPTS!"
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Freezing the disk with a snapshot ^(the VM keeps running^)...!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Congelando el disco con un snapshot ^(la VM sigue corriendo^)...!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_DIM!    Snapshot name: !_vwl_snapname!!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_DIM!    Nombre del snapshot: !_vwl_snapname!!C_RESET!
rem AVISO OBLIGATORIO ANTES DE LLAMAR: "vmrun snapshot" es SINCRONICO y no
rem retorna cuando el disco queda congelado -eso ocurre en segundos- sino cuando
rem VMware termina de volcar toda la RAM del invitado a disco, en un solo hilo.
rem Con 2 GB de RAM eso son minutos. La consola queda sin salida y sin cursor:
rem sin avisarlo, el operador cree que se colgo y pulsa CTRL+C. Esta llamada es
rem DIRECTA, no pasa por :ACQUIRE, asi que un CTRL+C aqui mata el batch dejando
rem la carpeta de la VM mutada a medias.
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] This may take SEVERAL MINUTES and shows no output. Do NOT press CTRL+C.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] Esto puede tardar VARIOS MINUTOS y no muestra salida. NO pulse CTRL+C.!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_DIM!    The disk freezes within seconds, but vmrun does not return until VMware!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_DIM!    El disco se congela en segundos, pero vmrun no retorna hasta que VMware!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_DIM!    finishes writing the whole guest RAM to disk on a single thread.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_DIM!    acaba de volcar toda la RAM del invitado a disco, con un solo hilo.!C_RESET!
call :UTCNOW _VWL_TS3
"!VMRUN_EXE!" snapshot "!SELECTED_VM_VMX!" "!_vwl_snapname!" >nul 2>&1
set "_vwl_snap_el=!errorLevel!"
call :UTCNOW _VWL_TS4
call :TOOL_VER_ONCE TOOLVER_VMRUN "!VMRUN_EXE!" ""
call :LOG_CMD "VMware_SnapshotCongelar" "vmrun snapshot ""!SELECTED_VM_VMX!"" ""!_vwl_snapname!""" "!_vwl_snap_el!" "!_VWL_TS3!" "!_VWL_TS4!" "" "" "!TOOLVER_VMRUN!"
if not "!_vwl_snap_el!"=="0" (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] vmrun snapshot failed ^(code !_vwl_snap_el!^).!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] vmrun snapshot fallo ^(código !_vwl_snap_el!^).!C_RESET!
    call :LOG_EVENT "Error: vmrun snapshot fallo (codigo !_vwl_snap_el!) sobre !SELECTED_VM_VMX!"
    goto VWL_ASK
)

:: Verificacion de que el base quedo realmente quiescente, en la subrutina comun
:: :VMWARE_PROBE_QUIESCENT. Antes se sondeaba AQUI el DESCRIPTOR: con
:: twoGbMaxExtentSparse (descriptor de ~600 bytes + extents -sNNN) nadie mantiene
:: abierto el descriptor, asi que la sonda salia bien SIEMPRE y se afirmaba
:: "congelado: nadie lo tiene abierto para escritura" sin haber comprobado nada.
:: Medido en esta maquina contra una VM viva: sondeando el descriptor sale limpio,
:: sondeando los 3 extents sale ocupado. La sonda buena ya existia en
:: :VMWARE_HOT_SNAPSHOT; ahora es una sola y la usan las dos vias.
call :VMWARE_PROBE_QUIESCENT "!_vwl_path!"
set "_vwl_quiesced=!_VMWQ_QUIESCED!"
if "!_vwl_quiesced!"=="1" (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Base disk frozen: nobody holds it open for writing.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Disco base congelado: nadie lo tiene abierto para escritura.!C_RESET!
) else (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![*] Could not confirm the base disk is quiescent. Verify the hash twice!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![*] No se pudo confirmar que el disco base este quiescente. Verifique dos!C_RESET!
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![*] before trusting the acquisition.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![*] veces el hash antes de dar por buena la adquisición.!C_RESET!
)

echo.
rem Es una PRECAUCION, no un fallo: C_WARN, no C_ERR. Y la rama inglesa llevaba
rem la etiqueta espanola "[AVISO]". El framework usa un solo par: [CAUTION]/[ATENCIÓN].
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![CAUTION] DO NOT delete this snapshot in VMware.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![ATENCIÓN] NO elimine este snapshot en VMware.!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN!    Deleting it consolidates the differential disk INTO the base, which!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN!    Eliminarlo consolida el disco diferencial DENTRO del base, lo que!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN!    writes to the evidence and destroys the frozen state.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN!    escribe sobre la evidencia y destruye el estado congelado.!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_DIM!    Record the snapshot in the chain of custody: it adds files to the VM!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_DIM!    Documente el snapshot en la cadena de custodia: agrega archivos a la!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_DIM!    folder, but leaves the evidence disk byte for byte identical.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_DIM!    carpeta de la VM, pero deja el disco de evidencia byte a byte igual.!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_DIM!    The RAM of the same instant is in the .vmsn/.vmem of this snapshot.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_DIM!    La RAM de ese mismo instante queda en el .vmsn/.vmem del snapshot.!C_RESET!
echo.

set "VMWL_FROZEN=1"
set "VMWL_SNAPNAME=!_vwl_snapname!"
:: La sonda de quiescencia tambien tiene que VIAJAR al llamador: sin exportarla,
:: :VMWARE_HOT_ACQUIRE solo heredaba VMWL_FROZEN y el informe declaraba siempre
:: "NO se pudo confirmar que el base quedara quiescente" aunque SI se hubiera
:: comprobado. Era una afirmacion pesimista pero igualmente falsa.
set "VMWL_QUIESCED=!_vwl_quiesced!"
:: Conmutar al llamador a la rama EN CALIENTE. Sin esto el flujo volvia a la
:: consolidacion en frio con vmware-vdiskmanager.exe, que exige candado
:: EXCLUSIVO sobre un disco que sigue bloqueado -el ".lck" del base NO
:: desaparece al congelar, ver la nota de la cabecera-: fallaba SIEMPRE con
:: "FileIO_Lock ... failed" dejando la carpeta de la VM mutada con un snapshot
:: nuevo y sin producir ninguna imagen.
:: VMW_FREEZE=0 porque el snapshot YA se tomo aqui: en 1, :VMWARE_HOT_ACQUIRE
:: tomaria un SEGUNDO snapshot innecesario sobre la misma VM.
set "VMW_HOT=1"
set "VMW_FREEZE=0"
call :LOG_EVENT "Disco congelado sin apagar la VM: snapshot !_vwl_snapname! sobre !SELECTED_VM_VMX! (base=!_vwl_name!, quiescente=!_vwl_quiesced!)"
call :LOG_EVENT "Motor de adquisicion VMware conmutado a QEMU EN CALIENTE tras congelar con snapshot: el base sigue con candado cooperativo y vdiskmanager no puede leerlo - !SELECTED_VM_VMX!"
exit /b 0

:: -----------------------------------------------------------------------
:: VMWARE_HOT_ACQUIRE
:: %1 = descriptor .vmdk de origen, ruta completa (la VM puede estar encendida)
:: %2 = carpeta destino donde se escribe la imagen
:: %3 = nombre base de salida SIN extension
::
:: Adquisicion EN CALIENTE con qemu-img. Requiere !QEMU_IMG!, !DEST! y
:: !SELECTED_VM_VMX! ya definidos por el llamador.
::
:: POR QUE qemu-img y no vmware-vdiskmanager: el ".lck" de VMware es un candado
:: COOPERATIVO -una carpeta creada junto al archivo-, no un bloqueo del sistema
:: operativo, y vmware-vmx.exe abre el .vmdk con FILE_SHARE_READ. qemu-img no
:: implementa ese protocolo y simplemente abre el archivo. vdiskmanager exige
:: un candado EXCLUSIVO y falla siempre con la VM encendida.
::
:: HONESTIDAD FORENSE, no se maquilla: con una fuente VIVA no existe hash de
:: origen verificable. El unico hash reproducible es el de la IMAGEN resultante
:: y es el que se calcula SIEMPRE, sin preguntar. Del origen solo se anota una
:: referencia con marca temporal, etiquetada como NO reproducible y en archivos
:: aparte. NUNCA se afirma que el origen quedo "verificado" ni se comparan
:: hashes origen-imagen como si demostraran integridad.
::
:: Salidas: !VMW_HOT_OK! (1=imagen creada) y !VMW_HOT_IMG! (ruta de la imagen).
:: -----------------------------------------------------------------------
:VMWARE_HOT_ACQUIRE
set "_vha_src=%~1"
set "_vha_dir=%~2"
set "_vha_name=%~3"
set "VMW_HOT_OK=0"
set "VMW_HOT_IMG="
set "VMW_HOT_FROZEN=0"
set "VMW_HOT_QUIESCED=0"
set "VMW_HOT_SNAPNAME="

:: Si el disco ya se congelo en :VWL_SNAPSHOT (opcion 1 del menu de disco en
:: uso), el snapshot existe pero llega con VMW_FREEZE=0 para no tomar otro. Hay
:: que heredar el hecho o el informe declararia "sin snapshot" siendo falso.
if "!VMWL_FROZEN!"=="1" set "VMW_HOT_FROZEN=1"
if "!VMWL_FROZEN!"=="1" set "VMW_HOT_SNAPNAME=!VMWL_SNAPNAME!"
if "!VMWL_FROZEN!"=="1" set "VMW_HOT_QUIESCED=!VMWL_QUIESCED!"

:: Estado REAL del origen para pantalla, diario e informe. Esta via tambien
:: alcanza ahora a una VM SUSPENDIDA -fuente quiescente, sin ejecucion-, donde
:: afirmar "ENCENDIDA Y EN USO" y "ventana de smear" seria simplemente falso.
:: El texto se ELIGE segun lo medido; no se deja fijo en el caso peor.
set "_vha_susp=0"
if /i "!VMW_VMSTATE!"=="SUSPENDIDA" set "_vha_susp=1"
set "_vha_statehdr=MAQUINA ENCENDIDA DURANTE LA ADQUISICION"
set "_vha_statetxt=ENCENDIDA Y EN USO durante toda la lectura."
set "_vha_stateshort=ENCENDIDA durante la adquisicion."
if "!_vha_susp!"=="1" set "_vha_statehdr=MAQUINA SUSPENDIDA DURANTE LA ADQUISICION - FUENTE QUIESCENTE"
if "!_vha_susp!"=="1" set "_vha_statetxt=SUSPENDIDA durante toda la lectura: sin ejecucion, sin paginas sucias y sin escrituras al disco."
if "!_vha_susp!"=="1" set "_vha_stateshort=SUSPENDIDA durante la adquisicion (fuente quiescente)."

if not exist "!QEMU_IMG!" (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] qemu-img.exe not found: hot acquisition is not possible.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] qemu-img.exe no encontrado: no se puede adquirir en caliente.!C_RESET!
    call :LOG_EVENT "Error: qemu-img.exe no disponible para adquisicion en caliente - !QEMU_IMG!"
    exit /b 1
)
if not exist "!_vha_dir!" mkdir "!_vha_dir!" >nul 2>&1

echo.
echo !C_BORDER!!SUBLINE!!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" if not "!_vha_susp!"=="1" echo !C_ACCENT!  HOT DISK ACQUISITION - THE MACHINE STAYS POWERED ON!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" if not "!_vha_susp!"=="1" echo !C_ACCENT!  ADQUISICIÓN DE DISCO EN CALIENTE - LA MÁQUINA SIGUE ENCENDIDA!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" if "!_vha_susp!"=="1" echo !C_ACCENT!  DISK ACQUISITION WITH THE VM SUSPENDED - QUIESCENT SOURCE!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" if "!_vha_susp!"=="1" echo !C_ACCENT!  ADQUISICIÓN DE DISCO CON LA VM SUSPENDIDA - FUENTE QUIESCENTE!C_RESET!
echo !C_BORDER!!SUBLINE!!C_RESET!

:: Congelacion OPCIONAL previa (opcion 2 del menu de motor). Nunca aborta: si
:: el snapshot falla se sigue leyendo en caliente sin congelar y se declara.
if "!VMW_FREEZE!"=="1" call :VMWARE_HOT_SNAPSHOT

set "VMW_HOT_IMG=!_vha_dir!\!_vha_name!_caliente.raw"
set "_vha_hashfile=!_vha_dir!\!_vha_name!_caliente.sha256.txt"
set "_vha_report=!_vha_dir!\!_vha_name!_caliente_informe.txt"
set "_vha_ref_pre=!_vha_dir!\!_vha_name!_caliente_fuente_T_inicio.txt"
set "_vha_ref_post=!_vha_dir!\!_vha_name!_caliente_fuente_T_fin.txt"

:: Los nombres llevan el prefijo del disco a proposito, igual que los de
:: :QEMU_CONVERT: con un nombre fijo por carpeta, dos actuaciones en el mismo
:: destino se pisarian la documentacion.
if exist "!VMW_HOT_IMG!" (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![-] Already exists: !VMW_HOT_IMG!!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![-] Ya existe: !VMW_HOT_IMG!!C_RESET!
    set "_vha_ow="
    if /i "!FORENSIC_LANG!"=="EN" set /p _vha_ow="!C_PROMPT!Overwrite? [Y/N]: !C_RESET!"
    if /i not "!FORENSIC_LANG!"=="EN" set /p _vha_ow="!C_PROMPT!¿Sobrescribir? [S/N]: !C_RESET!"
    rem El prompt en ingles ofrece [Y/N]; se acepta Y como S.
    if /i "!_vha_ow!"=="Y" set "_vha_ow=S"
    if /I not "!_vha_ow!"=="S" (
        if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Hot acquisition cancelled.!C_RESET!
        if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Adquisición en caliente cancelada.!C_RESET!
        call :LOG_EVENT "Adquisicion en caliente cancelada: la imagen ya existia y no se autorizo sobreescribir - !VMW_HOT_IMG!"
        exit /b 1
    )
    del /f "!VMW_HOT_IMG!" >nul 2>&1
)

:: Version EXACTA del binario, con build id, para el informe. Se evita el pipe
:: a findstr: combinado con una ruta entre comillas dentro de un for /f,
:: cmd.exe pierde el pareo de comillas del ejecutable. Solo la primera linea
:: trae la version -la segunda es el copyright- y el guardia "if not defined"
:: se queda con la primera sin necesidad de filtrar.
set "_vha_qver="
for /f "usebackq tokens=3*" %%a in (`""!QEMU_IMG!" --version" 2^>^&1`) do (
    if not defined _vha_qver set "_vha_qver=%%a %%b"
)
if not defined _vha_qver set "_vha_qver=N/D"

:: Carpeta del origen, para localizar los extents "-sNNN.vmdk" / "-flat.vmdk".
for %%F in ("!_vha_src!") do set "_vha_srcdir=%%~dpF"

:: Hay extents aparte, o el disco es MONOLITICO. Importa para el informe: con
:: "monolithicSparse" el .vmdk es UN SOLO archivo que SI contiene los datos, asi
:: que la frase "el descriptor es texto de ~1 KB y NO contiene los datos del
:: disco" es falsa en ese caso y el hash del descriptor es, de hecho, el hash de
:: todo el disco. Se detecta por presencia de extents en lugar de suponerlo.
set "_vha_hasext=0"
for %%E in ("!_vha_srcdir!!_vha_name!-s*.vmdk" "!_vha_srcdir!!_vha_name!-flat*.vmdk") do set "_vha_hasext=1"
set "_vha_dscsize=0"
for %%Z in ("!_vha_src!") do set "_vha_dscsize=%%~zZ"

:: SHA-256 del DESCRIPTOR: es texto de ~1 KB y fija el layout de extents, el CID
:: y el ddb.uuid. NO es el hash de los datos del disco -esos viven en los
:: extents- ni valida la imagen: es una referencia puntual del estado del
:: descriptor en el instante en que se leyo.
::
:: Se calcula con HashMyFiles, que viaja en el proyecto. NO con certutil: en un
:: equipo comprometido un hasher manipulado devuelve un valor falso con
:: apariencia de valido, y eso contamina la cadena de custodia peor que la
:: ausencia del dato. Si no se puede calcular queda NO_CALCULADO, sin inventar
:: nada y sin recurrir a ningun binario del anfitrion.
set "_vha_dschash="
call :HASH_SHA256 "!_vha_src!" _vha_dschash
if not defined _vha_dschash set "_vha_dschash=NO_CALCULADO"

echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Reading the disk with qemu-img while the VM keeps running...!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Leyendo el disco con qemu-img con la VM en marcha...!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_DIM!    Source     : !_vha_src!!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_DIM!    Origen     : !_vha_src!!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_DIM!    Destination: !VMW_HOT_IMG!!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_DIM!    Destino    : !VMW_HOT_IMG!!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_DIM!    Tool       : qemu-img !_vha_qver!!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_DIM!    Herramienta: qemu-img !_vha_qver!!C_RESET!
echo.
:: "El origen NO se modifica" era cierto de qemu-img y FALSO tal como lo leia el
:: operador: el origen SI se esta modificando continuamente, por el invitado. Era la
:: unica frase de este modulo que se desviaba del rigor del resto.
if /i "!FORENSIC_LANG!"=="EN" echo !C_DIM![i] qemu-img opens the source WITHOUT requesting write access: the tool!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_DIM![i] qemu-img abre el origen SIN pedir acceso de escritura: la herramienta!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_DIM![i] does not modify it. The GUEST however IS modifying it while it is read.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_DIM![i] no lo modifica. El invitado SI lo está modificando mientras se lee.!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_DIM![i] The full flag-by-flag rationale is written to the report.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_DIM![i] La justificacion flag por flag queda escrita en el informe.!C_RESET!
echo.

:: Referencia de la fuente en T_inicio. NO es verificacion (ver cabecera).
call :UTCNOW _VHA_TS1
call :VMWARE_HOT_SRCREF "!_vha_ref_pre!" "T_inicio (antes de leer)" "!_VHA_TS1!"
call :LOG_EVENT "Ventana de adquisicion en caliente INICIADA - T_inicio=!_VHA_TS1! UTC - estado del origen: !_vha_stateshort! - origen !_vha_src! -> imagen !VMW_HOT_IMG!"

call :NEWGUID ACQ_GUID
set "ACQ_CMD=!TEMP!\forensic_cmd_!ACQ_GUID!.tmp"
rem Flags verificados contra el binario y contra el disco VIVO. El POR QUE de
rem cada uno, que es lo que hay que poder defender en un informe:
rem   -p            progreso sobre el tamano virtual del disco.
rem   -f vmdk       formato de ENTRADA explicito. En forense nunca se depende
rem                 de la autodeteccion: la sonda es por contenido y no es
rem                 documentable ni deterministicamente reproducible.
rem   -O raw        salida 1:1 sin contenedor: offset N en la imagen = offset N
rem                 del disco virtual, legible por Autopsy/sleuthkit/X-Ways sin
rem                 depender de qemu. Ademas el hash de un raw ES el contenido,
rem                 mientras que dos qcow2 identicos pueden hashear distinto.
rem   -U            abrir compartido. Aqui es inocuo, pero deja la intencion
rem                 explicita en la linea de comando que queda registrada.
rem   --salvage     equivalente de "dd conv=noerror,sync": un error de lectura
rem                 transitorio sobre un extent en escritura activa ya NO
rem                 aborta la adquisicion entera; la zona ilegible se rellena
rem                 con ceros y queda DECLARADA en el informe, no en silencio.
rem   -S 0          destino totalmente asignado, sin huecos sparse. Verificado:
rem                 NO cambia los bytes ni el SHA-256, asi que NO se justifica
rem                 como argumento de integridad en el informe.
rem   -m 16         mas corrutinas en paralelo: acorta el reloj y por tanto
rem                 ESTRECHA la ventana de smear. Ese es el argumento forense.
rem   -t writeback  cache del destino explicita. El defecto de "convert" es
rem                 "unsafe" (ignora los flush), indefendible en un informe.
rem NO usar -T none ni -T directsync: en este build fallan al abrir el vmdk
rem ("L1 entry size is invalid") y romperian la adquisicion. Tampoco -W, -c,
rem -C, -n ni --target-is-zero: rompen la propiedad 1:1 o pueden producir una
rem imagen corrupta en silencio.
rem OBSERVABILIDAD DE --salvage. Es el flag forensemente delicado: convierte los
rem errores de lectura en ceros y sigue devolviendo 0. Su unico aviso salia por la
rem consola, y el wrapper lanza el proceso heredando los handles SIN redirigir nada,
rem asi que ese aviso no quedaba en ningun archivo: la unica fuente del campo "Errores
rem de lectura" del informe era PREGUNTARLE AL OPERADOR. El ACQ_CMD se ejecuta via
rem "cmd /s /c", asi que basta redirigir el flujo de errores a un archivo. Medido: la
rem barra de progreso de -p va por la salida estandar y se sigue viendo igual, y el
rem archivo queda de 0 bytes cuando no hubo nada que decir. El "2^>" va escapado para
rem que la redireccion se ESCRIBA en el ACQ_CMD en vez de aplicarse a este echo.
set "VMW_HOT_ERR=!VMW_HOT_IMG!_qemu-img_stderr.log"
>"!ACQ_CMD!" echo "!QEMU_IMG!" convert -p -f vmdk -O raw -U --salvage -S 0 -m 16 -t writeback "!_vha_src!" "!VMW_HOT_IMG!" 2^>"!VMW_HOT_ERR!"
rem _vha_qver ya se leyo mas arriba con "--version": viaja tambien al registro de
rem comandos, no solo al informe de esta via.
set "ACQ_TOOL_VER=qemu-img !_vha_qver!"
call :ACQUIRE "VMware_Disco_EnCaliente_qemu-img" "!ACQ_CMD!"
set "_vha_el=!errorlevel!"
call :UTCNOW _VHA_TS2
call :TIMEDIFF _vha_dur "!_VHA_TS1!" "!_VHA_TS2!"
if not defined _vha_dur set "_vha_dur=N/D"

:: Referencia de la fuente en T_fin: si difiere de la de T_inicio, eso es un
:: hallazgo ESPERADO que se reporta -prueba que la fuente estaba viva-, no un
:: fallo. Se toma incluso si la adquisicion fallo: documenta el estado real.
call :VMWARE_HOT_SRCREF "!_vha_ref_post!" "T_fin (despues de leer)" "!_VHA_TS2!"

if "!_vha_el!"=="2" (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![ABORT] Hot acquisition aborted by the operator.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![ABORT] Adquisición en caliente abortada por el operador.!C_RESET!
    call :LOG_EVENT "Adquisicion en caliente ABORTADA por el operador con CTRL+C - T_inicio=!_VHA_TS1! T_corte=!_VHA_TS2! UTC - la imagen queda INCOMPLETA: !VMW_HOT_IMG!"
    exit /b 1
)
if not "!_vha_el!"=="0" (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] qemu-img failed reading the disk ^(code !_vha_el!^).!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] qemu-img fallo al leer el disco ^(código !_vha_el!^).!C_RESET!
    call :LOG_EVENT "Error: adquisicion en caliente fallo (codigo !_vha_el!) - origen !_vha_src!"
    exit /b 1
)
if not exist "!VMW_HOT_IMG!" (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] qemu-img returned 0 but the image does not exist.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] qemu-img devolvio 0 pero la imagen no existe.!C_RESET!
    call :LOG_EVENT "Error: adquisicion en caliente sin imagen de salida - !VMW_HOT_IMG!"
    exit /b 1
)

if /i "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Image created. The VM was never powered off.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Imagen creada. La VM nunca se apago.!C_RESET!
call :LOG_EVENT "Ventana de adquisicion en caliente CERRADA - T_fin=!_VHA_TS2! UTC - duracion (ventana de smear)=!_vha_dur! - imagen !VMW_HOT_IMG!"

:: Tamano exacto en bytes de la imagen: junto al SHA-256 es lo que identifica
:: la evidencia de forma reproducible.
set "_vha_size=0"
for %%Z in ("!VMW_HOT_IMG!") do set "_vha_size=%%~zZ"

:: ERRORES DE LECTURA: se MIDEN sobre el archivo de errores capturado, no se le
:: preguntan al operador. Un "ninguno observado" respondido de memoria por quien acaba
:: de ver pasar una barra de progreso no es prueba de nada, y ese campo del informe es
:: justamente el que declara si --salvage sustituyo datos por ceros.
:: El literal "error while reading offset %llu: %s" se verifico en la tabla de cadenas
:: del binario 9.2.0; se busca "error while reading" para cubrir tambien las variantes
:: "at byte" y "block status at offset".
echo.
:: Se limpia en cada pasada: heredar el valor de una adquisicion anterior de la misma
:: sesion haria que esta declarara errores -o su ausencia- que no son suyos.
set "_vha_rderr="
set "_vha_errsz=0"
for %%Z in ("!VMW_HOT_ERR!") do set "_vha_errsz=%%~zZ"
set "_vha_errtxt=NO SE PUDO MEDIR: no existe el archivo de errores !VMW_HOT_ERR!, asi que NO puede afirmarse que no hubiera errores de lectura."
if not exist "!VMW_HOT_ERR!" goto VHA_ERRCHK_DONE
set "_vha_errtxt=Ninguno: qemu-img no escribio nada en su flujo de errores (!VMW_HOT_ERR!, 0 bytes). Medido, no declarado de memoria."
if "!_vha_errsz!"=="0" goto VHA_ERRCHK_DONE
findstr /i /c:"error while reading" "!VMW_HOT_ERR!" >nul 2>&1
:: El errorlevel se captura AQUI: el siguiente "set" lo pondria a 0 y la comprobacion
:: siguiente leeria un exito que no es el de findstr.
set "_vha_rderr=!errorlevel!"
if not "!_vha_rderr!"=="0" set "_vha_errtxt=qemu-img escribio !_vha_errsz! bytes de diagnostico en !VMW_HOT_ERR! sin errores de lectura reconocibles. Ese archivo debe leerse antes de dar la imagen por buena."
if "!_vha_rderr!"=="0" set "_vha_errtxt=SI HUBO ERRORES DE LECTURA. --salvage sustituyo esas zonas por CEROS y qemu-img devolvio 0 igualmente: la imagen NO reproduce el origen en ellas y su SHA-256 valida esos ceros, no los datos. Desplazamientos concretos en !VMW_HOT_ERR!."
:VHA_ERRCHK_DONE
if "!_vha_rderr!"=="0" if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] qemu-img reported READ ERRORS: --salvage wrote ZEROS there. See !VMW_HOT_ERR!!C_RESET!
if "!_vha_rderr!"=="0" if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] qemu-img reportó ERRORES DE LECTURA: --salvage escribió CEROS ahí. Vea !VMW_HOT_ERR!!C_RESET!
call :LOG_EVENT "Errores de lectura de la adquisicion en caliente (medidos sobre el flujo de errores capturado, no preguntados al operador): !_vha_errtxt!"

:: ------------------------------------------------------------------------
:: HASH DE LA IMAGEN YA PRODUCIDA. Se calcula sobre el RESULTADO, nunca sobre la
:: fuente: la fuente esta viva y cambia mientras se lee, asi que su hash no es
:: reproducible y no acreditaria nada. La imagen, en cambio, es un archivo
:: terminado y su hash SI es reproducible por un tercero.
::
:: El operador elige el algoritmo y puede renunciar (opcion 4), en cuyo caso se
:: registra como fallo, no como exito, porque eso es lo que es. Antes esto
:: se imponia sin preguntar; ahora se pregunta siempre, con SHA-256 por defecto
:: al pulsar Enter, de modo que el camino comodo sigue siendo el que deja la
:: evidencia hasheada.
::
:: Motor: HashMyFiles, que viaja en el proyecto. Nunca certutil ni ningun otro
:: binario del equipo analizado.
:: ------------------------------------------------------------------------
call :ASK_HASH_ALGO
set "_vha_hash="
set "_vha_hmd5="
set "_vha_hsha1="
set "_vha_halgtxt=!_HA_TXT!"
call :UTCNOW _VHA_HTS1
if defined _HA_NINGUNO goto VHA_HASH_OMITIDO
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Calculating !_vha_halgtxt! of the ACQUIRED IMAGE...!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Calculando !_vha_halgtxt! de la IMAGEN ADQUIRIDA...!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_DIM!    !_vha_size! bytes. This may take several minutes.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_DIM!    !_vha_size! bytes. Esto puede tardar varios minutos.!C_RESET!
call :HASH_SHA256 "!VMW_HOT_IMG!" _vha_hash
if defined _HA_MD5  call :HASH_SHA256 "!VMW_HOT_IMG!" _vha_hmd5 MD5
if defined _HA_SHA1 call :HASH_SHA256 "!VMW_HOT_IMG!" _vha_hsha1 SHA1
:VHA_HASH_OMITIDO
call :UTCNOW _VHA_HTS2
:: :HASH_SHA256 ya valida longitud y alfabeto y devuelve VACIO si no pudo. Un
:: vacio aqui significa "no calculado", nunca un valor de procedencia dudosa
:: publicado como hash autoritativo de la evidencia.
if not defined _vha_hash set "_vha_hash=NO_CALCULADO"
set "_vha_hel=0"
if "!_vha_hash!"=="NO_CALCULADO" set "_vha_hel=1"
if defined _HA_NINGUNO call :LOG_CMD "VMware_Hot_Hash_Imagen" "(omitido por el operador: !_HA_MOTIVO!)" "1" "!_VHA_HTS1!" "!_VHA_HTS2!" "!VMW_HOT_IMG!" "!_vha_hashfile!"
if not defined _HA_NINGUNO call :LOG_CMD "VMware_Hot_Hash_Imagen" "HashMyFiles !_vha_halgtxt! ""!VMW_HOT_IMG!""" "!_vha_hel!" "!_VHA_HTS1!" "!_VHA_HTS2!" "!VMW_HOT_IMG!" "!_vha_hashfile!"
if defined _HA_NINGUNO call :LOG_EVENT "El operador RENUNCIO al hash de la imagen adquirida en caliente. Motivo declarado: !_HA_MOTIVO!. La imagen existe pero queda SIN huella criptografica y NO debe declararse integridad verificada de ella - !VMW_HOT_IMG!"
if not defined _HA_NINGUNO if "!_vha_hel!"=="0" call :LOG_EVENT "Hash !_vha_halgtxt! de la IMAGEN adquirida en caliente (HashMyFiles) = !_vha_hash! (!_vha_size! bytes) - !VMW_HOT_IMG!"
if not defined _HA_NINGUNO if defined _vha_hmd5 call :LOG_EVENT "MD5 complementario de la IMAGEN adquirida en caliente = !_vha_hmd5! - !VMW_HOT_IMG!"
if not defined _HA_NINGUNO if defined _vha_hsha1 call :LOG_EVENT "SHA-1 complementario de la IMAGEN adquirida en caliente = !_vha_hsha1! - !VMW_HOT_IMG!"
if not defined _HA_NINGUNO if "!_vha_hel!"=="1" call :LOG_EVENT "Advertencia: no se pudo calcular el hash de la imagen adquirida en caliente con HashMyFiles - !VMW_HOT_IMG!"

:: Si el hash no salio, este archivo NO puede seguir titulandose "autoritativo"
:: ni acreditar integridad alguna: se declara la ausencia. Lo contrario es
:: exactamente lo que la regla forense del proyecto prohibe. El texto se resuelve
:: en variables porque una redireccion pegada a un "if" se aplica al if completo
:: y truncaria el archivo tambien cuando la condicion es falsa.
set "_vha_hdr=SHA-256 DE LA IMAGEN ADQUIRIDA - hash autoritativo y reproducible"
set "_vha_ac1=Este hash acredita la integridad de la evidencia ADQUIRIDA, desde el"
set "_vha_ac2=instante de la adquisicion en adelante. NO acredita coincidencia con el"
set "_vha_ac3=disco de origen: la fuente estaba viva y no admite un hash verificable."
if "!_vha_hel!"=="1" set "_vha_hdr=SHA-256 DE LA IMAGEN ADQUIRIDA - NO DISPONIBLE"
if "!_vha_hel!"=="1" set "_vha_ac1=NO se pudo calcular el hash de la imagen: HashMyFiles no devolvio un SHA-256"
if "!_vha_hel!"=="1" set "_vha_ac2=valido. Esta evidencia queda SIN acreditacion de integridad: debe hashearse"
if "!_vha_hel!"=="1" set "_vha_ac3=con otra herramienta antes de darla por valida en la cadena de custodia."

:: El informe es el entregable que se aporta al expediente, asi que su rotulo y su
:: parrafo tienen que decir lo MISMO que el .sha256.txt: si no hay hash, no puede
:: titularse AUTORITATIVO Y REPRODUCIBLE ni prometer que cualquiera obtendra el
:: mismo valor para siempre, porque no hay ningun valor que rehashear. Se resuelve
:: aqui, junto al resto del texto condicional, para no pegar una redireccion a un
:: "if": la redireccion se aplicaria al if completo y truncaria el informe.
set "_vha_rhdr==== HASH DE LA EVIDENCIA ADQUIRIDA  (AUTORITATIVO Y REPRODUCIBLE) ==="
set "_vha_rp1=  Este es el UNICO hash reproducible del conjunto: cualquiera que rehashee"
set "_vha_rp2=  este archivo obtendra el mismo valor para siempre. La integridad que"
set "_vha_rp3=  acredita es la de la evidencia ADQUIRIDA, desde el instante de la"
set "_vha_rp4=  adquisicion en adelante."
if "!_vha_hel!"=="1" set "_vha_rhdr==== HASH DE LA EVIDENCIA ADQUIRIDA - NO DISPONIBLE ==="
if "!_vha_hel!"=="1" set "_vha_rp1=  NO se pudo calcular el SHA-256 de la imagen adquirida: HashMyFiles no devolvio"
if "!_vha_hel!"=="1" set "_vha_rp2=  un valor valido. Esta evidencia queda SIN acreditacion de integridad y este"
if "!_vha_hel!"=="1" set "_vha_rp3=  informe NO puede afirmar que su hash sea reproducible. Debe hashearse con"
if "!_vha_hel!"=="1" set "_vha_rp4=  otra herramienta antes de darla por valida en la cadena de custodia."

>"!_vha_hashfile!" echo !_vha_hdr!
>>"!_vha_hashfile!" echo.
>>"!_vha_hashfile!" echo !_vha_hash!  *!_vha_name!_caliente.raw
>>"!_vha_hashfile!" echo.
>>"!_vha_hashfile!" echo Archivo         : !VMW_HOT_IMG!
>>"!_vha_hashfile!" echo Tamano exacto   : !_vha_size! bytes
>>"!_vha_hashfile!" echo Calculado (UTC) : !_VHA_HTS1! -^> !_VHA_HTS2!
>>"!_vha_hashfile!" echo Estado de la VM : !_vha_stateshort!
>>"!_vha_hashfile!" echo.
>>"!_vha_hashfile!" echo !_vha_ac1!
>>"!_vha_hashfile!" echo !_vha_ac2!
>>"!_vha_hashfile!" echo !_vha_ac3!

:: ------------------------------------------------------------------------
:: Informe. Documenta el metodo de forma DEFENDIBLE: separa el hash de la
:: evidencia (autoritativo) de la referencia de la fuente (no reproducible) y
:: declara la ventana de smear en lugar de disimularla.
:: ------------------------------------------------------------------------
rem El informe distingue TOMAR el snapshot de COMPROBAR que el base quedo
rem quiescente: son dos hechos distintos y el segundo puede fallar aunque vmrun
rem devuelva 0. Sin esa distincion el documento afirmaria como probado algo que
rem el propio script declaro no poder confirmar.
set "_vha_frozentxt=NO. El disco se leyo tal cual, con la VM en marcha y sin crear ningun snapshot."
if "!VMW_HOT_FROZEN!"=="1" set "_vha_frozentxt=SI se tomo el snapshot forense !VMW_HOT_SNAPNAME! antes de leer, pero NO se pudo confirmar que el base quedara quiescente."
if "!VMW_HOT_FROZEN!"=="1" if "!VMW_HOT_QUIESCED!"=="1" set "_vha_frozentxt=SI. Snapshot forense !VMW_HOT_SNAPNAME! tomado antes de leer: las escrituras pasaron a un disco diferencial y se COMPROBO que ningun proceso mantiene los extents del base abiertos para escritura."
set "_vha_elev=NO"
if defined IS_ADMIN set "_vha_elev=SI"

>"!_vha_report!" echo ===============================================================================
>>"!_vha_report!" echo   INFORME DE ADQUISICION DE DISCO VIRTUAL EN CALIENTE  ^(VMware / qemu-img^)
>>"!_vha_report!" echo   !_vha_statehdr!
>>"!_vha_report!" echo ===============================================================================
>>"!_vha_report!" echo.
>>"!_vha_report!" echo --- ESTADO DEL SISTEMA DURANTE LA ADQUISICION ---
>>"!_vha_report!" echo Estado de la VM      : !_vha_statetxt!
>>"!_vha_report!" echo Configuracion VMX    : !SELECTED_VM_VMX!
rem La explicacion anterior atribuia la causa al share mode de vmware-vmx.exe, y de
rem ahi se sigue implicitamente que cualquier lector de solo lectura funcionaria.
rem Esa prediccion la FALSA este mismo framework, que documenta que certutil y
rem Get-FileHash -share solo READ- no pueden hashear los extents de una VM viva. Lo
rem medido con CreateFileW en este proyecto es que gobierna el share mode del LECTOR.
>>"!_vha_report!" echo Candado VMware       : el descriptor mantiene su carpeta ".lck". Es un candado
>>"!_vha_report!" echo                        COOPERATIVO de VMware, no un bloqueo del sistema
>>"!_vha_report!" echo                        operativo. Lo que gobierna el acceso real es el SHARE
>>"!_vha_report!" echo                        MODE QUE SOLICITA EL LECTOR. Medido con CreateFileW
>>"!_vha_report!" echo                        sobre los extents de una VM encendida: pedir solo
>>"!_vha_report!" echo                        FILE_SHARE_READ devuelve ERROR_SHARING_VIOLATION (32);
>>"!_vha_report!" echo                        pedir FILE_SHARE_READ mas FILE_SHARE_WRITE abre bien.
>>"!_vha_report!" echo                        qemu-img solicita el segundo y por eso puede leer, igual
>>"!_vha_report!" echo                        que HashMyFiles. certutil y Get-FileHash piden solo
>>"!_vha_report!" echo                        FILE_SHARE_READ y por eso NO pueden abrirlos.
>>"!_vha_report!" echo Hash autoritativo    : el de la IMAGEN, no el de la fuente.
>>"!_vha_report!" echo Congelacion previa   : !_vha_frozentxt!
rem Snapshot tomado pero quiescencia SIN acreditar: se dice en el informe, con
rem la misma consecuencia practica que no haber congelado.
if "!VMW_HOT_FROZEN!"=="1" if not "!VMW_HOT_QUIESCED!"=="1" (
    >>"!_vha_report!" echo                        La sonda de escritura sobre los extents del base no se
    >>"!_vha_report!" echo                        pudo ejecutar o no dio resultado limpio, asi que la
    >>"!_vha_report!" echo                        quiescencia del base NO queda acreditada: tratese esta
    >>"!_vha_report!" echo                        imagen como temporalmente INCONSISTENTE, igual que si
    >>"!_vha_report!" echo                        no se hubiera congelado. Ver "quiescente=" en el diario.
)
>>"!_vha_report!" echo Host                 : !COMPUTERNAME!
>>"!_vha_report!" echo Operador             : !USERNAME!
>>"!_vha_report!" echo Sistema operativo    : !WIN_NAME! ^(!WIN_ARCH!^)
>>"!_vha_report!" echo Shell elevada        : !_vha_elev!
>>"!_vha_report!" echo.
rem El informe declaraba correctamente QUE se tomo el snapshot, pero no enumeraba
rem QUE ESCRIBIO en el origen ni que esos cambios persisten. El aviso de no borrarlo
rem vivia solo en pantalla. Se declara aqui, de antemano y por escrito.
if not "!VMW_HOT_FROZEN!"=="1" goto VHA_REP_NOSNAP
>>"!_vha_report!" echo --- ESCRITURAS SOBRE EL ORIGEN REALIZADAS POR ESTA ADQUISICION ---
>>"!_vha_report!" echo   El snapshot forense escribio en el directorio de la maquina de origen:
>>"!_vha_report!" echo     - disco diferencial nuevo "-000001.vmdk" ^(recibe las escrituras posteriores^)
>>"!_vha_report!" echo     - archivo de estado ".vmsn" ^(y ".vmem" si la VM tenia RAM asignada^)
>>"!_vha_report!" echo     - reescritura de scsi*.fileName en el ".vmx" y de la cadena en el ".vmsd"
>>"!_vha_report!" echo   Estas modificaciones PERSISTEN. Son la contrapartida deliberada de congelar
>>"!_vha_report!" echo   el disco base sin apagar la maquina, y se declaran aqui de antemano.
>>"!_vha_report!" echo   NO ELIMINAR el snapshot !VMW_HOT_SNAPNAME!: al borrarlo, VMware consolida el
>>"!_vha_report!" echo   diferencial DENTRO del base, escribiendo sobre la evidencia.
>>"!_vha_report!" echo.
goto VHA_REP_SNAPDONE
:VHA_REP_NOSNAP
>>"!_vha_report!" echo --- ESCRITURAS SOBRE EL ORIGEN REALIZADAS POR ESTA ADQUISICION ---
>>"!_vha_report!" echo   NINGUNA. No se tomo snapshot: no se creo ningun disco diferencial, no se
>>"!_vha_report!" echo   escribio ningun .vmsn/.vmem y no se reescribieron el .vmx ni el .vmsd. La
>>"!_vha_report!" echo   lectura fue estrictamente pasiva sobre los extents del disco de origen.
>>"!_vha_report!" echo.
:VHA_REP_SNAPDONE
>>"!_vha_report!" echo --- VENTANA DE ADQUISICION ^(VENTANA DE SMEAR^) ---
>>"!_vha_report!" echo T_inicio ^(UTC^)       : !_VHA_TS1!
>>"!_vha_report!" echo T_fin    ^(UTC^)       : !_VHA_TS2!
if "!_vha_susp!"=="1" goto VHA_REP_SUSPWIN
>>"!_vha_report!" echo Duracion             : !_vha_dur!   = ventana de smear
>>"!_vha_report!" echo.
>>"!_vha_report!" echo   La imagen NO es atomica, NO es point-in-time y NO es crash-consistent. Es
>>"!_vha_report!" echo   una adquisicion en vivo, temporalmente INCONSISTENTE por construccion
>>"!_vha_report!" echo   ^("smeared image"^): distintas regiones reflejan distintos instantes dentro
>>"!_vha_report!" echo   de la ventana T_inicio - T_fin. Los archivos escritos durante la ventana
>>"!_vha_report!" echo   pueden aparecer parcialmente escritos, y los metadatos del sistema de
>>"!_vha_report!" echo   archivos pueden no concordar con el contenido: el analisis puede requerir
>>"!_vha_report!" echo   replay de journal o fsck. Se declara de antemano, no se descubre despues.
>>"!_vha_report!" echo.
>>"!_vha_report!" echo --- JUSTIFICACION DEL METODO ---
>>"!_vha_report!" echo   Orden de volatilidad ^(RFC 3227^). Se acepta una imagen difuminada porque la
>>"!_vha_report!" echo   alternativa atomica no esta disponible con el sistema en marcha, y apagarlo
>>"!_vha_report!" echo   destruiria estado volatil: RAM, procesos, conexiones y caches. La decision
>>"!_vha_report!" echo   de adquirir en caliente es deliberada y esta documentada aqui.
>>"!_vha_report!" echo.
goto VHA_REP_WINDONE
:VHA_REP_SUSPWIN
rem VM SUSPENDIDA: no hay ventana de smear porque no hay nada escribiendo. Se
rem sigue registrando la duracion -es el intervalo de la lectura y forma parte
rem de la trazabilidad- pero NO se la presenta como una ventana de inconsistencia
rem que no existe, ni se invoca una justificacion que aqui no hace falta.
>>"!_vha_report!" echo Duracion             : !_vha_dur!   = duracion de la lectura
>>"!_vha_report!" echo.
>>"!_vha_report!" echo   La VM estaba SUSPENDIDA durante toda la lectura: no habia ejecucion, ningun
>>"!_vha_report!" echo   proceso invitado escribia y el disco permanecio quiescente. Por eso NO hay
>>"!_vha_report!" echo   ventana de smear: la imagen refleja un unico instante, el de la suspension.
>>"!_vha_report!" echo   El candado ".lck" sigue puesto porque VMware lo retiene hasta reanudar, pero
>>"!_vha_report!" echo   un candado retenido no implica escrituras. Lo que acredita la quiescencia es
>>"!_vha_report!" echo   la sonda de apertura sobre los extents, no la ausencia del candado.
>>"!_vha_report!" echo.
>>"!_vha_report!" echo   LIMITE DE ESTA AFIRMACION: no se ha verificado con un hash del ORIGEN que
>>"!_vha_report!" echo   los extents fueran identicos antes y despues de la lectura. La quiescencia
>>"!_vha_report!" echo   se sostiene en el estado de suspension y en la sonda de escritura, no en una
>>"!_vha_report!" echo   comparacion de hashes: no se declara verificacion cruzada origen-imagen.
>>"!_vha_report!" echo.
>>"!_vha_report!" echo --- JUSTIFICACION DEL METODO ---
>>"!_vha_report!" echo   Orden de volatilidad ^(RFC 3227^). Se lee con la VM suspendida y NO se la
>>"!_vha_report!" echo   reanuda ni se la apaga: reanudarla escribiria en el disco y consumiria el
>>"!_vha_report!" echo   ".vmss", destruyendo el estado volatil que acompana a esta imagen. Apagarla
>>"!_vha_report!" echo   destruiria lo mismo sin ganar consistencia: la fuente ya esta quiescente.
>>"!_vha_report!" echo.
:VHA_REP_WINDONE
>>"!_vha_report!" echo !_vha_rhdr!
>>"!_vha_report!" echo Imagen               : !VMW_HOT_IMG!
>>"!_vha_report!" echo Formato              : raw, 1:1, sin contenedor
>>"!_vha_report!" echo Tamano exacto        : !_vha_size! bytes
>>"!_vha_report!" echo SHA-256 de la imagen : !_vha_hash!
>>"!_vha_report!" echo Calculado ^(UTC^)      : !_VHA_HTS1! -^> !_VHA_HTS2!
>>"!_vha_report!" echo Archivo de hash      : !_vha_hashfile!
>>"!_vha_report!" echo.
>>"!_vha_report!" echo !_vha_rp1!
>>"!_vha_report!" echo !_vha_rp2!
>>"!_vha_report!" echo !_vha_rp3!
>>"!_vha_report!" echo !_vha_rp4!
>>"!_vha_report!" echo.
>>"!_vha_report!" echo === REFERENCIA TEMPORAL DE LA FUENTE  ^(NO REPRODUCIBLE - FUENTE VIVA^) ===
>>"!_vha_report!" echo   Esto NO es una verificacion. NO procede la verificacion cruzada
>>"!_vha_report!" echo   origen-imagen por tratarse de una fuente viva. Se espera que un hash del
>>"!_vha_report!" echo   origen tomado antes y otro tomado despues DIFIERAN: esa diferencia es
>>"!_vha_report!" echo   evidencia documentada de que la fuente estaba en uso, NO un fallo ni un
>>"!_vha_report!" echo   indicio de manipulacion. Estos valores se listan aparte del hash de la
>>"!_vha_report!" echo   evidencia a proposito: ninguno de los dos valida al otro.
>>"!_vha_report!" echo.
>>"!_vha_report!" echo Archivo .vmdk origen : !_vha_src!
>>"!_vha_report!" echo Tamano de ese archivo: !_vha_dscsize! bytes
>>"!_vha_report!" echo SHA-256 de ese archivo: !_vha_dschash!
if "!_vha_hasext!"=="1" >>"!_vha_report!" echo                        ^(referencia puntual: aqui el .vmdk es solo el
if "!_vha_hasext!"=="1" >>"!_vha_report!" echo                        DESCRIPTOR, que fija el layout de extents, el CID y
if "!_vha_hasext!"=="1" >>"!_vha_report!" echo                        el ddb.uuid. NO contiene los datos del disco, que
if "!_vha_hasext!"=="1" >>"!_vha_report!" echo                        estan en los extents, y el CID cambia en cada ciclo
if "!_vha_hasext!"=="1" >>"!_vha_report!" echo                        de encendido.^)
if "!_vha_hasext!"=="0" >>"!_vha_report!" echo                        ^(referencia puntual: NO se detectaron extents aparte,
if "!_vha_hasext!"=="0" >>"!_vha_report!" echo                        asi que este .vmdk es monolitico y SI contiene los
if "!_vha_hasext!"=="0" >>"!_vha_report!" echo                        datos del disco. Aun asi NO valida la imagen: se leyo
if "!_vha_hasext!"=="0" >>"!_vha_report!" echo                        con la fuente en uso y el valor no es reproducible.^)
>>"!_vha_report!" echo Extents en T_inicio  : !_vha_ref_pre!
>>"!_vha_report!" echo Extents en T_fin     : !_vha_ref_post!
>>"!_vha_report!" echo                        ^(tamano y fecha de modificacion de cada extent en los
>>"!_vha_report!" echo                        dos instantes. Si cambian, la mutacion de la fuente
>>"!_vha_report!" echo                        queda DEMOSTRADA, que es exactamente el objetivo.^)
>>"!_vha_report!" echo.
>>"!_vha_report!" echo --- COMPROBACIONES QUE SI SON REPRODUCIBLES ---
>>"!_vha_report!" echo   1^) Consistencia estructural interna: el tamano virtual que declara el
>>"!_vha_report!" echo      disco debe coincidir con el tamano exacto de la imagen raw. Ver el
>>"!_vha_report!" echo      bloque "INFO QEMU-IMG" al final de este informe.
>>"!_vha_report!" echo   2^) Cadena de custodia posterior: al copiar esta imagen al medio de
>>"!_vha_report!" echo      evidencia, recalcule su SHA-256. Ese segundo hash DEBE coincidir con el
>>"!_vha_report!" echo      de arriba, y esa coincidencia si es un eslabon verificable: prueba que
>>"!_vha_report!" echo      la imagen no se altero al manipularla. Es el sustituto real de la
>>"!_vha_report!" echo      verificacion contra el origen, que aqui no es posible.
>>"!_vha_report!" echo.
>>"!_vha_report!" echo --- HERRAMIENTA Y LINEA DE COMANDO ---
>>"!_vha_report!" echo Herramienta          : qemu-img !_vha_qver!
>>"!_vha_report!" echo Binario              : !QEMU_IMG!
>>"!_vha_report!" echo Resultado wrapper    : !_vha_el!  ^(0=ok 1=fallo 2=abortado por CTRL+C^)
>>"!_vha_report!" echo                        NO es el codigo de salida de qemu-img: el wrapper
>>"!_vha_report!" echo                        normaliza cualquier codigo distinto de 0 a 1, asi que el
>>"!_vha_report!" echo                        codigo real de la herramienta no llega hasta aqui.
>>"!_vha_report!" echo Errores de lectura   : !_vha_errtxt!
>>"!_vha_report!" echo Flujo de errores     : !VMW_HOT_ERR!
>>"!_vha_report!" echo Comando literal      :
>>"!_vha_report!" echo   "!QEMU_IMG!" convert -p -f vmdk -O raw -U --salvage -S 0 -m 16 -t writeback "!_vha_src!" "!VMW_HOT_IMG!" 2^>"!VMW_HOT_ERR!"
>>"!_vha_report!" echo.
>>"!_vha_report!" echo   -O raw        imagen 1:1 sin contenedor: el offset N de la imagen es el
>>"!_vha_report!" echo                 offset N del disco virtual. Legible por Autopsy, sleuthkit,
>>"!_vha_report!" echo                 X-Ways o FTK sin depender de qemu, y su hash ES el contenido.
>>"!_vha_report!" echo   -f vmdk       formato de entrada EXPLICITO. No se usa autodeteccion: la
>>"!_vha_report!" echo                 sonda es por contenido y no es documentable ni reproducible.
>>"!_vha_report!" echo   -U            apertura compartida, declarada de forma explicita.
>>"!_vha_report!" echo   --salvage     los errores de lectura no abortan la copia; las zonas
>>"!_vha_report!" echo                 ilegibles se rellenan con ceros. qemu-img devuelve 0 aunque
>>"!_vha_report!" echo                 ocurra, asi que el flujo de errores de la herramienta se
>>"!_vha_report!" echo                 REDIRIGE al archivo indicado arriba y el campo "Errores de
>>"!_vha_report!" echo                 lectura" se DERIVA de ese archivo. No queda en silencio ni
>>"!_vha_report!" echo                 depende de lo que recuerde el operador.
>>"!_vha_report!" echo   -S 0          destino totalmente asignado, sin huecos sparse. Verificado:
>>"!_vha_report!" echo                 NO altera los bytes ni el SHA-256. No se invoca como
>>"!_vha_report!" echo                 argumento de integridad, solo de asignacion fisica.
>>"!_vha_report!" echo   -m 16         mas corrutinas en paralelo: acorta el tiempo total y por
>>"!_vha_report!" echo                 tanto ESTRECHA la ventana de smear.
>>"!_vha_report!" echo   -t writeback  cache del destino explicita. El valor por defecto de
>>"!_vha_report!" echo                 "convert" es "unsafe", que ignora los flush.
>>"!_vha_report!" echo.
>>"!_vha_report!" echo --- INFO QEMU-IMG DE LA IMAGEN ADQUIRIDA ---
"!QEMU_IMG!" info "!VMW_HOT_IMG!" >>"!_vha_report!" 2>&1
>>"!_vha_report!" echo.
>>"!_vha_report!" echo --- REGISTRO ---
>>"!_vha_report!" echo Diario de evidencia  : !DEST!\Forensic_Journal.log
>>"!_vha_report!" echo Log de comandos      : !LOG_DIR!\Forensic_Commands.log
>>"!_vha_report!" echo ===============================================================================
call :LOG_EVENT "Informe de adquisicion en caliente generado: !_vha_report!"

echo.
echo !C_BORDER!!SUBLINE!!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" if not "!_vha_susp!"=="1" echo !C_OK!  HOT ACQUISITION COMPLETED - MACHINE POWERED ON DURING THE READ!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" if not "!_vha_susp!"=="1" echo !C_OK!  ADQUISICIÓN EN CALIENTE COMPLETADA - MÁQUINA ENCENDIDA DURANTE LA LECTURA!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" if "!_vha_susp!"=="1" echo !C_OK!  ACQUISITION COMPLETED - THE VM WAS SUSPENDED DURING THE READ!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" if "!_vha_susp!"=="1" echo !C_OK!  ADQUISICIÓN COMPLETADA - LA VM ESTUVO SUSPENDIDA DURANTE LA LECTURA!C_RESET!
echo !C_BORDER!!SUBLINE!!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT!  Image         : !VMW_HOT_IMG!!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT!  Imagen        : !VMW_HOT_IMG!!C_RESET!
echo !C_TEXT!  SHA-256       : !_vha_hash!!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT!  Exact size    : !_vha_size! bytes!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT!  Tamaño exacto : !_vha_size! bytes!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT!  Window ^(UTC^)  : !_VHA_TS1! -^> !_VHA_TS2!   ^(!_vha_dur!^)!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT!  Ventana ^(UTC^) : !_VHA_TS1! -^> !_VHA_TS2!   ^(!_vha_dur!^)!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT!  Report        : !_vha_report!!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT!  Informe       : !_vha_report!!C_RESET!
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Next link in the chain of custody: after copying the image to the!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Siguiente eslabon de la cadena de custodia: tras copiar la imagen al!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] evidence medium, recompute its SHA-256; both values MUST match.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] medio de evidencia, recalcule su SHA-256; ambos DEBEN coincidir.!C_RESET!
echo.

set "VMW_HOT_OK=1"
exit /b 0

:: -----------------------------------------------------------------------
:: VMWARE_HOT_SNAPSHOT
:: Congela el disco base SIN apagar la VM. Con el snapshot tomado, VMware
:: escribe en un disco diferencial "<disco>-000001.vmdk", el base deja de
:: cambiar y la RAM de ese mismo instante queda en el .vmsn/.vmem.
:: Usa !SELECTED_VM_VMX!, !VMRUN_EXE! y !_vha_src! del llamador.
:: NUNCA aborta la adquisicion: si el snapshot falla se sigue leyendo en
:: caliente sin congelar y se DECLARA asi en el informe (!VMW_HOT_FROZEN!).
:: -----------------------------------------------------------------------
:VMWARE_HOT_SNAPSHOT
set "VMW_HOT_FROZEN=0"
set "VMW_HOT_QUIESCED=0"
set "VMW_HOT_SNAPNAME="
if not exist "!VMRUN_EXE!" (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] vmrun.exe not found: reading hot WITHOUT freezing.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] No se encontró vmrun.exe: se lee en caliente SIN congelar.!C_RESET!
    call :LOG_EVENT "Advertencia: no hay vmrun.exe para congelar; se adquiere en caliente sin snapshot."
    exit /b 0
)
call :UTCNOW _VHS_TAG COMPACT
set "_vhs_name=FORENSE_!_VHS_TAG!"
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Freezing the disk with a snapshot ^(the VM keeps running^)...!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Congelando el disco con un snapshot ^(la VM sigue corriendo^)...!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_DIM!    Snapshot name: !_vhs_name!!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_DIM!    Nombre del snapshot: !_vhs_name!!C_RESET!
rem AVISO OBLIGATORIO ANTES DE LLAMAR: "vmrun snapshot" es SINCRONICO y no
rem retorna cuando el disco queda congelado -eso ocurre en segundos- sino cuando
rem VMware termina de volcar toda la RAM del invitado a disco, en un solo hilo.
rem Con 2 GB de RAM eso son minutos. La consola queda sin salida y sin cursor:
rem sin avisarlo, el operador cree que se colgo y pulsa CTRL+C. Esta llamada es
rem DIRECTA, no pasa por :ACQUIRE, asi que un CTRL+C aqui mata el batch dejando
rem la carpeta de la VM mutada a medias.
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] This may take SEVERAL MINUTES and shows no output. Do NOT press CTRL+C.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] Esto puede tardar VARIOS MINUTOS y no muestra salida. NO pulse CTRL+C.!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_DIM!    The disk freezes within seconds, but vmrun does not return until VMware!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_DIM!    El disco se congela en segundos, pero vmrun no retorna hasta que VMware!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_DIM!    finishes writing the whole guest RAM to disk on a single thread.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_DIM!    acaba de volcar toda la RAM del invitado a disco, con un solo hilo.!C_RESET!
call :UTCNOW _VHS_TS1
"!VMRUN_EXE!" snapshot "!SELECTED_VM_VMX!" "!_vhs_name!" >nul 2>&1
set "_vhs_el=!errorLevel!"
call :UTCNOW _VHS_TS2
call :TOOL_VER_ONCE TOOLVER_VMRUN "!VMRUN_EXE!" ""
call :LOG_CMD "VMware_SnapshotCongelar_Caliente" "vmrun snapshot ""!SELECTED_VM_VMX!"" ""!_vhs_name!""" "!_vhs_el!" "!_VHS_TS1!" "!_VHS_TS2!" "" "" "!TOOLVER_VMRUN!"
if not "!_vhs_el!"=="0" (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![-] vmrun snapshot failed ^(code !_vhs_el!^): reading hot WITHOUT freezing.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![-] vmrun snapshot fallo ^(código !_vhs_el!^): se lee en caliente SIN congelar.!C_RESET!
    call :LOG_EVENT "Advertencia: vmrun snapshot fallo (codigo !_vhs_el!); se adquiere en caliente sin congelar - !SELECTED_VM_VMX!"
    exit /b 0
)

:: Verificacion de que el base quedo realmente quiescente, en la subrutina
:: comun :VMWARE_PROBE_QUIESCENT (la misma sonda la usa :VWL_SNAPSHOT: estaba
:: duplicada y la copia de alla sondeaba el archivo equivocado).
call :VMWARE_PROBE_QUIESCENT "!_vha_src!"
set "_vhs_quiesced=!_VMWQ_QUIESCED!"
if "!_vhs_quiesced!"=="1" (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Base disk frozen: nobody holds it open for writing.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Disco base congelado: nadie lo tiene abierto para escritura.!C_RESET!
) else (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![*] Could not confirm the base disk is quiescent: treat the image as!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![*] No se pudo confirmar que el base este quiescente: trate la imagen!C_RESET!
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![*] temporally inconsistent anyway, as if it had not been frozen.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![*] como temporalmente inconsistente igual, como si no se hubiera congelado.!C_RESET!
)

echo.
rem Es una PRECAUCION, no un fallo: C_WARN, no C_ERR. Y la rama inglesa llevaba
rem la etiqueta espanola "[AVISO]". El framework usa un solo par: [CAUTION]/[ATENCIÓN].
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![CAUTION] DO NOT delete this snapshot in VMware.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![ATENCIÓN] NO elimine este snapshot en VMware.!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN!    Deleting it consolidates the differential disk INTO the base, which!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN!    Eliminarlo consolida el disco diferencial DENTRO del base, lo que!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN!    writes to the evidence and destroys the frozen state.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN!    escribe sobre la evidencia y destruye el estado congelado.!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_DIM!    Record the snapshot in the chain of custody: the RAM of that same!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_DIM!    Documente el snapshot en la cadena de custodia: la RAM de ese mismo!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_DIM!    instant is in the .vmsn/.vmem of this snapshot.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_DIM!    instante queda en el .vmsn/.vmem de este snapshot.!C_RESET!
echo.

set "VMW_HOT_FROZEN=1"
rem La comprobacion viaja al llamador, no solo al diario: el informe no puede
rem afirmar que el base dejo de cambiar si la sonda no lo pudo confirmar.
set "VMW_HOT_QUIESCED=!_vhs_quiesced!"
set "VMW_HOT_SNAPNAME=!_vhs_name!"
call :LOG_EVENT "Disco congelado sin apagar la VM para adquisicion en caliente: snapshot !_vhs_name! sobre !SELECTED_VM_VMX! (quiescente=!_vhs_quiesced!)"
rem La huella de escritura sobre el ORIGEN estaba justificada y avisada en pantalla,
rem pero no quedaba DOCUMENTADA en el registro permanente. 'vmrun snapshot' escribe
rem dentro del directorio de la evidencia y esos cambios PERSISTEN tras la
rem adquisicion: hay que enumerarlos, no solo mencionar que se tomo el snapshot.
call :LOG_EVENT "ESCRITURA SOBRE EL ORIGEN, justificada y PERSISTENTE: 'vmrun snapshot' creo el snapshot !_vhs_name! en el directorio de la maquina de origen. Efectos: nuevo disco diferencial -000001.vmdk que recibe las escrituras posteriores, nuevo archivo de estado .vmsn (y .vmem si la VM tenia RAM asignada), reescritura de scsi*.fileName en el .vmx y de la cadena de snapshots en el .vmsd. Motivo: congelar el disco base sin apagar la VM para estrechar la ventana de smear. El snapshot NO se elimina: borrarlo consolidaria el diferencial sobre el disco base y eso escribiria sobre la evidencia. (quiescente=!_vhs_quiesced!)"
exit /b 0

:: -----------------------------------------------------------------------
:: VMWARE_HOT_SRCREF
:: %1 = archivo de salida  %2 = etiqueta del instante  %3 = marca UTC
:: Anota tamano y fecha de modificacion del descriptor y de cada extent del
:: disco de origen. NO es una verificacion: la fuente esta VIVA y estos
:: valores cambian solos; sirven para DEMOSTRAR esa mutacion, no para
:: validar nada. Se registran tamano+mtime y no un SHA-256 completo de los
:: extents porque hashear varios GB antes de empezar retrasaria el inicio y
:: ENSANCHARIA la ventana de smear, sin aportar nada verificable.
:: Usa !_vha_src!, !_vha_srcdir! y !_vha_name! del llamador.
:: -----------------------------------------------------------------------
:VMWARE_HOT_SRCREF
set "_vhr_out=%~1"
set "_vhr_when=%~2"
set "_vhr_ts=%~3"
>"!_vhr_out!" echo REFERENCIA TEMPORAL DE LA FUENTE - NO REPRODUCIBLE ^(FUENTE VIVA^)
>>"!_vhr_out!" echo.
>>"!_vhr_out!" echo Instante        : !_vhr_when!
>>"!_vhr_out!" echo Marca UTC       : !_vhr_ts!
>>"!_vhr_out!" echo Estado de la VM : !_vha_stateshort!
>>"!_vhr_out!" echo.
>>"!_vhr_out!" echo Estos valores NO validan la imagen adquirida y NO son comparables con su
>>"!_vhr_out!" echo hash. Se registran para DOCUMENTAR que la fuente estaba mutando durante la
>>"!_vhr_out!" echo adquisicion: si difieren entre T_inicio y T_fin, eso es un hallazgo esperado
>>"!_vhr_out!" echo y declarado, no un fallo ni un indicio de manipulacion.
>>"!_vhr_out!" echo.
>>"!_vhr_out!" echo --- ARCHIVO .vmdk DE ORIGEN ^(descriptor si hay extents aparte; el disco
>>"!_vhr_out!" echo     completo si es monolitico - ver la lista de extents mas abajo^) ---
for %%D in ("!_vha_src!") do >>"!_vhr_out!" echo   %%~nxD   bytes=%%~zD   mtime_local=%%~tD
>>"!_vhr_out!" echo.
>>"!_vhr_out!" echo --- EXTENTS ^(contienen los datos reales del disco^) ---
for %%E in ("!_vha_srcdir!!_vha_name!-s*.vmdk") do >>"!_vhr_out!" echo   %%~nxE   bytes=%%~zE   mtime_local=%%~tE
for %%E in ("!_vha_srcdir!!_vha_name!-flat*.vmdk") do >>"!_vhr_out!" echo   %%~nxE   bytes=%%~zE   mtime_local=%%~tE
exit /b 0

:: -----------------------------------------------------------------------
:: VMWARE_SELECT_CLONE_SNAPSHOTS
:: Usa !SELECTED_VM_PATH! y !SELECTED_VM_VMX! ya definidos por el llamador.
:: Si hay varios snapshots, deja elegir CUALES incluir en el clon (Enter =
:: todos, sin cambiar el comportamiento previo). Los ancestros de cada
:: snapshot elegido se agregan automáticamente -VMware necesita la cadena
:: completa de discos para poder resolver cualquier snapshot- pero la
:: memoria (.vmsn/.vmem) solo se incluye para los snapshots elegidos
:: EXPLICITAMENTE, no para ancestros incluidos solo por necesidad de disco.
:: Resultado:
::   !VMWC_ABORT!          0=continuar, 1=el llamador debe cancelar
::   !VMWC_FILTER_ACTIVE!  0=copiar TODO sin filtrar, 1=copia selectiva
::   !VMWC_DISKFILES!      (si FILTER_ACTIVE=1) nombres de archivo de disco
::                         necesarios, entre comillas, listos para robocopy
::   !VMWC_MEMFILES!       (si FILTER_ACTIVE=1) idem para .vmsn/.vmem
:: -----------------------------------------------------------------------
:VMWARE_SELECT_CLONE_SNAPSHOTS
set "VMWC_ABORT=0"
set "VMWC_FILTER_ACTIVE=0"
set "VMWC_DISKFILES="
set "VMWC_MEMFILES="
set "VMWC_CHOSEN_LIST="

set "vmdk_count=0"
for %%D in ("!SELECTED_VM_PATH!\*.vmdk") do (
    echo %%~nxD | findstr /R /I /C:"-s[0-9][0-9]*\.vmdk" /C:"-flat\.vmdk" /C:"-delta\.vmdk" >nul
    if !errorlevel! neq 0 (
        set /a vmdk_count+=1
        set "VMDK_FILE_!vmdk_count!=%%~fD"
        set "VMDK_NAME_!vmdk_count!=%%~nxD"
    )
)
if !vmdk_count! leq 1 exit /b 0

for %%F in ("!SELECTED_VM_VMX!") do set "_vmwc_vmsd=%%~dpnF.vmsd"
for /L %%k in (1,1,!vmdk_count!) do (
    call :VMWARE_CLASSIFY_VMDK "!VMDK_FILE_%%k!"
    set "VMDK_ISBASE_%%k=!_VMDK_ISBASE!"
    set "VMDK_PARENT_%%k=!_VMDK_PARENTHINT!"
    set "VMDK_DISPNAME_%%k="
    if "!_VMDK_ISBASE!"=="0" (
        call :VMWARE_FIND_SNAPSHOT_MEMORY "!_vmwc_vmsd!" "!VMDK_NAME_%%k!"
        set "VMDK_DISPNAME_%%k=!_VMSN_DISPLAYNAME!"
    )
)

set "_vmwc_snaps=0"
for /L %%k in (1,1,!vmdk_count!) do if "!VMDK_ISBASE_%%k!"=="0" set /a _vmwc_snaps+=1
if !_vmwc_snaps! equ 0 exit /b 0

echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_TITLE!Detected !_vmwc_snaps! snapshot^(s^):!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TITLE!Se detectaron !_vmwc_snaps! snapshot^(s^):!C_RESET!
echo.
for /L %%k in (1,1,!vmdk_count!) do (
    if "!VMDK_ISBASE_%%k!"=="1" (
        if /i "!FORENSIC_LANG!"=="EN" echo !C_OK! %%k. !VMDK_NAME_%%k! ^(Base disk^)!C_RESET!
        if /i not "!FORENSIC_LANG!"=="EN" echo !C_OK! %%k. !VMDK_NAME_%%k! ^(Disco base^)!C_RESET!
    ) else (
        if defined VMDK_DISPNAME_%%k (
            echo !C_WARN! %%k. !VMDK_NAME_%%k! - "!VMDK_DISPNAME_%%k!" ^(Snapshot^)!C_RESET!
        ) else (
            echo !C_WARN! %%k. !VMDK_NAME_%%k! ^(Snapshot^)!C_RESET!
        )
    )
)
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] The base disk and the required ancestors of each chosen snapshot!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] El disco base y los ancestros necesarios de cada snapshot elegido!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT!    are included automatically ^(VMware needs the complete chain^).!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT!    se incluyen automáticamente ^(VMware necesita la cadena completa^).!C_RESET!
echo.
:VMWC_ASK_SEL
set "vmwc_sel="
if /i "!FORENSIC_LANG!"=="EN" set /p vmwc_sel="!C_PROMPT!Snapshots to include [Enter = all, or comma-separated numbers, e.g. 1,2] (0=cancel): !C_RESET!"
if /i not "!FORENSIC_LANG!"=="EN" set /p vmwc_sel="!C_PROMPT!Snapshots a incluir [Enter = todos, o números separados por coma, ej 1,2] (0=cancelar): !C_RESET!"
if "!vmwc_sel!"=="0" (
    set "VMWC_ABORT=1"
    exit /b 0
)
if not defined vmwc_sel exit /b 0

:: NOTA: la sustitucion de comas por espacios se hace en una variable
:: aparte con expansion INMEDIATA (%var%), no con "!var:,= !" directo
:: dentro del "for (...)" - esa combinacion es poco fiable (el for
:: tokeniza el texto antes de que la sustitucion retardada se resuelva
:: correctamente en esa posición). Verificado con reproduccion aislada.
set "_vmwc_list=%vmwc_sel:,= %"

set "_vmwc_valid=1"
for %%k in (%_vmwc_list%) do (
    set "_vmwc_tok=%%k"
    set "_vmwc_isnum=1"
    for /f "delims=0123456789" %%z in ("!_vmwc_tok!") do set "_vmwc_isnum=0"
    if "!_vmwc_isnum!"=="0" set "_vmwc_valid=0"
    if "!_vmwc_isnum!"=="1" if !_vmwc_tok! lss 1 set "_vmwc_valid=0"
    if "!_vmwc_isnum!"=="1" if !_vmwc_tok! gtr !vmdk_count! set "_vmwc_valid=0"
)
if "!_vmwc_valid!"=="0" (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Invalid selection. Use numbers from 1 to !vmdk_count! separated by commas.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Selección inválida. Use números del 1 al !vmdk_count! separados por coma.!C_RESET!
    goto VMWC_ASK_SEL
)

for /L %%k in (1,1,!vmdk_count!) do set "VMDK_CHOSEN_%%k=0"
for %%k in (%_vmwc_list%) do set "VMDK_CHOSEN_%%k=1"

:: Incluir ancestros de cada elegido, recorriendo parentFileNameHint hasta
:: llegar a la base (bucle de punto fijo: repite hasta que no cambie nada).
for /L %%k in (1,1,!vmdk_count!) do set "VMDK_NEEDED_%%k=!VMDK_CHOSEN_%%k!"
:VMWC_ANCESTOR_LOOP
set "_vmwc_changed=0"
for /L %%k in (1,1,!vmdk_count!) do (
    if "!VMDK_NEEDED_%%k!"=="1" if "!VMDK_ISBASE_%%k!"=="0" (
        for /L %%j in (1,1,!vmdk_count!) do (
            if /I "!VMDK_NAME_%%j!"=="!VMDK_PARENT_%%k!" if "!VMDK_NEEDED_%%j!"=="0" (
                set "VMDK_NEEDED_%%j=1"
                set "_vmwc_changed=1"
            )
        )
    )
)
if "!_vmwc_changed!"=="1" goto VMWC_ANCESTOR_LOOP

:: El/los discos base siempre se incluyen (raiz de cualquier cadena).
for /L %%k in (1,1,!vmdk_count!) do if "!VMDK_ISBASE_%%k!"=="1" set "VMDK_NEEDED_%%k=1"

:: Construir listas de archivos: descriptor + extents de cada disco
:: NECESARIO (elegidos + ancestros); memoria .vmsn/.vmem SOLO para los
:: elegidos EXPLICITAMENTE (vía el diccionario oficial .vmsd, igual que en
:: la reconstrucción de snapshots).
for %%F in ("!SELECTED_VM_VMX!") do set "_vmwc_vmsd=%%~dpnF.vmsd"

for /L %%k in (1,1,!vmdk_count!) do (
    if "!VMDK_NEEDED_%%k!"=="1" (
        set "VMWC_DISKFILES=!VMWC_DISKFILES! "!VMDK_NAME_%%k!""
        for %%X in ("!VMDK_NAME_%%k!") do set "_vmwc_base=%%~nX"
        if exist "!SELECTED_VM_PATH!\!_vmwc_base!-flat.vmdk" set "VMWC_DISKFILES=!VMWC_DISKFILES! "!_vmwc_base!-flat.vmdk""
        if exist "!SELECTED_VM_PATH!\!_vmwc_base!-delta.vmdk" set "VMWC_DISKFILES=!VMWC_DISKFILES! "!_vmwc_base!-delta.vmdk""
        for %%S in ("!SELECTED_VM_PATH!\!_vmwc_base!-s*.vmdk") do set "VMWC_DISKFILES=!VMWC_DISKFILES! "%%~nxS""
    )
    if "!VMDK_CHOSEN_%%k!"=="1" (
        set "VMWC_CHOSEN_LIST=!VMWC_CHOSEN_LIST!!VMDK_NAME_%%k!, "
        if exist "!_vmwc_vmsd!" (
            call :VMWARE_FIND_SNAPSHOT_MEMORY "!_vmwc_vmsd!" "!VMDK_NAME_%%k!"
            if defined _VMSN_NAME (
                set "VMWC_MEMFILES=!VMWC_MEMFILES! "!_VMSN_NAME!""
                for %%V in ("!_VMSN_NAME!") do set "_vmwc_vmembase=%%~nV"
                if exist "!SELECTED_VM_PATH!\!_vmwc_vmembase!.vmem" set "VMWC_MEMFILES=!VMWC_MEMFILES! "!_vmwc_vmembase!.vmem""
            )
        )
    )
)

set "VMWC_FILTER_ACTIVE=1"
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Will be included: !VMWC_CHOSEN_LIST!^(and their required ancestors^).!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Se incluiran: !VMWC_CHOSEN_LIST!^(y sus ancestros necesarios^).!C_RESET!
exit /b 0

:SELECT_VMWARE_VM
set "vm_count=0"
:: Sin inventario NO se abandona: el inventario es de Workstation y solo cubre las
:: VMs registradas en ESTA cuenta. Las VMs de Player, las traidas de un medio
:: externo y las de otro perfil no aparecen ahi, y antes eran INALCANZABLES porque
:: no existia ninguna forma de indicar una ruta .vmx a mano.
if not exist "%APPDATA%\VMware\inventory.vmls" goto VMW_NOINVENTORY
goto VMW_INV_PARSE

:VMW_NOINVENTORY
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![-] The inventory file was not found in %APPDATA%\VMware.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![-] No se encontró el archivo de inventario en %APPDATA%\VMware.!C_RESET!
goto VMW_MANUAL_VMX

:VMW_MANUAL_VMX
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Enter the full path of the VM's .vmx file.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Indique la ruta completa del archivo .vmx de la VM.!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_DIM!    Known limitation: a path containing "^!" cannot be handled by this shell.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_DIM!    Limitacion conocida: una ruta que contenga "^!" no la puede manejar este shell.!C_RESET!
set "_svm_manual="
if /i "!FORENSIC_LANG!"=="EN" set /p _svm_manual="!C_PROMPT!Path to the .vmx [0=cancel]: !C_RESET!"
if /i not "!FORENSIC_LANG!"=="EN" set /p _svm_manual="!C_PROMPT!Ruta del .vmx [0=cancelar]: !C_RESET!"
if "!_svm_manual!"=="0" exit /b 1
if not defined _svm_manual goto VMW_MANUAL_VMX
set "_svm_manual=!_svm_manual:"=!"
if not exist "!_svm_manual!" goto VMW_MANUAL_NOFILE
set "_svm_ext="
for %%F in ("!_svm_manual!") do set "_svm_ext=%%~xF"
if /I not "!_svm_ext!"==".vmx" goto VMW_MANUAL_NOTVMX
for %%F in ("!_svm_manual!") do set "SELECTED_VM_VMX=%%~fF"
for %%F in ("!_svm_manual!") do set "SELECTED_VM_PATH=%%~dpF"
if "!SELECTED_VM_PATH:~-1!"=="\" set "SELECTED_VM_PATH=!SELECTED_VM_PATH:~0,-1!"
if /i "!FORENSIC_LANG!"=="EN" echo !C_OK![+] VM given manually: !SELECTED_VM_VMX!!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_OK![+] VM indicada manualmente: !SELECTED_VM_VMX!!C_RESET!
call :LOG_EVENT "VM de VMware indicada MANUALMENTE por el operador, fuera del inventario de Workstation: !SELECTED_VM_VMX!"
exit /b 0
:VMW_MANUAL_NOFILE
if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] That path does not exist.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Esa ruta no existe.!C_RESET!
goto VMW_MANUAL_VMX
:VMW_MANUAL_NOTVMX
if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] The file must be a .vmx ^(the VM configuration^).!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] El archivo debe ser un .vmx ^(la configuración de la VM^).!C_RESET!
goto VMW_MANUAL_VMX

:VMW_INV_PARSE

:: "tokens=1,*" y no "tokens=2": con "tokens=2 delims==" una ruta que contuviera
:: un "=" se cortaba en ese caracter y la VM quedaba con una ruta truncada, es
:: decir invisible. Con "1,*" el segundo token es TODO lo que sigue al primer "=".
for /f "tokens=1,* delims==" %%A in ('findstr /I ".vmx" "%APPDATA%\VMware\inventory.vmls"') do (
    for %%F in (%%B) do (
        set "vp=%%~dpF"
        if "!vp:~-1!"=="\" set "vp=!vp:~0,-1!"
        
        set "is_dup=0"
        if !vm_count! gtr 0 (
            for /L %%k in (1,1,!vm_count!) do (
                if /I "!VM_PATH_%%k!"=="!vp!" set "is_dup=1"
            )
        )
        if "!is_dup!"=="0" (
            set /a vm_count+=1
            set "VM_PATH_!vm_count!=!vp!"
            set "VM_NAME_!vm_count!=%%~nF"
            set "VM_VMX_!vm_count!=%%~fF"
        )
    )
)

if !vm_count! equ 0 (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![-] No virtual machines found in the inventory.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![-] No se encontraron máquinas virtuales en el inventario.!C_RESET!
)
if !vm_count! equ 0 goto VMW_MANUAL_VMX

:: Detectar cuales están ENCENDIDAS ahora mismo (comando oficial "vmrun
:: list", sin pipes - evita la clase de bug de comillas de rutas-con-
:: espacios+pipe ya corregida en otras partes de este script) para
:: mostrarlo junto a cada VM en la lista, antes de elegir.
call :RESOLVE_VMWARE
call :NEWGUID _svm_guid
set "_svm_running=!TEMP!\forensic_running_!_svm_guid!.tmp"
type nul > "!_svm_running!"
set "_svm_hasvmrun=0"
if exist "!VMRUN_EXE!" set "_svm_hasvmrun=1"
if exist "!VMRUN_EXE!" for /f "skip=1 delims=" %%L in ('"!VMRUN_EXE!" list 2^>nul') do echo %%L>>"!_svm_running!"

if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT!Virtual Machines detected in your inventory:!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT!Máquinas Virtuales detectadas en tu inventario:!C_RESET!
for /L %%i in (1,1,!vm_count!) do (
    set "_svm_state=!C_DIM!Apagada!C_RESET!"
    if /i "!FORENSIC_LANG!"=="EN" set "_svm_state=!C_DIM!Powered off!C_RESET!"
    findstr /I /X /C:"!VM_VMX_%%i!" "!_svm_running!" >nul 2>&1
    if !errorlevel! equ 0 (
        set "_svm_state=!C_OK!Encendida!C_RESET!"
        if /i "!FORENSIC_LANG!"=="EN" set "_svm_state=!C_OK!Running!C_RESET!"
    ) else (
        rem No esta en "vmrun list" (que solo reporta VMs ENCENDIDAS). Puede
        rem seguir estando suspendida: en ese caso VMware retiene el bloqueo
        rem del disco (".vmdk.lck") hasta que se reanude. NOTA: la línea
        rem "checkpoint.vmState" del .vmx NO sirve para esto -verificado en
        rem pruebas reales-: VMware la deja como referencia obsoleta incluso
        rem después de apagar la VM normalmente, sin limpiarla. El bloqueo
        rem del disco es la única señal que reflaja el estado ACTUAL.
        rem El candado ".lck" de VMware es una CARPETA junto al archivo, y un
        rem "for" con comodin NO enumera directorios: el bucle anterior no ponia
        rem la bandera NUNCA y el estado "Suspendida" era inalcanzable (medido
        rem con .bat de prueba contra una VM viva: "for" no enumera, "if exist"
        rem si). Con "if exist" el comodin encuentra la carpeta.
        set "_svm_haslock=0"
        if exist "!VM_PATH_%%i!\*.vmdk.lck" set "_svm_haslock=1"
        rem Tres estados, sin mezclarlos: "vmrun list" solo reporta ENCENDIDAS,
        rem asi que "no listada + candado de disco" es SUSPENDIDA (o en uso).
        rem Sin vmrun no se puede separar encendida de suspendida y se dice asi
        rem en lugar de elegir una de las dos.
        if "!_svm_haslock!"=="1" if "!_svm_hasvmrun!"=="1" set "_svm_state=!C_WARN!Suspendida/en uso!C_RESET!"
        if "!_svm_haslock!"=="1" if "!_svm_hasvmrun!"=="1" if /i "!FORENSIC_LANG!"=="EN" set "_svm_state=!C_WARN!Suspended/in use!C_RESET!"
        if "!_svm_haslock!"=="1" if "!_svm_hasvmrun!"=="0" set "_svm_state=!C_WARN!Encendida o suspendida - sin vmrun no se distingue!C_RESET!"
        if "!_svm_haslock!"=="1" if "!_svm_hasvmrun!"=="0" if /i "!FORENSIC_LANG!"=="EN" set "_svm_state=!C_WARN!Running or suspended - cannot tell without vmrun!C_RESET!"
    )
    echo  %%i. !VM_NAME_%%i! [!VM_PATH_%%i!] - !_svm_state!
)
del "!_svm_running!" >nul 2>&1
echo.
:: "M" existe porque el inventario solo cubre las VMs registradas en Workstation
:: bajo ESTA cuenta: las de Player y las traidas de un medio externo no estan ahi.
if /i "!FORENSIC_LANG!"=="EN" echo !C_DIM!  M. Another VM: give the path of its .vmx by hand!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_DIM!  M. Otra VM: indicar a mano la ruta de su .vmx!C_RESET!
echo.
:PROMPT_VM_SEL
set "vm_sel="
if /i "!FORENSIC_LANG!"=="EN" set /p vm_sel="!C_PROMPT!Select the VM [1-!vm_count!, M = manual path, 0=cancel]: !C_RESET!"
if /i not "!FORENSIC_LANG!"=="EN" set /p vm_sel="!C_PROMPT!Seleccione la VM [1-!vm_count!, M = ruta manual, 0=cancelar]: !C_RESET!"
if "!vm_sel!"=="0" exit /b 1
if /i "!vm_sel!"=="M" goto VMW_MANUAL_VMX
if not defined vm_sel goto PROMPT_VM_SEL

for /f "delims=0123456789" %%a in ("!vm_sel!") do (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Please enter a valid number.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Por favor, ingrese un número válido.!C_RESET!
    goto PROMPT_VM_SEL
)
if !vm_sel! lss 1 goto PROMPT_VM_SEL
if !vm_sel! gtr !vm_count! goto PROMPT_VM_SEL

call :NORM_SEL vm_sel
set "SELECTED_VM_PATH=!VM_PATH_%vm_sel%!"
set "SELECTED_VM_VMX=!VM_VMX_%vm_sel%!"
:: El nombre de la VM en VMware es el del .vmx; no hay array VM_NAME_n.
for %%N in ("!SELECTED_VM_VMX!") do call :LOG_CTX "VMWARE" "%%~nN"
if not defined SELECTED_VM_PATH goto PROMPT_VM_SEL
if "!SELECTED_VM_PATH!"=="" (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Invalid selection.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Selección inválida.!C_RESET!
    goto PROMPT_VM_SEL
)
exit /b 0

:: -----------------------------------------------------------------------
:: VMWARE_COUNT_SNAPSHOT_DELTAS
:: %1 = carpeta de la VM.
:: Cuenta snapshots SIN vmrun, por CONTENIDO: un descriptor cuyo parentCID no
:: sea ffffffff es, por definicion del formato VMDK, un diferencial de snapshot.
:: Existe para no tener que afirmar "no hay snapshots" cuando lo unico cierto es
:: que no se pudo preguntar a VMware. Solo cubre lo que hay en la carpeta.
:: Salidas: !_VMWCD_COUNT! (numero de diferenciales, o DESCONOCIDO si no habia
:: ningun descriptor legible) y !_VMWCD_TOTAL! (descriptores examinados).
:: -----------------------------------------------------------------------
:VMWARE_COUNT_SNAPSHOT_DELTAS
setlocal enabledelayedexpansion
set "_vmwcd_dir=%~1"
set "_vmwcd_n=0"
set "_vmwcd_delta=0"
if not exist "!_vmwcd_dir!" goto VMWCD_END
:: Se examinan SOLO descriptores: los extents (-sNNN / -flat / -delta) no
:: declaran parentCID y contarlos duplicaria cada disco.
for %%D in ("!_vmwcd_dir!\*.vmdk") do (
    echo %%~nxD | findstr /R /I /C:"-s[0-9][0-9]*\.vmdk" /C:"-flat\.vmdk" /C:"-delta\.vmdk" >nul
    if !errorlevel! neq 0 (
        set /a _vmwcd_n+=1
        call :VMWARE_CLASSIFY_VMDK "%%~fD"
        if "!_VMDK_ISBASE!"=="0" set /a _vmwcd_delta+=1
    )
)
:VMWCD_END
if "!_vmwcd_n!"=="0" set "_vmwcd_delta=DESCONOCIDO"
endlocal & set "_VMWCD_COUNT=%_vmwcd_delta%" & set "_VMWCD_TOTAL=%_vmwcd_n%"
exit /b 0

:: -----------------------------------------------------------------------
:: VMWARE_ORIGINALS_INTEGRITY
:: %1 = carpeta de la VM   %2 = descriptor .vmdk a sondear (puede ir vacio)
:: %3 = patrones para el hash   %4 = archivo de reporte   %5 = etiqueta
:: Decide si los archivos ORIGINALES se pueden hashear o solo referenciar.
:: POR QUE: hashear todos los .vmdk de la carpeta con la VM VIVA no acredita nada.
::
:: El motivo YA NO es que la herramienta no pueda abrirlos. Se midio: HashMyFiles
:: pide FILE_SHARE_WRITE, igual que qemu-img, y SI puede leer un archivo que otro
:: proceso tiene abierto para escribir. Eso lo distingue de certutil, que pedia
:: solo FILE_SHARE_READ y fallaba en todos los extents de una VM encendida.
::
:: El motivo real, que no depende de la herramienta, es que el hash de una fuente
:: que esta cambiando NO ES REPRODUCIBLE: un tercero que lo recalcule obtendra
:: otro valor, asi que el numero no demuestra integridad de nada y en un informe
:: se lee como si lo hiciera. Ademas, en una cadena de cientos de GB el calculo
:: cuesta horas para producir ese dato inservible.
::
:: La compuerta sigue siendo la sonda de quiescencia: si nadie mantiene el disco
:: abierto para ESCRIBIR, la fuente esta quieta y su hash SI es reproducible, asi
:: que se calcula. Si no lo esta, se emite una REFERENCIA no reproducible
:: (tamano + mtime), igual que hace la via de adquisicion en caliente, declarando
:: expresamente que no acredita nada.
:: Salida: !VMW_ORIG_HASHED! (1 = se hasheo, 0 = solo referencia)
:: -----------------------------------------------------------------------
:VMWARE_ORIGINALS_INTEGRITY
set "_voi_dir=%~1"
set "_voi_base=%~2"
set "_voi_wild=%~3"
set "_voi_out=%~4"
set "_voi_label=%~5"
set "VMW_ORIG_HASHED=1"
if not exist "!_voi_dir!\*.vmdk.lck" goto VOI_HASH
if not defined _voi_base for %%D in ("!_voi_dir!\*.vmdk") do if not defined _voi_base set "_voi_base=%%~fD"
if not defined _voi_base goto VOI_REF
call :VMWARE_PROBE_QUIESCENT "!_voi_base!"
if "!_VMWQ_QUIESCED!"=="1" goto VOI_HASH
goto VOI_REF

:VOI_HASH
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Hashing the original files before copying...!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Hasheando los archivos originales antes de copiar...!C_RESET!
call :HASH_EVIDENCE FOLDER "!_voi_dir!" "!_voi_wild!" "!_voi_out!" "!_voi_label!"
exit /b 0

:VOI_REF
set "VMW_ORIG_HASHED=0"
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] The originals are NOT hashed: the source is IN USE and still changing, so!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] Los originales NO se hashean: la fuente esta EN USO y sigue cambiando, así!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] its hash would NOT be reproducible by a third party and would prove nothing.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] que su hash NO sería reproducible por un tercero y no demostraría nada.!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] A NON-REPRODUCIBLE reference is written instead ^(size + mtime^). It documents!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] En su lugar se escribe una referencia NO REPRODUCIBLE ^(tamaño + mtime^). Sirve!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] the state of the source; it does NOT prove the originals stayed intact.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] para DOCUMENTAR el estado de la fuente; NO prueba que los originales no cambien.!C_RESET!
call :UTCNOW _voi_ts
set "_voi_ref=!_voi_out!.referencia_fuente_viva.txt"
>"!_voi_ref!" echo REFERENCIA DE LOS ARCHIVOS ORIGINALES - NO REPRODUCIBLE ^(FUENTE EN USO^)
>>"!_voi_ref!" echo.
>>"!_voi_ref!" echo Etiqueta        : !_voi_label!
>>"!_voi_ref!" echo Carpeta origen  : !_voi_dir!
>>"!_voi_ref!" echo Patrones        : !_voi_wild!
>>"!_voi_ref!" echo Marca UTC       : !_voi_ts!
>>"!_voi_ref!" echo Host            : !COMPUTERNAME!    Operador: !USERNAME!
>>"!_voi_ref!" echo.
>>"!_voi_ref!" echo NO se calculo ningun hash de estos archivos. La sonda de apertura sobre los
>>"!_voi_ref!" echo extents del disco fallo: alguien los mantiene abiertos para ESCRIBIR, es decir
>>"!_voi_ref!" echo que la fuente esta VIVA y su contenido cambia mientras se lee. Un hash de una
>>"!_voi_ref!" echo fuente asi NO es reproducible: un tercero que lo recalcule obtendria otro valor,
>>"!_voi_ref!" echo de modo que el numero no demostraria integridad y en un informe se leeria como
>>"!_voi_ref!" echo si lo hiciera. Por eso no se calcula, y no porque la herramienta no pueda:
>>"!_voi_ref!" echo HashMyFiles solicita FILE_SHARE_WRITE y si podria abrirlos. Estos
>>"!_voi_ref!" echo valores NO acreditan integridad y NO son comparables con ningun hash: se
>>"!_voi_ref!" echo registran para DOCUMENTAR el estado de la fuente en este instante.
>>"!_voi_ref!" echo.
pushd "!_voi_dir!" 2>nul
if errorlevel 1 goto VOI_REF_NODIR
for %%F in (!_voi_wild!) do >>"!_voi_ref!" echo   %%~nxF   bytes=%%~zF   mtime_local=%%~tF
popd 2>nul
goto VOI_REF_END
:VOI_REF_NODIR
>>"!_voi_ref!" echo ERROR: no se pudo acceder a la carpeta de origen para enumerar los archivos.
:VOI_REF_END
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Reference written to: !_voi_ref!!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Referencia escrita en: !_voi_ref!!C_RESET!
call :LOG_EVENT "!_voi_label!: NO se hashearon los originales de !_voi_dir!. La sonda de apertura sobre los extents fallo (fuente en uso): el hash de una fuente que cambia no es reproducible y no acreditaria nada. Se emitio referencia no reproducible tamano+mtime en !_voi_ref!. NO se afirma integridad de los originales."
exit /b 0

:: -----------------------------------------------------------------------
:: VMWARE_LIST_VMX_DISKS
:: %1 = ruta del .vmx de la VM.
:: Enumera TODOS los discos virtuales declarados en el .vmx con su MODO, leyendo
:: las claves oficiales "<bus><N>:<M>.fileName" y "<bus><N>:<M>.mode".
:: POR QUE existe: nada en el modulo leia el .vmx, y de ahi tres huecos reales:
::   (a) un disco "independent-persistent" queda FUERA de cualquier snapshot, de
::       modo que congelar con snapshot NO lo congela: declarar el conjunto
::       quiescente seria falso mientras ese disco sigue mutando;
::   (b) "independent-nonpersistent" DESCARTA las escrituras al apagar la VM, asi
::       que la via en frio destruye datos que la via en caliente si veria;
::   (c) una VM con dos o mas discos se adquiria de uno en uno sin decir nunca
::       "este es 1 de N", y un disco entero podia quedarse fuera sin aviso.
:: Solo informa: no cambia ninguna decision por su cuenta.
:: NO TIENE SALIDAS. Antes exportaba VMW_DISK_COUNT, VMW_INDEP_COUNT y
:: VMW_NONPERSIST_COUNT con un "endlocal & set", y la cabecera las anunciaba como
:: salidas, pero NINGUN llamador las leia: eran tres variables muertas y una
:: cabecera que prometia una interfaz inexistente. Lo que esta rutina entrega son
:: los avisos en pantalla y el asiento en el diario, y con eso el operador decide.
:: Si algun dia hace falta el recuento en el codigo, se exporta entonces, no antes.
:: -----------------------------------------------------------------------
:VMWARE_LIST_VMX_DISKS
setlocal enabledelayedexpansion
set "_vxd_vmx=%~1"
set "_vxd_n=0"
set "_vxd_indep=0"
set "_vxd_np=0"
if not exist "!_vxd_vmx!" goto VXD_END
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Virtual disks declared in the .vmx:!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Discos virtuales declarados en el .vmx:!C_RESET!
for /f "usebackq tokens=1,* delims==" %%K in ("!_vxd_vmx!") do (
    set "_vxd_key=%%K"
    set "_vxd_keyt=!_vxd_key: =!"
    set "_vxd_raw=%%L"
    echo !_vxd_keyt!|findstr /R /I /C:"^scsi[0-9]*:[0-9]*\.fileName" /C:"^sata[0-9]*:[0-9]*\.fileName" /C:"^ide[0-9]*:[0-9]*\.fileName" /C:"^nvme[0-9]*:[0-9]*\.fileName" >nul
    if !errorlevel! equ 0 call :VXD_ONE
)
:VXD_END
if "!_vxd_n!"=="0" (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] The .vmx could not be read or declares no .vmdk disk: the disk layout is!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] No se pudo leer el .vmx o no declara ningun disco .vmdk: la composicion!C_RESET!
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] NOT verified. It is not asserted how many disks this VM has.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] de discos NO queda comprobada. No se afirma cuantos discos tiene la VM.!C_RESET!
)
if not "!_vxd_n!"=="1" if not "!_vxd_n!"=="0" (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] This VM has !_vxd_n! disks. Each acquisition covers ONE disk: repeat the!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] Esta VM tiene !_vxd_n! discos. Cada adquisición cubre UN disco: repita el!C_RESET!
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] process for each one, or the evidence will be incomplete.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] proceso con cada uno o la evidencia quedara incompleta.!C_RESET!
)
if not "!_vxd_indep!"=="0" (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] !_vxd_indep! disk^(s^) in INDEPENDENT mode. VMware leaves them OUT of every!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] !_vxd_indep! disco^(s^) en modo INDEPENDIENTE. VMware los deja FUERA de todo!C_RESET!
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] snapshot: freezing with a snapshot does NOT freeze them and they are!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] snapshot: congelar con snapshot NO los congela y NO se incluyen en el.!C_RESET!
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] NOT included in it. Do not claim the set is quiescent.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] No declare quiescente el conjunto por haber tomado un snapshot.!C_RESET!
)
if not "!_vxd_np!"=="0" (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] !_vxd_np! disk^(s^) in NONPERSISTENT mode: VMware DISCARDS their writes when!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] !_vxd_np! disco^(s^) en modo NONPERSISTENT: VMware DESCARTA sus escrituras al!C_RESET!
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] the VM is powered off. Powering it off DESTROYS that data: acquire hot.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] apagar la VM. Apagarla DESTRUYE esos datos: adquiera en caliente.!C_RESET!
)
call :LOG_EVENT "Composicion de discos leida del .vmx !_vxd_vmx!: !_vxd_n! disco(s) .vmdk, de los cuales !_vxd_indep! en modo independiente y !_vxd_np! en modo nonpersistent."
endlocal
exit /b 0

:VXD_ONE
rem Entra con !_vxd_raw! (valor crudo de fileName) y !_vxd_keyt! (clave sin
rem espacios) fijados por el llamador. El valor NO se pasa como argumento a
rem proposito: viene entre comillas dentro del .vmx y reenvolverlo en otro par de
rem comillas rompe el pareo de cmd.exe.
rem Los CD-ROM tambien declaran fileName ("auto detect", un .iso): solo cuentan
rem los valores que terminan en ".vmdk".
set "_vxd_val=!_vxd_raw!"
if "!_vxd_val:~0,1!"==" " set "_vxd_val=!_vxd_val:~1!"
set "_vxd_val=!_vxd_val:"=!"
if /I not "!_vxd_val:~-5!"==".vmdk" exit /b 0
set /a _vxd_n+=1
for /f "tokens=1 delims=." %%D in ("!_vxd_keyt!") do set "_vxd_dev=%%D"
set "_vxd_mode="
for /f "usebackq tokens=1,* delims==" %%A in ("!_vxd_vmx!") do (
    set "_vxd_k2=%%A"
    set "_vxd_k2t=!_vxd_k2: =!"
    if /I "!_vxd_k2t!"=="!_vxd_dev!.mode" set "_vxd_mode=%%B"
)
if defined _vxd_mode if "!_vxd_mode:~0,1!"==" " set "_vxd_mode=!_vxd_mode:~1!"
if defined _vxd_mode set "_vxd_mode=!_vxd_mode:"=!"
set "_vxd_modetxt=dependiente - por defecto: entra en los snapshots"
if /i "!FORENSIC_LANG!"=="EN" set "_vxd_modetxt=dependent - default: included in snapshots"
if defined _vxd_mode set "_vxd_modetxt=!_vxd_mode!"
echo !C_TEXT!  !_vxd_dev!  !_vxd_val!!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_DIM!      mode: !_vxd_modetxt!!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_DIM!      modo: !_vxd_modetxt!!C_RESET!
if not defined _vxd_mode exit /b 0
echo !_vxd_mode!|findstr /I /C:"independent" >nul
if !errorlevel! equ 0 set /a _vxd_indep+=1
echo !_vxd_mode!|findstr /I /C:"nonpersistent" >nul
if !errorlevel! equ 0 set /a _vxd_np+=1
exit /b 0

:: -----------------------------------------------------------------------
:: VMWARE_PRESERVE_SNAPSHOT_FILES
:: %1 = carpeta de la VM   %2 = carpeta destino
:: Preserva SOLO los archivos de los snapshots: descriptores diferenciales
:: "-NNNNNN.vmdk", sus extents "-NNNNNN-sNNN.vmdk", los "-delta.vmdk" antiguos,
:: los ".vmsn" (estado de dispositivos) y los ".vmem" (RAM de ese snapshot).
:: POR QUE no se usan los comodines de robocopy: medido con fixtures en esta
:: maquina, robocopy admite CERO caracteres en los "?" finales, de modo que
:: "*-??????.vmdk" se comporta como "*-*.vmdk" y arrastraba el descriptor base y
:: TODOS los extents del base a la carpeta Snapshots -duplicando el disco
:: completo-, mientras "*-s??.vmdk" no aportaba nada. Se filtra con findstr, que
:: si sabe contar digitos. Y se anaden los ".vmem": antes solo se copiaban los
:: ".vmsn", asi que se preservaba el estado de dispositivos y se dejaba atras la
:: RAM del snapshot.
:: Se copia archivo por archivo en vez de una lista unica para no depender del
:: limite de longitud de la linea de comandos con cadenas de muchos extents.
:: Resultado en !_VMWS_COPIED! (archivos comprobados en el destino).
:: -----------------------------------------------------------------------
:VMWARE_PRESERVE_SNAPSHOT_FILES
setlocal enabledelayedexpansion
set "_vmws_src=%~1"
set "_vmws_dst=%~2"
set "_vmws_n=0"
if not exist "!_vmws_dst!" mkdir "!_vmws_dst!" >nul 2>&1
for %%F in ("!_vmws_src!\*.vmdk") do (
    echo %%~nxF|findstr /R /I /C:"-[0-9][0-9][0-9][0-9][0-9][0-9][-.]" /C:"-delta\.vmdk" >nul
    if !errorlevel! equ 0 call :VMWS_COPY_ONE "!_vmws_src!" "!_vmws_dst!" "%%~nxF"
)
for %%F in ("!_vmws_src!\*.vmsn" "!_vmws_src!\*.vmem") do call :VMWS_COPY_ONE "!_vmws_src!" "!_vmws_dst!" "%%~nxF"
endlocal & set "_VMWS_COPIED=%_vmws_n%"
exit /b 0

:VMWS_COPY_ONE
rem El exito NO se deduce del codigo de robocopy -0 significa tambien "no se
rem copio nada"-, se comprueba que el archivo esta en el destino.
robocopy "%~1" "%~2" "%~3" /NFL /NDL /NJH /NJS /NC /NS >nul
if exist "%~2\%~3" set /a _vmws_n+=1
exit /b 0

:: -----------------------------------------------------------------------
:: VMWARE_PROBE_QUIESCENT
:: %1 = ruta completa del DESCRIPTOR .vmdk base cuyo estado se comprueba.
:: Responde a UNA pregunta: hay alguien con los datos de ese disco abiertos
:: para ESCRIBIR. No sirve esperar a que desaparezca el ".lck": VMware lo
:: mantiene sobre el base aunque ya solo lo lea.
:: Se sondean los EXTENTS ("-sNNN.vmdk" / "-flat.vmdk"), NO el descriptor: con
:: twoGbMaxExtentSparse el descriptor son ~600 bytes de texto que nadie mantiene
:: abierto, asi que abrirlo sale bien SIEMPRE y daria un falso "congelado".
:: Solo si no hay extents (disco monolitico de un solo archivo) el propio
:: descriptor ES el dato y ahi si es el archivo correcto.
:: El patron excluye a proposito el diferencial "-NNNNNN.vmdk", que tras el
:: snapshot queda abierto para escritura POR DISENO.
:: FileShare.Read es lo que hace util la sonda: al negar escritura a terceros,
:: la apertura falla si alguien tiene el extent abierto para ESCRIBIR.
:: Salidas: !_VMWQ_QUIESCED! (1 solo si se sondeo algo Y todo salio limpio) y
:: !_VMWQ_PROBED! (cuantos archivos se sondearon; 0 = no se comprobo nada).
:: -----------------------------------------------------------------------
:VMWARE_PROBE_QUIESCENT
setlocal enabledelayedexpansion
set "_vmwq_src=%~1"
set "_vmwq_probed=0"
set "_vmwq_busy=0"
set "_vmwq_q=0"
if not defined PS_AVAILABLE goto VMWQ_END
for %%F in ("!_vmwq_src!") do set "_vmwq_dir=%%~dpF"
for %%F in ("!_vmwq_src!") do set "_vmwq_base=%%~nF"
for %%E in ("!_vmwq_dir!!_vmwq_base!-s*.vmdk" "!_vmwq_dir!!_vmwq_base!-flat*.vmdk") do (
    set /a _vmwq_probed+=1
    powershell -NoProfile -Command "try{$s=[IO.File]::Open('%%~fE','Open','Read','Read');$s.Close();exit 0}catch{exit 1}" >nul 2>&1
    if errorlevel 1 set /a _vmwq_busy+=1
)
if "!_vmwq_probed!"=="0" (
    powershell -NoProfile -Command "try{$s=[IO.File]::Open('!_vmwq_src!','Open','Read','Read');$s.Close();exit 0}catch{exit 1}" >nul 2>&1
    if errorlevel 1 (set /a _vmwq_busy+=1) else (set /a _vmwq_probed+=1)
)
rem Cero archivos sondeados NO es una comprobacion superada.
if not "!_vmwq_probed!"=="0" if "!_vmwq_busy!"=="0" set "_vmwq_q=1"
:VMWQ_END
endlocal & set "_VMWQ_QUIESCED=%_vmwq_q%" & set "_VMWQ_PROBED=%_vmwq_probed%"
exit /b 0

:: -----------------------------------------------------------------------
:: VMWARE_CLASSIFY_VMDK
:: %1 = ruta completa y entre comillas del descriptor .vmdk a analizar.
:: Lee el descriptor VMDK como texto (formato documentado por VMware,
:: "Virtual Disk Format 1.1/5") y extrae los campos oficiales que
:: determinan la relación padre/hijo entre discos:
::   CID                 - identificador de contenido de ESTE disco
::   parentCID           - identificador de contenido del disco PADRE
::                          (valor ffffffff = no tiene padre = disco base)
::   parentFileNameHint  - nombre del archivo del disco PADRE (solo
::                          presente cuando el disco es un snapshot/delta)
:: Resultado en:
::   !_VMDK_ISBASE!      1 = disco base, 0 = snapshot/delta
::   !_VMDK_PARENTHINT!  nombre del padre (vacio si es base)
::   !_VMDK_CID!         CID de este disco
:: -----------------------------------------------------------------------
:VMWARE_CLASSIFY_VMDK
setlocal enabledelayedexpansion
set "_c_cid="
set "_c_parentcid="
set "_c_parenthint="
set "_c_isbase=1"
for /f "usebackq tokens=1,* delims==" %%K in (`findstr /B /I /C:"CID=" /C:"parentCID=" /C:"parentFileNameHint=" %1 2^>nul`) do (
    set "_c_key=%%K"
    set "_c_val=%%L"
    if /I "!_c_key!"=="CID" set "_c_cid=!_c_val!"
    if /I "!_c_key!"=="parentCID" set "_c_parentcid=!_c_val!"
    if /I "!_c_key!"=="parentFileNameHint" set "_c_parenthint=!_c_val!"
)
:: El hint viene entre comillas dobles en el descriptor: "archivo.vmdk"
if defined _c_parenthint set "_c_parenthint=!_c_parenthint:"=!"
:: Un disco es "base" si no declara parentCID, o si es ffffffff (sin padre).
:: Cualquier otro valor de parentCID confirma una relación de snapshot real,
:: independientemente de como se llame el archivo.
if defined _c_parentcid (
    if /I not "!_c_parentcid!"=="ffffffff" set "_c_isbase=0"
)
endlocal & set "_VMDK_ISBASE=%_c_isbase%" & set "_VMDK_PARENTHINT=%_c_parenthint%" & set "_VMDK_CID=%_c_cid%"
exit /b 0

:: -----------------------------------------------------------------------
:: VMDK_PRINT_CHILDREN
:: %1 = nombre de archivo del disco padre (busca hijos cuyo
::      parentFileNameHint coincida, usando el arreglo VMDK_PARENT_i ya
::      poblado por VMWARE_CLASSIFY_VMDK en el llamador).
:: %2 = nivel de indentacion (profundidad en la cadena).
:: Imprime recursivamente el arbol de snapshots encadenados. setlocal aisla
:: las variables de cada nivel de recursion para que no se pisen entre si.
:: -----------------------------------------------------------------------
:VMDK_PRINT_CHILDREN
setlocal enabledelayedexpansion
set "_p_parent=%~1"
set "_p_depth=%~2"
set "_p_indent="
for /L %%z in (1,1,!_p_depth!) do set "_p_indent=!_p_indent!      "
for /L %%k in (1,1,!vmdk_count!) do (
    if "!VMDK_ISBASE_%%k!"=="0" if /I "!VMDK_PARENT_%%k!"=="!_p_parent!" (
        if defined VMDK_DISPNAME_%%k (
            echo !C_TEXT!!_p_indent!└── !VMDK_NAME_%%k! - "!VMDK_DISPNAME_%%k!"!C_RESET!
        ) else (
            echo !C_TEXT!!_p_indent!└── !VMDK_NAME_%%k!!C_RESET!
        )
        set /a _p_next=_p_depth+1
        call :VMDK_PRINT_CHILDREN "!VMDK_NAME_%%k!" !_p_next!
    )
)
endlocal
exit /b 0

:: -----------------------------------------------------------------------
:: VMWARE_FIND_SNAPSHOT_MEMORY
:: %1 = ruta completa y entre comillas al archivo .vmsd de la VM (el
::      "diccionario de snapshots", texto plano, mismo nombre base que el
::      .vmx, junto a el en la carpeta de la VM - formato documentado por
::      VMware, usado internamente por Workstation/Fusion).
:: %2 = nombre del archivo .vmdk del snapshot que se quiere reconstruir
::      (solo el nombre, sin ruta - ej. "Ubuntu.final-000001.vmdk").
:: El .vmsd vincula cada snapshotN con sus discos (snapshotN.diskM.fileName;
:: algunas versiones usan snapshotN.disklistM.fileName) y con su archivo de
:: estado (snapshotN.filename, un .vmsn).
:: El .vmem que acompaña al volcado de memoria comparte el mismo nombre
:: base que el .vmsn (convencion VMware) y SOLO existe si la VM estaba
:: encendida o suspendida en el momento exacto de tomar ese snapshot.
:: Resultado en !_VMSN_NAME! (nombre del .vmsn, vacio si no hay
:: correspondencia registrada para ese .vmdk).
:: -----------------------------------------------------------------------
:VMWARE_FIND_SNAPSHOT_MEMORY
setlocal enabledelayedexpansion
set "_fm_vmsd=%~1"
set "_fm_vmdk=%~2"
set "_fm_prefix="
set "_fm_vmsn="
set "_fm_dispname="
if not exist "!_fm_vmsd!" goto FM_DONE

:: Primera pasada: localizar la entrada de disco del snapshot cuyo valor coincide
:: con el .vmdk buscado, y extraer su prefijo "snapshotN".
:: LA CLAVE REAL es "snapshotN.diskM.fileName". Antes se buscaba la subcadena
:: "disklist", que NO aparece en los .vmsd generados por Workstation (verificado
:: sobre un .vmsd real de esta maquina: snapshot0.disk0.fileName): no habia
:: coincidencia NUNCA, asi que _VMSN_NAME y _VMSN_DISPLAYNAME salian siempre
:: vacios y el modulo declaraba "no hay estado de memoria" con el .vmsn y el
:: .vmem delante. Se acepta tambien "disklistM" por compatibilidad con otras
:: versiones/productos que si usan esa forma.
:: El valor puede venir con ruta relativa, asi que se compara SOLO el nombre de
:: archivo; y la clave se compara sin espacios porque el .vmsd los pone alrededor
:: del "=".
for /f "usebackq tokens=1,* delims==" %%K in ("!_fm_vmsd!") do (
    set "_fm_key=%%K"
    set "_fm_keyt=!_fm_key: =!"
    echo !_fm_keyt!|findstr /R /I /C:"^snapshot[0-9]*\.disk[0-9]*\.fileName" /C:"^snapshot[0-9]*\.disklist[0-9]*\.fileName" >nul
    if !errorlevel! equ 0 (
        set "_fm_val=%%L"
        if "!_fm_val:~0,1!"==" " set "_fm_val=!_fm_val:~1!"
        set "_fm_val=!_fm_val:"=!"
        for %%X in ("!_fm_val!") do set "_fm_valn=%%~nxX"
        if /I "!_fm_valn!"=="!_fm_vmdk!" (
            for /f "tokens=1 delims=." %%P in ("!_fm_keyt!") do set "_fm_prefix=%%P"
        )
    )
)

:: Segunda pasada: con el prefijo ya identificado, leer "snapshotN.filename"
:: (el .vmsn asociado) y "snapshotN.displayName" (el nombre que el operador
:: le puso al snapshot en VMware - el que aparece en el Snapshot Manager,
:: no el nombre generico del archivo .vmdk).
if defined _fm_prefix (
    for /f "usebackq tokens=1,* delims==" %%K in ("!_fm_vmsd!") do (
        set "_fm_key2=%%K"
        set "_fm_key2t=!_fm_key2: =!"
        if /I "!_fm_key2t!"=="!_fm_prefix!.filename" (
            set "_fm_val2=%%L"
            if "!_fm_val2:~0,1!"==" " set "_fm_val2=!_fm_val2:~1!"
            set "_fm_vmsn=!_fm_val2:"=!"
        )
        if /I "!_fm_key2t!"=="!_fm_prefix!.displayName" (
            set "_fm_val3=%%L"
            if "!_fm_val3:~0,1!"==" " set "_fm_val3=!_fm_val3:~1!"
            set "_fm_dispname=!_fm_val3:"=!"
        )
    )
)
:FM_DONE
endlocal & set "_VMSN_NAME=%_fm_vmsn%" & set "_VMSN_DISPLAYNAME=%_fm_dispname%"
exit /b 0

:: =====================================================
:: MÓDULO HYPER-V - ADQUISICIÓN FORENSE
:: =====================================================

:MENU_HYPERV
set "HE_MODO="
cls
if /i "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Verifying Hyper-V environment...!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Verificando entorno Hyper-V...!C_RESET!
echo.
:: Una sola invocacion PowerShell para los 3 cmdlets (cada llamada separada
:: recargaba el módulo Hyper-V completo: ~3x mas lento).
:: El chequeo anterior solo contaba cmdlets con Get-Command SIN cualificar modulo,
:: y eso pasaba en dos situaciones en las que el modulo NO sirve:
::   - sin privilegios: Get-Command no los necesita y salia 0, pero Get-VM falla.
::   - con VMware PowerCLI instalado: exporta Get-VM/Start-VM/Stop-VM y en este
::     equipo PSModulePath pone Documents\...\Modules y Program Files\Windows
::     PowerShell\Modules ANTES de System32, asi que "Get-VM" podia resolver a
::     PowerCLI. El conteo seguia siendo 3 y todo el modulo "Hyper-V" habria
::     operado contra PowerCLI.
:: Ahora se importa el modulo Hyper-V explicitamente, se valida contra ESE modulo
:: y se hace una consulta REAL cualificada para distinguir cada causa.
set "HV_ENV="
for /f "usebackq delims=" %%E in (`powershell -NoProfile -Command "try { Import-Module Hyper-V -ErrorAction Stop } catch { Write-Output 'NOMODULE'; exit }; if (@(Get-Command -Module Hyper-V -Name Get-VM,Get-VMHardDiskDrive,Get-VMSnapshot -ErrorAction SilentlyContinue).Count -ne 3) { Write-Output 'NOCMDLETS'; exit }; try { $v = @(Hyper-V\Get-VM -ErrorAction Stop); if ($v.Count -eq 0) { Write-Output 'NOVM' } else { Write-Output 'OK' } } catch { Write-Output 'QUERYFAIL' }"`) do set "HV_ENV=%%E"
if "!HV_ENV!"=="OK" goto HV_MENU_SHOW
if "!HV_ENV!"=="NOVM" goto HV_ENV_NOVM
if "!HV_ENV!"=="QUERYFAIL" goto HV_ENV_QUERYFAIL
goto HV_NO_ENV

:HV_ENV_NOVM
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![-] Hyper-V responds correctly but this host has NO!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![-] Hyper-V responde correctamente pero este host NO tiene!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![-] virtual machines registered.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![-] ninguna máquina virtual registrada.!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] This is a measured fact, not a query failure:!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Es un hecho medido, no un fallo de consulta:!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Get-VM succeeded and returned zero VMs.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Get-VM funcionó y devolvió cero VMs.!C_RESET!
call :LOG_EVENT "Modulo Hyper-V: Get-VM respondio correctamente y devolvio 0 maquinas virtuales en este host."
pause
goto MENU_VM

:HV_ENV_QUERYFAIL
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] The Hyper-V cmdlets exist but the query FAILED.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Los cmdlets de Hyper-V existen pero la consulta FALLO.!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] This is NOT "there are no virtual machines": Get-VM returned an error.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] Esto NO es "no hay máquinas virtuales": Get-VM devolvio un error.!C_RESET!
if not defined IS_ADMIN if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Most likely cause: this process is NOT elevated.!C_RESET!
if not defined IS_ADMIN if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Causa mas probable: este proceso NO esta elevado.!C_RESET!
if defined HV_VMMS_STATE if /i not "!HV_VMMS_STATE!"=="RUNNING" if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] The vmms service is in state "!HV_VMMS_STATE!": start it and retry.!C_RESET!
if defined HV_VMMS_STATE if /i not "!HV_VMMS_STATE!"=="RUNNING" if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] El servicio vmms esta en estado "!HV_VMMS_STATE!": inicielo y reintente.!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Other causes: WMI/VMMS repository damaged, or a group policy blocking the query.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Otras causas: repositorio WMI/VMMS danado, o una politica que bloquea la consulta.!C_RESET!
call :LOG_EVENT "ABORTADO: el modulo Hyper-V no se inicia porque Get-VM devolvio error (no es ausencia de VMs). Elevado=!IS_ADMIN! vmms=!HV_VMMS_STATE!"
pause
goto MENU_VM

:HV_NO_ENV
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] ERROR: The Hyper-V cmdlets are not available on this system.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] ERROR: Los cmdlets de Hyper-V no están disponibles en este sistema.!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Verify that the Hyper-V role is enabled and that you run as Administrator.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Verifica que el rol de Hyper-V este habilitado y que ejecutas como Administrador.!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Required cmdlets ^(from the Hyper-V module^): Get-VM, Get-VMHardDiskDrive, Get-VMSnapshot!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Cmdlets requeridos ^(del modulo Hyper-V^): Get-VM, Get-VMHardDiskDrive, Get-VMSnapshot!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_DIM!    Note: another product (e.g. VMware PowerCLI) exporting cmdlets with the same!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_DIM!    Nota: otro producto (p. ej. VMware PowerCLI) que exporte cmdlets con el mismo!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_DIM!    name does NOT count: this module requires the real Hyper-V module.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_DIM!    nombre NO cuenta: este modulo exige el modulo Hyper-V real.!C_RESET!
pause
goto MENU_VM

:HV_MENU_SHOW
cls
echo !C_BORDER!!LINE!!C_RESET!
call :HDR TITLE "HYPER-V - FORENSIC ACQUISITION" "HYPER-V - ADQUISICIÓN FORENSE"
echo !C_BORDER!!LINE!!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT!1. RAM Memory Dump (Save-VM; no checkpoints are created)
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT!1. Volcado de Memoria RAM (Save-VM; no se crean checkpoints)
if /i "!FORENSIC_LANG!"=="EN" echo 2. Disk Acquisition (.vhdx/.vhd/.avhdx)
if /i not "!FORENSIC_LANG!"=="EN" echo 2. Adquisición de Discos (.vhdx/.vhd/.avhdx)
if /i "!FORENSIC_LANG!"=="EN" echo 3. Clone Full VM to Import into Hyper-V (config+disks+checkpoints)
if /i not "!FORENSIC_LANG!"=="EN" echo 3. Clonar VM Completa para Importar en Hyper-V (config+discos+checkpoints)
if /i "!FORENSIC_LANG!"=="EN" echo 0. Back!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo 0. Volver!C_RESET!
echo !C_BORDER!!LINE!!C_RESET!
set "hv_opt="
if /i "!FORENSIC_LANG!"=="EN" set /p hv_opt="!C_PROMPT!Select an option: !C_RESET!"
if /i not "!FORENSIC_LANG!"=="EN" set /p hv_opt="!C_PROMPT!Selecciona una opción: !C_RESET!"

for /f "delims=0123456789" %%a in ("!hv_opt!") do (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Invalid option.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Opción inválida.!C_RESET!
    call :WAIT 2
    goto HV_MENU_SHOW
)

if "!hv_opt!"=="0" goto MENU_VM
if "!hv_opt!"=="1" goto HV_MEM
if "!hv_opt!"=="2" goto HV_DISK
if "!hv_opt!"=="3" goto HV_CLONE_FULL

if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Invalid option.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Opción inválida.!C_RESET!
call :WAIT 2
goto HV_MENU_SHOW

:: -----------------------------------------------------------------------
:: HV_HANDLE_VM_RUNNING
:: %1 = nombre de la VM. Si esta en ejecución (o pausada), los .vhdx/.avhdx
:: están en uso y la copia forense no puede proceder de forma consistente.
:: Ofrece apagarla automáticamente (Stop-VM SIN -Force = apagado normal
:: vía Integration Services, equivalente a "vmrun stop soft"/"acpipower
:: button") o que el operador lo haga manualmente y reintente.
:: Resultado en !HVR_ABORT! (1=cancelar; 0=la VM esta apagada, continuar).
:: -----------------------------------------------------------------------
:HV_HANDLE_VM_RUNNING
set "_hvr_name=%~1"
:: Escapado para insercion segura dentro de literales PowerShell de comilla
:: simple: un nombre de VM con un apostrofo (carácter válido en Hyper-V)
:: rompe la sintaxis PowerShell si se interpola sin duplicar la comilla.
set "_hvr_name_ps=!_hvr_name:'=''!"
set "HVR_ABORT=0"

:HVR_CHECK
:: -ErrorAction SilentlyContinue dejaba _hvr_state vacio ante CUALQUIER fallo
:: (permisos, VM inexistente, error transitorio de VMMS) y el "if not defined
:: _hvr_state exit /b 0" de mas abajo lo interpretaba como "puedes copiar". Un
:: estado que no se ha podido medir NO es "apagada": se emite un token propio.
set "_hvr_state="
for /f "usebackq delims=" %%S in (`powershell -NoProfile -Command "try { (Hyper-V\Get-VM -Name '!_hvr_name_ps!' -ErrorAction Stop).State.ToString() } catch { 'ERROR' }"`) do set "_hvr_state=%%S"
if not defined _hvr_state goto HVR_STATE_UNKNOWN
if /I "!_hvr_state!"=="ERROR" goto HVR_STATE_UNKNOWN

:: Estados que CONTIENEN memoria del invitado guardada en disco. La comparacion
:: era de cadena exacta contra Off/Saved, asi que FastSaved, SavedCritical y
:: FastSavedCritical caian en la rama "esta encendida" y se ofrecia Stop-VM:
:: apagar una VM con estado guardado DESCARTA el .vmrs/.bin, es decir borra la
:: RAM del invitado, que es justo la evidencia volatil. Nunca se ofrece apagar
:: una VM en uno de estos estados.
set "_hvr_saved=0"
if /I "!_hvr_state!"=="Saved" set "_hvr_saved=1"
if /I "!_hvr_state!"=="FastSaved" set "_hvr_saved=1"
if /I "!_hvr_state!"=="SavedCritical" set "_hvr_saved=1"
if /I "!_hvr_state!"=="FastSavedCritical" set "_hvr_saved=1"
:: Los estados *Critical indican una VM degradada (por ejemplo el almacenamiento
:: de la VM no es accesible): se puede leer, pero hay que decirlo.
set "_hvr_crit=0"
if /I "!_hvr_state!"=="SavedCritical" set "_hvr_crit=1"
if /I "!_hvr_state!"=="FastSavedCritical" set "_hvr_crit=1"
if /I "!_hvr_state!"=="OffCritical" set "_hvr_crit=1"
if /I "!_hvr_state!"=="PausedCritical" set "_hvr_crit=1"
if /I "!_hvr_state!"=="RunningCritical" set "_hvr_crit=1"
if "!_hvr_crit!"=="1" (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] The VM is in a DEGRADED state ^("!_hvr_state!"^): Hyper-V reports a problem!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] La VM esta en estado DEGRADADO ^("!_hvr_state!"^): Hyper-V informa de un!C_RESET!
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN!    with the VM ^(usually its storage is not reachable^). Whatever is acquired!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN!    problema con la VM ^(normalmente su almacenamiento no es alcanzable^). Lo!C_RESET!
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN!    may be incomplete and this must be recorded in the report.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN!    que se adquiera puede ser incompleto y debe constar asi en el informe.!C_RESET!
    call :LOG_EVENT "ADVERTENCIA: la VM !_hvr_name! esta en estado degradado !_hvr_state!. Lo adquirido puede ser incompleto."
)
if /I "!_hvr_state!"=="Off" exit /b 0
if /I "!_hvr_state!"=="OffCritical" exit /b 0
if "!_hvr_saved!"=="1" (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_OK![+] The VM is in "!_hvr_state!": its disks are quiescent and its guest RAM is!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_OK![+] La VM esta en "!_hvr_state!": sus discos estan en reposo y la RAM del!C_RESET!
    if /i "!FORENSIC_LANG!"=="EN" echo !C_OK!    already on disk. Powering it off is NOT offered: that would DISCARD the!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_OK!    invitado ya esta en disco. NO se ofrece apagarla: eso DESCARTARIA el!C_RESET!
    if /i "!FORENSIC_LANG!"=="EN" echo !C_OK!    saved state and destroy the volatile evidence.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_OK!    estado guardado y destruiria la evidencia volatil.!C_RESET!
    call :LOG_EVENT "VM !_hvr_name! en estado !_hvr_state!: se copia sin apagarla para no descartar el estado guardado (RAM del invitado)."
    exit /b 0
)

echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] The VM "!_hvr_name!" is in state "!_hvr_state!".!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] La VM "!_hvr_name!" esta en estado "!_hvr_state!".!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] It must be powered off ^(Off^) to guarantee the forensic integrity of the disks.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] Debe estar apagada ^(Off^) para garantizar la integridad forense de los discos.!C_RESET!
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![1] Power off the VM automatically from this script ^(Stop-VM, normal shutdown^)
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![1] Apagar la VM automáticamente desde este script ^(Stop-VM, apagado normal^)
if /i "!FORENSIC_LANG!"=="EN" echo [2] I will power it off myself - retry the check
if /i not "!FORENSIC_LANG!"=="EN" echo [2] La apagaré yo manualmente - reintentar verificación
if /i "!FORENSIC_LANG!"=="EN" echo [0] Cancel!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo [0] Cancelar!C_RESET!
:HVR_ASK
set "_hvr_opt="
if /i "!FORENSIC_LANG!"=="EN" set /p _hvr_opt="!C_PROMPT!Option: !C_RESET!"
if /i not "!FORENSIC_LANG!"=="EN" set /p _hvr_opt="!C_PROMPT!Opción: !C_RESET!"
if "!_hvr_opt!"=="0" (
    set "HVR_ABORT=1"
    call :LOG_EVENT "Adquisicion Hyper-V cancelada: VM en estado !_hvr_state! - !_hvr_name!"
    exit /b 0
)
if "!_hvr_opt!"=="2" (
    echo.
    if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Power off the VM in Hyper-V Manager and press a key to retry...!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Apague la VM en Hyper-V Manager y presione una tecla para reintentar...!C_RESET!
    pause
    goto HVR_CHECK
)
if not "!_hvr_opt!"=="1" (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Invalid option. Enter 0, 1 or 2.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Opción inválida. Ingrese 0, 1 o 2.!C_RESET!
    goto HVR_ASK
)

echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Shutting down the VM normally ^(Stop-VM, without -Force^)...!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Apagando la VM de forma normal ^(Stop-VM, sin -Force^)...!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Uses Integration Services to ask the guest OS to shut down,!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Usa Integration Services para pedirle al SO invitado que se apague,!C_RESET!
rem Antes decia "igual que ... o ACPI power button (VirtualBox)", lo que sugeria
rem que el modulo de VirtualBox lo usa. No lo usa: alli se explica a proposito
rem por que NO se intenta el apagado automatico (la senal ACPI puede quedar a la
rem espera de una confirmacion manual dentro del invitado). Se cita solo VMware,
rem que es donde el framework si tiene equivalente.
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT!    same as "vmrun stop soft" ^(VMware^).!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT!    igual que "vmrun stop soft" ^(VMware^).!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT!    Requires the Integration Services to be installed and active.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT!    Requiere que las Integration Services esten instaladas y activas.!C_RESET!
call :UTCNOW _HVR_TS1
:: Con -ErrorAction SilentlyContinue powershell salia 0 aunque Stop-VM fallara
:: (caso real: VM en Paused), y el diario de la cadena de custodia registraba un
:: apagado correcto que no habia ocurrido. Con -ErrorAction Stop y exit 1 dentro
:: del catch, el codigo que se registra es el REAL.
powershell -NoProfile -Command "try { Hyper-V\Stop-VM -Name '!_hvr_name_ps!' -ErrorAction Stop } catch { exit 1 }" >nul 2>&1
set "_hvr_stop_el=!errorLevel!"
call :UTCNOW _HVR_TS2
call :LOG_CMD "HyperV_StopVM" "Stop-VM -Name ""!_hvr_name!""" "!_hvr_stop_el!" "!_HVR_TS1!" "!_HVR_TS2!" "" ""
if not "!_hvr_stop_el!"=="0" (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Stop-VM returned an error: the VM was NOT powered off by this framework.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Stop-VM devolvio error: la VM NO fue apagada por este framework.!C_RESET!
    call :LOG_EVENT "Error: Stop-VM fallo sobre !_hvr_name! (codigo !_hvr_stop_el!). No se afirma ningun apagado."
)

if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Waiting for the guest operating system to finish shutting down...!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Esperando a que el sistema operativo invitado termine de apagarse...!C_RESET!
set "_hvr_wait=0"
:HVR_WAIT_LOOP
call :WAIT 3
set "_hvr_state2="
for /f "usebackq delims=" %%S in (`powershell -NoProfile -Command "try { (Hyper-V\Get-VM -Name '!_hvr_name_ps!' -ErrorAction Stop).State.ToString() } catch { 'ERROR' }"`) do set "_hvr_state2=%%S"
if /I "!_hvr_state2!"=="Off" goto HVR_CONFIRMED
set /a _hvr_wait+=3
if !_hvr_wait! lss 60 goto HVR_WAIT_LOOP

if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] The VM is still in state "!_hvr_state2!" after 60 seconds of waiting.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] La VM sigue en estado "!_hvr_state2!" tras 60 segundos de espera.!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] The normal shutdown may require manual confirmation inside the guest,!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] El apagado normal puede requerir confirmación manual dentro del guest,!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] or the Integration Services are not installed/responding.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] o las Integration Services no están instaladas/respondiendo.!C_RESET!
call :LOG_EVENT "Advertencia: VM Hyper-V sigue encendida tras Stop-VM + 60s de espera - !_hvr_name!"
goto HVR_CHECK

:HVR_CONFIRMED
if /i "!FORENSIC_LANG!"=="EN" echo !C_OK![+] VM powered off successfully.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_OK![+] VM apagada correctamente.!C_RESET!
call :LOG_EVENT "VM Hyper-V apagada via Stop-VM: !_hvr_name!"
exit /b 0

:HVR_STATE_UNKNOWN
:: Un estado que no se ha podido leer NO es "apagada". Antes se devolvia
:: "puedes copiar" y se copiaban discos posiblemente en uso, con lo que la
:: evidencia salia inconsistente y ademas se declaraba correcta.
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Could NOT determine the state of the VM "!_hvr_name!".!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] NO se pudo determinar el estado de la VM "!_hvr_name!".!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] An unknown state is NOT the same as "powered off": copying now could produce!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] Un estado desconocido NO es lo mismo que "apagada": copiar ahora podria dar!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN!    an inconsistent image of disks that are still in use.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN!    una imagen inconsistente de discos que siguen en uso.!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Possible causes: no privileges, the VM no longer exists, a VMMS error, or a!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Causas posibles: sin privilegios, la VM ya no existe, error de VMMS, o un!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT!    VM name that this parser cannot carry ^(exclamation mark^).!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT!    nombre de VM que este parser no puede transportar ^(signo de exclamacion^).!C_RESET!
set "HVR_ABORT=1"
call :LOG_EVENT "ABORTADO: no se pudo determinar el estado de la VM Hyper-V !_hvr_name!. Un estado indeterminado no se trata como apagada."
pause
exit /b 0

:: -----------------------------------------------------------------------
:: ASK_HV_SNAPSHOT_MODE
:: %1 = cantidad de checkpoints detectados (siempre > 0 al llamarse).
:: Resultado en !HV_SNAP_MODE!:
::   1 = adquirir el disco COMPLETO (estado actual, con la cadena de
::       checkpoints tal como esta adjunta).
::   2 = adquirir SOLO el disco base (excluir checkpoints) - se resuelve
::       subiendo la cadena de discos diferenciales (Get-VHD ParentPath)
::       hasta la raiz.
::   3 = adquirir SOLO un checkpoint específico - copia su disco mas TODA
::       la cadena de ancestros necesaria (sin consolidar; para consolidar
::       ya existe la opción "Merge-VHD" del menu de discos).
::   0 = cancelar
:: -----------------------------------------------------------------------
:ASK_HV_SNAPSHOT_MODE
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![CAUTION] %~1 checkpoint^(s^) were detected for this virtual machine.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![ATENCIÓN] Se detectaron %~1 checkpoint^(s^) para esta máquina virtual.!C_RESET!
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT!How do you want to proceed?!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT!¿Cómo desea proceder?!C_RESET!
echo.
rem El rotulo decia "checkpoints aplicados", lo que sugiere una consolidacion que
rem NO ocurre: se copia la cadena tal cual esta, diferenciales incluidos. Ademas
rem el modo antes copiaba SOLO el disco hoja, con lo que ni siquiera era completo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![1] Acquire the COMPLETE chain ^(leaf .avhdx + every parent, nothing is merged^)
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![1] Adquirir la cadena COMPLETA ^(.avhdx hoja + todos sus padres, sin consolidar^)
if /i "!FORENSIC_LANG!"=="EN" echo [2] Acquire ONLY the base disk ^(exclude checkpoints^)
if /i not "!FORENSIC_LANG!"=="EN" echo [2] Adquirir SOLO el disco base ^(excluir checkpoints^)
if /i "!FORENSIC_LANG!"=="EN" echo [3] Acquire ONLY a specific checkpoint
if /i not "!FORENSIC_LANG!"=="EN" echo [3] Adquirir SOLO un checkpoint específico
if /i "!FORENSIC_LANG!"=="EN" echo [0] Cancel!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo [0] Cancelar!C_RESET!
:ASK_HV_MODE_LOOP
set "_hvm_opt="
if /i "!FORENSIC_LANG!"=="EN" set /p _hvm_opt="!C_PROMPT!Option: !C_RESET!"
if /i not "!FORENSIC_LANG!"=="EN" set /p _hvm_opt="!C_PROMPT!Opción: !C_RESET!"
if "!_hvm_opt!"=="1" (
    set "HV_SNAP_MODE=1"
    exit /b 0
)
if "!_hvm_opt!"=="2" (
    set "HV_SNAP_MODE=2"
    exit /b 0
)
if "!_hvm_opt!"=="3" (
    set "HV_SNAP_MODE=3"
    exit /b 0
)
if "!_hvm_opt!"=="0" (
    set "HV_SNAP_MODE=0"
    exit /b 0
)
if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Invalid option. Enter 0, 1, 2 or 3.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Opción inválida. Ingrese 0, 1, 2 o 3.!C_RESET!
goto ASK_HV_MODE_LOOP

:: -----------------------------------------------------------------------
:: HV_LIST_SNAPSHOTS
:: %1 = nombre de la VM. Enumera checkpoints con su nombre REAL (Get-
:: VMSnapshot ya expone el nombre visible en Hyper-V Manager - a diferencia
:: de VMware, aquí no hace falta buscar un diccionario aparte).
:: Resultado: !HVL_COUNT! y array !HVL_NAME_i!.
:: -----------------------------------------------------------------------
:HV_LIST_SNAPSHOTS
set "HVL_COUNT=0"
:: %~1 se interpolaba CRUDO en un literal PowerShell de comilla simple, al
:: contrario que el resto del modulo (que usa las variables _PS con la comilla
:: duplicada). Una VM cuyo nombre lleve un apostrofo -caracter valido en
:: Hyper-V- rompia la sintaxis del literal, Get-VMSnapshot no se ejecutaba,
:: HVL_COUNT quedaba en 0 y la pantalla decia "No se pudieron enumerar los
:: checkpoints con nombre", que apunta a un problema inexistente. Se escapa aqui
:: para que la rutina sea segura sea quien sea el que la llame.
set "_hls_name=%~1"
set "_hls_name_ps=!_hls_name:'=''!"
for /f "usebackq delims=" %%N in (`powershell -NoProfile -Command "Hyper-V\Get-VMSnapshot -VMName '!_hls_name_ps!' -ErrorAction SilentlyContinue | Select-Object -ExpandProperty Name"`) do (
    set /a HVL_COUNT+=1
    set "HVL_NAME_!HVL_COUNT!=%%N"
)
exit /b 0

:: -----------------------------------------------------------------------
:: HV_ENUM_VMS
:: Enumeracion UNICA de las maquinas virtuales de Hyper-V. Antes habia tres
:: copias del mismo for /f (discos, memoria y clon completo) y las tres se
:: desviaban entre si: las tres sin -NoProfile -un perfil de PowerShell que
:: escriba a stdout inyecta VMs fantasma en el array-, dos sin la version de
:: config, y ninguna capaz de sobrevivir a un nombre con caracteres hostiles.
:: Emite State^|Flag^|SafeName^|ConfigVer^|Name con el NOMBRE AL FINAL a
:: proposito: es el unico campo libre y con el token "*" sobrevive incluso si
:: el nombre contiene el propio separador "^|".
:: SafeName lo calcula PowerShell con GetInvalidFileNameChars, que es la lista
:: real de Win32; el saneado a mano en batch dejaba fuera ? * la comilla doble
:: y los puntos y espacios finales, y el mkdir fallaba mucho despues con un
:: mensaje ajeno ("No se pudo copiar ningun disco").
:: Flag=BANG marca los nombres con signo de exclamacion: la expansion retardada
:: los destruye al pasar por una variable de for o por un argumento de call
:: (medido: "Equipo !Alerta! de Ana" llega como "Equipo de Ana"), asi que esas
:: VMs se rechazan con un mensaje claro en vez de operar sobre otro nombre.
:: Los cmdlets van cualificados con el modulo: sin cualificar, VMware PowerCLI
:: -que tambien exporta Get-VM- puede ganar la resolucion de nombre.
:: Resultado: !HV_COUNT! y los arrays HV_STATE_i HV_FLAG_i HV_SAFE_i HV_VER_i
:: HV_NAME_i.
:: -----------------------------------------------------------------------
:HV_ENUM_VMS
set "HV_COUNT=0"
for /f "tokens=1,2,3,4,* delims=|" %%A in ('powershell -NoProfile -Command "Hyper-V\Get-VM | ForEach-Object { $sn = $_.Name; foreach ($c in [System.IO.Path]::GetInvalidFileNameChars()) { $sn = $sn.Replace($c, [char]95) }; $sn = $sn.Replace([char]33, [char]95).TrimEnd([char]32, [char]46); if (-not $sn) { $sn = 'VM_' + $_.Id.ToString() }; $cv = ''; if ($_.Version) { $cv = [string]$_.Version }; if (-not $cv) { $cv = 'no disponible' }; $_.State.ToString() + '|' + $(if ($_.Name.Contains([string][char]33)) { 'BANG' } else { 'OK' }) + '|' + $sn + '|' + $cv + '|' + $_.Name }" 2^>nul') do (
    set /a HV_COUNT+=1
    set "HV_STATE_!HV_COUNT!=%%A"
    set "HV_FLAG_!HV_COUNT!=%%B"
    set "HV_SAFE_!HV_COUNT!=%%C"
    set "HV_VER_!HV_COUNT!=%%D"
    set "HV_NAME_!HV_COUNT!=%%E"
)
exit /b 0

:: -----------------------------------------------------------------------
:: HV_CHECK_BANG_PATH
:: %1 = NOMBRE de la variable que contiene la ruta, NO su valor: pasar el valor
:: como argumento de call ya destruiria el caracter que se quiere detectar.
:: Devuelve !HV_BANG_PATH!=1 si la ruta
:: contiene un signo de exclamacion. Un "!" en la ruta sobrevive dentro de una
:: variable, pero se DESTRUYE al pasar por una variable de for o por un
:: argumento de call: medido, "D:\Casos\Eq!uipo" llega a :VALIDATE_DEST_DIR
:: como "D:\Casos\Equipo", de modo que se validaba una carpeta distinta de la
:: que se iba a usar. Es una limitacion real del parser de cmd.exe, no algo que
:: se pueda sortear: se detecta y se rechaza. La deteccion compara el valor
:: expandido con el mismo valor pasado por una variable de for, que es
:: precisamente donde el caracter se pierde.
:: -----------------------------------------------------------------------
:HV_CHECK_BANG_PATH
set "HV_BANG_PATH=0"
for /f "delims=" %%Z in ("!%~1!") do if not "%%Z"=="!%~1!" set "HV_BANG_PATH=1"
exit /b 0

:: -----------------------------------------------------------------------
:: HVC_SHOW_CONS
:: %1 = indice del disco consolidado. Imprime nombre y tamano real.
:: -----------------------------------------------------------------------
:HVC_SHOW_CONS
set "_hcs_name=!HVC_CONS_%1!"
set "_hcs_size=0"
for %%F in ("!HV_CONS_DIR!\!_hcs_name!") do set "_hcs_size=%%~zF"
if /i "!FORENSIC_LANG!"=="EN" echo     !C_OK!- !HV_CONS_DIR!\!_hcs_name!  ^(!_hcs_size! bytes^)!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo     !C_OK!- !HV_CONS_DIR!\!_hcs_name!  ^(!_hcs_size! bytes^)!C_RESET!
call :LOG_EVENT "Disco consolidado producido: !HV_CONS_DIR!\!_hcs_name! (!_hcs_size! bytes)"
exit /b 0

:: -----------------------------------------------------------------------
:: HVM_CLASSIFY_FILE
:: %1 = archivo de estado localizado. Clasifica por extension EXACTA:
::   .vmrs -> portador de RAM autosuficiente (config >= 6.2)
::   .bin  -> portador de RAM, pero SOLO utilizable junto a su .vsv (config < 6.2)
::   .vsv  -> estado de dispositivos: NO lleva RAM
::   .vmgs -> estado del invitado de una Gen2 reciente: NO lleva RAM
:: -----------------------------------------------------------------------
:HVM_CLASSIFY_FILE
set "_hmx=%~x1"
if /i "!_hmx!"==".vmrs" set /a hvm_vmrs_count+=1
if /i "!_hmx!"==".bin" set /a hvm_bin_count+=1
if /i "!_hmx!"==".vsv" set /a hvm_vsv_count+=1
if /i "!_hmx!"==".vmgs" set /a hvm_aux_count+=1
exit /b 0

:: -----------------------------------------------------------------------
:: HV_QEMU_CLASSIFY
:: %1 = archivo. Clasifica por extension EXACTA en base (.vhdx/.vhd/.vhds) o
:: diferencial (.avhdx/.avhd) y guarda el primer disco base en !hv_qemu_src!.
:: Se hace con comparacion de extension y no con comodines porque en cmd.exe el
:: patron "*.vhd" TAMBIEN casa con los archivos .vhdx.
:: -----------------------------------------------------------------------
:HV_QEMU_CLASSIFY
set "_hqx=%~x1"
set "_hqb=0"
if /i "!_hqx!"==".vhdx" set "_hqb=1"
if /i "!_hqx!"==".vhd" set "_hqb=1"
if /i "!_hqx!"==".vhds" set "_hqb=1"
if /i "!_hqx!"==".avhdx" set /a hv_qd_count+=1
if /i "!_hqx!"==".avhd" set /a hv_qd_count+=1
if "!_hqb!"=="1" set /a hv_qb_count+=1
if "!_hqb!"=="1" if not defined hv_qemu_src set "hv_qemu_src=%~1"
exit /b 0

:: -----------------------------------------------------------------------
:: HV_WARN_PASSTHRU
:: Aviso BLOQUEANTE por discos de paso a traves. Antes desaparecian sin dejar
:: rastro: Get-VMHardDiskDrive devuelve Path vacio para un disco fisico y
:: Sort-Object -Unique eliminaba el elemento nulo de la salida, asi que si el
:: paso a traves era el unico disco la pantalla decia "No se encontraron discos
:: asociados a esta VM" -falso, hay disco- y si convivia con un VHDX se copiaba
:: solo el VHDX y se cerraba con "Discos copiados exitosamente" mas hashes.
:: Eso es omision silenciosa de evidencia: ISO/IEC 27037 6.5 exige documentar el
:: alcance real de lo adquirido.
:: Devuelve !HV_PT_ABORT! definido si el operador decide no continuar.
:: -----------------------------------------------------------------------
:HV_WARN_PASSTHRU
set "HV_PT_ABORT="
echo.
echo !C_BORDER!!SUBLINE!!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![ATTENTION] This VM has !hv_passthru_count! PASS-THROUGH physical disk^(s^).!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![ATENCIÓN] Esta VM tiene !hv_passthru_count! disco^(s^) fisico^(s^) de PASO A TRAVES.!C_RESET!
for /L %%i in (1,1,!hv_passthru_count!) do echo     !C_WARN!- !HV_PT_%%i!!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] A pass-through disk is NOT a VHD/VHDX file: the guest writes straight to!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] Un disco de paso a traves NO es un archivo VHD/VHDX: el invitado escribe!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN!    a physical disk of the host. This module CANNOT copy it.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN!    directamente en un disco fisico del host. Este modulo NO lo puede copiar.!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] To acquire it, use the PHYSICAL DISK acquisition module of this framework!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Para adquirirlo, use el modulo de adquisición de DISCO FISICO de este!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT!    and give it the DiskNumber shown above.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT!    framework indicando el DiskNumber mostrado arriba.!C_RESET!
rem Se reparte en dos lineas: en una sola pasaba de las 74 columnas del lienzo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![i] If you continue, the acquisition will be INCOMPLETE and!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![i] Si continúa, la adquisición será INCOMPLETA y debe constar!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR!    must be reported as such.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR!    así en el informe.!C_RESET!
echo !C_BORDER!!SUBLINE!!C_RESET!
call :LOG_EVENT "ALCANCE LIMITADO: !HV_VMNAME! tiene !hv_passthru_count! disco/s de paso a traves que este modulo no puede copiar. La adquisicion de discos NO cubre la totalidad del almacenamiento de la VM."
:HV_PT_ASK
set "_hvpt_go="
if /i "!FORENSIC_LANG!"=="EN" set /p _hvpt_go="!C_PROMPT!Continue with the VHD/VHDX disks only? [Y/N]: !C_RESET!"
if /i not "!FORENSIC_LANG!"=="EN" set /p _hvpt_go="!C_PROMPT!¿Continuar solo con los discos VHD/VHDX? [S/N]: !C_RESET!"
if /i "!_hvpt_go!"=="Y" set "_hvpt_go=S"
if /I "!_hvpt_go!"=="S" (
    call :LOG_EVENT "El operador decide continuar la adquisicion de discos Hyper-V a sabiendas de que los discos de paso a traves quedan fuera."
    exit /b 0
)
if /I "!_hvpt_go!"=="N" (
    set "HV_PT_ABORT=1"
    call :LOG_EVENT "El operador cancela la adquisicion de discos Hyper-V al conocer los discos de paso a traves. No se copio nada."
    exit /b 0
)
if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Answer Y or N.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Responda S o N.!C_RESET!
goto HV_PT_ASK

:: Destino comun de rechazo cuando el nombre de la VM elegida contiene un signo
:: de exclamacion. No se intenta ningun truco: es una limitacion real del parser
:: y lo unico sostenible es decirlo y no actuar.
:HV_SEL_BANG
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] That VM cannot be processed from this framework: its name contains an!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Esa VM no se puede procesar desde este framework: su nombre contiene un!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] exclamation mark, which cmd.exe destroys under delayed expansion.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] signo de exclamacion, que cmd.exe destruye bajo expansion retardada.!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] Acting on it would mean acting on a DIFFERENT VM name than the one shown.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] Actuar sobre ella seria actuar sobre un nombre de VM DISTINTO del mostrado.!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Options: rename the VM in Hyper-V Manager (does not touch its disks), or!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Opciones: renombrar la VM en Hyper-V Manager (no toca sus discos), o!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT!    acquire it with Export-VM from an elevated PowerShell.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT!    adquirirla con Export-VM desde un PowerShell elevado.!C_RESET!
call :LOG_EVENT "RECHAZADO: la VM seleccionada tiene un signo de exclamacion en el nombre. El parser de cmd.exe lo destruye y se operaria sobre otro nombre. No se realiza ninguna accion sobre esa VM."
pause
goto HV_MENU_SHOW

:: --- HYPER-V: ADQUISICIÓN DE DISCOS ---
:HV_DISK
:: Los .vhdx y la configuracion se obtienen copiandolos. La deteccion mira el
:: PATH, asi que la compuerta tambien cubre un host con System32 fuera del PATH.
if not defined HAS_ROBOCOPY call :ROBOCOPY_MISSING "Hyper-V - adquisicion de discos virtuales"
if not defined HAS_ROBOCOPY goto HV_MENU_SHOW
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Hyper-V Virtual Disk Acquisition!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Adquisición de Discos Virtuales Hyper-V!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Enumerating virtual machines...!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Enumerando máquinas virtuales...!C_RESET!
echo.

call :HV_ENUM_VMS

if !HV_COUNT! equ 0 (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![-] No virtual machines were found in Hyper-V.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![-] No se encontraron máquinas virtuales en Hyper-V.!C_RESET!
    pause
    goto HV_MENU_SHOW
)

if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT!Hyper-V Virtual Machines detected:!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT!Máquinas Virtuales Hyper-V detectadas:!C_RESET!
set "HV_ANY_BANG="
for /L %%i in (1,1,!HV_COUNT!) do (
    echo.
    echo  !C_OK!%%i. !HV_NAME_%%i!!C_RESET!
    if /i "!FORENSIC_LANG!"=="EN" echo     State: !HV_STATE_%%i!
    if /i not "!FORENSIC_LANG!"=="EN" echo     Estado: !HV_STATE_%%i!
    if "!HV_FLAG_%%i!"=="BANG" if /i "!FORENSIC_LANG!"=="EN" echo     !C_ERR![-] Name with an exclamation mark: NOT selectable^(*^)!C_RESET!
    if "!HV_FLAG_%%i!"=="BANG" if /i not "!FORENSIC_LANG!"=="EN" echo     !C_ERR![-] Nombre con signo de exclamacion: NO seleccionable^(*^)!C_RESET!
    if "!HV_FLAG_%%i!"=="BANG" set "HV_ANY_BANG=1"
)
echo.
:: (*) No es un capricho: cmd.exe destruye el "!" al pasar el nombre por una
:: variable de for o por un argumento de call, asi que el framework operaria
:: sobre un nombre distinto del que el operador cree haber elegido. Se avisa y
:: se rechaza, en vez de intentar un truco que no se puede sostener.
if defined HV_ANY_BANG (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] ^(*^) cmd.exe destroys the exclamation mark when the name travels through!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] ^(*^) cmd.exe destruye el signo de exclamacion al pasar el nombre por una!C_RESET!
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN!     a for variable or a call argument: it would act on a DIFFERENT name.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN!     variable de for o un argumento de call: se actuaria sobre OTRO nombre.!C_RESET!
    if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT!     Rename the VM in Hyper-V Manager, or acquire it with Export-VM from!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT!     Renombre la VM en Hyper-V Manager, o adquierala con Export-VM desde!C_RESET!
    if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT!     an elevated PowerShell.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT!     un PowerShell elevado.!C_RESET!
    echo.
)

:HV_PROMPT_DISK_SEL
set "hv_sel="
if /i "!FORENSIC_LANG!"=="EN" set /p hv_sel="!C_PROMPT!Select the VM [1-!hv_count!, 0=cancel]: !C_RESET!"
if /i not "!FORENSIC_LANG!"=="EN" set /p hv_sel="!C_PROMPT!Seleccione la VM [1-!hv_count!, 0=cancelar]: !C_RESET!"
if "!hv_sel!"=="0" goto HV_MENU_SHOW
if not defined hv_sel goto HV_PROMPT_DISK_SEL
for /f "delims=0123456789" %%a in ("!hv_sel!") do (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Please enter a valid number.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Por favor, ingrese un número válido.!C_RESET!
    goto HV_PROMPT_DISK_SEL
)
if !hv_sel! lss 1 goto HV_PROMPT_DISK_SEL
if !hv_sel! gtr !hv_count! goto HV_PROMPT_DISK_SEL

call :NORM_SEL hv_sel
set "HV_VMNAME=!HV_NAME_%hv_sel%!"
call :LOG_CTX "HYPER-V" "!HV_VMNAME!"
if not defined HV_VMNAME goto HV_PROMPT_DISK_SEL
if "!HV_FLAG_%hv_sel%!"=="BANG" goto HV_SEL_BANG
:: Escapado para PowerShell (comilla simple duplicada) - ver nota en HV_HANDLE_VM_RUNNING.
set "HV_VMNAME_PS=!HV_VMNAME:'=''!"

:: Verificar que la VM NO este en ejecución - si lo esta, ofrecer apagarla
:: automáticamente (Stop-VM, apagado normal) o que el operador lo haga manual.
call :HV_HANDLE_VM_RUNNING "!HV_VMNAME!"
if "!HVR_ABORT!"=="1" goto HV_MENU_SHOW

:: Nombre de carpeta ya saneado por :HV_ENUM_VMS con la lista real de caracteres
:: invalidos de Win32 (antes se quitaban a mano / : \ < > | pero NO ? * la
:: comilla doble ni los puntos y espacios finales, y el mkdir fallaba despues).
set "HV_FOLDER=!HV_SAFE_%hv_sel%!"
if not defined HV_FOLDER set "HV_FOLDER=VM_HyperV"

:: Pedir destino de evidencia
echo.
:ASK_HV_DEST
set "hv_dest="
if /i "!FORENSIC_LANG!"=="EN" set /p hv_dest="!C_PROMPT!Destination folder path [Enter = !DEFAULT_DEST!] (0=cancel): !C_RESET!"
if /i not "!FORENSIC_LANG!"=="EN" set /p hv_dest="!C_PROMPT!Ruta de la carpeta destino [Enter = !DEFAULT_DEST!] (0=cancelar): !C_RESET!"
if "!hv_dest!"=="0" goto HV_MENU_SHOW
if defined hv_dest set "hv_dest=!hv_dest:"=!"
if not defined hv_dest (
    set "hv_dest=!DEFAULT_DEST!"
    if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Using default destination: !DEFAULT_DEST!!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Usando destino por defecto: !DEFAULT_DEST!!C_RESET!
)
:: Un "!" en la ruta sobrevive dentro de una variable pero se destruye al pasar
:: por :VALIDATE_DEST_DIR (argumento de call): se validaria una carpeta y se
:: escribiria en otra. Se detecta ANTES de validar.
call :HV_CHECK_BANG_PATH hv_dest
if "!HV_BANG_PATH!"=="1" (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] The destination path contains an exclamation mark. cmd.exe cannot carry it!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] La ruta de destino contiene un signo de exclamacion. cmd.exe no lo puede!C_RESET!
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] reliably, and the evidence would be written somewhere else.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] transportar con fiabilidad y la evidencia acabaria en otra carpeta.!C_RESET!
    if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Use a destination path without that character.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Use una ruta de destino sin ese caracter.!C_RESET!
    call :LOG_EVENT "RECHAZADO: la ruta de destino de la adquisicion de discos Hyper-V contiene un signo de exclamacion."
    goto ASK_HV_DEST
)
call :VALIDATE_DEST_DIR "!hv_dest!"
if not "!_VD_OK!"=="1" goto ASK_HV_DEST

:: La carpeta llevaba solo el nombre de la VM, y los archivos de disco y de
:: estado se llaman por GUID: repetir la adquisicion de la MISMA VM hacia que
:: robocopy sobreescribiera los archivos de la anterior. Con marca de tiempo UTC
:: cada actuacion queda en su propia carpeta y ninguna pisa a la otra.
call :UTCNOW HV_ACQ_TS COMPACT
set "HV_EVIDENCE=!hv_dest!\HyperV\!HV_FOLDER!_!HV_ACQ_TS!"
set "DEST=!HV_EVIDENCE!"
if not exist "!HV_EVIDENCE!\Disks" mkdir "!HV_EVIDENCE!\Disks"

call :LOG_EVENT "Adquisicion de discos Hyper-V iniciada: !HV_VMNAME! -> !HV_EVIDENCE!"

:: Detectar checkpoints/snapshots ANTES de enumerar discos (comando oficial:
:: Get-VMSnapshot) y preguntar al operador como proceder.
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Verifying checkpoints/snapshots of !HV_VMNAME!...!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Verificando checkpoints/snapshots de !HV_VMNAME!...!C_RESET!
:: Con -ErrorAction SilentlyContinue un fallo real -VM inexistente, modulo Hyper-V
:: ausente, consulta sin privilegios- dejaba $s vacio y se imprimia 0, igual que
:: una VM SIN checkpoints. Se cambia a -ErrorAction Stop dentro de try/catch para
:: que el fallo emita un token propio. Medido: la VM inexistente da ERROR, la
:: coleccion legitimamente vacia da 0, y en los dos casos powershell sale con 0
:: -asi que el for /f sigue leyendo el token-.
set "hv_snap_count=DESCONOCIDO"
for /f "usebackq delims=" %%S in (`powershell -NoProfile -Command "try { $s = @(Get-VMSnapshot -VMName '!HV_VMNAME_PS!' -ErrorAction Stop); $s.Count } catch { 'ERROR' }"`) do set "hv_snap_count=%%S"
if "!hv_snap_count!"=="" set "hv_snap_count=DESCONOCIDO"
if /i "!hv_snap_count!"=="ERROR" set "hv_snap_count=DESCONOCIDO"

set "HV_SNAP_MODE=1"
set "HV_CHOSEN_SNAP_NAME="
if "!hv_snap_count!"=="DESCONOCIDO" goto HV_SNAP_ENUM_FAILED
if !hv_snap_count! equ 0 (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_OK![+] No checkpoints detected.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_OK![+] No se detectaron checkpoints.!C_RESET!
    goto HV_SNAP_MODE_DONE
)
call :ASK_HV_SNAPSHOT_MODE !hv_snap_count!
call :LOG_EVENT "Hyper-V checkpoints detectados: !hv_snap_count! (modo=!HV_SNAP_MODE!) - !HV_VMNAME!"
if "!HV_SNAP_MODE!"=="0" goto HV_MENU_SHOW
if "!HV_SNAP_MODE!"=="1" if /i "!FORENSIC_LANG!"=="EN" echo !C_OK![+] The COMPLETE chain will be acquired: active differential plus every parent.!C_RESET!
if "!HV_SNAP_MODE!"=="1" if /i not "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Se adquirira la cadena COMPLETA: el diferencial activo y todos sus padres.!C_RESET!
if "!HV_SNAP_MODE!"=="1" if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] Nothing is merged: to obtain a single mountable disk use the consolidation!C_RESET!
if "!HV_SNAP_MODE!"=="1" if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] No se consolida nada: para obtener un disco único montable use la opción de!C_RESET!
if "!HV_SNAP_MODE!"=="1" if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN!    option offered after the copy. A chain missing one link is not analysable.!C_RESET!
if "!HV_SNAP_MODE!"=="1" if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN!    consolidacion que se ofrece tras la copia. Una cadena incompleta no se analiza.!C_RESET!
if "!HV_SNAP_MODE!"=="2" if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] Checkpoints will be excluded. Only the base disk will be acquired.!C_RESET!
if "!HV_SNAP_MODE!"=="2" if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] Los checkpoints serán excluidos. Solo se adquirira el disco base.!C_RESET!
if not "!HV_SNAP_MODE!"=="3" goto HV_SNAP_MODE_DONE

:: NOTA: selección a nivel superior (sin envolver en "if (...)") - ver la
:: misma nota en VBOX_DISK sobre labels anidados dentro de parentesis.
call :HV_LIST_SNAPSHOTS "!HV_VMNAME!"
if !HVL_COUNT! equ 0 (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Could not enumerate the named checkpoints.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] No se pudieron enumerar los checkpoints con nombre.!C_RESET!
    pause
    goto HV_MENU_SHOW
)
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_TITLE!Available checkpoints:!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TITLE!Checkpoints disponibles:!C_RESET!
echo.
for /L %%i in (1,1,!HVL_COUNT!) do echo  !C_WARN!%%i. !HVL_NAME_%%i!!C_RESET!
echo.
:HV_PROMPT_SNAP_SEL
set "hvl_sel="
if /i "!FORENSIC_LANG!"=="EN" set /p hvl_sel="!C_PROMPT!Select the checkpoint to acquire [1-!HVL_COUNT!, 0=cancel]: !C_RESET!"
if /i not "!FORENSIC_LANG!"=="EN" set /p hvl_sel="!C_PROMPT!Seleccione el checkpoint a adquirir [1-!HVL_COUNT!, 0=cancelar]: !C_RESET!"
if "!hvl_sel!"=="0" goto HV_MENU_SHOW
if not defined hvl_sel goto HV_PROMPT_SNAP_SEL
for /f "delims=0123456789" %%a in ("!hvl_sel!") do (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Enter a valid number.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Ingrese un número válido.!C_RESET!
    goto HV_PROMPT_SNAP_SEL
)
if !hvl_sel! lss 1 goto HV_PROMPT_SNAP_SEL
if !hvl_sel! gtr !HVL_COUNT! goto HV_PROMPT_SNAP_SEL
call :NORM_SEL hvl_sel
set "HV_CHOSEN_SNAP_NAME=!HVL_NAME_%hvl_sel%!"
if not defined HV_CHOSEN_SNAP_NAME goto HV_PROMPT_SNAP_SEL
if /i "!FORENSIC_LANG!"=="EN" echo !C_OK![+] ONLY the checkpoint will be acquired: !HV_CHOSEN_SNAP_NAME!!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Se adquirira SOLO el checkpoint: !HV_CHOSEN_SNAP_NAME!!C_RESET!
goto HV_SNAP_MODE_DONE

:HV_SNAP_ENUM_FAILED
:: Mismo criterio que en :HV_LIST_SNAPSHOTS mas abajo: si no se puede enumerar,
:: se aborta y se dice por que, en vez de afirmar que no hay checkpoints.
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Could not enumerate the checkpoints of !HV_VMNAME!.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] No se pudieron enumerar los checkpoints de !HV_VMNAME!.!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] Get-VMSnapshot returned an error. Possible causes: the Hyper-V module is!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] Get-VMSnapshot devolvio error. Causas posibles: el modulo de Hyper-V no!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] not available, the VM no longer exists, or there are no privileges to query it.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] esta disponible, la VM ya no existe, o no hay privilegios para consultarla.!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] The acquisition is NOT continued: the checkpoint chain could not be verified.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] NO se continua la adquisición: no se pudo comprobar la cadena de checkpoints.!C_RESET!
call :LOG_EVENT "ABORTADO: no se pudo enumerar los checkpoints con Get-VMSnapshot - !HV_VMNAME! - no se afirma un recuento que no se pudo medir"
pause
goto HV_MENU_SHOW

:HV_SNAP_MODE_DONE

:: Obtener discos de la VM según el modo elegido:
::  1=cadena actual completa, 2=solo raiz (Get-VHD ParentPath hasta la
::  base), 3=cadena completa de ancestros del checkpoint elegido (sin
::  consolidar - para eso ya existe la opción "Merge-VHD" mas abajo).
:: Se usa un archivo .ps1 temporal para evitar problemas de comillas con nombres con espacios
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Getting disks associated with !HV_VMNAME!...!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Obteniendo discos asociados a !HV_VMNAME!...!C_RESET!

call :NEWGUID HV_PS_GUID
set "HV_PS_TEMP=!TEMP!\forensic_!HV_PS_GUID!.ps1"
:: El nombre del checkpoint lo escribe el analista y los apostrofos son
:: frecuentes ("Ana's baseline"): sin duplicar la comilla el literal PowerShell
:: quedaba roto, el script no se ejecutaba, se leian 0 discos y la pantalla
:: decia "No se encontraron discos asociados a esta VM", que es falso.
set "HV_CHOSEN_SNAP_NAME_PS=!HV_CHOSEN_SNAP_NAME:'=''!"
(
echo Import-Module Hyper-V -ErrorAction Stop
echo $vmName = '!HV_VMNAME_PS!'
echo $mode = !HV_SNAP_MODE!
echo $chosenSnap = '!HV_CHOSEN_SNAP_NAME_PS!'
echo $paths = @^(^)
echo $passthru = @^(^)
echo function Get-VhdChain^($p^) {
echo     $chain = @^($p^)
echo     $cur = $p
echo     while ^($true^) {
echo         try { $info = Hyper-V\Get-VHD -Path $cur -ErrorAction Stop } catch { break }
echo         if ^($info.ParentPath^) { $chain += $info.ParentPath; $cur = $info.ParentPath } else { break }
echo     }
echo     return $chain
echo }
echo # Un disco de PASO A TRAVES ^(disco fisico conectado directamente a la VM^) no
echo # tiene Path: el numero de disco viaja en DiskNumber. Antes se hacia
echo # "$paths += $d.Path", el elemento nulo lo eliminaba Sort-Object -Unique y el
echo # disco desaparecia de la salida SIN UNA SOLA LINEA de aviso.
echo function Add-DiskEntry^($d^) {
echo     if ^($d.Path^) { return $true }
rem Dentro de comillas dobles cmd NO procesa el "^": los parentesis y el "|" ya
rem estan protegidos por las propias comillas y escaparlos dejaba los carets
rem literales en el .ps1 generado.
echo     $ctl = "$($d.ControllerType)$($d.ControllerNumber):$($d.ControllerLocation)"
echo     $num = $d.DiskNumber
echo     if ^($num -eq $null^) { $num = 'desconocido' }
echo     $script:passthru += "PASSTHRU|$ctl|DiskNumber=$num"
echo     return $false
echo }
echo if ^($mode -eq 3^) {
echo     $snap = Hyper-V\Get-VMSnapshot -VMName $vmName -Name $chosenSnap -ErrorAction SilentlyContinue
echo     if ^($snap^) {
echo         $snapDisks = $snap ^| Hyper-V\Get-VMHardDiskDrive -ErrorAction SilentlyContinue
echo         foreach ^($d in $snapDisks^) { if ^(Add-DiskEntry $d^) { $paths += Get-VhdChain $d.Path } }
echo     }
echo } elseif ^($mode -eq 2^) {
echo     $disks = Hyper-V\Get-VMHardDiskDrive -VMName $vmName -ErrorAction SilentlyContinue
echo     foreach ^($d in $disks^) {
echo         if ^(Add-DiskEntry $d^) {
echo             $chain = Get-VhdChain $d.Path
echo             $paths += $chain[-1]
echo         }
echo     }
echo } else {
echo     # MODO 1: la cadena COMPLETA, no solo el disco hoja. Get-VMHardDiskDrive
echo     # devuelve el .avhdx activo cuando hay checkpoints; copiar solo ese
echo     # diferencial ^(a veces unos pocos MB de deltas^) sin su .vhdx base
echo     # entregaba un disco que no se puede montar ni analizar, y ademas hacia
echo     # fallar siempre la consolidacion posterior por falta del padre.
echo     $disks = Hyper-V\Get-VMHardDiskDrive -VMName $vmName -ErrorAction SilentlyContinue
echo     foreach ^($d in $disks^) { if ^(Add-DiskEntry $d^) { $paths += Get-VhdChain $d.Path } }
echo }
echo foreach ^($pt in $passthru^) { Write-Output $pt }
echo if ^($paths.Count -gt 0^) { $paths ^| Sort-Object -Unique ^| ForEach-Object { $_ } } elseif ^($passthru.Count -eq 0^) { Write-Output 'NONE' }
) > "!HV_PS_TEMP!"

set "hv_disk_count=0"
set "hv_passthru_count=0"
set "HV_PT_ABORT="
for /f "usebackq tokens=1,2,* delims=|" %%P in (`powershell -NoProfile -ExecutionPolicy Bypass -File "!HV_PS_TEMP!"`) do (
    if "%%P"=="PASSTHRU" (
        set /a hv_passthru_count+=1
        set "HV_PT_!hv_passthru_count!=%%Q %%R"
        if /i "!FORENSIC_LANG!"=="EN" echo  !C_ERR![-] PASS-THROUGH physical disk: controller %%Q, %%R!C_RESET!
        if /i not "!FORENSIC_LANG!"=="EN" echo  !C_ERR![-] Disco fisico de PASO A TRAVES: controlador %%Q, %%R!C_RESET!
        call :LOG_EVENT "Disco de paso a traves detectado en !HV_VMNAME!: %%Q %%R - NO es un archivo VHD/VHDX y NO se copia desde este modulo."
    ) else if /I not "%%P"=="NONE" (
        set /a hv_disk_count+=1
        set "HV_DISK_!hv_disk_count!=%%P"
        if /i "!FORENSIC_LANG!"=="EN" echo  !C_OK![+] Disk !hv_disk_count!: %%P!C_RESET!
        if /i not "!FORENSIC_LANG!"=="EN" echo  !C_OK![+] Disco !hv_disk_count!: %%P!C_RESET!
    )
)
del "!HV_PS_TEMP!" >nul 2>&1

if !hv_passthru_count! gtr 0 call :HV_WARN_PASSTHRU
if defined HV_PT_ABORT goto HV_MENU_SHOW

if !hv_disk_count! equ 0 (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![-] No disks associated with this VM were found.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![-] No se encontraron discos asociados a esta VM.!C_RESET!
    call :LOG_EVENT "Advertencia: No se encontraron discos para !HV_VMNAME!"
    pause
    goto HV_MENU_SHOW
)

:: Copiar discos
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Copying disks to evidence...!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Copiando discos a evidencia...!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] Virtual disks can be very large. This will take time.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] Los discos virtuales pueden ser muy grandes. Esto tomara tiempo.!C_RESET!
set "hv_copy_done=0"
set "hv_copy_fail=0"
set "hv_copy_abort="
for /L %%i in (1,1,!hv_disk_count!) do call :HV_COPY_DISK_ITEM %%i

if defined hv_copy_abort (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![ABORT] Disk copy aborted by the user. Returning to the Hyper-V menu.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![ABORT] Copia de discos abortada por el usuario. Volviendo al menú Hyper-V.!C_RESET!
    call :LOG_EVENT "Copia de discos Hyper-V abortada por el usuario (CTRL+C). VM: !HV_VMNAME! - copiados !hv_copy_done! de !hv_disk_count!"
    pause
    goto HV_MENU_SHOW
)
:: hv_copy_ok=1 se activaba con UN disco copiado: con 3 discos de una cadena y 2
:: fallos se llegaba a "Discos copiados exitosamente". Una cadena a la que le
:: falta un eslabon NO es analizable, asi que un solo fallo es fallo del conjunto.
if !hv_copy_done! equ 0 goto HV_DISK_COPY_NONE
if !hv_copy_fail! gtr 0 goto HV_DISK_COPY_PARTIAL
if !hv_copy_done! lss !hv_disk_count! goto HV_DISK_COPY_PARTIAL
goto HV_DISK_COPY_OK

:HV_DISK_COPY_NONE
if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] No disk could be copied ^(0 of !hv_disk_count!^).!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] No se pudo copiar ningún disco ^(0 de !hv_disk_count!^).!C_RESET!
call :LOG_EVENT "Error: Ningun disco copiado para !HV_VMNAME! (0 de !hv_disk_count!)"
pause
goto HV_MENU_SHOW

:HV_DISK_COPY_PARTIAL
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] INCOMPLETE ACQUISITION: !hv_copy_done! of !hv_disk_count! disks copied, !hv_copy_fail! failed.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] ADQUISICIÓN INCOMPLETA: !hv_copy_done! de !hv_disk_count! discos copiados, !hv_copy_fail! con error.!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] A differential chain missing one link cannot be mounted or analysed: the!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] Una cadena diferencial a la que le falta un eslabon no se puede montar ni!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN!    whole set is treated as a FAILURE, not as a partial success.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN!    analizar: el conjunto se trata como FALLO, no como éxito parcial.!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Neither consolidation nor RAW conversion is offered: there is nothing coherent to convert.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] No se ofrece consolidacion ni conversion RAW: no hay un conjunto coherente que convertir.!C_RESET!
call :LOG_EVENT "FALLO DEL CONJUNTO: adquisicion de discos Hyper-V incompleta para !HV_VMNAME! - copiados !hv_copy_done! de !hv_disk_count!, fallidos !hv_copy_fail!. La cadena entregada NO es analizable."
:: Se hashea lo que SI se copio -son archivos que existen y hay que poder
:: identificarlos- pero con el contexto PARCIAL para que ni la pantalla ni el
:: archivo de hashes sugieran una adquisicion terminada.
call :HASH_EVIDENCE FOLDER "!HV_EVIDENCE!\Disks" "*.vhdx,*.vhd,*.avhdx,*.avhd,*.vhds" "!HV_EVIDENCE!\hashes_PARCIAL.txt" "HyperV_Discos_INCOMPLETO" PARCIAL
pause
goto HV_MENU_SHOW

:HV_DISK_COPY_OK
echo.
set "hv_disk_dest=!HV_EVIDENCE!\Disks"
if /i "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Disks copied successfully to: !hv_disk_dest!!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Discos copiados exitosamente a: !hv_disk_dest!!C_RESET!

:: Verificación de integridad OPCIONAL (decisión del operador).
:: El comodin incluye .avhd y .vhds: en una VM Gen1 con base .vhd (host 8.1/
:: 2012R2, dentro del objetivo de compatibilidad) los diferenciales son .avhd y
:: quedaban FUERA del hash aunque la pantalla anunciara "verificación de
:: integridad" sobre la carpeta entera.
set "hv_hash_dest=!HV_EVIDENCE!\hashes.txt"
call :HASH_EVIDENCE FOLDER "!HV_EVIDENCE!\Disks" "*.vhdx,*.vhd,*.avhdx,*.avhd,*.vhds" "!hv_hash_dest!" "HyperV_Discos"
call :LOG_EVENT "Adquisicion de discos Hyper-V finalizada: !HV_VMNAME! (!hv_copy_done! de !hv_disk_count! discos)"
:: ALCANCE REAL DE LO HASHEADO. Se dice explicitamente porque lo anterior podia
:: leerse como una verificacion origen-contra-copia que este flujo NO hace: los
:: discos ORIGEN nunca se hashean aqui (estan en el host, pueden ser enormes y
:: hasta cientos de GB), asi que estos hashes acreditan QUE SON ESTOS ARCHIVOS,
:: no que sean identicos al origen. ISO/IEC 27042 6.3: no afirmar mas de lo medido.
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] SCOPE: these hashes are of the COPIES. The source disks were not hashed,!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] ALCANCE: estos hashes son de las COPIAS. Los discos ORIGEN no se hashearon,!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN!    so they do NOT prove copy == source. They prove these files have not!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN!    asi que NO acreditan que copia == origen. Acreditan que estos archivos no!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN!    changed since this moment. To prove equality, hash the source too.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN!    han cambiado desde este momento. Para acreditar igualdad, hashee el origen.!C_RESET!
call :LOG_EVENT "Alcance declarado: los hashes de HyperV_Discos son de las COPIAS. El origen no se hasheo, por lo que NO se afirma coincidencia origen-copia."
if /i "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Disk acquisition process finished.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Proceso de adquisición de discos terminado.!C_RESET!
echo.

:: Preservar también la CONFIGURACIÓN de la VM (.vmcx/.vmrs modernos, o
:: .xml en VMs legacy/Generacion 1) - sin ella, Hyper-V no puede importar
:: esta VM después. Se copia la carpeta "Virtual Machines" completa desde
:: ConfigurationLocation (contiene los archivos nombrados por el GUID de
:: la VM, pequenos).
set "hv_cfgfolder="
for /f "usebackq delims=" %%C in (`powershell -NoProfile -Command "(Hyper-V\Get-VM -Name '!HV_VMNAME_PS!' -ErrorAction SilentlyContinue).ConfigurationLocation"`) do set "hv_cfgfolder=%%C"
:: Antes esto era "if defined X if exist Y (...) else (...)": el else se ata al if
:: INTERNO, asi que cuando no se podia leer ConfigurationLocation no se imprimia
:: NADA y la configuracion se omitia en silencio. Se separan los dos casos.
if not defined hv_cfgfolder (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] Could not read ConfigurationLocation for this VM: the configuration is NOT preserved.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] No se pudo leer ConfigurationLocation de esta VM: la configuración NO queda preservada.!C_RESET!
    if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Without it Hyper-V cannot import this VM later. Copy it manually if needed.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Sin ella Hyper-V no podrá importar esta VM despues. Copiela a mano si procede.!C_RESET!
    call :LOG_EVENT "Advertencia: no se pudo leer ConfigurationLocation de !HV_VMNAME!. La configuracion NO se preservo."
)
if defined hv_cfgfolder if not exist "!hv_cfgfolder!\Virtual Machines" (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] The folder "!hv_cfgfolder!\Virtual Machines" does not exist: configuration NOT preserved.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] La carpeta "!hv_cfgfolder!\Virtual Machines" no existe: configuración NO preservada.!C_RESET!
    call :LOG_EVENT "Advertencia: !hv_cfgfolder!\Virtual Machines no existe para !HV_VMNAME!. La configuracion NO se preservo."
)
if defined hv_cfgfolder if exist "!hv_cfgfolder!\Virtual Machines" (
    if not exist "!HV_EVIDENCE!\Config" mkdir "!HV_EVIDENCE!\Config"
    rem Sin /R: /W: robocopy hereda los valores por defecto de cmd -/R:1000000
    rem /W:30-: un archivo denegado o bloqueado dejaba el framework aparentemente
    rem congelado durante DIAS y sin dialogo de CTRL+C. Con /R:1 /W:1 falla rapido
    rem y el errorlevel se comprueba de verdad: robocopy 0-7 es exito, >=8 error.
    robocopy "!hv_cfgfolder!\Virtual Machines" "!HV_EVIDENCE!\Config" /E /R:1 /W:1 /NFL /NDL /NJH /NJS >nul
    set "_hvcfg_el=!errorlevel!"
    if !_hvcfg_el! geq 8 (
        if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Error copying the configuration ^(robocopy !_hvcfg_el!^): it is NOT preserved.!C_RESET!
        if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Error al copiar la configuración ^(robocopy !_hvcfg_el!^): NO queda preservada.!C_RESET!
        call :LOG_EVENT "Error: robocopy de la configuracion Hyper-V devolvio !_hvcfg_el! para !HV_VMNAME!. La configuracion NO se preservo."
    ) else (
        if /i "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Configuration ^(.vmcx/.vmrs/.xml^) preserved in: !HV_EVIDENCE!\Config!C_RESET!
        if /i not "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Configuración ^(.vmcx/.vmrs/.xml^) preservada en: !HV_EVIDENCE!\Config!C_RESET!
        call :LOG_EVENT "Configuracion Hyper-V preservada: !HV_EVIDENCE!\Config (origen: !hv_cfgfolder!\Virtual Machines)"
        call :HASH_EVIDENCE FOLDER "!HV_EVIDENCE!\Config" "*.vmcx,*.vmrs,*.vmgs,*.xml,*.bin,*.vsv" "!HV_EVIDENCE!\Config\hashes.sha256" "HyperV_Configuracion"
    )
)
echo.

:: Preguntar si desea consolidar checkpoints
set "hv_cons_ask="
if /i "!FORENSIC_LANG!"=="EN" set /p hv_cons_ask="!C_PROMPT!Consolidate the checkpoint chain (.avhdx)? [Y/N]: !C_RESET!"
if /i not "!FORENSIC_LANG!"=="EN" set /p hv_cons_ask="!C_PROMPT!¿Consolidar la cadena de checkpoints (.avhdx)? [S/N]: !C_RESET!"
:: El prompt en ingles ofrece [Y/N]; se acepta Y como S.
if /i "!hv_cons_ask!"=="Y" set "hv_cons_ask=S"
if /I "!hv_cons_ask!"=="S" goto HV_CONS_FROM_DISK

:: Si no consolida, ofrecer conversión QEMU - SOLO cuando tiene sentido.
:: Antes se tomaba el PRIMER *.vhdx de Disks, que en una cadena diferencial es la
:: BASE: se entregaba el estado ANTERIOR a todos los checkpoints rotulado como
:: "disco en formato RAW forense". Y tras el modo que copiaba solo el .avhdx se
:: decia "No se encontro disco .vhdx para convertir", que suena a fallo cuando en
:: realidad el conjunto no era convertible. Ahora se clasifica lo copiado y solo
:: se convierte un disco UNICO y NO diferencial.
if not exist "!QEMU_IMG!" goto HV_SKIP_QEMU_DISK
set "hv_qb_count=0"
set "hv_qd_count=0"
set "hv_qemu_src="
:: Se clasifica por extension EXACTA en una subrutina: el comodin "*.vhd" de
:: cmd.exe tambien casa con los .vhdx, asi que contar con comodines duplicaba.
for %%F in ("!HV_EVIDENCE!\Disks\*.*") do call :HV_QEMU_CLASSIFY "%%F"
if !hv_qd_count! gtr 0 goto HV_QEMU_NEEDS_CONS
if !hv_qb_count! equ 0 goto HV_QEMU_NO_BASE
if !hv_qb_count! gtr 1 goto HV_QEMU_MULTI

set "hv_qemu_disk="
if /i "!FORENSIC_LANG!"=="EN" set /p hv_qemu_disk="!C_PROMPT!Convert the disk to forensic RAW/IMG format (QEMU)? [Y/N]: !C_RESET!"
if /i not "!FORENSIC_LANG!"=="EN" set /p hv_qemu_disk="!C_PROMPT!¿Convertir el disco a formato RAW/IMG forense (QEMU)? [S/N]: !C_RESET!"
:: El prompt en ingles ofrece [Y/N]; se acepta Y como S.
if /i "!hv_qemu_disk!"=="Y" set "hv_qemu_disk=S"
if /I "!hv_qemu_disk!"=="S" (
    for %%F in ("!hv_qemu_src!") do set "hv_qemu_base=%%~nF"
    call :QEMU_CONVERT "!hv_qemu_src!" "!HV_EVIDENCE!" "!hv_qemu_base!_forense"
)
goto HV_SKIP_QEMU_DISK

:HV_QEMU_NEEDS_CONS
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] RAW conversion is not offered: the acquired set is a DIFFERENTIAL chain!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] No se ofrece conversión RAW: el conjunto adquirido es una CADENA diferencial!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN!    ^(!hv_qd_count! .avhdx/.avhd^). qemu-img converts one file at a time and would!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN!    ^(!hv_qd_count! .avhdx/.avhd^). qemu-img convierte un archivo suelto y entregaria!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN!    hand over either the pre-checkpoint base or an unmountable differential.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN!    la base anterior a los checkpoints, o un diferencial no montable.!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Consolidate the chain first ^(the option offered above^); the consolidated!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Consolide primero la cadena ^(la opción ofrecida arriba^); tras consolidar el!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT!    disk can then be converted to RAW.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT!    disco resultante si se puede convertir a RAW.!C_RESET!
call :LOG_EVENT "Conversion RAW no ofrecida para !HV_VMNAME!: el conjunto copiado es una cadena diferencial (!hv_qd_count! diferenciales). Hay que consolidar antes."
goto HV_SKIP_QEMU_DISK

:HV_QEMU_MULTI
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] This VM has !hv_qb_count! independent disks: RAW conversion is not offered!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Esta VM tiene !hv_qb_count! discos independientes: no se ofrece la conversión RAW!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT!    automatically, so as not to silently pick one of them. Use the!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT!    automatica para no elegir uno de ellos en silencio. Use la opción!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT!    "Convert Disk to RAW/IMG ^(QEMU^)" option and convert each one explicitly.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT!    "Convertir Disco a RAW/IMG ^(QEMU^)" y convierta cada uno explicitamente.!C_RESET!
call :LOG_EVENT "Conversion RAW no ofrecida automaticamente para !HV_VMNAME!: hay !hv_qb_count! discos base independientes."
goto HV_SKIP_QEMU_DISK

:HV_QEMU_NO_BASE
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![-] No non-differential disk was found in Disks to convert.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![-] No se encontró ningún disco no diferencial en Disks para convertir.!C_RESET!
:HV_SKIP_QEMU_DISK
pause
goto HV_MENU_SHOW

:: =====================================================
:: HYPER-V - VOLCADO DE MEMORIA RAM
:: Hyper-V NO tiene equivalente a .vmem (VMware) ni a
:: "debugvm dumpvmcore" (VirtualBox). La RAM del guest solo se
:: materializa en disco vía el mecanismo de estado guardado:
::   - Config versión <  6.2 (2008-2012R2/Win8.1): <Id>.bin
::     (memoria) + <Id>.vsv (dispositivos)
::   - Config versión >= 6.2 (WS2016/Win10+): <Id>.vmrs
::     (RAM completa sin comprimir + estado runtime)
:: NINGUNO es imagen RAW directa: Volatility3 NO los abre sin
:: conversión (verificado: issue volatility3#1886). La vía DFIR
:: aceptada es leerlos con la API oficial VmSavedStateDumpProvider
:: (Windows SDK) vía MemProcFS/LeechCore. vm2dmp solo sirve
:: para <=2008R2 y falla con >=4GB de RAM.
:: Metodos de captura (el antiguo metodo de checkpoint estandar se
:: retiro: obligaba a cambiar el CheckpointType de la VM y a crear un
:: checkpoint en el host examinado; el menu dice "no se crean checkpoints"):
::   - SAVED: si la VM ya esta en estado Saved (o FastSaved...), sus
::     archivos de estado ya contienen la RAM y se copian sin tocar nada.
::   - SAVE: Save-VM detiene la VM (queda en Saved) con confirmacion
::     expresa del operador; se ofrece Start-VM al terminar.
:: =====================================================
:HV_MEM
:: El .bin/.vsv/.vmrs del estado guardado se obtiene copiandolo.
if not defined HAS_ROBOCOPY call :ROBOCOPY_MISSING "Hyper-V - volcado de memoria"
if not defined HAS_ROBOCOPY goto HV_MENU_SHOW
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] RAM Memory Dump - Hyper-V!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Volcado de Memoria RAM - Hyper-V!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Enumerating virtual machines...!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Enumerando máquinas virtuales...!C_RESET!
echo.

call :HV_ENUM_VMS

if !HV_COUNT! equ 0 (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![-] No virtual machines were found in Hyper-V.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![-] No se encontraron máquinas virtuales en Hyper-V.!C_RESET!
    pause
    goto HV_MENU_SHOW
)

if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT!Hyper-V Virtual Machines detected:!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT!Máquinas Virtuales Hyper-V detectadas:!C_RESET!
:: "Config version" salia EN BLANCO en Windows 8/8.1/2012/2012R2, donde el modulo
:: Hyper-V no expone la propiedad Version, y ese blanco se copiaba tal cual al
:: FORMAT_NOTE.txt - que es precisamente el dato con el que el analista decide si
:: espera .bin/.vsv o .vmrs. Ahora :HV_ENUM_VMS emite "no disponible" y mas abajo
:: la nota de formato deriva el dato de la extension REALMENTE encontrada.
for /L %%i in (1,1,!HV_COUNT!) do (
    echo.
    echo  !C_OK!%%i. !HV_NAME_%%i!!C_RESET!
    if /i "!FORENSIC_LANG!"=="EN" echo     State: !HV_STATE_%%i!  -  Config version: !HV_VER_%%i!
    if /i not "!FORENSIC_LANG!"=="EN" echo     Estado: !HV_STATE_%%i!  -  Version de config: !HV_VER_%%i!
    if "!HV_FLAG_%%i!"=="BANG" if /i "!FORENSIC_LANG!"=="EN" echo     !C_ERR![-] Name with an exclamation mark: NOT selectable!C_RESET!
    if "!HV_FLAG_%%i!"=="BANG" if /i not "!FORENSIC_LANG!"=="EN" echo     !C_ERR![-] Nombre con signo de exclamacion: NO seleccionable!C_RESET!
)
echo.

:HVM_PROMPT_SEL
set "hvm_sel="
if /i "!FORENSIC_LANG!"=="EN" set /p hvm_sel="!C_PROMPT!Select the VM [1-!HV_COUNT!, 0=cancel]: !C_RESET!"
if /i not "!FORENSIC_LANG!"=="EN" set /p hvm_sel="!C_PROMPT!Seleccione la VM [1-!HV_COUNT!, 0=cancelar]: !C_RESET!"
if "!hvm_sel!"=="0" goto HV_MENU_SHOW
if not defined hvm_sel goto HVM_PROMPT_SEL
for /f "delims=0123456789" %%a in ("!hvm_sel!") do (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Please enter a valid number.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Por favor, ingrese un número válido.!C_RESET!
    goto HVM_PROMPT_SEL
)
if !hvm_sel! lss 1 goto HVM_PROMPT_SEL
if !hvm_sel! gtr !HV_COUNT! goto HVM_PROMPT_SEL

call :NORM_SEL hvm_sel
set "HVM_VMNAME=!HV_NAME_%hvm_sel%!"
if not defined HVM_VMNAME goto HVM_PROMPT_SEL
if "!HV_FLAG_%hvm_sel%!"=="BANG" goto HV_SEL_BANG
:: Escapado para PowerShell (comilla simple duplicada) - ver nota en HV_HANDLE_VM_RUNNING.
set "HVM_VMNAME_PS=!HVM_VMNAME:'=''!"
set "HVM_STATE=!HV_STATE_%hvm_sel%!"
set "HVM_VER=!HV_VER_%hvm_sel%!"
set "HVM_SAFE=!HV_SAFE_%hvm_sel%!"
if not defined HVM_STATE goto HVM_PROMPT_SEL

:: Estados sin memoria del invitado en ningun sitio: no hay RAM que volcar.
:: OffCritical se incluye porque tambien es una VM apagada.
set "HVM_IS_OFF=0"
if /I "!HVM_STATE!"=="Off" set "HVM_IS_OFF=1"
if /I "!HVM_STATE!"=="OffCritical" set "HVM_IS_OFF=1"
if "!HVM_IS_OFF!"=="1" (
    echo.
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] The VM "!HVM_VMNAME!" is POWERED OFF ^(!HVM_STATE!^).!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] La VM "!HVM_VMNAME!" esta APAGADA ^(!HVM_STATE!^).!C_RESET!
    if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] There is no RAM to dump from a powered-off VM.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] No hay memoria RAM que volcar de una VM apagada.!C_RESET!
    if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Power on the VM ^(or leave it in "Saved" after suspending it^) and try again.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Encienda la VM ^(o dejela en "Saved" tras suspenderla^) e intente de nuevo.!C_RESET!
    pause
    goto HV_MENU_SHOW
)

:: Estados que YA tienen la RAM del invitado materializada en disco. Antes solo
:: se reconocia "Saved" exacto: FastSaved, SavedCritical y FastSavedCritical se
:: enrutaban a Checkpoint-VM/Save-VM, es decir se ALTERABA la VM para volver a
:: escribir en disco una memoria que ya estaba escrita.
set "HVM_HAS_SAVED=0"
if /I "!HVM_STATE!"=="Saved" set "HVM_HAS_SAVED=1"
if /I "!HVM_STATE!"=="FastSaved" set "HVM_HAS_SAVED=1"
if /I "!HVM_STATE!"=="SavedCritical" set "HVM_HAS_SAVED=1"
if /I "!HVM_STATE!"=="FastSavedCritical" set "HVM_HAS_SAVED=1"

:: Nombre de carpeta ya saneado por :HV_ENUM_VMS (lista real de Win32).
set "HVM_FOLDER=!HVM_SAFE!"
if not defined HVM_FOLDER set "HVM_FOLDER=VM_HyperV"

echo.
:ASK_HVM_DEST
set "hvm_dest="
if /i "!FORENSIC_LANG!"=="EN" set /p hvm_dest="!C_PROMPT!Destination folder path [Enter = !DEFAULT_DEST!] (0=cancel): !C_RESET!"
if /i not "!FORENSIC_LANG!"=="EN" set /p hvm_dest="!C_PROMPT!Ruta de la carpeta destino [Enter = !DEFAULT_DEST!] (0=cancelar): !C_RESET!"
if "!hvm_dest!"=="0" goto HV_MENU_SHOW
if defined hvm_dest set "hvm_dest=!hvm_dest:"=!"
if not defined hvm_dest (
    set "hvm_dest=!DEFAULT_DEST!"
    if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Using default destination: !DEFAULT_DEST!!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Usando destino por defecto: !DEFAULT_DEST!!C_RESET!
)
call :HV_CHECK_BANG_PATH hvm_dest
if "!HV_BANG_PATH!"=="1" (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] The destination path contains an exclamation mark; cmd.exe cannot carry it!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] La ruta de destino contiene un signo de exclamacion; cmd.exe no lo puede!C_RESET!
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] reliably. Use a path without that character.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] transportar con fiabilidad. Use una ruta sin ese caracter.!C_RESET!
    call :LOG_EVENT "RECHAZADO: la ruta de destino del volcado de memoria Hyper-V contiene un signo de exclamacion."
    goto ASK_HVM_DEST
)
call :VALIDATE_DEST_DIR "!hvm_dest!"
if not "!_VD_OK!"=="1" goto ASK_HVM_DEST

:: Los archivos de estado se llaman por GUID de VM o de checkpoint: sin marca de
:: tiempo en la carpeta, una segunda adquisicion Save-VM de la MISMA VM hacia que
:: robocopy sobreescribiera el <vmid>.vmrs anterior, es decir destruia evidencia
:: ya adquirida.
call :UTCNOW HVM_ACQ_TS COMPACT
set "HVM_EVIDENCE=!hvm_dest!\HyperV\!HVM_FOLDER!_!HVM_ACQ_TS!"
set "DEST=!HVM_EVIDENCE!"
if not exist "!HVM_EVIDENCE!\Memory" mkdir "!HVM_EVIDENCE!\Memory"

call :LOG_EVENT "Volcado de memoria Hyper-V iniciado: !HVM_VMNAME! (Estado: !HVM_STATE!, Config: !HVM_VER!) -> !HVM_EVIDENCE!"

set "HVM_METHOD="

:: Si la VM ya tiene la RAM materializada en disco (Saved, FastSaved y sus
:: variantes Critical), se copia directo sin tocar la VM. Antes solo se
:: reconocia "Saved" exacto y una VM en FastSaved acababa en Checkpoint-VM.
if "!HVM_HAS_SAVED!"=="1" (
    echo.
    if /i "!FORENSIC_LANG!"=="EN" echo !C_OK![+] The VM is in "!HVM_STATE!": its memory is already on disk.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_OK![+] La VM esta en "!HVM_STATE!": su memoria ya esta en disco.!C_RESET!
    if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] The existing state files will be copied without altering the VM.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Se copiaran los archivos de estado existentes sin alterar la VM.!C_RESET!
    set "HVM_METHOD=SAVED"
    goto HVM_LOCATE_BY_VMID
)

:: VM en ejecucion (o pausada): la captura se hace SIEMPRE con Save-VM.
::
:: LA VIA DE CHECKPOINT SE RETIRO A PROPOSITO. Antes habia un menu que ofrecia
:: tambien "checkpoint estandar", presentado como recomendado porque la VM no se
:: detiene. Se descarto por lo que ese metodo obliga a hacerle al HOST y a la VM:
::
::   1. Crea archivos nuevos en el almacen de Hyper-V del host -un disco
::      diferencial .avhdx y el estado del checkpoint-, es decir escribe en el
::      medio que puede ser el mismo que se esta investigando.
::   2. Al retirar el checkpoint, Hyper-V FUNDE ese diferencial en el disco base:
::      REESCRIBE el archivo de disco original de la VM.
::   3. Obliga a cambiar CheckpointType a Standard -el tipo por defecto desde
::      WS2016/Win10 es Production, que NO incluye la RAM-, o sea a MODIFICAR LA
::      CONFIGURACION PERSISTENTE de la VM y despues restaurarla.
::   4. Si el proceso se interrumpe a mitad, deja un checkpoint huerfano y su
::      diferencial creciendo.
::
:: Save-VM no hace nada de eso: escribe el estado guardado que Hyper-V ya usa para
:: ese fin, no toca el subsistema de checkpoints, no crea disco diferencial y no
:: altera la configuracion de la VM. El precio, declarado al operador mas abajo, es
:: que la VM queda DETENIDA hasta que se reanude. Se prefiere una parada declarada
:: y reversible antes que escribir en el medio bajo analisis (ISO/IEC 27037 5.4.3).
goto HVM_METHOD_SAVE

:: --- MÉTODO B: SAVE-VM ---
:HVM_METHOD_SAVE
set "HVM_METHOD=SAVE"
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![CAUTION] Save-VM WILL STOP the VM ^(it will remain in Saved^).!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![ATENCIÓN] Save-VM DETENDRÁ la ejecución de la VM ^(quedará en Saved^).!C_RESET!
rem Igual que en el metodo A: la escritura de la RAM ocurre en el medio del HOST y
rem eso hay que decirlo ANTES de que el operador decida, no solo dejarlo en el log.
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] The guest RAM is written to the HOST volume that stores the VM: several GB!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] La RAM del invitado se escribe en el volumen del HOST que aloja la VM: se!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN!    of that medium's unallocated space are consumed, and that medium may itself!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN!    consumen varios GB de espacio no asignado de ese medio, que puede ser!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN!    be evidence ^(deleted-file carving is affected^).!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN!    evidencia el mismo ^(afecta al carving de archivos borrados^).!C_RESET!
rem EFECTO VISIBLE QUE SORPRENDE SI NO SE ADVIERTE (comprobado en una VM real):
rem al detenerse la VM, cualquier ventana de "Virtual Machine Connection" abierta
rem contra ella PIERDE LA SESION y muestra "The session was disconnected. Would you
rem like to try to reconnect?". No es un fallo ni un cuelgue: la adquisicion sigue
rem su curso y la VM vuelve a Running al reanudarse, pero el visor NO se reconecta
rem solo. Se avisa aqui, antes de decidir, porque en una actuacion con la consola
rem del invitado a la vista ese dialogo se interpreta como que algo se rompio.
rem NO HAY QUE HACER NADA CON ESE DIALOGO MIENTRAS EL PROCESO CORRE. El framework
rem no espera a que nadie reconecte: reanuda la VM por su cuenta en cuanto el estado
rem esta copiado. Pulsar Reconnect en los primeros segundos -con la VM todavia en
rem Saved- solo consigue que el intento falle y haya que repetirlo. Se dice aqui
rem porque, sin avisar, ese cuadro se lee como "algo se ha bloqueado" y el operador
rem interviene justo cuando no debe.
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] Any open "Virtual Machine Connection" window will DISCONNECT and ask to!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] Cualquier ventana de "Virtual Machine Connection" abierta se DESCONECTARÁ y!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN!    reconnect. That is NORMAL: the VM stops. Do NOT press anything there:!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN!    pedirá reconectar. Es NORMAL: la VM se detiene. NO pulse nada ahí:!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN!    WAIT for this process to finish, then press Reconnect once.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN!    ESPERE a que este proceso termine y pulse Reconnect una sola vez.!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] The VM is resumed as soon as the state is copied, before converting: the!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] La VM se reanuda en cuanto el estado está copiado, antes de convertir: la!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT!    stop lasts seconds; the conversion afterwards runs with the VM already up.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT!    parada dura segundos; la conversión posterior corre con la VM ya en marcha.!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Progress: the copy and the RAW conversion both show a percentage. Save-VM!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Progreso: la copia y la conversión a RAW muestran porcentaje. Save-VM no!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT!    does not: it is a single Hyper-V call that reports nothing until it ends.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT!    lo muestra: es una sola llamada a Hyper-V que no informa hasta terminar.!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] DFIR STANDARD: controlled and documented alteration.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] ESTÁNDAR DFIR: alteración controlada y documentada.!C_RESET!
set "hvm_confirm="
if /i "!FORENSIC_LANG!"=="EN" set /p hvm_confirm="!C_PROMPT!Do you want to continue? [Y/N]: !C_RESET!"
if /i not "!FORENSIC_LANG!"=="EN" set /p hvm_confirm="!C_PROMPT!¿Desea continuar? [S/N]: !C_RESET!"
:: El prompt en ingles ofrece [Y/N]; se acepta Y como S.
if /i "!hvm_confirm!"=="Y" set "hvm_confirm=S"
if /I not "!hvm_confirm!"=="S" (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Operation aborted by the user.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Operación cancelada por el usuario.!C_RESET!
    call :LOG_EVENT "Volcado de memoria Hyper-V cancelado por el usuario antes de Save-VM."
    pause
    goto HV_MENU_SHOW
)
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Saving the VM state ^(Save-VM^)...!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Guardando el estado de la VM ^(Save-VM^)...!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] This may take a while depending on the assigned RAM size.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] Esto puede tardar dependiendo del tamaño de la RAM asignada.!C_RESET!
call :UTCNOW _HVM_TS1
powershell -NoProfile -Command "Hyper-V\Save-VM -Name '!HVM_VMNAME_PS!' -ErrorAction Stop" 2>nul
set "_hvm_save_el=!errorlevel!"
call :UTCNOW _HVM_TS2
call :LOG_CMD "HyperV_SaveVM" "Save-VM -Name ""!HVM_VMNAME!""" "!_hvm_save_el!" "!_HVM_TS1!" "!_HVM_TS2!" "" ""
if !_hvm_save_el! neq 0 (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Error saving the state of the VM.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Error al guardar el estado de la VM.!C_RESET!
    if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Verify that the VM has no pending operations or blocked dependencies.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Verifique que la VM no tenga operaciones pendientes o dependencias bloqueadas.!C_RESET!
    call :LOG_EVENT "Error: Save-VM fallo para !HVM_VMNAME!"
    pause
    goto HV_MENU_SHOW
)
if /i "!FORENSIC_LANG!"=="EN" echo !C_OK![+] VM state saved successfully ^(Saved^).!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Estado de la VM guardado correctamente ^(Saved^).!C_RESET!

:: --- LOCALIZAR ARCHIVOS DE ESTADO POR ID DE LA VM (Saved / Save-VM) ---
:HVM_LOCATE_BY_VMID
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Locating saved state files...!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Localizando archivos de estado guardado...!C_RESET!
call :NEWGUID HVM_PS_GUID
set "HVM_PS_TEMP=!TEMP!\forensic_!HVM_PS_GUID!.ps1"
(
echo Import-Module Hyper-V -ErrorAction Stop
echo $vm = Hyper-V\Get-VM -Name '!HVM_VMNAME_PS!' -ErrorAction SilentlyContinue
echo if ^(-not $vm^) { Write-Output 'NONE'; exit }
echo $vmId = $vm.Id.ToString^(^)
echo $searchDirs = @^($vm.SnapshotFileLocation, $vm.ConfigurationLocation, $vm.Path^) ^| Where-Object { $_ } ^| Select-Object -Unique
echo $found = @^(^)
echo foreach ^($d in $searchDirs^) {
echo     if ^(Test-Path $d^) {
echo         $found += Get-ChildItem -Path $d -Recurse -Include "$vmId.bin","$vmId.vsv","$vmId.vmrs","$vmId.VMRS","$vmId.vmgs" -ErrorAction SilentlyContinue
echo     }
echo }
echo if ^($found.Count -eq 0^) { Write-Output 'NONE'; exit }
echo $found ^| Select-Object -ExpandProperty FullName -Unique
) > "!HVM_PS_TEMP!"

set "hvm_file_count=0"
for /f "usebackq delims=" %%P in (`powershell -NoProfile -ExecutionPolicy Bypass -File "!HVM_PS_TEMP!"`) do (
    if /I not "%%P"=="NONE" (
        set /a hvm_file_count+=1
        set "HVM_FILE_!hvm_file_count!=%%P"
        if /i "!FORENSIC_LANG!"=="EN" echo  !C_OK![+] Found: %%P!C_RESET!
        if /i not "!FORENSIC_LANG!"=="EN" echo  !C_OK![+] Encontrado: %%P!C_RESET!
    )
)
del "!HVM_PS_TEMP!" >nul 2>&1

if !hvm_file_count! equ 0 (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] No saved state files found ^(.bin/.vsv/.vmrs^).!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] No se encontraron archivos de estado guardado ^(.bin/.vsv/.vmrs^).!C_RESET!
    if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] The VM was saved but the files were not located automatically.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] La VM se guardo pero los archivos no se localizaron automáticamente.!C_RESET!
    call :LOG_EVENT "Error: archivos de estado no localizados para !HVM_VMNAME!"
    pause
    goto HV_MENU_SHOW
)


:: La busqueda acepta como "archivos de estado" tambien .vmgs y .vsv, que NO
:: llevan RAM: el .vmgs es el estado del invitado de una Gen2 y el .vsv el estado
:: de dispositivos. Un checkpoint que solo produjera esos daba hvm_file_count>0 y
:: la pantalla decia "Volcado de memoria completado" y acto seguido "No se
:: encontro .vmrs ni .bin en la carpeta Memory para convertir": dos mensajes
:: contradictorios sobre la misma actuacion. Se clasifica por extension y solo se
:: declara volcado de memoria si hay un archivo PORTADOR de memoria.
set "hvm_vmrs_count=0"
set "hvm_bin_count=0"
set "hvm_vsv_count=0"
set "hvm_aux_count=0"
for /L %%i in (1,1,!hvm_file_count!) do call :HVM_CLASSIFY_FILE "!HVM_FILE_%%i!"
:: Un .bin sin su .vsv no se puede abrir con la API oficial: no cuenta como RAM.
set "hvm_has_ram=0"
if !hvm_vmrs_count! gtr 0 set "hvm_has_ram=1"
if !hvm_bin_count! gtr 0 if !hvm_vsv_count! gtr 0 set "hvm_has_ram=1"

:: Copiar cada archivo encontrado a la carpeta de evidencia (vía :ACQUIRE,
:: CTRL+C cancelable con dialogo de confirmación, igual que el resto del framework).
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Copying saved state files to evidence...!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Copiando archivos de estado guardado a evidencia...!C_RESET!
set "hvm_copy_ok=0"
set "hvm_copy_abort="
for /L %%i in (1,1,!hvm_file_count!) do call :HVM_COPY_FILE_ITEM %%i

if defined hvm_copy_abort (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![ABORT] Copy aborted by the user.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![ABORT] Copia abortada por el usuario.!C_RESET!
    rem La VM queda en Saved: se dice, porque el operador tiene que saber que su
    rem sujeto sigue detenido aunque la copia no se completara.
    if "!HVM_METHOD!"=="SAVE" if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] The VM is still STOPPED in Saved state. Resume it from Hyper-V Manager.!C_RESET!
    if "!HVM_METHOD!"=="SAVE" if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] La VM sigue DETENIDA en estado Saved. Reanúdela desde Hyper-V Manager.!C_RESET!
    call :LOG_EVENT "Copia de memoria Hyper-V abortada por el usuario (CTRL+C). VM: !HVM_VMNAME!. Metodo: !HVM_METHOD!. Si el metodo fue SAVE, la VM permanece DETENIDA en estado Saved."
    pause
    goto HV_MENU_SHOW
)
if not "!hvm_copy_ok!"=="1" (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] No state file could be copied.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] No se pudo copiar ningún archivo de estado.!C_RESET!
    if "!HVM_METHOD!"=="SAVE" if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] The VM is still STOPPED in Saved state. Resume it from Hyper-V Manager.!C_RESET!
    if "!HVM_METHOD!"=="SAVE" if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] La VM sigue DETENIDA en estado Saved. Reanúdela desde Hyper-V Manager.!C_RESET!
    call :LOG_EVENT "Error: Ningun archivo de memoria copiado para !HVM_VMNAME!. Metodo: !HVM_METHOD!. Si el metodo fue SAVE, la VM permanece DETENIDA en estado Saved."
    pause
    goto HV_MENU_SHOW
)

echo.
if "!hvm_has_ram!"=="1" if /i "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Memory dump completed in: !HVM_EVIDENCE!\Memory!C_RESET!
if "!hvm_has_ram!"=="1" if /i not "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Volcado de memoria completado en: !HVM_EVIDENCE!\Memory!C_RESET!
if "!hvm_has_ram!"=="1" call :LOG_EVENT "Volcado de memoria Hyper-V finalizado: !HVM_VMNAME! (portadores de RAM: !hvm_vmrs_count! .vmrs, !hvm_bin_count! .bin con !hvm_vsv_count! .vsv)"
if not "!hvm_has_ram!"=="1" (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] The state files were copied, but NONE of them carries the guest RAM.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Los archivos de estado se copiaron, pero NINGUNO lleva la RAM del invitado.!C_RESET!
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] Copied: !hvm_vmrs_count! .vmrs, !hvm_bin_count! .bin, !hvm_vsv_count! .vsv, !hvm_aux_count! .vmgs!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] Copiados: !hvm_vmrs_count! .vmrs, !hvm_bin_count! .bin, !hvm_vsv_count! .vsv, !hvm_aux_count! .vmgs!C_RESET!
    if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] .vsv holds device state and .vmgs the Gen2 guest state: neither contains memory.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] El .vsv lleva estado de dispositivos y el .vmgs el estado de invitado Gen2:!C_RESET!
    if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT!    A .bin without its .vsv is not usable either.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT!    ninguno contiene memoria. Un .bin sin su .vsv tampoco es utilizable.!C_RESET!
    rem El texto anterior recomendaba "el metodo 1 ^(checkpoint estandar^)", una via
    rem que el modulo ya no ofrece. Solo quedan Save-VM y el volcado dentro del guest.
    if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Check the files by hand. Retry with the VM running ^(Save-VM^),!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Revise los archivos a mano. Reintente con la VM en marcha ^(Save-VM^),!C_RESET!
    if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT!    or dump the RAM inside the guest with DumpIt/winpmem.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT!    o volque la RAM DENTRO del invitado con DumpIt/winpmem.!C_RESET!
    call :LOG_EVENT "NO SE OBTUVO MEMORIA para !HVM_VMNAME!: se copiaron !hvm_file_count! archivo/s de estado pero ninguno es portador de RAM (!hvm_vmrs_count! .vmrs, !hvm_bin_count! .bin, !hvm_vsv_count! .vsv, !hvm_aux_count! .vmgs). NO se declara volcado de memoria."
)

:: Documentar el formato REAL (verificado contra doc Microsoft y comunidad DFIR:
:: estos archivos NO son imagen RAW y Volatility NO los abre sin conversión).
(
echo FORMATO: Hyper-V Saved State ^(estado guardado^)
echo VM: !HVM_VMNAME!  -  Config versión: !HVM_VER!  -  Método: !HVM_METHOD!
rem La propiedad Version NO existe en el modulo Hyper-V de Windows 8/8.1/2012/
rem 2012R2: alli se escribia un blanco justo en el dato con el que el analista
rem decide si espera .bin/.vsv o .vmrs. Se anade lo REALMENTE encontrado, que no
rem depende de la version del modulo.
echo ARCHIVOS REALMENTE COPIADOS EN ESTA ADQUISICIÓN:
echo   .vmrs: !hvm_vmrs_count!   .bin: !hvm_bin_count!   .vsv: !hvm_vsv_count!   .vmgs: !hvm_aux_count!
echo   Portador de memoria RAM presente: !hvm_has_ram! ^(1=si, 0=no^)
echo   Si "Config versión" dice "no disponible", este host no expone la propiedad
echo   Version ^(Windows 8/8.1/2012/2012R2^): use el recuento de arriba para saber
echo   ante que formato esta.
echo.
echo ARCHIVOS SEGÚN CONFIG VERSIÓN DE LA VM:
echo   ^>= 6.2 ^(WS2016 / Win10+^) : ^<Id^>.vmrs  ^(RAM completa sin comprimir + estado runtime^)
echo                               ^<Id^>.vmgs  ^(estado del guest, Gen2 recientes^)
echo   ^<  6.2 ^(2008-2012R2^)     : ^<Id^>.bin ^(memoria^) + ^<Id^>.vsv ^(dispositivos^)
echo.
echo IMPORTANTE - ANÁLISIS:
echo   NINGUNO de estos archivos es una imagen RAW analizable directamente.
echo   Volatility 3 NO abre .vmrs ni .bin de Hyper-V ^(estado verificado 2026^).
echo.
echo CONVERSIÓN A MEMORIA RAW:
echo   Este framework la automatiza ^(opción tras la copia^) usando la API OFICIAL
echo   de Microsoft VmSavedStateDumpProvider ^(vmsavedstatedumpprovider.dll del
echo   Windows 10/11 SDK^). Si el .raw no se genero, el propio conversor dice por
echo   que ^(codigo 3=DLL ausente, 4=proceso de 32 bits, 5=el DLL no carga,
echo   6=entrada ilegible, 7=destino no escribible^).
echo   IMPORTANTE: el .raw producido se verifica SOLO en tamaño y alineación a
echo   4096. NADIE comprueba aquí que sea analizable: ni este framework ni el
echo   conversor ejecutan Volatility. Junto al .raw se escribe un .raw.info.txt
echo   con el supuesto de disposición de la memoria y el alcance de lo verificado.
echo   Para convertir manualmente en un equipo con SDK, USE RUTAS ABSOLUTAS:
echo     powershell -File Sistema\lib\hv_savedstate_to_raw.ps1 ^^
echo        -SavedStatePath "^<archivo^>.vmrs" -OutputRaw "^<salida^>.raw"
echo   ^(para .bin añada -VsvPath "^<archivo^>.vsv"^)
echo.
echo ALTERNATIVAS EXTERNAS:
echo   - MemProcFS -device "^<archivo^>.vmrs" -forensic 1 ^(requiere driver Dokany^)
echo   - vm2dmp.exe ^(solo Hyper-V ^<= 2008R2 y VMs con menos de 4GB RAM^)
echo   - livekd -hv "^<VM^>" -p -o salida.dmp ^(Debugging Tools + símbolos^)
echo   - Volcado DENTRO del guest con DumpIt/winpmem ^(Sistema\herramientas\Volcados\RAM^)
) > "!HVM_EVIDENCE!\Memory\FORMAT_NOTE.txt"

:: --- REANUDAR LA VM YA, ANTES DE CONVERTIR Y HASHEAR ---
:: El estado guardado YA esta copiado en la carpeta de evidencia, y tanto la
:: conversion a RAW como el hasheo trabajan SOBRE ESA COPIA -:HVM_CONVERT_RAW
:: recorre los HVM_FILE_i, que apuntan a !HVM_EVIDENCE!\Memory-, no sobre la VM.
:: Por tanto nada de lo que viene despues necesita que la VM siga detenida.
::
:: Antes se reanudaba al FINAL, despues de convertir y hashear. Eso mantenia el
:: sujeto caido durante todo ese tiempo sin ninguna necesidad tecnica: medido en
:: una VM de 2 GB, la conversion sola son 10 s y el hasheo se suma; con una VM de
:: 32 o 64 GB esa espera crece en proporcion y el servicio del invitado sigue sin
:: responder todo ese rato. Reanudar aqui deja la parada reducida a lo que si es
:: inevitable: Save-VM mas la copia del estado.
::
:: IMPORTANTE: se reanuda DESPUES de copiar y no antes, porque al arrancar la VM
:: Hyper-V CONSUME y descarta el estado guardado. Con la copia ya hecha, perderlo
:: no afecta a la evidencia; hacerlo al reves la destruiria.
if "!HVM_METHOD!"=="SAVE" call :HVM_RESUME_VM

:: --- CONVERSIÓN AUTOMÁTICA A MEMORIA RAW (vía API oficial de Microsoft) ---
:: Se ofrece convertir el estado guardado a una imagen RAW física que Volatility 3
:: abre directamente. Requiere vmsavedstatedumpprovider.dll (Windows SDK); el .ps1
:: lo autodetecta (carpeta de herramientas, SDK instalado o PATH) y degrada limpio.
echo.
:: Ofrecer la conversion cuando no hay ningun portador de RAM solo servia para
:: encadenar el mensaje "No se encontro .vmrs ni .bin ... para convertir". Si no
:: hay memoria, no se ofrece convertirla.
if not "!hvm_has_ram!"=="1" goto HVM_SKIP_CONV
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![FORMAT] State files ^(.vmrs/.bin^) are NOT directly analyzable RAW.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![FORMATO] Los archivos de estado ^(.vmrs/.bin^) NO son RAW analizable directo.!C_RESET!
set "hvm_conv="
if /i "!FORENSIC_LANG!"=="EN" set /p hvm_conv="!C_PROMPT!Convert now to RAW memory analyzable by Volatility 3? [Y/N]: !C_RESET!"
if /i not "!FORENSIC_LANG!"=="EN" set /p hvm_conv="!C_PROMPT!¿Convertir ahora a memoria RAW analizable por Volatility 3? [S/N]: !C_RESET!"
:: El prompt en ingles ofrece [Y/N]; se acepta Y como S.
if /i "!hvm_conv!"=="Y" set "hvm_conv=S"
if /I "!hvm_conv!"=="S" call :HVM_CONVERT_RAW
:HVM_SKIP_CONV

:: Verificación de integridad OPCIONAL (decisión del operador). Incluye el .raw
:: generado (si la conversión se realizo) ademas de los archivos de estado.
call :HASH_EVIDENCE FOLDER "!HVM_EVIDENCE!\Memory" "*.bin,*.vsv,*.vmrs,*.VMRS,*.vmgs,*.raw" "!HVM_EVIDENCE!\Memory\hashes.txt" "HyperV_Memoria"

:: La reanudacion de la VM YA SE HIZO, justo despues de copiar el estado y antes de
:: convertir y hashear (subrutina :HVM_RESUME_VM). Ver alli el motivo.

pause
goto HV_MENU_SHOW


:: ---------------------------------------------------------------------------
:: ---------------------------------------------------------------------------
:: HVM_RESUME_VM - reanuda la VM que Save-VM dejo en estado Saved.
:: Se llama en cuanto el estado guardado esta COPIADO, para que el sujeto vuelva a
:: operar mientras el framework convierte y hashea sobre la copia.
:: Flujo lineal, sin bloque entre parentesis: dentro de un if(...) el set /p y las
:: comparaciones con expansion retardada se resuelven en el momento equivocado.
:: ---------------------------------------------------------------------------
:HVM_RESUME_VM
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] The state is already copied: the VM no longer needs to stay stopped.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] El estado ya está copiado: la VM no necesita seguir detenida.!C_RESET!
set "hvm_resume="
if /i "!FORENSIC_LANG!"=="EN" set /p hvm_resume="!C_PROMPT!Resume the virtual machine now? [Y/N]: !C_RESET!"
if /i not "!FORENSIC_LANG!"=="EN" set /p hvm_resume="!C_PROMPT!¿Reanudar la máquina virtual ahora? [S/N]: !C_RESET!"
rem El prompt en ingles ofrece [Y/N]; se acepta Y como S.
if /i "!hvm_resume!"=="Y" set "hvm_resume=S"
if /I not "!hvm_resume!"=="S" goto HVM_RESUME_NO
if /i "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Resuming the virtual machine...!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Reanudando la máquina virtual...!C_RESET!
call :UTCNOW _HVMR_TS1
powershell -NoProfile -Command "Hyper-V\Start-VM -Name '!HVM_VMNAME_PS!' -ErrorAction Stop" 2>nul
set "_hvmr_el=!errorlevel!"
call :UTCNOW _HVMR_TS2
call :LOG_CMD "HyperV_Resume" "Start-VM -Name ""!HVM_VMNAME!""" "!_hvmr_el!" "!_HVMR_TS1!" "!_HVMR_TS2!" "" ""
if not "!_hvmr_el!"=="0" goto HVM_RESUME_FAIL
if /i "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Virtual machine started. The conversion continues with it running.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Máquina virtual iniciada. La conversión continúa con ella en marcha.!C_RESET!
call :LOG_EVENT "VM reanudada via Start-VM: !HVM_VMNAME!. El estado guardado ya estaba copiado en la carpeta de evidencia, asi que la conversion a RAW y el hasheo se hacen sobre la copia, con la VM ya operativa. Tiempo de parada del sujeto: Save-VM mas la copia."
exit /b 0
:HVM_RESUME_FAIL
if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Could not resume the VM automatically. Start it from Hyper-V Manager.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] No se pudo reanudar la VM automáticamente. Iníciela desde Hyper-V Manager.!C_RESET!
call :LOG_EVENT "AVISO: no se pudo reanudar !HVM_VMNAME! automaticamente (codigo !_hvmr_el!). La VM sigue DETENIDA en estado Saved y debe iniciarse a mano. La evidencia ya estaba copiada."
exit /b 0
:HVM_RESUME_NO
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] The VM is left STOPPED in Saved state, by operator decision.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] La VM queda DETENIDA en estado Saved, por decisión del operador.!C_RESET!
call :LOG_EVENT "El operador decidio NO reanudar !HVM_VMNAME!: la VM permanece DETENIDA en estado Saved. La evidencia ya estaba copiada."
exit /b 0

:: ---------------------------------------------------------------------------
:: HVM_CONVERT_RAW - convierte el estado guardado copiado a memoria RAW física
:: usando hv_savedstate_to_raw.ps1 (API oficial VmSavedStateDumpProvider).
:: Elige la fuente entre los archivos ya copiados a la carpeta Memory:
::   preferido .vmrs; si no, el par .bin + .vsv.
:: ---------------------------------------------------------------------------
:HVM_CONVERT_RAW
if not exist "!HV_RAW_PS1!" (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Converter not found: !HV_RAW_PS1!!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Conversor no encontrado: !HV_RAW_PS1!!C_RESET!
    exit /b
)
set "_hvsrc="
set "_hvvsv="
set "_hvtype="
set "_hvbase="
:: Antes se elegia el PRIMER *.vmrs alfabetico de la carpeta Memory y, para el
:: caso .bin, se emparejaba el primer .bin con el primer .vsv. Como el destino es
:: determinista, con dos adquisiciones acumuladas en la misma carpeta se convertia
:: la ANTIGUA, y se podia emparejar un .bin con el .vsv de otra captura. Ahora se
:: recorren los archivos COPIADOS EN ESTA EJECUCION (HVM_FILE_i) y el .vsv se
:: empareja por NOMBRE BASE con su .bin.
for /L %%i in (1,1,!hvm_file_count!) do call :HVM_PICK_CONV_SRC "!HVM_FILE_%%i!"
if not defined _hvsrc (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![-] None of the files copied in this run carries memory ^(.vmrs or .bin^).!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![-] Ninguno de los archivos copiados en esta ejecución lleva memoria ^(.vmrs o .bin^).!C_RESET!
    exit /b
)
:: El .bin sin su .vsv no lo abre la API: se empareja por nombre base dentro de la
:: carpeta de ESTA adquisicion.
if "!_hvtype!"=="bin" (
    if exist "!HVM_EVIDENCE!\Memory\!_hvbase!.vsv" set "_hvvsv=!HVM_EVIDENCE!\Memory\!_hvbase!.vsv"
    if not defined _hvvsv (
        if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Found "!_hvbase!.bin" but not its "!_hvbase!.vsv"; cannot convert.!C_RESET!
        if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Se encontró "!_hvbase!.bin" pero no su "!_hvbase!.vsv"; no se puede convertir.!C_RESET!
        if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] No .vsv from another capture is paired with it: that would mix two states.!C_RESET!
        if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] No se empareja con el .vsv de otra captura: eso mezclaria dos estados.!C_RESET!
        call :LOG_EVENT "Conversion a RAW no realizada: !_hvbase!.bin sin su .vsv correspondiente. No se empareja con el .vsv de otra captura."
        exit /b
    )
)

for %%F in ("!_hvsrc!") do set "_hvraw=!HVM_EVIDENCE!\Memory\%%~nF.raw"
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Converting saved state to RAW memory...!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Convirtiendo estado guardado a memoria RAW...!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_DIM!    Source: !_hvsrc!!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_DIM!    Fuente: !_hvsrc!!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_DIM!    Output: !_hvraw!!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_DIM!    Salida: !_hvraw!!C_RESET!
:: El proveedor solo existe en x64. Si este .bat se lanzo desde un cmd de 32 bits,
:: "powershell" resuelve a SysWOW64 y el conversor sale 4 sin poder convertir nada.
:: PROCESSOR_ARCHITEW6432 solo esta definida en un proceso de 32 bits sobre un
:: Windows de 64, y Sysnative es la puerta a los binarios nativos desde ahi.
set "_hvps_exe=powershell"
if defined PROCESSOR_ARCHITEW6432 if exist "!SystemRoot!\Sysnative\WindowsPowerShell\v1.0\powershell.exe" set "_hvps_exe=!SystemRoot!\Sysnative\WindowsPowerShell\v1.0\powershell.exe"
call :UTCNOW _HVCV_TS1
if "!_hvtype!"=="bin" (
    "!_hvps_exe!" -NoProfile -ExecutionPolicy Bypass -File "!HV_RAW_PS1!" -SavedStatePath "!_hvsrc!" -VsvPath "!_hvvsv!" -OutputRaw "!_hvraw!"
) else (
    "!_hvps_exe!" -NoProfile -ExecutionPolicy Bypass -File "!HV_RAW_PS1!" -SavedStatePath "!_hvsrc!" -OutputRaw "!_hvraw!"
)
set "_hvcv_el=!errorlevel!"
call :UTCNOW _HVCV_TS2
call :LOG_CMD "HyperV_ConversionRAW" "hv_savedstate_to_raw.ps1 -SavedStatePath ""!_hvsrc!"" -OutputRaw ""!_hvraw!""" "!_hvcv_el!" "!_HVCV_TS1!" "!_HVCV_TS2!" "!_hvraw!" ""

:: Un solo codigo 3 significaba tres cosas distintas y el framework las traducia
:: todas a "falta el DLL": un proceso de 32 bits o un DLL que no carga por falta
:: del runtime de VC++ se diagnosticaban como archivo ausente. El .ps1 ahora
:: devuelve un codigo por causa y aqui se traduce cada uno.
if "!_hvcv_el!"=="0" goto HVCV_OK
if "!_hvcv_el!"=="3" goto HVCV_NODLL
if "!_hvcv_el!"=="4" goto HVCV_X86
if "!_hvcv_el!"=="5" goto HVCV_LOADFAIL
if "!_hvcv_el!"=="6" goto HVCV_BADIN
if "!_hvcv_el!"=="7" goto HVCV_BADOUT
goto HVCV_GENERIC

:HVCV_OK
if /i "!FORENSIC_LANG!"=="EN" echo !C_OK![+] RAW image generated: !_hvraw!!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Imagen RAW generada: !_hvraw!!C_RESET!
rem El texto decia "Analizable directamente", una afirmacion que nadie comprobo:
rem el framework NO ejecuta Volatility en ningun punto, solo imprime la linea.
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Analysability NOT verified by this framework. Check it yourself with:!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Analizabilidad NO comprobada por este framework. Compruebela usted con:!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT!    vol.py -f "!_hvraw!" windows.info!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT!    vol.py -f "!_hvraw!" windows.info!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] What WAS verified: size, 4096 alignment and the layout!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Lo que SI se verificó: tamaño, alineación 4096 y el supuesto!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT!    assumption. It is all written in the .raw.info.txt.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT!    de disposición. Todo consta en el .raw.info.txt.!C_RESET!
call :LOG_EVENT "Conversion a RAW completada: !_hvraw! - verificado tamano y alineacion; NO se comprobo analizabilidad (el framework no ejecuta Volatility)."
exit /b

:HVCV_NODLL
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![-] Could not convert: vmsavedstatedumpprovider.dll was NOT FOUND ^(Windows SDK^).!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![-] No se pudo convertir: NO SE ENCONTRO vmsavedstatedumpprovider.dll ^(Windows SDK^).!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] The state files remain copied; convert on a machine with the SDK.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Los archivos de estado quedan copiados; convierta en un equipo con SDK.!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Details in FORMAT_NOTE.txt.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Detalles en FORMAT_NOTE.txt.!C_RESET!
call :LOG_EVENT "Conversion a RAW omitida: vmsavedstatedumpprovider.dll no encontrado (codigo 3)."
exit /b

:HVCV_X86
if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Could not convert: PowerShell ran as a 32-bit process.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] No se pudo convertir: PowerShell se ejecuto como proceso de 32 bits.!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] The provider only exists for x64. Launch the framework from a 64-bit cmd.exe!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] El proveedor solo existe para x64. Lance el framework desde un cmd.exe de 64!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT!    ^(%%SystemRoot%%\System32\cmd.exe^), not from SysWOW64.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT!    bits ^(%%SystemRoot%%\System32\cmd.exe^), no desde SysWOW64.!C_RESET!
call :LOG_EVENT "Conversion a RAW omitida: el proceso de PowerShell era de 32 bits (codigo 4). El DLL existe solo para x64."
exit /b

:HVCV_LOADFAIL
if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Could not convert: the DLL was FOUND but failed to load.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] No se pudo convertir: el DLL SI se encontró pero no se pudo cargar.!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] This is not a missing file: usual causes are a missing Visual C++ x64!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] No es un archivo ausente: causas habituales son que falte el runtime de!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT!    runtime, or an SDK build that needs Hyper-V components not present here.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT!    Visual C++ x64, o un SDK que exige componentes de Hyper-V no presentes.!C_RESET!
call :LOG_EVENT "Conversion a RAW fallida: LoadLibrary del proveedor fallo (codigo 5). El DLL existe."
exit /b

:HVCV_BADIN
if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Could not convert: the input state file is missing or unreadable.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] No se pudo convertir: el archivo de estado de entrada no existe o no es legible.!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_DIM!    Source: !_hvsrc!!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_DIM!    Fuente: !_hvsrc!!C_RESET!
call :LOG_EVENT "Conversion a RAW fallida: entrada inexistente o ilegible (codigo 6): !_hvsrc!"
exit /b

:HVCV_BADOUT
if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Could not convert: the output could not be written ^(path or free space^).!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] No se pudo convertir: no se pudo escribir la salida ^(ruta o espacio libre^).!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_DIM!    Output: !_hvraw!!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_DIM!    Salida: !_hvraw!!C_RESET!
call :LOG_EVENT "Conversion a RAW fallida: destino no escribible (codigo 7): !_hvraw!"
exit /b

:HVCV_GENERIC
if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] The conversion to RAW failed ^(code !_hvcv_el!^).!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] La conversión a RAW fallo ^(código !_hvcv_el!^).!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] The original state files remain intact as evidence.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Los archivos de estado originales quedan intactos como evidencia.!C_RESET!
call :LOG_EVENT "Error: conversion a RAW fallo para !HVM_VMNAME! (codigo !_hvcv_el!)"
exit /b

:: ---------------------------------------------------------------------------
:: HVM_PICK_CONV_SRC
:: %1 = ruta ORIGINAL de un archivo de estado copiado en ESTA ejecucion.
:: La fuente de la conversion es siempre la COPIA que esta en la carpeta de
:: evidencia, nunca el archivo del host: el original no se vuelve a leer.
:: Prioridad: .vmrs (autosuficiente) sobre .bin (necesita su .vsv).
:: ---------------------------------------------------------------------------
:HVM_PICK_CONV_SRC
set "_hpc_ext=%~x1"
set "_hpc_base=%~n1"
set "_hpc_copy=!HVM_EVIDENCE!\Memory\%~nx1"
if not exist "!_hpc_copy!" exit /b 0
if /i "!_hpc_ext!"==".vmrs" (
    set "_hvsrc=!_hpc_copy!"
    set "_hvtype=vmrs"
    set "_hvbase=!_hpc_base!"
    exit /b 0
)
if /i "!_hpc_ext!"==".bin" if not "!_hvtype!"=="vmrs" (
    set "_hvsrc=!_hpc_copy!"
    set "_hvtype=bin"
    set "_hvbase=!_hpc_base!"
)
exit /b 0

:: Subrutina: copia un archivo de estado guardado (%1 = indice)
:HVM_COPY_FILE_ITEM
if defined hvm_copy_abort exit /b
set "hvm_copy_src=!HVM_FILE_%1!"
if not exist "!hvm_copy_src!" (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] File not found: !hvm_copy_src!!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Archivo no encontrado: !hvm_copy_src!!C_RESET!
    call :LOG_EVENT "Error: Archivo de estado no encontrado: !hvm_copy_src!"
    exit /b
)
for %%F in ("!hvm_copy_src!") do (
    set "_hvmc_dir=%%~dpF"
    set "_hvmc_file=%%~nxF"
)
if "!_hvmc_dir:~-1!"=="\" set "_hvmc_dir=!_hvmc_dir:~0,-1!"
call :NEWGUID ACQ_GUID
set "ACQ_CMD=!TEMP!\forensic_cmd_!ACQ_GUID!.tmp"
:: Robocopy 0-7 = exito; se mapea a 0/1 dentro del comando para el wrapper.
>"!ACQ_CMD!" echo robocopy "!_hvmc_dir!" "!HVM_EVIDENCE!\Memory" "!_hvmc_file!" !RBC_J! /R:1 /W:1 /NJH /NJS /NDL /NC /NS ^& if errorlevel 8 (exit 1) else (exit 0)
set "ACQ_TOOL_VER=robocopy in-box de !WIN_NAME! build !WIN_BUILD! - no publica version propia: su identidad es la build del SO"
call :ACQUIRE "HyperV_CopiaMemoria - !_hvmc_file!" "!ACQ_CMD!"
set "_hvmc_el=!errorlevel!"
if "!_hvmc_el!"=="2" (
    set "hvm_copy_abort=1"
    exit /b
)
if "!_hvmc_el!"=="0" (
    set "hvm_copy_ok=1"
    call :LOG_EVENT "Archivo de estado copiado: !hvm_copy_src!"
) else (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Error copying: !hvm_copy_src!!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Error al copiar: !hvm_copy_src!!C_RESET!
    call :LOG_EVENT "Error: Fallo al copiar archivo de estado: !hvm_copy_src!"
)
exit /b


:: --- HYPER-V: CONSOLIDAR DESDE DISCOS ADQUIRIDOS ---
:HV_CONS_FROM_DISK
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Consolidate Checkpoint Chain from acquired disks!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Consolidar Cadena de Checkpoints desde discos adquiridos!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Will consolidate from the disks already copied in the Disks folder.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Se consolidara desde los discos ya copiados en la carpeta Disks.!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] The original acquired disks will NOT be modified.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Los discos originales adquiridos NO serán modificados.!C_RESET!
echo.

:: Validar cmdlets
powershell -NoProfile -Command "if (@(Get-Command -Module Hyper-V -Name Get-VHD -ErrorAction SilentlyContinue).Count -eq 1) { exit 0 } else { exit 1 }" >nul 2>&1
if !errorlevel! neq 0 goto HV_CONS_NO_CMDLET
powershell -NoProfile -Command "if (@(Get-Command -Module Hyper-V -Name Merge-VHD,Set-VHD -ErrorAction SilentlyContinue).Count -eq 2) { exit 0 } else { exit 1 }" >nul 2>&1
if !errorlevel! neq 0 goto HV_CONS_NO_CMDLET
goto HV_CONS_CMDLET_OK

:HV_CONS_NO_CMDLET
if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] The Get-VHD and/or Merge-VHD cmdlets are not available.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Los cmdlets Get-VHD y/o Merge-VHD no están disponibles.!C_RESET!
pause
goto HV_MENU_SHOW

:HV_CONS_CMDLET_OK
:: Preparar carpetas de consolidación
set "HV_DISKS_DIR=!HV_EVIDENCE!\Disks"
set "HV_CONS_DIR=!HV_EVIDENCE!\Consolidation"
set "HV_CONS_WORK=!HV_CONS_DIR!\Working"
if not exist "!HV_CONS_DIR!" mkdir "!HV_CONS_DIR!"
if not exist "!HV_CONS_WORK!" mkdir "!HV_CONS_WORK!"

:: El nombre del consolidado ya NO fuerza .vhdx: la extension se deriva del disco
:: RAIZ real, porque en una cadena Gen1 la raiz es un .vhd y el nombre mentia
:: sobre el formato. Aqui solo se fija el prefijo.
set "hvc_cons_prefix=!HV_FOLDER!_consolidated"

call :LOG_EVENT "Consolidacion iniciada desde discos adquiridos: !HV_VMNAME!"

:: Script PS1 de consolidacion. Reescrito por completo: el anterior elegia el
:: disco activo y su padre por ORDEN ALFABETICO ($wAvhdx[0], $base[0]) y ejecutaba
:: Merge-VHD SIN -DestinationPath, que funde UN SOLO nivel. Consecuencias medidas
:: sobre la logica del codigo: con la cadena base<-a1<-a2 el .vhdx base no recibia
:: nada y era justo el que se copiaba como "consolidado" (es decir, se entregaba el
:: estado ANTERIOR a todos los checkpoints); si $wAvhdx[0] caia en un diferencial
:: intermedio el resultado era un punto temporal arbitrario; y con dos discos cada
:: uno con su cadena, se fundia la hoja del disco A y se copiaba el disco B como
:: consolidado. Los tres casos acababan en "Consolidacion completada exitosamente".
:: Ahora se resuelve la cadena real por ParentPath, se identifica la hoja (la que
:: nadie referencia como padre) y la raiz, se funde con -DestinationPath (que funde
:: TODA la cadena), se VERIFICAN las postcondiciones y se hace por cada disco.
call :NEWGUID HVC_GUID
set "HVC_MERGE_PS=!TEMP!\forensic_!HVC_GUID!.ps1"
> "!HVC_MERGE_PS!" echo Import-Module Hyper-V -ErrorAction Stop
>> "!HVC_MERGE_PS!" echo $disksDir = '!HV_DISKS_DIR:'=''!'
>> "!HVC_MERGE_PS!" echo $workDir = '!HV_CONS_WORK:'=''!'
>> "!HVC_MERGE_PS!" echo $consDir = '!HV_CONS_DIR:'=''!'
>> "!HVC_MERGE_PS!" echo $consPrefix = '!hvc_cons_prefix:'=''!'
>> "!HVC_MERGE_PS!" echo $diskExt = @('.vhdx','.vhd','.vhds','.avhdx','.avhd')
>> "!HVC_MERGE_PS!" echo $diffExt = @('.avhdx','.avhd')
>> "!HVC_MERGE_PS!" echo(
>> "!HVC_MERGE_PS!" echo function Get-DiskFiles($dir) {
>> "!HVC_MERGE_PS!" echo     $r = @()
>> "!HVC_MERGE_PS!" echo     foreach ($f in @(Get-ChildItem -Path $dir -Recurse -ErrorAction SilentlyContinue)) {
>> "!HVC_MERGE_PS!" echo         if ($f.PSIsContainer) { continue }
>> "!HVC_MERGE_PS!" echo         if ($diskExt -contains $f.Extension.ToLower()) { $r += $f }
>> "!HVC_MERGE_PS!" echo     }
>> "!HVC_MERGE_PS!" echo     return $r
>> "!HVC_MERGE_PS!" echo }
>> "!HVC_MERGE_PS!" echo(
>> "!HVC_MERGE_PS!" echo # El padre DECLARADO por el propio disco. Get-VHD puede fallar si el padre no es
>> "!HVC_MERGE_PS!" echo # alcanzable desde la ruta grabada, asi que se cae al metadato del archivo.
>> "!HVC_MERGE_PS!" echo function Get-ParentDeclared($p) {
>> "!HVC_MERGE_PS!" echo     try {
>> "!HVC_MERGE_PS!" echo         $i = Hyper-V\Get-VHD -Path $p -ErrorAction Stop
>> "!HVC_MERGE_PS!" echo         if ($i.ParentPath) { return $i.ParentPath }
>> "!HVC_MERGE_PS!" echo         return $null
>> "!HVC_MERGE_PS!" echo     } catch { }
>> "!HVC_MERGE_PS!" echo     try {
>> "!HVC_MERGE_PS!" echo         $stream = [System.IO.File]::OpenRead($p)
>> "!HVC_MERGE_PS!" echo         try {
>> "!HVC_MERGE_PS!" echo             $headerSize = [int][Math]::Min($stream.Length, 1048576)
>> "!HVC_MERGE_PS!" echo             $bytes = New-Object byte[] $headerSize
>> "!HVC_MERGE_PS!" echo             [void]$stream.Read($bytes, 0, $headerSize)
>> "!HVC_MERGE_PS!" echo         } finally { $stream.Close() }
>> "!HVC_MERGE_PS!" echo         $text = [System.Text.Encoding]::Unicode.GetString($bytes)
>> "!HVC_MERGE_PS!" echo         $m = [regex]::Match($text, '([A-Za-z]:\\[^^\x00]+?\.(avhdx^|avhd^|vhdx^|vhds^|vhd))', 'IgnoreCase')
>> "!HVC_MERGE_PS!" echo         if ($m.Success) { return $m.Value }
>> "!HVC_MERGE_PS!" echo     } catch { }
>> "!HVC_MERGE_PS!" echo     return $null
>> "!HVC_MERGE_PS!" echo }
>> "!HVC_MERGE_PS!" echo(
>> "!HVC_MERGE_PS!" echo $srcAll = Get-DiskFiles $disksDir
>> "!HVC_MERGE_PS!" echo $srcDiff = @($srcAll ^| Where-Object { $diffExt -contains $_.Extension.ToLower() })
>> "!HVC_MERGE_PS!" echo if ($srcDiff.Count -eq 0) { Write-Output 'NO_CHAIN'; exit }
>> "!HVC_MERGE_PS!" echo(
>> "!HVC_MERGE_PS!" echo Write-Output 'INFO^|Copiando discos a la carpeta de trabajo (la evidencia en Disks no se toca)'
>> "!HVC_MERGE_PS!" echo foreach ($d in $srcAll) {
>> "!HVC_MERGE_PS!" echo     try { Copy-Item -LiteralPath $d.FullName -Destination $workDir -Force -ErrorAction Stop }
>> "!HVC_MERGE_PS!" echo     catch { Write-Output "INFO|No se pudo copiar a Working: $($d.Name)"; Write-Output 'MERGE_FAIL'; exit }
>> "!HVC_MERGE_PS!" echo }
>> "!HVC_MERGE_PS!" echo(
>> "!HVC_MERGE_PS!" echo $work = Get-DiskFiles $workDir
>> "!HVC_MERGE_PS!" echo $parentOf = @{}
>> "!HVC_MERGE_PS!" echo foreach ($f in $work) {
>> "!HVC_MERGE_PS!" echo     $pd = Get-ParentDeclared $f.FullName
>> "!HVC_MERGE_PS!" echo     if ($pd) { $parentOf[$f.Name] = [System.IO.Path]::GetFileName($pd) } else { $parentOf[$f.Name] = $null }
>> "!HVC_MERGE_PS!" echo }
>> "!HVC_MERGE_PS!" echo(
>> "!HVC_MERGE_PS!" echo # Re-enlazar cada diferencial a la COPIA local de su padre.
>> "!HVC_MERGE_PS!" echo $broken = @()
>> "!HVC_MERGE_PS!" echo foreach ($f in $work) {
>> "!HVC_MERGE_PS!" echo     $pn = $parentOf[$f.Name]
>> "!HVC_MERGE_PS!" echo     if (-not $pn) { continue }
>> "!HVC_MERGE_PS!" echo     $np = Join-Path $workDir $pn
>> "!HVC_MERGE_PS!" echo     if (-not (Test-Path -LiteralPath $np)) { $broken += "$($f.Name) necesita $pn y no esta en Working"; continue }
>> "!HVC_MERGE_PS!" echo     try {
>> "!HVC_MERGE_PS!" echo         Hyper-V\Set-VHD -Path $f.FullName -ParentPath $np -IgnoreIdMismatch -ErrorAction Stop
>> "!HVC_MERGE_PS!" echo         Write-Output "INFO|Re-enlazado: $($f.Name) -> $pn"
>> "!HVC_MERGE_PS!" echo     } catch { $broken += "no se pudo re-enlazar $($f.Name) a $pn" }
>> "!HVC_MERGE_PS!" echo }
>> "!HVC_MERGE_PS!" echo if ($broken.Count -gt 0) {
>> "!HVC_MERGE_PS!" echo     foreach ($b in $broken) { Write-Output "INFO|Eslabon no resuelto: $b" }
>> "!HVC_MERGE_PS!" echo     Write-Output 'MERGE_FAIL'
>> "!HVC_MERGE_PS!" echo     exit
>> "!HVC_MERGE_PS!" echo }
>> "!HVC_MERGE_PS!" echo(
>> "!HVC_MERGE_PS!" echo # La HOJA de cada cadena es el disco al que NADIE referencia como padre. Antes se
>> "!HVC_MERGE_PS!" echo # tomaba $wAvhdx[0], es decir el primero por orden alfabetico, que no guarda
>> "!HVC_MERGE_PS!" echo # ninguna relacion con el orden de la cadena.
>> "!HVC_MERGE_PS!" echo $referenced = @{}
>> "!HVC_MERGE_PS!" echo foreach ($f in $work) {
>> "!HVC_MERGE_PS!" echo     $pn = $parentOf[$f.Name]
>> "!HVC_MERGE_PS!" echo     if ($pn) { $referenced[$pn.ToLower()] = $true }
>> "!HVC_MERGE_PS!" echo }
>> "!HVC_MERGE_PS!" echo $leaves = @($work ^| Where-Object { -not $referenced.ContainsKey($_.Name.ToLower()) })
>> "!HVC_MERGE_PS!" echo if ($leaves.Count -eq 0) { Write-Output 'INFO^|No se pudo identificar la hoja de ninguna cadena'; Write-Output 'MERGE_FAIL'; exit }
>> "!HVC_MERGE_PS!" echo(
>> "!HVC_MERGE_PS!" echo $idx = 0
>> "!HVC_MERGE_PS!" echo foreach ($leaf in $leaves) {
>> "!HVC_MERGE_PS!" echo     $idx++
>> "!HVC_MERGE_PS!" echo     $rootName = $leaf.Name
>> "!HVC_MERGE_PS!" echo     $guard = 0
>> "!HVC_MERGE_PS!" echo     while ($parentOf[$rootName] -and $guard -lt 128) { $rootName = $parentOf[$rootName]; $guard++ }
>> "!HVC_MERGE_PS!" echo     $leafPath = Join-Path $workDir $leaf.Name
>> "!HVC_MERGE_PS!" echo     $rootPath = Join-Path $workDir $rootName
>> "!HVC_MERGE_PS!" echo     if ($rootName -eq $leaf.Name) {
>> "!HVC_MERGE_PS!" echo         Write-Output "INFO|$($leaf.Name) no es diferencial: ya esta consolidado, se copia tal cual"
>> "!HVC_MERGE_PS!" echo     } else {
>> "!HVC_MERGE_PS!" echo         Write-Output "INFO|Cadena $idx : hoja $($leaf.Name) -> raiz $rootName"
>> "!HVC_MERGE_PS!" echo         # -DestinationPath funde TODA la cadena hasta la raiz. Sin ese parametro
>> "!HVC_MERGE_PS!" echo         # Merge-VHD funde UN SOLO nivel (en el padre inmediato) y la raiz, que es
>> "!HVC_MERGE_PS!" echo         # justo lo que se entregaba como "consolidado", no recibia nada.
>> "!HVC_MERGE_PS!" echo         try { Hyper-V\Merge-VHD -Path $leafPath -DestinationPath $rootPath -Force -Confirm:$false -ErrorAction Stop }
>> "!HVC_MERGE_PS!" echo         catch { Write-Output "INFO|Merge-VHD fallo en la cadena $idx : $($_.Exception.Message)"; Write-Output 'MERGE_FAIL'; exit }
>> "!HVC_MERGE_PS!" echo         if (Test-Path -LiteralPath $leafPath) {
>> "!HVC_MERGE_PS!" echo             Write-Output "INFO|La hoja sigue existiendo tras el merge: $($leaf.Name)"
>> "!HVC_MERGE_PS!" echo             Write-Output 'MERGE_FAIL'
>> "!HVC_MERGE_PS!" echo             exit
>> "!HVC_MERGE_PS!" echo         }
>> "!HVC_MERGE_PS!" echo         $ri = $null
>> "!HVC_MERGE_PS!" echo         try { $ri = Hyper-V\Get-VHD -Path $rootPath -ErrorAction Stop } catch { }
>> "!HVC_MERGE_PS!" echo         if (-not $ri) { Write-Output "INFO|No se pudo verificar el disco consolidado $rootName"; Write-Output 'MERGE_FAIL'; exit }
>> "!HVC_MERGE_PS!" echo         if ($ri.ParentPath) {
>> "!HVC_MERGE_PS!" echo             Write-Output "INFO|El disco consolidado $rootName sigue declarando padre: la cadena NO se fundio por completo"
>> "!HVC_MERGE_PS!" echo             Write-Output 'MERGE_FAIL'
>> "!HVC_MERGE_PS!" echo             exit
>> "!HVC_MERGE_PS!" echo         }
>> "!HVC_MERGE_PS!" echo     }
>> "!HVC_MERGE_PS!" echo     # La extension del consolidado se deriva del disco raiz REAL: forzar .vhdx
>> "!HVC_MERGE_PS!" echo     # producia un nombre que mentia sobre el formato en las cadenas .vhd/.avhd.
>> "!HVC_MERGE_PS!" echo     $ext = [System.IO.Path]::GetExtension($rootName)
>> "!HVC_MERGE_PS!" echo     if ($leaves.Count -eq 1) {
>> "!HVC_MERGE_PS!" echo         $outName = $consPrefix + $ext
>> "!HVC_MERGE_PS!" echo     } else {
>> "!HVC_MERGE_PS!" echo         $outName = $consPrefix + '_' + $idx + '_' + [System.IO.Path]::GetFileNameWithoutExtension($rootName) + $ext
>> "!HVC_MERGE_PS!" echo     }
>> "!HVC_MERGE_PS!" echo     $outPath = Join-Path $consDir $outName
>> "!HVC_MERGE_PS!" echo     try { Copy-Item -LiteralPath $rootPath -Destination $outPath -Force -ErrorAction Stop }
>> "!HVC_MERGE_PS!" echo     catch { Write-Output "INFO|No se pudo copiar el consolidado $outName"; Write-Output 'MERGE_FAIL'; exit }
>> "!HVC_MERGE_PS!" echo     Write-Output "CONSOLIDATED|$outName"
>> "!HVC_MERGE_PS!" echo }
>> "!HVC_MERGE_PS!" echo Write-Output "TOTAL|$($leaves.Count)"
>> "!HVC_MERGE_PS!" echo Write-Output 'MERGE_OK'
>> "!HVC_MERGE_PS!" echo try { Remove-Item -LiteralPath $workDir -Recurse -Force -ErrorAction SilentlyContinue } catch { }
>> "!HVC_MERGE_PS!" echo(


if /i "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Running consolidation...!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Ejecutando consolidación...!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] This process may take several minutes.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] Este proceso puede tardar varios minutos.!C_RESET!

set "hvc_merge_result=FAIL"
set "hvc_no_chain=0"
set "hvc_cons_count=0"
set "hvc_first_name="
:: La salida del .ps1 se vuelca a un archivo y se examina con findstr SOBRE EL
:: ARCHIVO. Antes se hacia "echo %%R | findstr ...": el valor sustituido incluia
:: $($_.Exception.Message) de Merge-VHD/Copy-Item, asi que un &, un | o un > en el
:: mensaje de error rompia el echo o ejecutaba un fragmento del mensaje como
:: comando. Ademas los mensajes ya no viajan en el mismo flujo que se parsea: el
:: .ps1 emite tokens fijos (NO_CHAIN, MERGE_OK, MERGE_FAIL, CONSOLIDATED, TOTAL) y
:: los mensajes van prefijados con INFO.
set "HVC_OUT=!TEMP!\forensic_!HVC_GUID!.out"
powershell -NoProfile -ExecutionPolicy Bypass -File "!HVC_MERGE_PS!" > "!HVC_OUT!" 2>&1
:: "type" no reinterpreta el contenido: es la forma segura de mostrarlo.
type "!HVC_OUT!"
findstr /b /c:"NO_CHAIN" "!HVC_OUT!" >nul 2>&1 && set "hvc_no_chain=1"
findstr /b /c:"MERGE_OK" "!HVC_OUT!" >nul 2>&1 && set "hvc_merge_result=OK"
findstr /b /c:"MERGE_FAIL" "!HVC_OUT!" >nul 2>&1 && set "hvc_merge_result=FAIL"
for /f "usebackq tokens=1,* delims=|" %%A in (`findstr /b /c:"CONSOLIDATED" "!HVC_OUT!"`) do (
    set /a hvc_cons_count+=1
    set "HVC_CONS_!hvc_cons_count!=%%B"
    if not defined hvc_first_name set "hvc_first_name=%%B"
)
del "!HVC_MERGE_PS!" >nul 2>&1
del "!HVC_OUT!" >nul 2>&1

if "!hvc_no_chain!"=="1" (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![-] No differential disks ^(.avhdx/.avhd^) were found in the Disks folder.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![-] No se encontraron discos diferenciales ^(.avhdx/.avhd^) en la carpeta Disks.!C_RESET!
    if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] There is no checkpoint chain to consolidate.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] No hay cadena de checkpoints para consolidar.!C_RESET!
    call :LOG_EVENT "Consolidacion: No hay discos diferenciales en Disks para !HV_VMNAME!"
    pause
    goto HV_MENU_SHOW
)

if "!hvc_merge_result!"=="FAIL" (
    echo.
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] The consolidation FAILED. No consolidated disk is declared.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] La consolidación FALLO. No se declara ningún disco consolidado.!C_RESET!
    if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] The reason is in the lines above. The original evidence in Disks is untouched.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] El motivo esta en las lineas de arriba. La evidencia original en Disks no se toco.!C_RESET!
    call :LOG_EVENT "Error: consolidacion fallida para !HV_VMNAME!. No se produjo ningun disco consolidado valido."
    pause
    goto HV_MENU_SHOW
)

:: Validar resultado: se exige que el .ps1 haya declarado al menos un consolidado
:: y que el archivo EXISTA de verdad.
if !hvc_cons_count! equ 0 (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] No consolidated file was generated.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] No se genero ningún archivo consolidado.!C_RESET!
    call :LOG_EVENT "Error: Consolidado no encontrado."
    pause
    goto HV_MENU_SHOW
)
set "hvc_missing=0"
for /L %%i in (1,1,!hvc_cons_count!) do if not exist "!HV_CONS_DIR!\!HVC_CONS_%%i!" set "hvc_missing=1"
if "!hvc_missing!"=="1" (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] A consolidated file declared by the converter is not on disk.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Un archivo consolidado declarado por el conversor no esta en disco.!C_RESET!
    call :LOG_EVENT "Error: el .ps1 declaro un consolidado que no existe en !HV_CONS_DIR!."
    pause
    goto HV_MENU_SHOW
)

set "hvc_final_path=!HV_CONS_DIR!\!hvc_first_name!"
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Consolidation completed: !hvc_cons_count! consolidated disk^(s^).!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Consolidación completada: !hvc_cons_count! disco^(s^) consolidado^(s^).!C_RESET!
for /L %%i in (1,1,!hvc_cons_count!) do call :HVC_SHOW_CONS %%i
call :LOG_EVENT "Consolidacion completada para !HV_VMNAME!: !hvc_cons_count! disco/s consolidado/s en !HV_CONS_DIR!. Cada cadena se fundio de la hoja a su raiz con Merge-VHD -DestinationPath y se verifico que la hoja desaparecio y que la raiz ya no declara padre."

:: Verificación de integridad OPCIONAL (decisión del operador)
set "hvc_hash_path=!HV_CONS_DIR!\hashes.txt"
call :HASH_EVIDENCE FOLDER "!HV_CONS_DIR!" "!hvc_cons_prefix!*.*" "!hvc_hash_path!" "HyperV_Consolidado"
call :LOG_EVENT "Consolidacion finalizada: !HV_VMNAME!"
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Consolidation process finished.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Proceso de consolidación terminado.!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] The consolidated disk is a derived artifact for analysis.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] El disco consolidado es un artefacto derivado para análisis.!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] The original evidence in Disks was not deleted.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] La evidencia original en Disks no fue eliminada.!C_RESET!
echo.

:: Ofrecer conversión QEMU del consolidado. Con varias cadenas hay varios
:: consolidados y elegir uno "el primero" en silencio es exactamente el defecto
:: que se acaba de corregir: se remite al menu de conversion.
if not exist "!QEMU_IMG!" goto HV_SKIP_QEMU_CONS
if !hvc_cons_count! gtr 1 (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] There are !hvc_cons_count! consolidated disks: automatic RAW conversion is not!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Hay !hvc_cons_count! discos consolidados: no se ofrece la conversión RAW!C_RESET!
    if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT!    offered, so as not to pick one silently. Use the "Convert Disk to RAW/IMG!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT!    automatica para no elegir uno en silencio. Use la opción "Convertir Disco!C_RESET!
    if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT!    ^(QEMU^)" option and convert each one explicitly.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT!    a RAW/IMG ^(QEMU^)" y convierta cada uno explicitamente.!C_RESET!
    goto HV_SKIP_QEMU_CONS
)
set "hv_qemu_cons="
if /i "!FORENSIC_LANG!"=="EN" set /p hv_qemu_cons="!C_PROMPT!Convert the consolidated disk to forensic RAW/IMG format (QEMU)? [Y/N]: !C_RESET!"
if /i not "!FORENSIC_LANG!"=="EN" set /p hv_qemu_cons="!C_PROMPT!¿Convertir el disco consolidado a RAW/IMG forense (QEMU)? [S/N]: !C_RESET!"
:: El prompt en ingles ofrece [Y/N]; se acepta Y como S.
if /i "!hv_qemu_cons!"=="Y" set "hv_qemu_cons=S"
if /I "!hv_qemu_cons!"=="S" (
    if exist "!hvc_final_path!" (
        for %%F in ("!hvc_final_path!") do set "hvc_qemu_base=%%~nF"
        call :QEMU_CONVERT "!hvc_final_path!" "!HV_CONS_DIR!" "!hvc_qemu_base!_forense"
    ) else (
        if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![-] The consolidated file to convert was not found.!C_RESET!
        if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![-] No se encontró el archivo consolidado para convertir.!C_RESET!
    )
)
:HV_SKIP_QEMU_CONS
pause
goto HV_MENU_SHOW

:: =====================================================
:: HYPER-V - SUBRUTINAS DE COPIA
:: =====================================================

:HV_COPY_DISK_ITEM
:: %1 = index number
:: Copia vía :ACQUIRE (robocopy modo archivo-unico): CTRL+C cancelable con
:: dialogo de confirmación. Los .vhdx pueden ser enormes; copy /B no era
:: interrumpible de forma segura.
if defined hv_copy_abort exit /b
set "hv_copy_src=!HV_DISK_%1!"
if not exist "!hv_copy_src!" (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] File not found: !hv_copy_src!!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Archivo no encontrado: !hv_copy_src!!C_RESET!
    call :LOG_EVENT "Error: Archivo de disco no encontrado: !hv_copy_src!"
    set /a hv_copy_fail+=1
    exit /b
)
if /i "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Copying: !hv_copy_src!!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Copiando: !hv_copy_src!!C_RESET!
for %%F in ("!hv_copy_src!") do (
    set "_hvc_dir=%%~dpF"
    set "_hvc_file=%%~nxF"
)
if "!_hvc_dir:~-1!"=="\" set "_hvc_dir=!_hvc_dir:~0,-1!"
call :NEWGUID ACQ_GUID
set "ACQ_CMD=!TEMP!\forensic_cmd_!ACQ_GUID!.tmp"
:: Robocopy 0-7 = exito; se mapea a 0/1 dentro del comando para el wrapper.
>"!ACQ_CMD!" echo robocopy "!_hvc_dir!" "!HV_EVIDENCE!\Disks" "!_hvc_file!" !RBC_J! /R:1 /W:1 /NJH /NJS /NDL /NC /NS ^& if errorlevel 8 (exit 1) else (exit 0)
set "ACQ_TOOL_VER=robocopy in-box de !WIN_NAME! build !WIN_BUILD! - no publica version propia: su identidad es la build del SO"
call :ACQUIRE "HyperV_CopiaDisco - !_hvc_file!" "!ACQ_CMD!"
set "_hvc_el=!errorlevel!"
if "!_hvc_el!"=="2" (
    set "hv_copy_abort=1"
    exit /b
)
if "!_hvc_el!"=="0" (
    set /a hv_copy_done+=1
    call :LOG_EVENT "Disco copiado: !hv_copy_src!"
) else (
    set /a hv_copy_fail+=1
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Error copying: !hv_copy_src!!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Error al copiar: !hv_copy_src!!C_RESET!
    call :LOG_EVENT "Error: Fallo al copiar disco: !hv_copy_src!"
)
exit /b

:: =====================================================
:: HYPER-V - CLONAR VM COMPLETA
:: Copia la carpeta COMPLETA de la máquina (Virtual Machines\ config +
:: Virtual Hard Disks\ + Snapshots\ con la cadena diferencial) intacta,
:: sin consolidar nada - igual que la opción equivalente de VMware/
:: VirtualBox. Permite importarla en Hyper-V Manager (Import-VM) y
:: restaurar cualquier checkpoint desde su propio administrador.
:: =====================================================
:HV_CLONE_FULL
:: Tanto el clon como la preservacion parcial por ubicaciones son copias.
if not defined HAS_ROBOCOPY call :ROBOCOPY_MISSING "Hyper-V - clon completo de la VM"
if not defined HAS_ROBOCOPY goto HV_MENU_SHOW
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Clone Full VM to Import in Hyper-V!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Clonar VM Completa para Importar en Hyper-V!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Copies the COMPLETE VM folder ^(config + disks + checkpoints!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Copia la carpeta COMPLETA de la VM ^(config + discos + checkpoints!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] without consolidating^) to import it in Hyper-V Manager and restore!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] sin consolidar^) para importarla en Hyper-V Manager y restaurar!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] any original checkpoint from its own manager.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] cualquier checkpoint original desde su propio administrador.!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] A copied disk ^(Disk Acquisition option^) is NOT valid for this:!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] Un disco copiado ^(opción Adquisición de Discos^) NO sirve para esto:!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] does not include the configuration nor the checkpoint chain. That is why here!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] no incluye la configuración ni la cadena de checkpoints. Por eso aquí!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] the whole VM is exported with Export-VM, which resolves every location.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] se exporta la VM completa con Export-VM, que resuelve todas las ubicaciones.!C_RESET!
echo.

call :HV_ENUM_VMS
if !HV_COUNT! equ 0 (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![-] No virtual machines were found in Hyper-V.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![-] No se encontraron máquinas virtuales en Hyper-V.!C_RESET!
    pause
    goto HV_MENU_SHOW
)
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT!Hyper-V Virtual Machines detected:!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT!Máquinas Virtuales Hyper-V detectadas:!C_RESET!
for /L %%i in (1,1,!HV_COUNT!) do echo  !C_OK!%%i. !HV_NAME_%%i! ^(!HV_STATE_%%i!^)!C_RESET!
for /L %%i in (1,1,!HV_COUNT!) do if "!HV_FLAG_%%i!"=="BANG" if /i "!FORENSIC_LANG!"=="EN" echo     !C_ERR![-] %%i: name with an exclamation mark, NOT selectable!C_RESET!
for /L %%i in (1,1,!HV_COUNT!) do if "!HV_FLAG_%%i!"=="BANG" if /i not "!FORENSIC_LANG!"=="EN" echo     !C_ERR![-] %%i: nombre con signo de exclamacion, NO seleccionable!C_RESET!
echo.
:HVC_PROMPT_SEL
set "hvc_sel="
if /i "!FORENSIC_LANG!"=="EN" set /p hvc_sel="!C_PROMPT!Select the VM [1-!hv_count!, 0=cancel]: !C_RESET!"
if /i not "!FORENSIC_LANG!"=="EN" set /p hvc_sel="!C_PROMPT!Seleccione la VM [1-!hv_count!, 0=cancelar]: !C_RESET!"
if "!hvc_sel!"=="0" goto HV_MENU_SHOW
if not defined hvc_sel goto HVC_PROMPT_SEL
for /f "delims=0123456789" %%a in ("!hvc_sel!") do (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Please enter a valid number.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Por favor, ingrese un número válido.!C_RESET!
    goto HVC_PROMPT_SEL
)
if !hvc_sel! lss 1 goto HVC_PROMPT_SEL
if !hvc_sel! gtr !HV_COUNT! goto HVC_PROMPT_SEL
call :NORM_SEL hvc_sel
set "HVC_VMNAME=!HV_NAME_%hvc_sel%!"
if not defined HVC_VMNAME goto HVC_PROMPT_SEL
if "!HV_FLAG_%hvc_sel%!"=="BANG" goto HV_SEL_BANG
:: Escapado para PowerShell (comilla simple duplicada) - ver nota en HV_HANDLE_VM_RUNNING.
set "HVC_VMNAME_PS=!HVC_VMNAME:'=''!"

call :HV_HANDLE_VM_RUNNING "!HVC_VMNAME!"
if "!HVR_ABORT!"=="1" goto HV_MENU_SHOW

set "HVC_VMFOLDER="
for /f "usebackq delims=" %%P in (`powershell -NoProfile -Command "(Hyper-V\Get-VM -Name '!HVC_VMNAME_PS!' -ErrorAction SilentlyContinue).Path"`) do set "HVC_VMFOLDER=%%P"
if not defined HVC_VMFOLDER (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Could not locate the VM folder.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] No se pudo localizar la carpeta de la VM.!C_RESET!
    pause
    goto HV_MENU_SHOW
)
if "!HVC_VMFOLDER:~-1!"=="\" set "HVC_VMFOLDER=!HVC_VMFOLDER:~0,-1!"

:: Nombre de carpeta ya saneado por :HV_ENUM_VMS. El saneado local solo quitaba
:: / : \ - ni ? ni * ni la comilla doble ni los puntos finales-, con lo que una VM
:: llamada 'Ana? "prod"' hacia fallar el mkdir.
set "HVC_FOLDER=!HV_SAFE_%hvc_sel%!"
if not defined HVC_FOLDER set "HVC_FOLDER=VM_HyperV"

echo.
:ASK_HVC_DEST
set "hvc_dest="
if /i "!FORENSIC_LANG!"=="EN" set /p hvc_dest="!C_PROMPT!Destination folder path [Enter = !DEFAULT_DEST!] (0=cancel): !C_RESET!"
if /i not "!FORENSIC_LANG!"=="EN" set /p hvc_dest="!C_PROMPT!Ruta de la carpeta destino [Enter = !DEFAULT_DEST!] (0=cancelar): !C_RESET!"
if "!hvc_dest!"=="0" goto HV_MENU_SHOW
if defined hvc_dest set "hvc_dest=!hvc_dest:"=!"
if not defined hvc_dest (
    set "hvc_dest=!DEFAULT_DEST!"
    if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Using default destination: !DEFAULT_DEST!!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Usando destino por defecto: !DEFAULT_DEST!!C_RESET!
)
call :HV_CHECK_BANG_PATH hvc_dest
if "!HV_BANG_PATH!"=="1" (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] The destination path contains an exclamation mark; cmd.exe cannot carry it!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] La ruta de destino contiene un signo de exclamacion; cmd.exe no lo puede!C_RESET!
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] reliably. Use a path without that character.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] transportar con fiabilidad. Use una ruta sin ese caracter.!C_RESET!
    call :LOG_EVENT "RECHAZADO: la ruta de destino del clon completo Hyper-V contiene un signo de exclamacion."
    goto ASK_HVC_DEST
)
call :VALIDATE_DEST_DIR "!hvc_dest!"
if not "!_VD_OK!"=="1" goto ASK_HVC_DEST

:: Marca de tiempo UTC en la carpeta: Export-VM se niega a escribir sobre una
:: exportacion previa de la misma VM, y sin la marca una segunda actuacion sobre
:: el mismo destino fallaba o mezclaba dos capturas en la misma carpeta.
call :UTCNOW HVC_ACQ_TS COMPACT
set "HVC_EVIDENCE=!hvc_dest!\HyperV\!HVC_FOLDER!\Clon_Completo_HyperV_!HVC_ACQ_TS!"
set "DEST=!HVC_EVIDENCE!"
if not exist "!HVC_EVIDENCE!" mkdir "!HVC_EVIDENCE!"

echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Hashing original files before copying ^(integrity verification^)...!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Hasheando archivos originales antes de copiar ^(verificación de integridad^)...!C_RESET!
call :LOG_EVENT "Clon completo Hyper-V iniciado: VM=!HVC_VMNAME! carpeta=!HVC_VMFOLDER!"
call :HASH_EVIDENCE FOLDER "!HVC_VMFOLDER!" "*.vhdx,*.vhd,*.avhdx,*.vmcx,*.vmrs,*.xml,*.bin,*.vsv" "!HVC_EVIDENCE!\hashes_originales_PREcopia.sha256" "HyperV_Original_PreCopia_ClonCompleto"

echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Copying complete VM ^(config + disks + checkpoints^)...!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Copiando VM completa ^(config + discos + checkpoints^)...!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] This may take a while depending on the VM size.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] Esto puede tardar según el tamaño de la VM.!C_RESET!
:: Export-VM es el mecanismo OFICIAL de Hyper-V y resuelve EL SOLO todas las
:: ubicaciones. Lo anterior era "robocopy (Get-VM).Path /E", y con las rutas por
:: defecto del host eso: (a) podia copiar la configuracion SIN los discos, porque
:: los VHDX viven en VMHost.VirtualHardDiskPath, fuera de Path; (b) podia meter
:: las configuraciones de OTRAS VMs en la carpeta de evidencia de esta, porque el
:: raiz por defecto C:\ProgramData\Microsoft\Windows\Hyper-V lo comparten TODAS
:: las VMs del host; y (c) perdia los checkpoints alojados en un
:: SnapshotFileLocation distinto. Export-VM ademas admite exportacion en caliente.
call :NEWGUID ACQ_GUID
set "ACQ_CMD=!TEMP!\forensic_cmd_!ACQ_GUID!.tmp"
set "HVC_EVIDENCE_PS=!HVC_EVIDENCE:'=''!"
>"!ACQ_CMD!" echo powershell -NoProfile -Command "try { Import-Module Hyper-V -ErrorAction Stop; Hyper-V\Export-VM -Name '!HVC_VMNAME_PS!' -Path '!HVC_EVIDENCE_PS!' -ErrorAction Stop } catch { exit 1 }"
set "ACQ_TOOL_VER=Windows PowerShell !PS_VER! con el modulo Hyper-V in-box de !WIN_NAME! build !WIN_BUILD!"
call :ACQUIRE "HyperV_ExportVM" "!ACQ_CMD!"
set "_hvc2_el=!errorlevel!"
if "!_hvc2_el!"=="2" (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![ABORT] Export aborted by the user.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![ABORT] Exportacion abortada por el usuario.!C_RESET!
    call :LOG_EVENT "Clon completo Hyper-V abortado por el usuario (CTRL+C) durante Export-VM."
    pause
    goto HV_MENU_SHOW
)
if not "!_hvc2_el!"=="0" goto HVC_EXPORT_FAILED

:: Export-VM crea una subcarpeta con el nombre de la VM dentro del destino.
set "HVC_EXPORT_ROOT="
for /d %%D in ("!HVC_EVIDENCE!\*") do if not defined HVC_EXPORT_ROOT set "HVC_EXPORT_ROOT=%%D"
if not defined HVC_EXPORT_ROOT (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Export-VM reported success but no exported folder was found.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Export-VM dijo que fue bien pero no se encontró ninguna carpeta exportada.!C_RESET!
    call :LOG_EVENT "Error: Export-VM salio 0 pero no se localizo la carpeta exportada en !HVC_EVIDENCE!."
    pause
    goto HV_MENU_SHOW
)
if /i "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Complete VM exported to: !HVC_EXPORT_ROOT!!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_OK![+] VM completa exportada a: !HVC_EXPORT_ROOT!!C_RESET!
call :LOG_EVENT "Clon completo Hyper-V finalizado via Export-VM: !HVC_EXPORT_ROOT!"
set "HVC_IMPORT_HINT=!HVC_EXPORT_ROOT!\Virtual Machines"
call :HASH_EVIDENCE FOLDER "!HVC_EVIDENCE!" "*.vhdx,*.vhd,*.vhds,*.avhdx,*.avhd,*.vmcx,*.vmrs,*.vmgs,*.xml,*.bin,*.vsv" "!HVC_EVIDENCE!\hashes_copia_POSTcopia.sha256" "HyperV_Copia_ClonCompleto"
goto HVC_AFTER_COPY

:HVC_EXPORT_FAILED
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Export-VM FAILED. No importable export was produced.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Export-VM FALLO. No se produjo ninguna exportacion importable.!C_RESET!
call :LOG_EVENT "Error: Export-VM fallo para !HVC_VMNAME! (codigo !_hvc2_el!). Se ofrece preservacion parcial por ubicaciones."
:: Enumeracion de la UNION de ubicaciones de la VM, marcando las que comparte con
:: otras VMs. Una carpeta COMPARTIDA no se copia en bloque nunca: eso es lo que
:: metia configuraciones ajenas en la carpeta de evidencia de esta VM.
call :NEWGUID HVC_LOC_GUID
set "HVC_LOC_PS=!TEMP!\forensic_!HVC_LOC_GUID!.ps1"
> "!HVC_LOC_PS!" echo Import-Module Hyper-V -ErrorAction Stop
>> "!HVC_LOC_PS!" echo $vmName = '!HVC_VMNAME_PS!'
>> "!HVC_LOC_PS!" echo try { $vm = Hyper-V\Get-VM -Name $vmName -ErrorAction Stop } catch { Write-Output 'LOCERR'; exit 1 }
>> "!HVC_LOC_PS!" echo $all = @(Hyper-V\Get-VM -ErrorAction SilentlyContinue)
>> "!HVC_LOC_PS!" echo $locs = @()
>> "!HVC_LOC_PS!" echo foreach ($p in @($vm.Path, $vm.ConfigurationLocation, $vm.SnapshotFileLocation, $vm.CheckpointFileLocation)) {
>> "!HVC_LOC_PS!" echo     if ($p) { $locs += $p }
>> "!HVC_LOC_PS!" echo }
>> "!HVC_LOC_PS!" echo if ($vm.SmartPagingFilePath) { $locs += $vm.SmartPagingFilePath }
>> "!HVC_LOC_PS!" echo foreach ($d in @(Hyper-V\Get-VMHardDiskDrive -VM $vm -ErrorAction SilentlyContinue)) {
>> "!HVC_LOC_PS!" echo     if (-not $d.Path) { continue }
>> "!HVC_LOC_PS!" echo     $cur = $d.Path
>> "!HVC_LOC_PS!" echo     $guard = 0
>> "!HVC_LOC_PS!" echo     while ($cur -and $guard -lt 128) {
>> "!HVC_LOC_PS!" echo         $guard++
>> "!HVC_LOC_PS!" echo         $locs += (Split-Path $cur -Parent)
>> "!HVC_LOC_PS!" echo         $info = $null
>> "!HVC_LOC_PS!" echo         try { $info = Hyper-V\Get-VHD -Path $cur -ErrorAction Stop } catch { break }
>> "!HVC_LOC_PS!" echo         if ($info.ParentPath) { $cur = $info.ParentPath } else { break }
>> "!HVC_LOC_PS!" echo     }
>> "!HVC_LOC_PS!" echo }
>> "!HVC_LOC_PS!" echo $clean = @()
>> "!HVC_LOC_PS!" echo foreach ($l in $locs) {
>> "!HVC_LOC_PS!" echo     if (-not $l) { continue }
>> "!HVC_LOC_PS!" echo     $t = $l.TrimEnd('\')
>> "!HVC_LOC_PS!" echo     if ($t -and -not ($clean -contains $t)) { $clean += $t }
>> "!HVC_LOC_PS!" echo }
>> "!HVC_LOC_PS!" echo foreach ($l in $clean) {
>> "!HVC_LOC_PS!" echo     if (-not (Test-Path -LiteralPath $l -PathType Container)) { continue }
>> "!HVC_LOC_PS!" echo     $shared = $false
>> "!HVC_LOC_PS!" echo     foreach ($o in $all) {
>> "!HVC_LOC_PS!" echo         if ($o.Id -eq $vm.Id) { continue }
>> "!HVC_LOC_PS!" echo         foreach ($op in @($o.Path, $o.ConfigurationLocation, $o.SnapshotFileLocation, $o.CheckpointFileLocation)) {
>> "!HVC_LOC_PS!" echo             if (-not $op) { continue }
>> "!HVC_LOC_PS!" echo             $ot = $op.TrimEnd('\')
>> "!HVC_LOC_PS!" echo             if ($ot -eq $l) { $shared = $true }
>> "!HVC_LOC_PS!" echo             elseif ($ot.StartsWith($l + '\', 'OrdinalIgnoreCase')) { $shared = $true }
>> "!HVC_LOC_PS!" echo         }
>> "!HVC_LOC_PS!" echo     }
>> "!HVC_LOC_PS!" echo     if ($shared) { Write-Output "SHARED|$l" } else { Write-Output "OWN|$l" }
>> "!HVC_LOC_PS!" echo }
>> "!HVC_LOC_PS!" echo(
set "hvc_own_count=0"
set "hvc_shared_count=0"
for /f "usebackq tokens=1,* delims=|" %%A in (`powershell -NoProfile -ExecutionPolicy Bypass -File "!HVC_LOC_PS!"`) do (
    if "%%A"=="OWN" (
        set /a hvc_own_count+=1
        set "HVC_OWN_!hvc_own_count!=%%B"
    ) else if "%%A"=="SHARED" (
        set /a hvc_shared_count+=1
        set "HVC_SHARED_!hvc_shared_count!=%%B"
    )
)
del "!HVC_LOC_PS!" >nul 2>&1
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Locations of this VM found on the host:!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Ubicaciones de esta VM encontradas en el host:!C_RESET!
set "_hvc_own_lbl=propia"
set "_hvc_sh_lbl=COMPARTIDA con otras VMs"
if /i "!FORENSIC_LANG!"=="EN" set "_hvc_own_lbl=own"
if /i "!FORENSIC_LANG!"=="EN" set "_hvc_sh_lbl=SHARED with other VMs"
for /L %%i in (1,1,!hvc_own_count!) do echo     !C_OK!- ^(!_hvc_own_lbl!^) !HVC_OWN_%%i!!C_RESET!
for /L %%i in (1,1,!hvc_shared_count!) do echo     !C_WARN!- ^(!_hvc_sh_lbl!^) !HVC_SHARED_%%i!!C_RESET!
if !hvc_shared_count! gtr 0 (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] The shared folders are NOT copied in bulk: doing so would put other VMs!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] Las carpetas compartidas NO se copian en bloque: hacerlo meteria!C_RESET!
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN!    configurations inside this VM evidence folder ^(cross contamination^).!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN!    configuraciones de otras VMs en esta carpeta de evidencia ^(contaminacion cruzada^).!C_RESET!
    call :LOG_EVENT "Preservacion parcial: !hvc_shared_count! ubicacion/es de !HVC_VMNAME! son compartidas con otras VMs y NO se copian en bloque."
)
if !hvc_own_count! equ 0 (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] No exclusive location to preserve. Export the VM manually with Export-VM.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] No hay ninguna ubicacion exclusiva que preservar. Exporte la VM a mano con Export-VM.!C_RESET!
    call :LOG_EVENT "Preservacion parcial no realizada para !HVC_VMNAME!: no hay ubicaciones exclusivas."
    pause
    goto HV_MENU_SHOW
)
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] What follows is a PARTIAL PRESERVATION by locations, NOT an importable export.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] Lo siguiente es una PRESERVACION PARCIAL por ubicaciones, NO una exportacion importable.!C_RESET!
set "hvc_fb="
if /i "!FORENSIC_LANG!"=="EN" set /p hvc_fb="!C_PROMPT!Preserve the exclusive locations anyway? [Y/N]: !C_RESET!"
if /i not "!FORENSIC_LANG!"=="EN" set /p hvc_fb="!C_PROMPT!¿Preservar de todos modos las ubicaciones exclusivas? [S/N]: !C_RESET!"
if /i "!hvc_fb!"=="Y" set "hvc_fb=S"
if /I not "!hvc_fb!"=="S" (
    call :LOG_EVENT "El operador declina la preservacion parcial por ubicaciones de !HVC_VMNAME!."
    pause
    goto HV_MENU_SHOW
)
set "hvc_fb_done=0"
set "hvc_fb_fail=0"
set "hvc_fb_abort="
for /L %%i in (1,1,!hvc_own_count!) do call :HVC_FALLBACK_COPY %%i
if defined hvc_fb_abort (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![ABORT] Partial preservation aborted by the user.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![ABORT] Preservacion parcial abortada por el usuario.!C_RESET!
    call :LOG_EVENT "Preservacion parcial de !HVC_VMNAME! abortada por el usuario (CTRL+C)."
    pause
    goto HV_MENU_SHOW
)
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Locations preserved: !hvc_fb_done! of !hvc_own_count! ^(!hvc_fb_fail! failed^).!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Ubicaciones preservadas: !hvc_fb_done! de !hvc_own_count! ^(!hvc_fb_fail! con error^).!C_RESET!
call :LOG_EVENT "Preservacion parcial de !HVC_VMNAME!: !hvc_fb_done! de !hvc_own_count! ubicaciones exclusivas copiadas, !hvc_fb_fail! con error. NO es una exportacion importable."
set "HVC_IMPORT_HINT="
call :HASH_EVIDENCE FOLDER "!HVC_EVIDENCE!" "*.vhdx,*.vhd,*.vhds,*.avhdx,*.avhd,*.vmcx,*.vmrs,*.vmgs,*.xml,*.bin,*.vsv" "!HVC_EVIDENCE!\hashes_copia_POSTcopia.sha256" "HyperV_Copia_ClonCompleto_PARCIAL" PARCIAL

:HVC_AFTER_COPY

:: El "despues" se tomaba sobre la COPIA y el ORIGEN no se volvia a hashear nunca,
:: mientras la pantalla afirmaba "hash verificado antes y despues de la copia". Se
:: re-hashea el ORIGEN al terminar en un tercer archivo: es lo unico que permite
:: sostener despues que la configuracion y los discos originales no cambiaron.
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Re-hashing the ORIGIN after the copy (PRE/POST of the source)...!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Re-hasheando el ORIGEN después de la copia (PRE/POST del origen)...!C_RESET!
call :HASH_EVIDENCE FOLDER "!HVC_VMFOLDER!" "*.vhdx,*.vhd,*.vhds,*.avhdx,*.avhd,*.vmcx,*.vmrs,*.vmgs,*.xml,*.bin,*.vsv" "!HVC_EVIDENCE!\hashes_originales_POSTcopia.sha256" "HyperV_Original_PostCopia_ClonCompleto"
call :LOG_EVENT "Clon completo Hyper-V: se registraron TRES listas de hash - origen PRE-copia, copia POST-copia y origen POST-copia. El framework NO las compara automaticamente: la comparacion archivo por archivo la debe hacer el analista."
:: Alcance de las dos listas del ORIGEN: cubren la carpeta Path de la VM, no la
:: union de ubicaciones. Los discos alojados en VirtualHardDiskPath quedan fuera
:: de esas dos listas (si estan en la lista de la COPIA, que se toma sobre lo
:: exportado). Se dice, en vez de dejar que se lea como una cobertura total.
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] SCOPE of the two SOURCE lists: only the VM Path folder ^(!HVC_VMFOLDER!^).!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] ALCANCE de las dos listas del ORIGEN: solo la carpeta Path de la VM ^(!HVC_VMFOLDER!^).!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN!    Disks stored elsewhere are NOT in those two lists.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN!    Los discos alojados en otra ruta NO estan en esas dos listas.!C_RESET!
call :LOG_EVENT "Alcance declarado: las listas de hash del ORIGEN del clon completo cubren solo !HVC_VMFOLDER!, no la union de ubicaciones de la VM."

echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![FORENSIC NOTE] This clone is a WORKING COPY for interactive examination,!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![NOTA FORENSE] Este clon es una COPIA OPERATIVA para examen interactivo,!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT!not a read-only image. Three hash lists were recorded: SOURCE before!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT!no una imagen de solo lectura. Se registraron tres listas de hash:!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT!copying, COPY after copying and SOURCE after copying. Compare them!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT!ORIGEN antes de copiar, COPIA después y ORIGEN después. Compárelas!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT!file by file: the framework does NOT compare them automatically.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT!archivo por archivo: el framework NO las compara automáticamente.!C_RESET!
echo.
if defined HVC_IMPORT_HINT (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] To use it: import the copy in Hyper-V Manager with!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Para usarlo: importe la copia en Hyper-V Manager con!C_RESET!
    if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT!    Import-VM -Path "!HVC_IMPORT_HINT!\^<file^>.vmcx"!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT!    Import-VM -Path "!HVC_IMPORT_HINT!\^<archivo^>.vmcx"!C_RESET!
    if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT!    ^(or use "Import Virtual Machine..." in the graphical interface^) and from the!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT!    ^(o use "Import Virtual Machine..." en la interfaz gráfica^) y desde el!C_RESET!
    if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT!    Checkpoints panel restore the desired point.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT!    panel de Checkpoints restaure el punto deseado.!C_RESET!
)
:: Sin HVC_IMPORT_HINT no hubo Export-VM: lo que hay es una preservacion por
:: ubicaciones y NO se debe sugerir Import-VM sobre ella como si funcionara.
if not defined HVC_IMPORT_HINT (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] This is NOT an importable export: Export-VM failed and only the exclusive!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] Esto NO es una exportacion importable: Export-VM fallo y solo se preservaron!C_RESET!
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN!    locations were preserved. Import-VM is NOT expected to work on it.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN!    las ubicaciones exclusivas. NO se espera que Import-VM funcione sobre esto.!C_RESET!
    if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] To obtain an importable copy, run Export-VM manually once the cause is fixed.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Para obtener una copia importable, ejecute Export-VM a mano al resolver la causa.!C_RESET!
)
echo.
pause
goto HV_MENU_SHOW

:: -----------------------------------------------------------------------
:: HVC_FALLBACK_COPY
:: %1 = indice de una ubicacion EXCLUSIVA de la VM. Copia esa carpeta a una
:: subcarpeta propia dentro de la evidencia, via :ACQUIRE (CTRL+C cancelable) y
:: con /R:1 /W:1 para que un archivo bloqueado no cuelgue la ejecucion durante
:: dias con los reintentos por defecto de robocopy.
:: -----------------------------------------------------------------------
:HVC_FALLBACK_COPY
if defined hvc_fb_abort exit /b
set "_hfb_src=!HVC_OWN_%1!"
if not exist "!_hfb_src!" (
    set /a hvc_fb_fail+=1
    call :LOG_EVENT "Preservacion parcial: la ubicacion !_hfb_src! ya no existe."
    exit /b
)
for %%F in ("!_hfb_src!") do set "_hfb_leaf=%%~nxF"
if not defined _hfb_leaf set "_hfb_leaf=Ubicacion_%1"
set "_hfb_dst=!HVC_EVIDENCE!\Preservacion_Parcial\%1_!_hfb_leaf!"
if not exist "!_hfb_dst!" mkdir "!_hfb_dst!"
call :NEWGUID ACQ_GUID
set "ACQ_CMD=!TEMP!\forensic_cmd_!ACQ_GUID!.tmp"
>"!ACQ_CMD!" echo robocopy "!_hfb_src!" "!_hfb_dst!" /E /COPY:DAT /R:1 /W:1 /NFL /NDL ^& if errorlevel 8 (exit 1) else (exit 0)
set "ACQ_TOOL_VER=robocopy in-box de !WIN_NAME! build !WIN_BUILD! - no publica version propia: su identidad es la build del SO"
call :ACQUIRE "HyperV_PreservacionParcial - !_hfb_leaf!" "!ACQ_CMD!"
set "_hfb_el=!errorlevel!"
if "!_hfb_el!"=="2" (
    set "hvc_fb_abort=1"
    exit /b
)
if "!_hfb_el!"=="0" (
    set /a hvc_fb_done+=1
    call :LOG_EVENT "Preservacion parcial: ubicacion copiada !_hfb_src! -> !_hfb_dst!"
) else (
    set /a hvc_fb_fail+=1
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Error preserving: !_hfb_src!!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Error al preservar: !_hfb_src!!C_RESET!
    call :LOG_EVENT "Error: fallo al preservar la ubicacion !_hfb_src!"
)
exit /b

:: =====================================================
:: MÓDULO DOCKER - ADQUISICIÓN FORENSE
:: =====================================================

:MENU_DOCKER
set "HE_MODO="
cls
if /i "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Verifying Docker availability...!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Verificando disponibilidad de Docker...!C_RESET!
:: docker versión ya contacta el daemon (falla si no responde); una sola llamada.
docker version >nul 2>&1
if !errorlevel! neq 0 goto DK_NO_DOCKER
goto DK_MENU_SHOW

:DK_NO_DOCKER
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Docker is not available or the engine is not responding.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Docker no esta disponible o el motor no responde.!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Verify that Docker Desktop is installed and the service active.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Verifique que Docker Desktop este instalado y el servicio activo.!C_RESET!
call :LOG_EVENT "Error: Docker no disponible."
pause
goto MENU_PRINCIPAL

:DK_MENU_SHOW
:: Aqui vuelven TODAS las operaciones del modulo (19 saltos), no a
:: :MENU_DOCKER. Sin limpiar aqui, la eleccion de hash de una adquisicion
:: se reutilizaba en la siguiente y el operador ya no podia elegir.
set "HE_MODO="
cls
echo !C_BORDER!!LINE!!C_RESET!
call :HDR TITLE "DOCKER - FORENSIC ACQUISITION" "DOCKER - ADQUISICIÓN FORENSE"
echo !C_BORDER!!LINE!!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT!1. List Containers
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT!1. Enumerar Contenedores
if /i "!FORENSIC_LANG!"=="EN" echo 2. Acquire Container Filesystem
if /i not "!FORENSIC_LANG!"=="EN" echo 2. Adquirir Filesystem del Contenedor
if /i "!FORENSIC_LANG!"=="EN" echo 3. Acquire Container Volumes
if /i not "!FORENSIC_LANG!"=="EN" echo 3. Adquirir Volúmenes del Contenedor
if /i "!FORENSIC_LANG!"=="EN" echo 4. Logical Acquisition - Files/Folders
if /i not "!FORENSIC_LANG!"=="EN" echo 4. Adquisición Lógica - Archivos/Carpetas
if /i "!FORENSIC_LANG!"=="EN" echo 0. Back!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo 0. Volver!C_RESET!
echo !C_BORDER!!LINE!!C_RESET!
set "dk_opt="
if /i "!FORENSIC_LANG!"=="EN" set /p dk_opt="!C_PROMPT!Select an option: !C_RESET!"
if /i not "!FORENSIC_LANG!"=="EN" set /p dk_opt="!C_PROMPT!Selecciona una opción: !C_RESET!"

for /f "delims=0123456789" %%a in ("!dk_opt!") do (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Invalid option.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Opción inválida.!C_RESET!
    call :WAIT 2
    goto DK_MENU_SHOW
)

if "!dk_opt!"=="0" goto MENU_PRINCIPAL
if "!dk_opt!"=="1" goto DOCKER_ENUM
if "!dk_opt!"=="2" goto DOCKER_FS
if "!dk_opt!"=="3" goto DOCKER_VOLUMES
if "!dk_opt!"=="4" goto DOCKER_ARTIFACTS

if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Invalid option.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Opción inválida.!C_RESET!
call :WAIT 2
goto DK_MENU_SHOW

:: =====================================================
:: DOCKER - OPCIÓN 1: ENUMERAR CONTENEDORES
:: =====================================================
:DOCKER_ENUM
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Enumerating Docker Containers!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Enumerando Contenedores Docker!C_RESET!
echo.
docker ps -a --format "table {{.ID}}\t{{.Names}}\t{{.Image}}\t{{.Status}}"
echo.
call :LOG_EVENT "Docker: Contenedores enumerados."
pause
goto DK_MENU_SHOW

:: =====================================================
:: DOCKER - SUBRUTINA: SELECCIONAR CONTENEDOR
:: =====================================================
:DK_SELECT_CONTAINER
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Enumerating containers...!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Enumerando contenedores...!C_RESET!
echo.

set "dk_count=0"
for /f "tokens=1,2 delims=|" %%A in ('docker ps -a --format "{{.ID}}|{{.Names}}" 2^>nul') do (
    set /a dk_count+=1
    set "DK_ID_!dk_count!=%%A"
    set "DK_NAME_!dk_count!=%%B"
)

if !dk_count! equ 0 (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![-] No containers were found.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![-] No se encontraron contenedores.!C_RESET!
    set "DK_SEL_ID="
    exit /b 1
)

if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT!Docker containers:!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT!Contenedores Docker:!C_RESET!
for /L %%i in (1,1,!dk_count!) do echo  !C_OK!%%i. !DK_NAME_%%i! [!DK_ID_%%i!]!C_RESET!
echo.

:DK_SEL_PROMPT
set "dk_sel="
if /i "!FORENSIC_LANG!"=="EN" set /p dk_sel="!C_PROMPT!Select the container [1-!dk_count!, 0=cancel]: !C_RESET!"
if /i not "!FORENSIC_LANG!"=="EN" set /p dk_sel="!C_PROMPT!Seleccione el contenedor [1-!dk_count!, 0=cancelar]: !C_RESET!"
if "!dk_sel!"=="0" (
    set "DK_SEL_ID="
    exit /b 1
)
for /f "delims=0123456789" %%a in ("!dk_sel!") do (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Enter a valid number.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Ingrese un número válido.!C_RESET!
    goto DK_SEL_PROMPT
)
if !dk_sel! lss 1 goto DK_SEL_PROMPT
if !dk_sel! gtr !dk_count! goto DK_SEL_PROMPT

call :NORM_SEL dk_sel
set "DK_SEL_ID=!DK_ID_%dk_sel%!"
set "DK_SEL_NAME=!DK_NAME_%dk_sel%!"
call :LOG_CTX "DOCKER" "!DK_SEL_NAME!" "!DK_SEL_ID!"
if not defined DK_SEL_ID goto DK_SEL_PROMPT

:: Sanitizar nombre para carpeta
:: Se cubren tambien * ? y la comilla, que la lista anterior dejaba pasar.
set "_sn_in=!DK_SEL_NAME:"=_!"
call :SANITIZE_NAME_IN
set "DK_FOLDER=!_SN_OUT!"
exit /b 0

:: =====================================================
:: DOCKER - OPCIÓN 2: ADQUIRIR FILESYSTEM
:: =====================================================
:DOCKER_FS
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Acquire Container Filesystem (docker export)!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Adquirir Filesystem del Contenedor (docker export)!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] docker export does NOT include mounted volumes, only the internal filesystem.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] docker export NO incluye volúmenes montados, solo el filesystem interno.!C_RESET!

call :DK_SELECT_CONTAINER
if not defined DK_SEL_ID goto DK_MENU_SHOW

:ASK_DK_FS_DEST
set "dk_fs_dest="
if /i "!FORENSIC_LANG!"=="EN" set /p dk_fs_dest="!C_PROMPT!Destination folder path [Enter = !DEFAULT_DEST!] (0=cancel): !C_RESET!"
if /i not "!FORENSIC_LANG!"=="EN" set /p dk_fs_dest="!C_PROMPT!Ruta de la carpeta destino [Enter = !DEFAULT_DEST!] (0=cancelar): !C_RESET!"
if "!dk_fs_dest!"=="0" goto DK_MENU_SHOW
if defined dk_fs_dest set "dk_fs_dest=!dk_fs_dest:"=!"
if not defined dk_fs_dest (
    set "dk_fs_dest=!DEFAULT_DEST!"
    if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Using default destination: !DEFAULT_DEST!!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Usando destino por defecto: !DEFAULT_DEST!!C_RESET!
)
call :VALIDATE_DEST_DIR "!dk_fs_dest!"
if not "!_VD_OK!"=="1" goto ASK_DK_FS_DEST

set "DK_EVIDENCE=!dk_fs_dest!\Docker\!DK_FOLDER!"
set "DEST=!DK_EVIDENCE!"
if not exist "!DK_EVIDENCE!\ContainerExport" mkdir "!DK_EVIDENCE!\ContainerExport"

set "dk_tar_path=!DK_EVIDENCE!\ContainerExport\!DK_FOLDER!_filesystem.tar"

echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Exporting filesystem of !DK_SEL_NAME!...!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Exportando filesystem de !DK_SEL_NAME!...!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] This may take a while depending on the container size.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Esto puede tardar dependiendo del tamaño del contenedor.!C_RESET!

:: El estado del contenedor en el instante del export es dato de cadena de custodia:
:: un export en marcha produce un tar temporalmente INCONSISTENTE, la misma clase de
:: imagen difuminada que el modulo VMware documenta con detalle y que aqui no se
:: mencionaba. La consulta ya existia en el modulo de artefactos y no se usaba aqui.
set "_dkfs_run="
for /f "usebackq delims=" %%R in (`docker inspect --format "{{.State.Running}}" "!DK_SEL_ID!" 2^>nul`) do set "_dkfs_run=%%R"
if not defined _dkfs_run set "_dkfs_run=desconocido"
:: 'docker inspect' completo es el artefacto de metadata mas valioso del modulo
:: (imagen base y su digest, Created, Cmd, Entrypoint, Env, montajes, red) y solo se
:: consultaba para leer volumenes. Se PRESERVA junto a la evidencia.
docker inspect "!DK_SEL_ID!" > "!DK_EVIDENCE!\ContainerExport\docker_inspect.json" 2>&1
call :LOG_EVENT "Docker export iniciado: !DK_SEL_NAME! (!DK_SEL_ID!) con State.Running=!_dkfs_run! en el instante del export. Metadata completa preservada en docker_inspect.json. LIMITACION DEL METODO: toda la adquisicion pasa por el demonio Docker del propio host analizado, cuya integridad es una dependencia del metodo."
if /I not "!_dkfs_run!"=="true" goto DKFS_STATE_DONE
:: El aviso de 3 lineas salia por pantalla en cada export. Queda solo en el
:: diario (LOG_EVENT de abajo), que es lo que acompana a la evidencia.
call :LOG_EVENT "ADVERTENCIA: 'docker export' sobre un contenedor EN EJECUCION produce un tar de un filesystem que muta durante la escritura: NO es point-in-time. Tampoco incluye procesos, tmpfs ni archivos borrados con descriptor abierto. La limitacion se declara, no se maquilla."
:DKFS_STATE_DONE

call :NEWGUID ACQ_GUID
set "ACQ_CMD=!TEMP!\forensic_cmd_!ACQ_GUID!.tmp"
>"!ACQ_CMD!" echo docker export "!DK_SEL_ID!" -o "!dk_tar_path!"
call :ACQ_VER TOOLVER_DOCKER "!DOCKER_EXE!" "--version"
call :ACQUIRE "Docker_ExportFS" "!ACQ_CMD!"
set "_dk_el=!errorlevel!"
if "!_dk_el!"=="2" (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![ABORT] Export aborted by the user.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![ABORT] Exportación abortada por el usuario.!C_RESET!
    call :LOG_EVENT "Docker export abortado por el usuario (CTRL+C)."
    pause
    goto DK_MENU_SHOW
)
if !_dk_el! neq 0 (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Error exporting the container filesystem.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Error al exportar el filesystem del contenedor.!C_RESET!
    call :LOG_EVENT "Error: docker export fallo para !DK_SEL_NAME!"
    pause
    goto DK_MENU_SHOW
)

for %%F in ("!dk_tar_path!") do set "dk_tar_size=%%~zF"
if /i "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Filesystem exported successfully.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Filesystem exportado exitosamente.!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Size: !dk_tar_size! bytes!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Tamaño: !dk_tar_size! bytes!C_RESET!
call :LOG_EVENT "Docker export completado: !dk_tar_path! (!dk_tar_size! bytes)"

:: Verificación de integridad OPCIONAL (decisión del operador)
set "dk_hash_file=!DK_EVIDENCE!\hashes.txt"
call :HASH_EVIDENCE FILE "!dk_tar_path!" "" "!dk_hash_file!" "Docker_Filesystem"
if /i "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Filesystem acquisition completed.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Adquisición de filesystem completada.!C_RESET!
pause
goto DK_MENU_SHOW

:: =====================================================
:: DOCKER - OPCIÓN 3: ADQUIRIR VOLÚMENES
:: =====================================================
:DOCKER_VOLUMES
:: El contenido del volumen se preserva copiandolo desde el host.
if not defined HAS_ROBOCOPY call :ROBOCOPY_MISSING "Docker - adquisicion de volumenes del contenedor"
if not defined HAS_ROBOCOPY goto DK_MENU_SHOW
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Acquire Container Volumes!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Adquirir Volúmenes del Contenedor!C_RESET!

call :DK_SELECT_CONTAINER
if not defined DK_SEL_ID goto DK_MENU_SHOW

:ASK_DK_VOL_DEST
set "dk_vol_dest="
if /i "!FORENSIC_LANG!"=="EN" set /p dk_vol_dest="!C_PROMPT!Destination folder path [Enter = !DEFAULT_DEST!] (0=cancel): !C_RESET!"
if /i not "!FORENSIC_LANG!"=="EN" set /p dk_vol_dest="!C_PROMPT!Ruta de la carpeta destino [Enter = !DEFAULT_DEST!] (0=cancelar): !C_RESET!"
if "!dk_vol_dest!"=="0" goto DK_MENU_SHOW
if defined dk_vol_dest set "dk_vol_dest=!dk_vol_dest:"=!"
if not defined dk_vol_dest (
    set "dk_vol_dest=!DEFAULT_DEST!"
    if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Using default destination: !DEFAULT_DEST!!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Usando destino por defecto: !DEFAULT_DEST!!C_RESET!
)
call :VALIDATE_DEST_DIR "!dk_vol_dest!"
if not "!_VD_OK!"=="1" goto ASK_DK_VOL_DEST

set "DK_EVIDENCE=!dk_vol_dest!\Docker\!DK_FOLDER!"
set "DEST=!DK_EVIDENCE!"
set "dk_hash_file=!DK_EVIDENCE!\hashes.txt"
if not exist "!DK_EVIDENCE!\Volumes" mkdir "!DK_EVIDENCE!\Volumes"

call :LOG_EVENT "Docker volumenes: inspeccionando !DK_SEL_NAME! (!DK_SEL_ID!)"

:: Obtener mounts vía PowerShell para parseo seguro
call :NEWGUID DK_VOL_GUID
set "DK_VOL_PS=!TEMP!\forensic_!DK_VOL_GUID!.ps1"
> "!DK_VOL_PS!" echo $json = docker inspect "!DK_SEL_ID!" 2^>$null ^| ConvertFrom-Json
>> "!DK_VOL_PS!" echo $mounts = $json[0].Mounts
>> "!DK_VOL_PS!" echo if (-not $mounts -or $mounts.Count -eq 0) { Write-Output 'NO_VOLUMES'; exit }
>> "!DK_VOL_PS!" echo foreach ($m in $mounts) {
>> "!DK_VOL_PS!" echo     $name = if ($m.Name) { $m.Name } else { $m.Destination -replace '[/\\:]','_' }
>> "!DK_VOL_PS!" echo     Write-Output "$($name)|$($m.Source)|$($m.Destination)|$($m.Type)"
>> "!DK_VOL_PS!" echo }

echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Detecting mounted volumes...!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Detectando volúmenes montados...!C_RESET!

set "dk_vol_count=0"
set "dk_no_vols=0"
for /f "usebackq delims=" %%L in (`powershell -NoProfile -ExecutionPolicy Bypass -File "!DK_VOL_PS!"`) do (
    rem Comparacion directa, NO 'echo %%L^|findstr': la linea trae los '^|'
    rem separadores de campo (nombre^|origen^|destino^|tipo) y al pasarlos por echo^|
    rem cmd los interpretaba como pipes de comando -> errores "no se reconoce".
    if "%%L"=="NO_VOLUMES" (
        set "dk_no_vols=1"
    ) else (
        set /a dk_vol_count+=1
        set "DK_VOL_LINE_!dk_vol_count!=%%L"
    )
)
del "!DK_VOL_PS!" >nul 2>&1

if "!dk_no_vols!"=="1" (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![-] The container has no mounted volumes.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![-] El contenedor no tiene volúmenes montados.!C_RESET!
    call :LOG_EVENT "Docker volumenes: !DK_SEL_NAME! no tiene mounts."
    pause
    goto DK_MENU_SHOW
)
if !dk_vol_count! equ 0 (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![-] No volumes detected.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![-] No se detectaron volúmenes.!C_RESET!
    pause
    goto DK_MENU_SHOW
)

if /i "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Volumes detected: !dk_vol_count!!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Volúmenes detectados: !dk_vol_count!!C_RESET!
echo.

:: Copiar cada volumen (CTRL+C cancelable vía :ACQUIRE)
set "dk_vol_abort="
set "dk_vol_ok=0"
set "dk_vol_skip=0"
for /L %%i in (1,1,!dk_vol_count!) do call :DK_COPY_VOLUME %%i

if defined dk_vol_abort (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![ABORT] Volume copy aborted by the user. Returning to Docker menu.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![ABORT] Copia de volúmenes abortada por el usuario. Volviendo al menú Docker.!C_RESET!
    call :LOG_EVENT "Copia de volumenes Docker abortada por el usuario (CTRL+C)."
    pause
    goto DK_MENU_SHOW
)
:: Verificación de integridad OPCIONAL (decisión del operador)
call :HASH_EVIDENCE FOLDER "!DK_EVIDENCE!\Volumes" "*" "!dk_hash_file!" "Docker_Volumenes"
:: Mensaje HONESTO: no se afirma "completado" si algun volumen fallo. Se dice
:: cuantos se copiaron de cuantos, para que el perito no crea que capturo todo.
if "!dk_vol_skip!"=="0" (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Volume acquisition completed: !dk_vol_ok!/!dk_vol_count! copied.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Adquisición de volúmenes completada: !dk_vol_ok!/!dk_vol_count! copiados.!C_RESET!
) else (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![-] Volumes: !dk_vol_ok!/!dk_vol_count! copied, !dk_vol_skip! FAILED. Check the log.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![-] Volúmenes: !dk_vol_ok!/!dk_vol_count! copiados, !dk_vol_skip! FALLARON. Revise el log.!C_RESET!
)
call :LOG_EVENT "Docker volumenes: !dk_vol_ok! copiados, !dk_vol_skip! fallidos, de !dk_vol_count! detectados en !DK_SEL_NAME!."
pause
goto DK_MENU_SHOW

:: Subrutina: copiar un volumen
:DK_COPY_VOLUME
:: %1 = index
if defined dk_vol_abort exit /b
set "dk_vline=!DK_VOL_LINE_%1!"
for /f "tokens=1,2,3,4 delims=|" %%A in ("!dk_vline!") do (
    set "dk_v_name=%%A"
    set "dk_v_source=%%B"
    set "dk_v_dest=%%C"
    set "dk_v_type=%%D"
)
echo  !C_TEXT![%1] !dk_v_name! (!dk_v_type!)!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo      Source      : !dk_v_source!
if /i not "!FORENSIC_LANG!"=="EN" echo      Origen : !dk_v_source!
if /i "!FORENSIC_LANG!"=="EN" echo      Destination : !dk_v_dest!
if /i not "!FORENSIC_LANG!"=="EN" echo      Destino: !dk_v_dest!

:: Sanitizar nombre para carpeta con la rutina comun: el nombre puede salir del
:: punto de montaje del contenedor, y solo se cambiaban / y :.
set "_sn_in=!dk_v_name:"=_!"
call :SANITIZE_NAME_IN
set "dk_v_folder=!_SN_OUT!"

set "dk_v_out=!DK_EVIDENCE!\Volumes\!dk_v_folder!"
if not exist "!dk_v_out!" mkdir "!dk_v_out!"

call :NEWGUID ACQ_GUID
set "ACQ_CMD=!TEMP!\forensic_cmd_!ACQ_GUID!.tmp"
:: Dos vias segun el Source sea accesible desde el host:
::  - Bind mount (o volumen cuyo Source SI existe en el host): robocopy directo.
::  - Volumen CON NOMBRE en Docker Desktop: Source es una ruta dentro de la VM de
::    Docker (/var/lib/docker/volumes/.../_data), inaccesible desde Windows. Antes
::    se saltaba con "ruta no accesible" y el volumen NO se adquiria. Ahora se copia
::    el punto de montaje del contenedor a traves del demonio con 'docker cp', que
::    funciona sea cual sea la ubicacion fisica del volumen.
if not exist "!dk_v_source!" goto DK_VOL_VIA_DOCKERCP

if /i "!FORENSIC_LANG!"=="EN" echo  !C_TEXT!   Copying (host path)...!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo  !C_TEXT!   Copiando (ruta del host)...!C_RESET!
:: Vía :ACQUIRE: CTRL+C cancelable; robocopy 0-7 exito -> mapeado a 0/1.
>"!ACQ_CMD!" echo robocopy "!dk_v_source!" "!dk_v_out!" /E /COPY:DAT /R:1 /W:1 /NFL /NDL ^& if errorlevel 8 (exit 1) else (exit 0)
set "ACQ_TOOL_VER=robocopy in-box de !WIN_NAME! build !WIN_BUILD! - no publica version propia: su identidad es la build del SO"
set "_dkv_via=robocopy (ruta del host)"
goto DK_VOL_DO_ACQ

:DK_VOL_VIA_DOCKERCP
if /i "!FORENSIC_LANG!"=="EN" echo  !C_TEXT!   Host path not accessible ^(named volume^); copying via docker cp...!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo  !C_TEXT!   Ruta del host no accesible ^(volumen con nombre^); copiando via docker cp...!C_RESET!
:: 'docker cp <cont>:<punto_montaje>/. <destino>' copia el CONTENIDO del volumen
:: montado, a traves del demonio. El '/.' final significa "el contenido de", no la
:: carpeta en si. Se declara en la cadena de custodia que esta via pasa por el
:: demonio Docker del host, cuya integridad es una dependencia del metodo.
>"!ACQ_CMD!" echo docker cp "!DK_SEL_ID!:!dk_v_dest!/." "!dk_v_out!"
call :ACQ_VER TOOLVER_DOCKER "!DOCKER_EXE!" "--version"
set "ACQ_TOOL_VER=!TOOLVER_DOCKER!"
set "_dkv_via=docker cp (demonio Docker)"

:DK_VOL_DO_ACQ
call :ACQUIRE "Docker_CopiaVolumen - !dk_v_name!" "!ACQ_CMD!"
set "_dkv_el=!errorlevel!"
if "!_dkv_el!"=="2" (
    set "dk_vol_abort=1"
    exit /b
)
if "!_dkv_el!"=="0" (
    set /a dk_vol_ok+=1
    if /i "!FORENSIC_LANG!"=="EN" echo  !C_OK!   [+] Copied to: !dk_v_out!!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo  !C_OK!   [+] Copiado a: !dk_v_out!!C_RESET!
    call :LOG_EVENT "Volumen copiado (!_dkv_via!): !dk_v_name! -> !dk_v_out!"
) else (
    set /a dk_vol_skip+=1
    if /i "!FORENSIC_LANG!"=="EN" echo  !C_ERR!   [-] Error copying the volume: !dk_v_name!!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo  !C_ERR!   [-] Error al copiar el volumen: !dk_v_name!!C_RESET!
    call :LOG_EVENT "Error: Fallo al copiar volumen (!_dkv_via!): !dk_v_name!"
)
exit /b

:: =====================================================
:: DOCKER - OPCIÓN 4: EXTRACCIÓN DE ARTEFACTOS
:: =====================================================
:DOCKER_ARTIFACTS
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Logical Acquisition - Files/Folders!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Adquisición Lógica - Archivos/Carpetas!C_RESET!

call :DK_SELECT_CONTAINER
if not defined DK_SEL_ID goto DK_MENU_SHOW

:ASK_DK_ART_DEST
set "dk_art_dest="
if /i "!FORENSIC_LANG!"=="EN" set /p dk_art_dest="!C_PROMPT!Destination folder path [Enter = !DEFAULT_DEST!] (0=cancel): !C_RESET!"
if /i not "!FORENSIC_LANG!"=="EN" set /p dk_art_dest="!C_PROMPT!Ruta de la carpeta destino [Enter = !DEFAULT_DEST!] (0=cancelar): !C_RESET!"
if "!dk_art_dest!"=="0" goto DK_MENU_SHOW
if defined dk_art_dest set "dk_art_dest=!dk_art_dest:"=!"
if not defined dk_art_dest (
    set "dk_art_dest=!DEFAULT_DEST!"
    if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Using default destination: !DEFAULT_DEST!!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Usando destino por defecto: !DEFAULT_DEST!!C_RESET!
)
call :VALIDATE_DEST_DIR "!dk_art_dest!"
if not "!_VD_OK!"=="1" goto ASK_DK_ART_DEST

set "DK_EVIDENCE=!dk_art_dest!\Docker\!DK_FOLDER!"
set "DEST=!DK_EVIDENCE!"
if not exist "!DK_EVIDENCE!\Artifacts" mkdir "!DK_EVIDENCE!\Artifacts"
set "dk_hash_file=!DK_EVIDENCE!\hashes.txt"
call :LOG_EVENT "Docker artefactos: inicio para !DK_SEL_NAME! (!DK_SEL_ID!)"

set "dk_nav_path=/"

:: =====================================================
:: DOCKER - NAVEGADOR INTERACTIVO DEL FILESYSTEM
:: =====================================================
:DK_NAV_BROWSE
cls
echo !C_BORDER!!LINE!!C_RESET!
call :HDR TITLE "DOCKER BROWSER - !DK_SEL_NAME!" "NAVEGADOR DOCKER - !DK_SEL_NAME!"
echo !C_BORDER!!LINE!!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT!Current path: !dk_nav_path!!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT!Ruta actual: !dk_nav_path!!C_RESET!
echo.

:: Verificar conectividad ANTES de listar (bug real detectado en auditoría
:: dinamica): "docker exec ... 2^>nul" silencia stderr, así que un
:: contenedor detenido produce la MISMA salida vacia que una carpeta
:: realmente vacia - indistinguible para el operador. Riesgo de
:: COMPLETITUD (no de corrupcion): sin este chequeo, el operador podria
:: documentar un artefacto como "no existe" cuando en realidad el
:: contenedor se detuvo a mitad de la navegacion.
set "_dk_running="
for /f "usebackq delims=" %%R in (`docker inspect --format "{{.State.Running}}" "!DK_SEL_ID!" 2^>nul`) do set "_dk_running=%%R"
if not "!_dk_running!"=="true" (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Container "!DK_SEL_NAME!" is not accessible ^(stopped or deleted^).!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] El contenedor "!DK_SEL_NAME!" no esta accesible ^(detenido o eliminado^).!C_RESET!
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] This does NOT mean the current folder is empty: the connection was lost.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] Esto NO significa que la carpeta actual este vacia: se perdio la conexión.!C_RESET!
    echo.
    if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT!  R    Retry
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT!  R    Reintentar
    if /i "!FORENSIC_LANG!"=="EN" echo   0    Cancel and go back!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo   0    Cancelar y volver!C_RESET!
    set "_dk_conn_retry="
    set /p _dk_conn_retry="!C_PROMPT!> !C_RESET!"
    if /I "!_dk_conn_retry!"=="R" goto DK_NAV_BROWSE
    goto DK_ART_FINISH
)

:: La navegacion se hace con "docker exec": eso EJECUTA procesos nuevos DENTRO del
:: contenedor de evidencia. Es una intrusion sobre la fuente -proceso nuevo, posible
:: escritura en la capa superior, cambio de tiempos de acceso- y no quedaba constancia
:: de ella en ninguna parte. Se declara UNA vez por contenedor y despues se anota cada
:: ruta enumerada: registrar cada pulsacion inundaria el diario, y no registrar nada
:: deja sin rastro una alteracion real de la fuente (ISO/IEC 27037, minimizacion de la
:: huella: lo que no se puede evitar se documenta).
if not "!DK_EXEC_DECLARED!"=="!DK_SEL_ID!" call :LOG_EVENT "ALTERACION DE LA FUENTE, declarada: la navegacion del contenedor !DK_SEL_NAME! (!DK_SEL_ID!) se realiza con 'docker exec' (ls y test, sin shell intermedio), que EJECUTA procesos nuevos DENTRO del contenedor en ejecucion. Crea procesos, puede escribir en la capa superior de escritura y modifica tiempos de acceso. Es inevitable para navegar un contenedor vivo y se documenta: NO es una lectura pasiva."
if not "!DK_EXEC_DECLARED!"=="!DK_SEL_ID!" set "DK_EXEC_DECLARED=!DK_SEL_ID!"
call :LOG_EVENT "docker exec sobre !DK_SEL_ID!: enumeracion de !dk_nav_path! con 'ls -1pL' para la navegacion."
if /i "!FORENSIC_LANG!"=="EN" echo !C_DIM!  [Folders]   - type the name to ENTER!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_DIM!  [Carpetas]  - escribe el nombre para ENTRAR!C_RESET!
:: SIN "sh -c". Antes la ruta se interpolaba entre comillas simples dentro de una
:: orden de shell: un nombre de carpeta del contenedor con un apostrofo -por ejemplo
:: x'$(rm -rf /data)'- cerraba la comilla y EJECUTABA ese comando dentro de la
:: evidencia al navegar hasta el. Los nombres los controla quien preparo el
:: contenedor, asi que es una via de alteracion de la fuente. Ahora "ls" recibe la
:: ruta como ARGUMENTO directo de docker exec, sin shell que la interprete, y el
:: filtrado carpetas/archivos se hace aqui con el sufijo "/" de -p, igual que ADB.
call :NEWGUID _dk_ls_guid
set "DK_LS_TMP=!TEMP!\forensic_dkls_!_dk_ls_guid!.tmp"
docker exec "!DK_SEL_ID!" ls -1pL -- "!dk_nav_path!" > "!DK_LS_TMP!" 2>nul
set "_dk_has_dirs=0"
for /f "usebackq delims=" %%N in ("!DK_LS_TMP!") do (
    set "_dk_n=%%N"
    if "!_dk_n:~-1!"=="/" (
        echo !C_PROMPT!    [DIR]  !_dk_n:~0,-1!!C_RESET!
        set "_dk_has_dirs=1"
    )
)
if "!_dk_has_dirs!"=="0" if /i "!FORENSIC_LANG!"=="EN" echo !C_DIM!    (no subfolders)!C_RESET!
if "!_dk_has_dirs!"=="0" if /i not "!FORENSIC_LANG!"=="EN" echo !C_DIM!    (sin subcarpetas)!C_RESET!
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_DIM!  [Files]     - type the name to ACQUIRE!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_DIM!  [Archivos]  - escribe el nombre para ADQUIRIR!C_RESET!
set "_dk_has_files=0"
for /f "usebackq delims=" %%N in ("!DK_LS_TMP!") do (
    set "_dk_n=%%N"
    if not "!_dk_n:~-1!"=="/" (
        echo !C_TEXT!    [FILE] !_dk_n!!C_RESET!
        set "_dk_has_files=1"
    )
)
del "!DK_LS_TMP!" >nul 2>&1
if "!_dk_has_files!"=="0" if /i "!FORENSIC_LANG!"=="EN" echo !C_DIM!    (no files)!C_RESET!
if "!_dk_has_files!"=="0" if /i not "!FORENSIC_LANG!"=="EN" echo !C_DIM!    (sin archivos)!C_RESET!
echo.
echo !C_BORDER!!LINE!!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT!  S    Acquire this entire folder  [!dk_nav_path!]
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT!  S    Adquirir esta carpeta completa  [!dk_nav_path!]
if /i "!FORENSIC_LANG!"=="EN" echo   ..   Go up to the parent directory
if /i not "!FORENSIC_LANG!"=="EN" echo   ..   Subir al directorio padre
if /i "!FORENSIC_LANG!"=="EN" echo   0    Cancel!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo   0    Cancelar!C_RESET!
echo !C_BORDER!!LINE!!C_RESET!
set "dk_browse_in="
set /p dk_browse_in="!C_PROMPT!> !C_RESET!"
if defined dk_browse_in set "dk_browse_in=!dk_browse_in:"=!"

if "!dk_browse_in!"=="0" goto DK_ART_FINISH
if "!dk_browse_in!"=="" goto DK_NAV_BROWSE
if /I "!dk_browse_in!"=="S" (
    set "dk_cp_src=!dk_nav_path!"
    if "!dk_cp_src:~-1!"=="/" set "dk_cp_src=!dk_cp_src:~0,-1!"
    goto DK_NAV_DO_ACQ
)
if "!dk_browse_in!"==".." goto DK_NAV_UP

:: Comprobar si es carpeta o archivo en el contenedor
set "_dk_test=!dk_nav_path!!dk_browse_in!"
:: El evento se registra ANTES de los dos 'docker exec': un 'call' entre el exec y el
:: 'if errorlevel' pisaria el codigo que hay que leer.
call :LOG_EVENT "docker exec sobre !DK_SEL_ID!: comprobacion del tipo de '!_dk_test!' con 'test -d' y, si procede, 'test -e'."
:: test recibe la ruta como argumento directo, sin shell: ver la nota del listado.
docker exec "!DK_SEL_ID!" test -d "!_dk_test!" >nul 2>&1
if !errorlevel! equ 0 (
    set "dk_nav_path=!_dk_test!/"
    goto DK_NAV_BROWSE
)
docker exec "!DK_SEL_ID!" test -e "!_dk_test!" >nul 2>&1
if !errorlevel! equ 0 (
    set "dk_cp_src=!_dk_test!"
    goto DK_NAV_DO_ACQ
)
if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Not found: !_dk_test!!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] No encontrado: !_dk_test!!C_RESET!
call :WAIT 2
goto DK_NAV_BROWSE

:DK_NAV_UP
if "!dk_nav_path!"=="/" goto DK_NAV_BROWSE
for /f "usebackq delims=" %%P in (`powershell -NoProfile -Command "$p='!dk_nav_path:'=''!'.TrimEnd('/'); if($p -eq ''){'/'}else{$p.Substring(0,$p.LastIndexOf('/')+1)}"`) do set "dk_nav_path=%%P"
if "!dk_nav_path!"=="" set "dk_nav_path=/"
goto DK_NAV_BROWSE

:DK_NAV_DO_ACQ
:: Saneado COMPLETO con :SANITIZE_NAME. Antes solo se cambiaban / \ y :, y una ruta
:: Linux legitima con * ? " < > | daba un nombre invalido en Windows: docker cp
:: fallaba con un error opaco. La comilla se cambia aqui porque :SANITIZE_NAME no
:: la trata.
set "_sn_in=!dk_cp_src:"=_!"
call :SANITIZE_NAME_IN
set "dk_safe_name=!_SN_OUT!"
if "!dk_safe_name:~0,1!"=="_" set "dk_safe_name=!dk_safe_name:~1!"
set "dk_acq_dest=!DK_EVIDENCE!\Artifacts\!dk_safe_name!"
:: Evitar sobrescribir una adquisición previa con el mismo nombre saneado.
set "_dk_dup=1"
:DK_DUP_CHECK
if not exist "!dk_acq_dest!" goto DK_DUP_OK
set /a _dk_dup+=1
set "dk_acq_dest=!DK_EVIDENCE!\Artifacts\!dk_safe_name!__!_dk_dup!"
goto DK_DUP_CHECK
:DK_DUP_OK
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Acquiring: !dk_cp_src!!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Adquiriendo: !dk_cp_src!!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] docker cp !DK_SEL_ID!:!dk_cp_src! to !dk_acq_dest!!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] docker cp !DK_SEL_ID!:!dk_cp_src! hacia !dk_acq_dest!!C_RESET!
echo.
call :NEWGUID ACQ_GUID
set "ACQ_CMD=!TEMP!\forensic_cmd_!ACQ_GUID!.tmp"
>"!ACQ_CMD!" echo docker cp "!DK_SEL_ID!:!dk_cp_src!" "!dk_acq_dest!"
call :ACQ_VER TOOLVER_DOCKER "!DOCKER_EXE!" "--version"
call :ACQUIRE "Docker_Artefacto_cp" "!ACQ_CMD!"
set "_dkcp_el=!errorlevel!"
if "!_dkcp_el!"=="2" (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![ABORT] Copy aborted by the user.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![ABORT] Copia abortada por el usuario.!C_RESET!
    call :LOG_EVENT "Docker cp abortado por el usuario (CTRL+C)."
    pause
    goto DK_NAV_BROWSE
)
if !_dkcp_el! neq 0 (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Error copying. Verify that the path exists in the container.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Error al copiar. Verifique que la ruta existe en el contenedor.!C_RESET!
    call :LOG_EVENT "Docker cp fallo: !DK_SEL_ID!:!dk_cp_src!"
    pause
    goto DK_NAV_BROWSE
)
if /i "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Acquired: !dk_acq_dest!!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Adquirido: !dk_acq_dest!!C_RESET!
call :LOG_EVENT "Artefacto adquirido: !dk_cp_src! hacia !dk_acq_dest!"
:: Empaquetar siempre la evidencia en un contenedor .7z (7zr solo soporta .7z).
set "dk_zip_dest=!dk_acq_dest!.7z"
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Compressing evidence to .7z container...!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Comprimiendo evidencia a contenedor .7z...!C_RESET!
:: 7zr.exe no se comprobaba en ningun punto. Si falta, cmd devuelve 9009 y su salida va
:: a >nul: el operador leia "no se pudo crear el contenedor (codigo 9009)" sin ninguna
:: pista de que la causa era la ausencia del binario. Se dice cual es.
if not exist "!SEVENZIP!" goto DK_ZIP_NO7Z
call :UTCNOW _DKZIP_TS1
"!SEVENZIP!" a -t7z "!dk_zip_dest!" "!dk_acq_dest!" >nul 2>&1
set "_dkzip_el=!errorlevel!"
call :UTCNOW _DKZIP_TS2
call :TOOL_VER_ONCE TOOLVER_7ZR "!SEVENZIP!" ""
call :LOG_CMD "Docker_Logico_7z" "7zr a -t7z [!dk_zip_dest!] [!dk_acq_dest!]" "!_dkzip_el!" "!_DKZIP_TS1!" "!_DKZIP_TS2!" "!dk_acq_dest!" "!dk_zip_dest!" "!TOOLVER_7ZR!"
:: La unica guarda era la EXISTENCIA del .7z, y _dkzip_el se capturaba sin
:: consultarse nunca: con codigo 1 (algun archivo no legible) o 2 (error fatal)
:: tras haber creado el archivo, el contenedor quedaba incompleto y a continuacion
:: se destruia el arbol extraido. Se comprueba el codigo Y el contenido con
:: '7zr t' ANTES de tocar nada, y el borrado pasa a ser decision expresa.
if not exist "!dk_zip_dest!" goto DK_ZIP_FAIL
:: 7zr devuelve 1 como ADVERTENCIA: el contenedor se crea pero algun archivo
:: quedo fuera (bloqueado, en uso, sin permiso). Comprobado en laboratorio:
:: con un archivo bloqueado, 'a' da 1, el .7z existe y 't' lo valida con 0.
:: Tratarlo como fallo hacia que el diario dijera que la evidencia quedaba sin
:: comprimir teniendo el contenedor delante. Se marca PARCIAL y se verifica.
:: Estado de la adquisicion logica. Cuatro valores, nunca ambiguos:
::   COMPLETO      la medicion confirma que esta todo
::   PARCIAL       la medicion confirma que FALTAN elementos
::   NO_VERIFICADO se adquirio, pero no se pudo comprobar la completitud
::   ERROR         una etapa fallo de verdad (copia, compresion o prueba)
:: "No pude verificar" NO es "se que faltan datos". Un recuento que sale a cero
:: por un fallo no puede leerse ni como exito ni como carencia.
set "_dkzip_estado=COMPLETO"
if "!_dkzip_el!"=="1" set "_dkzip_estado=POR_VERIFICAR"
if not "!_dkzip_el!"=="0" if not "!_dkzip_el!"=="1" goto DK_ZIP_FAIL
"!SEVENZIP!" t "!dk_zip_dest!" >nul 2>&1
set "_dkzip_tel=!errorlevel!"
if not "!_dkzip_tel!"=="0" goto DK_ZIP_BADCONTAINER
if not "!_dkzip_estado!"=="POR_VERIFICAR" goto DK_ZIP_COUNTED
:: 7zr devuelve 1 tambien cuando no puede RESOLVER un enlace simbolico, aunque
:: SI almacena la entrada. Los de un contenedor Linux apuntan a rutas que no
:: existen en este host. Se MIDE: si el contenedor tiene al menos tantas
:: entradas como elementos el arbol, no falta nada y el aviso era por enlaces.
:: Las tuberias van en lineas normales y no dentro de un for /f, donde una ruta
:: entrecomillada rompe el analisis del comando.
call :NEWGUID _DKZIP_GUID
set "_dkzip_lst=!TEMP!\forensic_7zl_!_DKZIP_GUID!.tmp"
set "_dkzip_pie=!TEMP!\forensic_7zp_!_DKZIP_GUID!.tmp"
set "_dkzip_arb=!TEMP!\forensic_7za_!_DKZIP_GUID!.tmp"
set "_dkzip_cnt=!TEMP!\forensic_7zc_!_DKZIP_GUID!.tmp"
"!SEVENZIP!" l "!dk_zip_dest!" > "!_dkzip_lst!" 2>nul
:: El pie es la ULTIMA linea del listado: se recorre entero y la ultima
:: asignacion es la que vale. Asi no se depende del idioma de 7-Zip.
set "_dkzip_nf="
set "_dkzip_nd="
for /f "usebackq tokens=5,7" %%a in ("!_dkzip_lst!") do (
    set "_dkzip_nf=%%a"
    set "_dkzip_nd=%%b"
)
dir /s /b /a-d "!dk_acq_dest!" > "!_dkzip_arb!" 2>nul
"!_WFIND!" /c /v "" < "!_dkzip_arb!" > "!_dkzip_cnt!" 2>nul
set "_dkzip_nt="
for /f "usebackq tokens=*" %%C in ("!_dkzip_cnt!") do set "_dkzip_nt=%%C"
del "!_dkzip_lst!" "!_dkzip_pie!" "!_dkzip_arb!" "!_dkzip_cnt!" >nul 2>&1
:: Cualquier medicion que no salga -> NO_VERIFICADO. Nunca COMPLETO ni PARCIAL.
if not defined _dkzip_nf goto DK_ZIP_NOCOUNT
if not defined _dkzip_nd goto DK_ZIP_NOCOUNT
if not defined _dkzip_nt goto DK_ZIP_NOCOUNT
:: Los tres recuentos tienen que ser numeros. Si no lo fueran, "if LEQ"
:: compararia cadenas y el veredicto seria impredecible.
set "_dkzip_mal="
for /f "delims=0123456789" %%X in ("!_dkzip_nf!") do set "_dkzip_mal=1"
for /f "delims=0123456789" %%X in ("!_dkzip_nd!") do set "_dkzip_mal=1"
for /f "delims=0123456789" %%X in ("!_dkzip_nt!") do set "_dkzip_mal=1"
if defined _dkzip_mal goto DK_ZIP_NOCOUNT
set /a _dkzip_nz=_dkzip_nf+_dkzip_nd 2>nul
if not defined _dkzip_nz goto DK_ZIP_NOCOUNT
if !_dkzip_nf! LEQ 0 goto DK_ZIP_NOCOUNT
if !_dkzip_nt! LEQ 0 goto DK_ZIP_NOCOUNT
if !_dkzip_nf! LSS !_dkzip_nt! goto DK_ZIP_FALTAN
set "_dkzip_estado=COMPLETO"
call :LOG_EVENT "ESTADO=COMPLETO. 7zr devolvio 1 pero la medicion confirma que no falta nada: !_dkzip_nf! archivos en el contenedor para !_dkzip_nt! archivos del arbol (mas !_dkzip_nd! carpetas). El aviso proviene de enlaces simbolicos cuyo destino no existe en este host, tipico al copiar un filesystem Linux a Windows: 7zr guarda la entrada pero no puede resolver el destino. Contenedor: !dk_zip_dest!"
goto DK_ZIP_COUNTED
:DK_ZIP_FALTAN
set "_dkzip_estado=PARCIAL"
call :LOG_EVENT "ESTADO=PARCIAL. La medicion CONFIRMA que faltan archivos: !_dkzip_nf! en el contenedor frente a !_dkzip_nt! en el arbol. El arbol extraido se CONSERVA: es el unico conjunto completo. Contenedor: !dk_zip_dest!"
goto DK_ZIP_COUNTED
:DK_ZIP_NOCOUNT
set "_dkzip_estado=NO_VERIFICADO"
call :LOG_EVENT "ESTADO=NO_VERIFICADO. La adquisicion se realizo y el contenedor paso la prueba '7zr t', pero NO se pudo medir su contenido (recuento no disponible: archivos en contenedor=[!_dkzip_nf!] carpetas=[!_dkzip_nd!] archivos en arbol=[!_dkzip_nt!]). NO se afirma que falten archivos ni que esten todos: solo que la completitud no pudo comprobarse. El arbol extraido se CONSERVA. Contenedor: !dk_zip_dest!"
:DK_ZIP_COUNTED
if "!_dkzip_estado!"=="COMPLETO" if /i "!FORENSIC_LANG!"=="EN" echo !C_OK![+] COMPLETE container, verified with '7zr t': !dk_zip_dest!!C_RESET!
if "!_dkzip_estado!"=="COMPLETO" if /i not "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Contenedor COMPLETO, verificado con '7zr t': !dk_zip_dest!!C_RESET!
if "!_dkzip_estado!"=="PARCIAL" if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![-] PARTIAL container: !_dkzip_nf! of !_dkzip_nt! files - files ARE missing.!C_RESET!
if "!_dkzip_estado!"=="PARCIAL" if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![-] Contenedor PARCIAL: !_dkzip_nf! de !_dkzip_nt! archivos - SI faltan archivos.!C_RESET!
if "!_dkzip_estado!"=="PARCIAL" if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] The extracted tree is kept: it is the only complete set.!C_RESET!
if "!_dkzip_estado!"=="PARCIAL" if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] El arbol extraido se conserva: es el unico conjunto completo.!C_RESET!
if "!_dkzip_estado!"=="NO_VERIFICADO" if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] NOT VERIFIED: container passed '7zr t' but its contents could not be measured.!C_RESET!
if "!_dkzip_estado!"=="NO_VERIFICADO" if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] NO VERIFICADO: el contenedor paso '7zr t' pero no se pudo medir su contenido.!C_RESET!
if "!_dkzip_estado!"=="NO_VERIFICADO" if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] It is NOT claimed that files are missing. The extracted tree is kept.!C_RESET!
if "!_dkzip_estado!"=="NO_VERIFICADO" if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] NO se afirma que falten archivos. El arbol extraido se conserva.!C_RESET!
call :LOG_EVENT "Contenedor .7z probado con '7zr t' (codigo !_dkzip_tel!). Estado de completitud: !_dkzip_estado!. Contenedor: !dk_zip_dest!"
:: Hash del contenedor .7z ANTES de ofrecer el borrado: si el arbol se retira, el
:: .7z pasa a ser la unica copia y tiene que estar ya hasheado.
call :HASH_EVIDENCE FILE "!dk_zip_dest!" "" "!dk_zip_dest!_hashes.txt" "Docker_Logico"
echo.
:: El arbol extraido solo se ofrece retirar cuando la completitud del
:: contenedor esta CONFIRMADA. Con PARCIAL o NO_VERIFICADO el arbol es la
:: unica copia integra o la unica no cuestionada, y borrarlo es irreversible.
if not "!_dkzip_estado!"=="COMPLETO" goto DK_ZIP_KEEPTREE
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] The extracted tree is kept alongside the container. Removing it is!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] El árbol extraído se conserva junto al contenedor. Retirarlo es!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] irreversible if the container turns out to be incomplete.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] irreversible si el contenedor resultara incompleto.!C_RESET!
set "_dkzip_rm="
if /i "!FORENSIC_LANG!"=="EN" set /p _dkzip_rm="!C_PROMPT!Remove the extracted tree, keeping only the .7z? [Y/N]: !C_RESET!"
if /i not "!FORENSIC_LANG!"=="EN" set /p _dkzip_rm="!C_PROMPT!¿Retirar el árbol extraído y dejar sólo el .7z? [S/N]: !C_RESET!"
:: El prompt en ingles ofrece [Y/N]; se acepta Y como S.
if /i "!_dkzip_rm!"=="Y" set "_dkzip_rm=S"
if /I not "!_dkzip_rm!"=="S" goto DK_ZIP_KEEPTREE
if exist "!dk_acq_dest!\" rmdir /s /q "!dk_acq_dest!" >nul 2>&1
if exist "!dk_acq_dest!" del /f /q "!dk_acq_dest!" >nul 2>&1
call :LOG_EVENT "Arbol extraido retirado por decision expresa del operador, con el contenedor ya verificado y hasheado: !dk_acq_dest! (queda !dk_zip_dest!)"
goto DK_ZIP_DONE
:DK_ZIP_KEEPTREE
call :LOG_EVENT "Arbol extraido CONSERVADO junto al contenedor .7z (estado de completitud: !_dkzip_estado!): !dk_acq_dest!"
goto DK_ZIP_DONE
:DK_ZIP_BADCONTAINER
set "_dkzip_estado=ERROR"
if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] The .7z exists but '7zr t' failed (code !_dkzip_tel!): the container is!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] El .7z existe pero '7zr t' fallo (código !_dkzip_tel!): el contenedor NO!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] NOT trustworthy. The extracted tree is KEPT: !dk_acq_dest!!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] es fiable. El árbol extraído se CONSERVA: !dk_acq_dest!!C_RESET!
call :LOG_EVENT "ESTADO=ERROR. El contenedor !dk_zip_dest! existe pero no paso la prueba '7zr t' (codigo !_dkzip_tel!). NO se borra el arbol extraido !dk_acq_dest!."
goto DK_ZIP_DONE
:DK_ZIP_FAIL
set "_dkzip_estado=ERROR"
if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Could not create the container ^(code !_dkzip_el!^). The evidence stays uncompressed in: !dk_acq_dest!!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] No se pudo crear el contenedor ^(código !_dkzip_el!^). La evidencia queda sin comprimir en: !dk_acq_dest!!C_RESET!
call :LOG_EVENT "ESTADO=ERROR. Fallo compresion .7z (codigo !_dkzip_el!) para: !dk_acq_dest!. El arbol extraido se CONSERVA intacto."
goto DK_ZIP_DONE
:DK_ZIP_NO7Z
set "_dkzip_estado=NO_VERIFICADO"
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] 7zr.exe was not found: !SEVENZIP!!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] No se encontró 7zr.exe: !SEVENZIP!!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] No container is produced. The evidence is NOT lost: it stays as an!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] No se produce contenedor. La evidencia NO se pierde: queda como árbol!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] uncompressed tree in: !dk_acq_dest!!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] sin comprimir en: !dk_acq_dest!!C_RESET!
call :LOG_EVENT "ESTADO=NO_VERIFICADO. LIMITACION DE ESTE HOST: 7zr.exe no esta disponible en !SEVENZIP!, asi que la evidencia NO se empaqueta en un contenedor .7z. El arbol extraido se CONSERVA intacto en !dk_acq_dest! y es la copia autoritativa. No se ha borrado nada."
:DK_ZIP_DONE
set "dk_more="
if /i "!FORENSIC_LANG!"=="EN" set /p dk_more="!C_PROMPT!Acquire another artifact? [Y/N]: !C_RESET!"
if /i not "!FORENSIC_LANG!"=="EN" set /p dk_more="!C_PROMPT!¿Adquirir otro artefacto? [S/N]: !C_RESET!"
:: El prompt en ingles ofrece [Y/N]; se acepta Y como S.
if /i "!dk_more!"=="Y" set "dk_more=S"
if /I "!dk_more!"=="S" goto DK_NAV_BROWSE
goto DK_ART_FINISH

:DK_ART_FINISH
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Artifact acquisition finished for: !DK_SEL_NAME!!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Adquisición de artefactos finalizada para: !DK_SEL_NAME!!C_RESET!
call :LOG_EVENT "Docker artefactos: adquisicion finalizada para !DK_SEL_NAME!"
pause
goto DK_MENU_SHOW

:: =====================================================
:: MÓDULO ADB - ADQUISICIÓN FORENSE DE DISPOSITIVOS ANDROID
:: Conexion/desconexion de dispositivos y adquisición lógica
:: con navegador interactivo (adb shell ls + adb pull).
:: =====================================================

:MENU_ADB
set "HE_MODO="
cls
echo !C_BORDER!!LINE!!C_RESET!
call :HDR TITLE "ANDROID DEVICES - ADB" "DISPOSITIVOS ANDROID - ADB"
echo !C_BORDER!!LINE!!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT!1. Status / Connected devices
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT!1. Estado / Dispositivos conectados
if /i "!FORENSIC_LANG!"=="EN" echo 2. Connect device over network (IP:port)
if /i not "!FORENSIC_LANG!"=="EN" echo 2. Conectar dispositivo por red (IP:puerto)
if /i "!FORENSIC_LANG!"=="EN" echo 3. Disconnect devices / Stop ADB server
if /i not "!FORENSIC_LANG!"=="EN" echo 3. Desconectar dispositivos / Detener servidor ADB
if /i "!FORENSIC_LANG!"=="EN" echo 4. Logical Acquisition - Files/Folders
if /i not "!FORENSIC_LANG!"=="EN" echo 4. Adquisición Lógica - Archivos/Carpetas
if /i "!FORENSIC_LANG!"=="EN" echo 0. Back!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo 0. Volver!C_RESET!
echo !C_BORDER!!LINE!!C_RESET!
set "adb_opt="
if /i "!FORENSIC_LANG!"=="EN" set /p adb_opt="!C_PROMPT!Select an option: !C_RESET!"
if /i not "!FORENSIC_LANG!"=="EN" set /p adb_opt="!C_PROMPT!Selecciona una opción: !C_RESET!"

for /f "delims=0123456789" %%a in ("!adb_opt!") do (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Invalid option.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Opción inválida.!C_RESET!
    call :WAIT 2
    goto MENU_ADB
)

if "!adb_opt!"=="0" goto MENU_PRINCIPAL
if "!adb_opt!"=="1" goto ADB_STATUS
if "!adb_opt!"=="2" goto ADB_CONNECT
if "!adb_opt!"=="3" goto ADB_DISCONNECT
if "!adb_opt!"=="4" goto ADB_LOGICAL

if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Invalid option.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Opción inválida.!C_RESET!
call :WAIT 2
goto MENU_ADB

:: --- ADB: ESTADO / DISPOSITIVOS ---
:ADB_STATUS
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] ADB devices detected:!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Dispositivos ADB detectados:!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_DIM!    (device = authorized, unauthorized = confirm on the phone screen)!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_DIM!    (device = autorizado, unauthorized = confirme en la pantalla del movil)!C_RESET!
echo.
"!ADB_EXE!" devices -l
echo.
call :LOG_EVENT "ADB: dispositivos enumerados."
pause
goto MENU_ADB

:: --- ADB: CONECTAR POR RED ---
:ADB_CONNECT
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Wireless connection: the device must have debugging!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Conexión inalámbrica: el dispositivo debe tener la depuración!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] over network enabled (Settings ^> Developer options).!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] por red activada (Ajustes ^> Opciones de desarrollador).!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_DIM!    Over USB this step is not required: connect the cable and authorize.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_DIM!    Por USB no se requiere este paso: conecte el cable y autorice.!C_RESET!
echo.
set "adb_ip="
if /i "!FORENSIC_LANG!"=="EN" set /p adb_ip="!C_PROMPT!Device IP:port (e.g.: 192.168.1.50:5555, 0=back): !C_RESET!"
if /i not "!FORENSIC_LANG!"=="EN" set /p adb_ip="!C_PROMPT!IP:puerto del dispositivo (ej: 192.168.1.50:5555, 0=volver): !C_RESET!"
if "!adb_ip!"=="0" goto MENU_ADB
if "!adb_ip!"=="" (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] No address was entered. Returning to the ADB menu.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] No se introdujo ninguna dirección. Volviendo al menú ADB.!C_RESET!
    call :WAIT 2
    goto MENU_ADB
)
set "adb_ip=!adb_ip:"=!"
echo.
call :UTCNOW _ADBC_TS1
"!ADB_EXE!" connect "!adb_ip!"
set "_adbc_el=!errorlevel!"
call :UTCNOW _ADBC_TS2
call :LOG_CMD "ADB_Connect" "adb connect !adb_ip!" "!_adbc_el!" "!_ADBC_TS1!" "!_ADBC_TS2!" "" ""
call :LOG_EVENT "ADB connect: !adb_ip!"
echo.
pause
goto MENU_ADB

:: --- ADB: DESCONECTAR ---
:ADB_DISCONNECT
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT!1. Disconnect network devices (adb disconnect)
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT!1. Desconectar dispositivos de red (adb disconnect)
if /i "!FORENSIC_LANG!"=="EN" echo 2. Stop the ADB server completely (adb kill-server)
if /i not "!FORENSIC_LANG!"=="EN" echo 2. Detener el servidor ADB por completo (adb kill-server)
if /i "!FORENSIC_LANG!"=="EN" echo 0. Back!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo 0. Volver!C_RESET!
set "adb_dc="
if /i "!FORENSIC_LANG!"=="EN" set /p adb_dc="!C_PROMPT!Option: !C_RESET!"
if /i not "!FORENSIC_LANG!"=="EN" set /p adb_dc="!C_PROMPT!Opción: !C_RESET!"
if "!adb_dc!"=="0" goto MENU_ADB
if "!adb_dc!"=="1" goto ADB_DC_NET
if "!adb_dc!"=="2" goto ADB_DC_KILL
if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Invalid option.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Opción inválida.!C_RESET!
call :WAIT 2
goto ADB_DISCONNECT
:ADB_DC_NET
"!ADB_EXE!" disconnect
call :LOG_EVENT "ADB: dispositivos de red desconectados."
if /i "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Network devices disconnected.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Dispositivos de red desconectados.!C_RESET!
pause
goto MENU_ADB
:ADB_DC_KILL
"!ADB_EXE!" kill-server
call :LOG_EVENT "ADB: servidor detenido (kill-server)."
if /i "!FORENSIC_LANG!"=="EN" echo !C_OK![+] ADB server stopped.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Servidor ADB detenido.!C_RESET!
pause
goto MENU_ADB

:: --- ADB: SUBRUTINA SELECCIÓN DE DISPOSITIVO ---
:ADB_SELECT_DEVICE
set "ADB_SERIAL="
set "adb_dev_count=0"
:: 'adb devices' imprime cabecera "List of devices attached"; se omite con skip=1.
for /f "usebackq skip=1 tokens=1,2" %%A in (`"!ADB_EXE!" devices 2^>nul`) do (
    if "%%B"=="device" (
        set /a adb_dev_count+=1
        set "ADB_DEV_!adb_dev_count!=%%A"
    )
)
if !adb_dev_count! equ 0 (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![-] No authorized devices connected.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![-] No hay dispositivos autorizados conectados.!C_RESET!
    if /i "!FORENSIC_LANG!"=="EN" echo !C_DIM!    Connect over USB and accept the authorization, or use Connect over network.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_DIM!    Conecte por USB y acepte la autorización, o use la opción Conectar por red.!C_RESET!
    exit /b 1
)
if !adb_dev_count! equ 1 (
    set "ADB_SERIAL=!ADB_DEV_1!"
    if /i "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Device: !ADB_DEV_1!!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Dispositivo: !ADB_DEV_1!!C_RESET!
    exit /b 0
)
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT!Authorized devices:!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT!Dispositivos autorizados:!C_RESET!
for /L %%i in (1,1,!adb_dev_count!) do echo  !C_OK!%%i. !ADB_DEV_%%i!!C_RESET!
echo.
:ADB_DEV_PROMPT
set "adb_dsel="
if /i "!FORENSIC_LANG!"=="EN" set /p adb_dsel="!C_PROMPT!Select the device [1-!adb_dev_count!, 0=cancel]: !C_RESET!"
if /i not "!FORENSIC_LANG!"=="EN" set /p adb_dsel="!C_PROMPT!Seleccione el dispositivo [1-!adb_dev_count!, 0=cancelar]: !C_RESET!"
if "!adb_dsel!"=="0" exit /b 1
for /f "delims=0123456789" %%a in ("!adb_dsel!") do goto ADB_DEV_PROMPT
if !adb_dsel! lss 1 goto ADB_DEV_PROMPT
if !adb_dsel! gtr !adb_dev_count! goto ADB_DEV_PROMPT
call :NORM_SEL adb_dsel
set "ADB_SERIAL=!ADB_DEV_%adb_dsel%!"
if not defined ADB_SERIAL goto ADB_DEV_PROMPT
exit /b 0

:: --- ADB: ADQUISICIÓN LÓGICA CON NAVEGADOR ---
:ADB_LOGICAL
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Logical Acquisition - Files/Folders (adb pull)!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Adquisición Lógica - Archivos/Carpetas (adb pull)!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_DIM![i] Without root, access is limited to readable paths (ex: /sdcard).!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_DIM![i] Sin root el acceso esta limitado a rutas legibles (ej: /sdcard).!C_RESET!
echo.
call :ADB_SELECT_DEVICE
if not defined ADB_SERIAL (
    pause
    goto MENU_ADB
)

:ASK_ADB_DEST
set "adb_dest="
if /i "!FORENSIC_LANG!"=="EN" set /p adb_dest="!C_PROMPT!Destination folder path [Enter = !DEFAULT_DEST!] (0=cancel): !C_RESET!"
if /i not "!FORENSIC_LANG!"=="EN" set /p adb_dest="!C_PROMPT!Ruta de la carpeta destino [Enter = !DEFAULT_DEST!] (0=cancelar): !C_RESET!"
if "!adb_dest!"=="0" goto MENU_ADB
if defined adb_dest set "adb_dest=!adb_dest:"=!"
if not defined adb_dest (
    set "adb_dest=!DEFAULT_DEST!"
    if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Using default destination: !DEFAULT_DEST!!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Usando destino por defecto: !DEFAULT_DEST!!C_RESET!
)
call :VALIDATE_DEST_DIR "!adb_dest!"
if not "!_VD_OK!"=="1" goto ASK_ADB_DEST

:: Sanitizar serial para nombre de carpeta
set "ADB_FOLDER=!ADB_SERIAL!"
set "ADB_FOLDER=!ADB_FOLDER::=_!"
set "ADB_FOLDER=!ADB_FOLDER:.=_!"
set "ADB_EVIDENCE=!adb_dest!\ADB\!ADB_FOLDER!"
set "DEST=!ADB_EVIDENCE!"
if not exist "!ADB_EVIDENCE!\Artifacts" mkdir "!ADB_EVIDENCE!\Artifacts"
call :LOG_EVENT "ADB adquisicion logica: inicio para !ADB_SERIAL!"

:: IDENTIFICACION DEL DISPOSITIVO. El serial ADB era lo unico que se registraba y
:: NO identifica el aparato: en conexion por red es solo IP:puerto. Sin fabricante,
:: modelo, fingerprint y version de Android la evidencia no es atribuible a un
:: objeto concreto (NIST SP 800-101r1 5.1; ISO/IEC 27037 7.1.3).
set "_adb_idfile=!ADB_EVIDENCE!\dispositivo_identificacion.txt"
call :UTCNOW _adb_idts
>"!_adb_idfile!" echo IDENTIFICACION DEL DISPOSITIVO - adquisicion LOGICA (adb pull)
>>"!_adb_idfile!" echo Generado UTC : !_adb_idts!
>>"!_adb_idfile!" echo Serial ADB   : !ADB_SERIAL!
>>"!_adb_idfile!" echo Host         : !COMPUTERNAME!   Operador: !USERNAME!
>>"!_adb_idfile!" echo.
>>"!_adb_idfile!" echo --- PROPIEDADES LEIDAS DEL DISPOSITIVO ---
for %%P in (ro.product.manufacturer ro.product.model ro.product.name ro.serialno ro.build.fingerprint ro.build.version.release ro.build.version.sdk) do call :ADB_GETPROP_ROW %%P
>>"!_adb_idfile!" echo.
>>"!_adb_idfile!" echo --- ALCANCE Y LIMITACIONES ---
>>"!_adb_idfile!" echo Nivel de adquisicion: LOGICA (NIST SP 800-101r1), NO fisica. Alcanza solo lo
>>"!_adb_idfile!" echo que el usuario ADB puede leer: sin root NO incluye /data, ni espacio no
>>"!_adb_idfile!" echo asignado, ni archivos borrados.
>>"!_adb_idfile!" echo El dispositivo esta VIVO y mutando durante la extraccion: esta adquisicion NO
>>"!_adb_idfile!" echo es REPETIBLE y no produce un estado point-in-time.
>>"!_adb_idfile!" echo Si la conexion es por red (serial con formato IP:puerto), el transporte ADB
>>"!_adb_idfile!" echo sobre TCP no ofrece autenticacion ni cifrado extremo a extremo del tipo que un
>>"!_adb_idfile!" echo peritaje esperaria, y la sesion depende de un pareo previo en el dispositivo.
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] SCOPE: LOGICAL acquisition, not physical. It only!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] ALCANCE: adquisición LÓGICA, no física. Sólo!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] reaches what the ADB user can read: without root there is NO /data,!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] alcanza lo que el usuario ADB puede leer: sin root NO hay /data,!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] no unallocated space and no deleted files. The device is LIVE and!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] ni espacio no asignado, ni archivos borrados. El dispositivo está!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] changing: this extraction is NOT repeatable.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] VIVO y mutando: esta extracción NO es repetible.!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Device identification written to: !_adb_idfile!!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Identificación del dispositivo escrita en: !_adb_idfile!!C_RESET!
call :LOG_EVENT "ADB: adquisicion LOGICA (NIST SP 800-101r1) sobre dispositivo VIVO !ADB_SERIAL!. Alcance limitado a las rutas legibles por el usuario ADB; sin root NO incluye /data, espacio no asignado ni archivos borrados. Extraccion NO repetible: la fuente muta. Identificacion del aparato (fabricante, modelo, fingerprint, version de Android) en dispositivo_identificacion.txt"
echo.
pause

set "adb_nav_path=/sdcard/"

:: --- NAVEGADOR DEL FILESYSTEM ANDROID ---
:ADB_NAV_BROWSE
cls
echo !C_BORDER!!LINE!!C_RESET!
call :HDR TITLE "ANDROID BROWSER - !ADB_SERIAL!" "NAVEGADOR ANDROID - !ADB_SERIAL!"
echo !C_BORDER!!LINE!!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT!Current path: !adb_nav_path!!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT!Ruta actual: !adb_nav_path!!C_RESET!
echo.

:: Verificar conectividad ANTES de listar (mismo bug real de completitud
:: detectado en el navegador Docker, vía auditoría dinamica): "adb shell
:: ... 2>nul" silencia stderr, así que un dispositivo desconectado produce
:: la MISMA salida vacia que una carpeta realmente vacia - indistinguible
:: para el operador, quien podria documentar un artefacto como "no existe".
set "_adb_state="
for /f "usebackq delims=" %%R in (`"!ADB_EXE!" -s !ADB_SERIAL! get-state 2^>nul`) do set "_adb_state=%%R"
if not "!_adb_state!"=="device" (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] The device "!ADB_SERIAL!" is not accessible ^(disconnected^).!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] El dispositivo "!ADB_SERIAL!" no esta accesible ^(desconectado^).!C_RESET!
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] This does NOT mean the current folder is empty: the connection was lost.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] Esto NO significa que la carpeta actual este vacia: se perdio la conexión.!C_RESET!
    echo.
    if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT!  R    Retry
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT!  R    Reintentar
    if /i "!FORENSIC_LANG!"=="EN" echo   0    Cancel and go back!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo   0    Cancelar y volver!C_RESET!
    set "_adb_conn_retry="
    set /p _adb_conn_retry="!C_PROMPT!> !C_RESET!"
    if /I "!_adb_conn_retry!"=="R" goto ADB_NAV_BROWSE
    goto ADB_ART_FINISH
)

:: NEWGUID en vez de %RANDOM% (rango 0-32767, colisionable entre instancias
:: concurrentes) - mismo patron usado en el resto del archivo; ver nota en
:: el fix analogo del Write Blocker (bug real detectado en auditoría dinamica).
call :NEWGUID _adb_ls_guid
set "ADB_LS_TMP=!TEMP!\forensic_adbls_!_adb_ls_guid!.tmp"
:: "adb shell" NO pasa argumentos sueltos: los UNE en una sola linea que interpreta
:: el sh del dispositivo. Una carpeta llamada, por ejemplo, x;rm -r /sdcard/DCIM se
:: ejecutaba en el telefono de evidencia al navegar a ella. La ruta va ahora entre
:: comillas simples para ese sh, con cada apostrofo interno escrito como '\''.
set "_adb_q=!adb_nav_path:'='\''!"
"!ADB_EXE!" -s !ADB_SERIAL! shell ls -1p "'!_adb_q!'" > "!ADB_LS_TMP!" 2>nul
if /i "!FORENSIC_LANG!"=="EN" echo !C_DIM!  [Folders]   - type the name to ENTER!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_DIM!  [Carpetas]  - escribe el nombre para ENTRAR!C_RESET!
set "_adb_has_dirs=0"
for /f "usebackq delims=" %%N in ("!ADB_LS_TMP!") do (
    set "_adb_n=%%N"
    if "!_adb_n:~-1!"=="/" (
        echo !C_PROMPT!    [DIR]  !_adb_n:~0,-1!!C_RESET!
        set "_adb_has_dirs=1"
    )
)
if "!_adb_has_dirs!"=="0" if /i "!FORENSIC_LANG!"=="EN" echo !C_DIM!    (no subfolders)!C_RESET!
if "!_adb_has_dirs!"=="0" if /i not "!FORENSIC_LANG!"=="EN" echo !C_DIM!    (sin subcarpetas)!C_RESET!
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_DIM!  [Files]     - type the name to ACQUIRE!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_DIM!  [Archivos]  - escribe el nombre para ADQUIRIR!C_RESET!
set "_adb_has_files=0"
for /f "usebackq delims=" %%N in ("!ADB_LS_TMP!") do (
    set "_adb_n=%%N"
    if not "!_adb_n:~-1!"=="/" (
        echo !C_TEXT!    [FILE] !_adb_n!!C_RESET!
        set "_adb_has_files=1"
    )
)
if "!_adb_has_files!"=="0" if /i "!FORENSIC_LANG!"=="EN" echo !C_DIM!    (no files)!C_RESET!
if "!_adb_has_files!"=="0" if /i not "!FORENSIC_LANG!"=="EN" echo !C_DIM!    (sin archivos)!C_RESET!
del "!ADB_LS_TMP!" >nul 2>&1
echo.
echo !C_BORDER!!LINE!!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT!  S    Acquire this whole folder  [!adb_nav_path!]
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT!  S    Adquirir esta carpeta completa  [!adb_nav_path!]
if /i "!FORENSIC_LANG!"=="EN" echo   ..   Go up to the parent directory
if /i not "!FORENSIC_LANG!"=="EN" echo   ..   Subir al directorio padre
if /i "!FORENSIC_LANG!"=="EN" echo   0    Cancel!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo   0    Cancelar!C_RESET!
echo !C_BORDER!!LINE!!C_RESET!
set "adb_browse_in="
set /p adb_browse_in="!C_PROMPT!> !C_RESET!"
if defined adb_browse_in set "adb_browse_in=!adb_browse_in:"=!"

if "!adb_browse_in!"=="0" goto ADB_ART_FINISH
if "!adb_browse_in!"=="" goto ADB_NAV_BROWSE
if /I "!adb_browse_in!"=="S" (
    set "adb_pull_src=!adb_nav_path!"
    if "!adb_pull_src:~-1!"=="/" set "adb_pull_src=!adb_pull_src:~0,-1!"
    goto ADB_NAV_DO_ACQ
)
if "!adb_browse_in!"==".." goto ADB_NAV_UP

:: Comprobar si es carpeta o archivo en el dispositivo (requiere adb shell v2, Android 7+)
set "_adb_test=!adb_nav_path!!adb_browse_in!"
:: Misma proteccion que el listado: comillas simples para el sh del dispositivo.
set "_adb_q=!_adb_test:'='\''!"
"!ADB_EXE!" -s !ADB_SERIAL! shell test -d "'!_adb_q!'" >nul 2>&1
if !errorlevel! equ 0 (
    set "adb_nav_path=!_adb_test!/"
    goto ADB_NAV_BROWSE
)
"!ADB_EXE!" -s !ADB_SERIAL! shell test -e "'!_adb_q!'" >nul 2>&1
if !errorlevel! equ 0 (
    set "adb_pull_src=!_adb_test!"
    goto ADB_NAV_DO_ACQ
)
if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Not found or no read permission: !_adb_test!!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] No encontrado o sin permiso de lectura: !_adb_test!!C_RESET!
call :WAIT 2
goto ADB_NAV_BROWSE

:ADB_NAV_UP
if "!adb_nav_path!"=="/" goto ADB_NAV_BROWSE
for /f "usebackq delims=" %%P in (`powershell -NoProfile -Command "$p='!adb_nav_path:'=''!'.TrimEnd('/'); if($p -eq ''){'/'}else{$p.Substring(0,$p.LastIndexOf('/')+1)}"`) do set "adb_nav_path=%%P"
if "!adb_nav_path!"=="" set "adb_nav_path=/"
goto ADB_NAV_BROWSE

:ADB_NAV_DO_ACQ
:: Mismo saneado completo que en Docker: una ruta de Android con * ? " < > | o \
:: producia un nombre invalido en Windows y adb pull fallaba.
set "_sn_in=!adb_pull_src:"=_!"
call :SANITIZE_NAME_IN
set "adb_safe_name=!_SN_OUT!"
if "!adb_safe_name:~0,1!"=="_" set "adb_safe_name=!adb_safe_name:~1!"
set "adb_acq_dest=!ADB_EVIDENCE!\Artifacts\!adb_safe_name!"
:: Evitar sobrescribir una adquisición previa con el mismo nombre saneado.
set "_adb_dup=1"
:ADB_DUP_CHECK
if not exist "!adb_acq_dest!" goto ADB_DUP_OK
set /a _adb_dup+=1
set "adb_acq_dest=!ADB_EVIDENCE!\Artifacts\!adb_safe_name!__!_adb_dup!"
goto ADB_DUP_CHECK
:ADB_DUP_OK
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Acquiring: !adb_pull_src!!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Adquiriendo: !adb_pull_src!!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] adb pull -a !adb_pull_src! to !adb_acq_dest!!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] adb pull -a !adb_pull_src! hacia !adb_acq_dest!!C_RESET!
echo.
call :NEWGUID ACQ_GUID
set "ACQ_CMD=!TEMP!\forensic_cmd_!ACQ_GUID!.tmp"
>"!ACQ_CMD!" echo "!ADB_EXE!" -s !ADB_SERIAL! pull -a "!adb_pull_src!" "!adb_acq_dest!"
set "ACQ_TOOL_VER=adb - no interrogada: adb version arranca el demonio y alteraria el host; identificacion por SHA-256 en Herramientas_SHA256.txt"
call :ACQUIRE "ADB_Pull_Logico" "!ACQ_CMD!"
set "_adbp_el=!errorlevel!"
if "!_adbp_el!"=="2" (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![ABORT] Acquisition aborted by the user.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![ABORT] Adquisición abortada por el usuario.!C_RESET!
    call :LOG_EVENT "ADB pull abortado por el usuario (CTRL+C)."
    pause
    goto ADB_NAV_BROWSE
)
if !_adbp_el! neq 0 (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Error extracting. Verify read permissions on the device.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Error al extraer. Verifique permisos de lectura en el dispositivo.!C_RESET!
    call :LOG_EVENT "ADB pull fallo: !adb_pull_src!"
    pause
    goto ADB_NAV_BROWSE
)
if /i "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Acquired: !adb_acq_dest!!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Adquirido: !adb_acq_dest!!C_RESET!
call :LOG_EVENT "Artefacto ADB adquirido: !adb_pull_src! hacia !adb_acq_dest!"
:: Empaquetar en contenedor .7z (igual que la adquisición lógica de Docker).
set "adb_zip_dest=!adb_acq_dest!.7z"
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Compressing evidence to .7z container...!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Comprimiendo evidencia a contenedor .7z...!C_RESET!
:: Comprobacion del binario, igual que en la via de Docker: sin ella un 7zr ausente se
:: presentaba como "codigo 9009" y nada mas.
if not exist "!SEVENZIP!" goto ADB_ZIP_NO7Z
call :UTCNOW _ADBZ_TS1
"!SEVENZIP!" a -t7z "!adb_zip_dest!" "!adb_acq_dest!" >nul 2>&1
set "_adbz_el=!errorlevel!"
call :UTCNOW _ADBZ_TS2
call :TOOL_VER_ONCE TOOLVER_7ZR "!SEVENZIP!" ""
call :LOG_CMD "ADB_Logico_7z" "7zr a -t7z [!adb_zip_dest!] [!adb_acq_dest!]" "!_adbz_el!" "!_ADBZ_TS1!" "!_ADBZ_TS2!" "!adb_acq_dest!" "!adb_zip_dest!" "!TOOLVER_7ZR!"
:: Antes de borrar el arbol extraido hay que ACREDITAR que el contenedor lo
:: contiene. La unica guarda era la EXISTENCIA del .7z, y _adbz_el se capturaba
:: sin consultarse nunca: con codigo 1 (algun archivo no legible) o 2 (error
:: fatal) tras haber creado el archivo, el contenedor quedaba incompleto y a
:: continuacion se destruia irreversiblemente lo extraido. El 'adb pull' sobre un
:: dispositivo vivo NO es repetible, asi que ese borrado no tiene vuelta atras.
if not exist "!adb_zip_dest!" goto ADB_ZIP_FAIL
if not "!_adbz_el!"=="0" goto ADB_ZIP_FAIL
"!SEVENZIP!" t "!adb_zip_dest!" >nul 2>&1
set "_adbz_tel=!errorlevel!"
if not "!_adbz_tel!"=="0" goto ADB_ZIP_BADCONTAINER
if /i "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Container created and verified with '7zr t': !adb_zip_dest!!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Contenedor creado y verificado con '7zr t': !adb_zip_dest!!C_RESET!
call :LOG_EVENT "Contenedor .7z verificado con '7zr t' (codigo 0) ANTES de retirar el arbol extraido: !adb_zip_dest!"
:: El arbol extraido no se borra por defecto: es la unica copia de una extraccion
:: que no se puede repetir. El retiro es una decision expresa del operador.
call :HASH_EVIDENCE FILE "!adb_zip_dest!" "" "!adb_zip_dest!_hashes.txt" "ADB_Logico"
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] The extracted tree is kept alongside the container. Removing it is!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] El árbol extraído se conserva junto al contenedor. Retirarlo es!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] irreversible: 'adb pull' on a live device cannot be repeated.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] irreversible: 'adb pull' sobre un dispositivo vivo no se repite.!C_RESET!
set "_adbz_rm="
if /i "!FORENSIC_LANG!"=="EN" set /p _adbz_rm="!C_PROMPT!Remove the extracted tree, keeping only the .7z? [Y/N]: !C_RESET!"
if /i not "!FORENSIC_LANG!"=="EN" set /p _adbz_rm="!C_PROMPT!¿Retirar el árbol extraído y dejar sólo el .7z? [S/N]: !C_RESET!"
:: El prompt en ingles ofrece [Y/N]; se acepta Y como S.
if /i "!_adbz_rm!"=="Y" set "_adbz_rm=S"
if /I not "!_adbz_rm!"=="S" goto ADB_ZIP_KEEPTREE
if exist "!adb_acq_dest!\" rmdir /s /q "!adb_acq_dest!" >nul 2>&1
if exist "!adb_acq_dest!" del /f /q "!adb_acq_dest!" >nul 2>&1
call :LOG_EVENT "Arbol extraido retirado por decision expresa del operador, con el contenedor ya verificado y hasheado: !adb_acq_dest! (queda !adb_zip_dest!)"
goto ADB_ZIP_DONE
:ADB_ZIP_KEEPTREE
call :LOG_EVENT "Arbol extraido CONSERVADO junto al contenedor .7z: !adb_acq_dest!"
goto ADB_ZIP_DONE
:ADB_ZIP_BADCONTAINER
if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] The .7z exists but '7zr t' failed (code !_adbz_tel!): the container is!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] El .7z existe pero '7zr t' fallo (código !_adbz_tel!): el contenedor NO!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] NOT trustworthy. The extracted tree is KEPT: !adb_acq_dest!!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] es fiable. El árbol extraído se CONSERVA: !adb_acq_dest!!C_RESET!
call :LOG_EVENT "ADVERTENCIA: el contenedor !adb_zip_dest! existe pero no paso la prueba '7zr t' (codigo !_adbz_tel!). NO se borra el arbol extraido !adb_acq_dest!: es la unica copia de una extraccion no repetible."
goto ADB_ZIP_DONE
:ADB_ZIP_FAIL
if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Could not create the container ^(code !_adbz_el!^). The evidence stays uncompressed in: !adb_acq_dest!!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] No se pudo crear el contenedor ^(código !_adbz_el!^). La evidencia queda sin comprimir en: !adb_acq_dest!!C_RESET!
call :LOG_EVENT "Fallo compresion .7z (codigo !_adbz_el!) para: !adb_acq_dest!. El arbol extraido se CONSERVA intacto: es la unica copia de una extraccion no repetible."
goto ADB_ZIP_DONE
:ADB_ZIP_NO7Z
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] 7zr.exe was not found: !SEVENZIP!!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] No se encontró 7zr.exe: !SEVENZIP!!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] No container is produced. The extracted tree is KEPT and is the only!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] No se produce contenedor. El árbol extraído se CONSERVA y es la única!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] copy of a non-repeatable extraction: !adb_acq_dest!!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] copia de una extracción no repetible: !adb_acq_dest!!C_RESET!
call :LOG_EVENT "ESTADO=NO_VERIFICADO. LIMITACION DE ESTE HOST: 7zr.exe no esta disponible en !SEVENZIP!, asi que la evidencia NO se empaqueta en un contenedor .7z. El arbol extraido se CONSERVA intacto en !adb_acq_dest!: es la unica copia de una extraccion no repetible. No se ha borrado nada."
:ADB_ZIP_DONE
set "adb_more="
if /i "!FORENSIC_LANG!"=="EN" set /p adb_more="!C_PROMPT!Acquire another artifact? [Y/N]: !C_RESET!"
if /i not "!FORENSIC_LANG!"=="EN" set /p adb_more="!C_PROMPT!¿Adquirir otro artefacto? [S/N]: !C_RESET!"
:: El prompt en ingles ofrece [Y/N]; se acepta Y como S.
if /i "!adb_more!"=="Y" set "adb_more=S"
if /I "!adb_more!"=="S" goto ADB_NAV_BROWSE
goto ADB_ART_FINISH

:ADB_ART_FINISH
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_OK![+] ADB logical acquisition finished for: !ADB_SERIAL!!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Adquisición lógica ADB finalizada para: !ADB_SERIAL!!C_RESET!
call :LOG_EVENT "ADB adquisicion logica finalizada: !ADB_SERIAL!"
pause
goto MENU_ADB

:: ---------------------------------------------------------------------------
:: ADB_GETPROP_ROW  %1 = nombre de la propiedad
:: Anade una linea "propiedad = valor" al archivo de identificacion. Si la
:: propiedad no se puede leer se escribe asi explicitamente: un hueco silencioso
:: en la identificacion del aparato es peor que la constancia de que falta.
:: ---------------------------------------------------------------------------
:ADB_GETPROP_ROW
set "_adb_pv="
for /f "usebackq delims=" %%V in (`"!ADB_EXE!" -s !ADB_SERIAL! shell getprop %1 2^>nul`) do if not defined _adb_pv set "_adb_pv=%%V"
if not defined _adb_pv set "_adb_pv=(no legible en este dispositivo)"
>>"!_adb_idfile!" echo %1 = !_adb_pv!
exit /b 0

:: =====================================================
:: MÓDULO QEMU - CONVERSIÓN A FORMATO FORENSE RAW/IMG
:: =====================================================

:MENU_QEMU
set "HE_MODO="
cls
echo !C_BORDER!!LINE!!C_RESET!
call :HDR ACCENT "VIRTUAL DISK CONVERSION TO RAW/IMG (QEMU)" "CONVERSIÓN DE DISCO VIRTUAL A RAW/IMG (QEMU)"
call :HDR DIM "Supported formats: VMDK, VHD, VHDX, VDI" "Formatos soportados: VMDK, VHD, VHDX, VDI"
echo !C_BORDER!!LINE!!C_RESET!

:: Validar QEMU
if not exist "!QEMU_IMG!" (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] ERROR: qemu-img.exe was not found in:!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] ERROR: No se encontró qemu-img.exe en:!C_RESET!
    echo !C_ERR!    !QEMU_IMG!!C_RESET!
    pause
    goto MENU_VM
)

if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] This module converts virtual disk images to RAW or IMG format,!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Este módulo convierte imágenes de disco virtual a formato RAW o IMG,!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT!    compatible with Autopsy, Volatility, The Sleuth Kit, FTK and X-Ways.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT!    compatible con Autopsy, Volatility, The Sleuth Kit, FTK y X-Ways.!C_RESET!
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT!1. Select virtual disk file manually!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT!1. Seleccionar archivo de disco virtual manualmente!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT!2. Select folder (search for disks automatically)!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT!2. Seleccionar carpeta (buscar discos automáticamente)!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT!0. Back!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT!0. Volver!C_RESET!
echo !C_BORDER!!LINE!!C_RESET!
set "qemu_menu_opt="
if /i "!FORENSIC_LANG!"=="EN" set /p qemu_menu_opt="!C_PROMPT!Select an option: !C_RESET!"
if /i not "!FORENSIC_LANG!"=="EN" set /p qemu_menu_opt="!C_PROMPT!Selecciona una opción: !C_RESET!"

for /f "delims=0123456789" %%a in ("!qemu_menu_opt!") do (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Invalid option.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Opción inválida.!C_RESET!
    call :WAIT 2
    goto MENU_QEMU
)

if "!qemu_menu_opt!"=="0" goto MENU_VM
if "!qemu_menu_opt!"=="1" goto QEMU_SEL_FILE
if "!qemu_menu_opt!"=="2" goto QEMU_SEL_FOLDER

if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Invalid option.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Opción inválida.!C_RESET!
call :WAIT 2
goto MENU_QEMU

:QEMU_SEL_FILE
echo.
set "qemu_src="
if /i "!FORENSIC_LANG!"=="EN" set /p qemu_src="!C_PROMPT!Full path of the disk file (.vmdk, .vhd, .vhdx, .vdi) (0=cancel): !C_RESET!"
if /i not "!FORENSIC_LANG!"=="EN" set /p qemu_src="!C_PROMPT!Ruta completa del archivo de disco (.vmdk, .vhd, .vhdx, .vdi) (0=cancelar): !C_RESET!"
if "!qemu_src!"=="0" goto MENU_QEMU
if "!qemu_src!"=="" (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] No path was entered. Returning to the QEMU menu.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] No se introdujo ninguna ruta. Volviendo al menú QEMU.!C_RESET!
    call :WAIT 2
    goto MENU_QEMU
)
set "qemu_src=!qemu_src:"=!"

if not exist "!qemu_src!" (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] File not found: !qemu_src!!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Archivo no encontrado: !qemu_src!!C_RESET!
    pause
    goto QEMU_SEL_FILE
)

:: Pedir destino. Bloque UNICO: lo comparten la via de archivo suelto
:: (:QEMU_SEL_FILE) y la de busqueda en carpeta (:QEMU_SEL_FOUND). Las dos
:: llegan con !qemu_src! ya fijado y validado y las dos salen por MENU_QEMU,
:: por eso no hay ninguna etiqueta de reintento que parametrizar.
:ASK_QEMU_OUT
:: El destino por defecto es Derivados\, NO la carpeta de adquisiciones: lo que
:: sale de aqui es un artefacto derivado -el diario ya lo declara asi- y mezclarlo
:: con el original obliga a leer el log para saber cual de los dos es la evidencia.
set "qemu_out_dir="
if /i "!FORENSIC_LANG!"=="EN" set /p qemu_out_dir="!C_PROMPT!Destination folder [Enter = !DERIV_DEST!] (0=cancel): !C_RESET!"
if /i not "!FORENSIC_LANG!"=="EN" set /p qemu_out_dir="!C_PROMPT!Carpeta destino [Enter = !DERIV_DEST!] (0=cancelar): !C_RESET!"
if "!qemu_out_dir!"=="0" goto MENU_QEMU
if defined qemu_out_dir set "qemu_out_dir=!qemu_out_dir:"=!"
if not defined qemu_out_dir (
    set "qemu_out_dir=!DERIV_DEST!"
    if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Using default destination: !DERIV_DEST!!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Usando destino por defecto: !DERIV_DEST!!C_RESET!
)
call :VALIDATE_DEST_DIR "!qemu_out_dir!"
if not "!_VD_OK!"=="1" goto ASK_QEMU_OUT
if not exist "!qemu_out_dir!" mkdir "!qemu_out_dir!"

:: Obtener nombre base
for %%F in ("!qemu_src!") do set "qemu_base_name=%%~nF"

set "DEST=!qemu_out_dir!"
call :QEMU_CONVERT "!qemu_src!" "!qemu_out_dir!" "!qemu_base_name!"
pause
goto MENU_QEMU

:QEMU_SEL_FOLDER
echo.
set "qemu_scan_dir="
if /i "!FORENSIC_LANG!"=="EN" set /p qemu_scan_dir="!C_PROMPT!Folder to search for virtual disks (0=cancel): !C_RESET!"
if /i not "!FORENSIC_LANG!"=="EN" set /p qemu_scan_dir="!C_PROMPT!Carpeta donde buscar discos virtuales (0=cancelar): !C_RESET!"
if "!qemu_scan_dir!"=="0" goto MENU_QEMU
if "!qemu_scan_dir!"=="" (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] No folder was entered. Returning to the QEMU menu.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] No se introdujo ninguna carpeta. Volviendo al menú QEMU.!C_RESET!
    call :WAIT 2
    goto MENU_QEMU
)
set "qemu_scan_dir=!qemu_scan_dir:"=!"

if not exist "!qemu_scan_dir!" (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Folder not found.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Carpeta no encontrada.!C_RESET!
    pause
    goto QEMU_SEL_FOLDER
)

echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Searching virtual disks in: !qemu_scan_dir!!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Buscando discos virtuales en: !qemu_scan_dir!!C_RESET!
set "qemu_found=0"
:: Se exige la extension EXACTA: en cmd el comodin "*.vhd" casa tambien con los
:: .vhdx (ver :HV_QEMU_CLASSIFY), y cada .vhdx salia DOS veces en la lista.
for %%E in (vmdk vhd vhdx vdi) do (
    for %%F in ("!qemu_scan_dir!\*.%%E") do (
        if exist "%%F" if /i "%%~xF"==".%%E" (
            set /a qemu_found+=1
            set "QEMU_FILE_!qemu_found!=%%F"
            set "QEMU_NAME_!qemu_found!=%%~nxF"
            echo !C_TEXT!  !qemu_found!. %%~nxF!C_RESET!
        )
    )
)

if !qemu_found! equ 0 (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![-] No virtual disks found in that folder.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![-] No se encontraron discos virtuales en esa carpeta.!C_RESET!
    pause
    goto MENU_QEMU
)

echo.
:QEMU_SEL_FOUND
set "qemu_fsel="
if /i "!FORENSIC_LANG!"=="EN" set /p qemu_fsel="!C_PROMPT!Select disk [1-!qemu_found!, 0=cancel]: !C_RESET!"
if /i not "!FORENSIC_LANG!"=="EN" set /p qemu_fsel="!C_PROMPT!Seleccione disco [1-!qemu_found!, 0=cancelar]: !C_RESET!"
if "!qemu_fsel!"=="0" goto MENU_QEMU
for /f "delims=0123456789" %%a in ("!qemu_fsel!") do goto QEMU_SEL_FOUND
if !qemu_fsel! lss 1 goto QEMU_SEL_FOUND
if !qemu_fsel! gtr !qemu_found! goto QEMU_SEL_FOUND

call :NORM_SEL qemu_fsel
set "qemu_src=!QEMU_FILE_%qemu_fsel%!"
if not defined qemu_src goto QEMU_SEL_FOUND

:: El destino, la conversion y el retorno al menu son IDENTICOS a los de la
:: via de archivo suelto, asi que se reutiliza ese bloque en vez de mantener
:: una segunda copia que ya habia empezado a divergir en los comentarios.
goto ASK_QEMU_OUT

:: =====================================================
:: SUBRUTINA: QEMU_CONVERT
:: %1 = ruta archivo origen (entre comillas)
:: %2 = carpeta destino (entre comillas)
:: %3 = nombre base de salida (entre comillas)
:: =====================================================
:QEMU_CONVERT
set "qc_src=%~1"
set "qc_dest_dir=%~2"
set "qc_name=%~3"

:: Validar QEMU
if not exist "!QEMU_IMG!" (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] qemu-img.exe not found. Conversion skipped.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] qemu-img.exe no encontrado. Conversión omitida.!C_RESET!
    exit /b 1
)

:: Detectar formato por extensión
set "qc_ext="
for %%F in ("!qc_src!") do set "qc_ext=%%~xF"
set "qc_ext=!qc_ext:.=!"

set "qc_fmt="
if /I "!qc_ext!"=="vmdk" set "qc_fmt=vmdk"
if /I "!qc_ext!"=="vhd" set "qc_fmt=vpc"
if /I "!qc_ext!"=="vhdx" set "qc_fmt=vhdx"
if /I "!qc_ext!"=="avhdx" set "qc_fmt=vhdx"
if /I "!qc_ext!"=="vdi" set "qc_fmt=vdi"

if "!qc_fmt!"=="" (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Unsupported format: .!qc_ext!!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Formato no soportado: .!qc_ext!!C_RESET!
    if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Supported formats: .vmdk, .vhd, .vhdx, .avhdx, .vdi!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Formatos soportados: .vmdk, .vhd, .vhdx, .avhdx, .vdi!C_RESET!
    exit /b 1
)

echo.
echo !C_BORDER!!SUBLINE!!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_ACCENT!  QEMU-IMG CONVERSION TO FORENSIC FORMAT!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_ACCENT!  CONVERSIÓN QEMU-IMG A FORMATO FORENSE!C_RESET!
echo !C_BORDER!!SUBLINE!!C_RESET!
echo.

:: Seleccionar formato de salida
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT!Output format:!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT!Formato de salida:!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT!  1. RAW (.raw) - Recommended!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT!  1. RAW (.raw) - Recomendado!C_RESET!
echo !C_TEXT!  2. IMG (.img)!C_RESET!
:: Este era el unico menu del framework sin validacion: solo el "2" se comprobaba
:: y CUALQUIER otra entrada -un 7, un "abc", un dedazo- caia en silencio a RAW.
:: La extension forma parte del nombre de la evidencia, asi que una eleccion no
:: pedida no puede resolverse por defecto sin decirlo. Tampoco habia forma de
:: salir sin convertir.
:QC_FMT_ASK
set "qc_out_opt="
if /i "!FORENSIC_LANG!"=="EN" set /p qc_out_opt="!C_PROMPT!Select format [1-2, Enter = 1] (0=cancel): !C_RESET!"
if /i not "!FORENSIC_LANG!"=="EN" set /p qc_out_opt="!C_PROMPT!Seleccione formato [1-2, Enter = 1] (0=cancelar): !C_RESET!"
if "!qc_out_opt!"=="" set "qc_out_opt=1"
if "!qc_out_opt!"=="0" (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Conversion cancelled by the operator.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Conversión cancelada por el operador.!C_RESET!
    set "_LE_SRC=!qc_src!"
    call :LOG_EVENT "El operador cancelo en la eleccion de formato de salida. No se ejecuto qemu-img." "CONVERSION_QEMU" "OMITIDO"
    exit /b 0
)
set "qc_out_ext="
if "!qc_out_opt!"=="1" set "qc_out_ext=raw"
if "!qc_out_opt!"=="2" set "qc_out_ext=img"
if not defined qc_out_ext (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Invalid option. Enter 1, 2 or 0.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Opción inválida. Ingrese 1, 2 o 0.!C_RESET!
    goto QC_FMT_ASK
)

set "qc_output=!qc_dest_dir!\!qc_name!.!qc_out_ext!"

:: Verificar si ya existe
if exist "!qc_output!" (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![-] Already exists: !qc_output!!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![-] Ya existe: !qc_output!!C_RESET!
    set "qc_overwrite="
    if /i "!FORENSIC_LANG!"=="EN" set /p qc_overwrite="!C_PROMPT!Overwrite? [Y/N]: !C_RESET!"
    if /i not "!FORENSIC_LANG!"=="EN" set /p qc_overwrite="!C_PROMPT!¿Sobrescribir? [S/N]: !C_RESET!"
    rem El prompt en ingles ofrece [Y/N]; se acepta Y como S.
    if /i "!qc_overwrite!"=="Y" set "qc_overwrite=S"
    if /I not "!qc_overwrite!"=="S" (
        if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Conversion cancelled.!C_RESET!
        if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Conversión cancelada.!C_RESET!
        exit /b 0
    )
    del /f "!qc_output!" >nul 2>&1
)

:: Paso 1: Info del origen
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Source disk information:!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Información del disco origen:!C_RESET!
:: "-U" (force-share) y SIN silenciar el flujo de errores. Sin -U, qemu-img toma el
:: candado de imagen por defecto y sobre un origen en uso falla con "Failed to get
:: shared 'write' lock"; el "2>nul" ademas ocultaba el motivo, asi que el operador se
:: quedaba sin informacion del origen Y sin saber por que. Aqui -U es de solo lectura y
:: es inocuo, igual que en la via de adquisicion en caliente.
"!QEMU_IMG!" info -U "!qc_src!"
echo.

:: Paso 2: Hash SHA256 del ARCHIVO de origen (no necesariamente del disco).
:: Con un .vmdk de tipo "twoGbMaxExtentSparse" o "monolithicFlat" el archivo que
:: se indica aqui es solo el DESCRIPTOR -texto de unos cientos de bytes con el
:: layout de extents- y los datos viven en archivos aparte. Rotular eso como
:: "SHA256 del ORIGEN" invita a leerlo como hash del contenido del disco, que es
:: justo lo que la rama de adquisicion en caliente se prohibe a si misma afirmar.
:: Se mide el tamano y se detectan los extents para poder decir QUE se hasheo.
set "qc_src_size=0"
for %%Z in ("!qc_src!") do set "qc_src_size=%%~zZ"
set "qc_src_extents=0"
for %%X in ("!qc_src!") do set "qc_src_dir=%%~dpX"
for %%X in ("!qc_src!") do set "qc_src_base=%%~nX"
for %%E in ("!qc_src_dir!!qc_src_base!-s*.vmdk" "!qc_src_dir!!qc_src_base!-flat*.vmdk") do set "qc_src_extents=1"
set "qc_src_kind=archivo de origen completo"
if "!qc_src_extents!"=="1" set "qc_src_kind=DESCRIPTOR .vmdk - los datos del disco estan en extents aparte"
if /i "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Calculating the SHA256 of the source FILE... This may take several minutes.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Calculando SHA256 del ARCHIVO de origen... Esto puede tardar varios minutos.!C_RESET!
if "!qc_src_extents!"=="1" if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] This .vmdk is a descriptor of !qc_src_size! bytes: the hash covers the descriptor,!C_RESET!
if "!qc_src_extents!"=="1" if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] Este .vmdk es un descriptor de !qc_src_size! bytes: el hash es del descriptor,!C_RESET!
if "!qc_src_extents!"=="1" if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] NOT the disk contents. The authoritative hash is the one of the output image.!C_RESET!
if "!qc_src_extents!"=="1" if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] NO del contenido del disco. El hash autoritativo es el de la imagen de salida.!C_RESET!
set "qc_hash_src="
call :UTCNOW _QC_TS1
call :HASH_SHA256 "!qc_src!" qc_hash_src
call :UTCNOW _QC_TS2
if defined qc_hash_src set "qc_hash_src=!qc_hash_src: =!"
:: El motor de hash es HashMyFiles y :HASH_SHA256 devuelve vacio si no pudo calcular.
:: Se valida igualmente la forma antes de publicar el valor.
:: Aqui el caso es REAL y no teorico: el origen puede estar vivo y cambiando, asi
:: que sobre un extent VMDK de una VM encendida falla siempre. Sin validar el
:: formato, el informe de conversion publicaria el texto del error como SHA-256
:: del origen y :LOG_CMD lo registraria con codigo 0.
call :IS_SHA256 qc_hash_src
if not "!_IS_SHA_OK!"=="1" set "qc_hash_src="
if defined qc_hash_src (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_OK![+] SHA256 of the source FILE ^(!qc_src_size! bytes^): !qc_hash_src!!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_OK![+] SHA256 del ARCHIVO de origen ^(!qc_src_size! bytes^): !qc_hash_src!!C_RESET!
    call :LOG_CMD "QEMU_Hash_Origen" "HashMyFiles SHA256 ""!qc_src!""" "0" "!_QC_TS1!" "!_QC_TS2!" "!qc_src!" ""
) else (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![-] Could not calculate the source hash.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![-] No se pudo calcular hash del origen.!C_RESET!
    call :LOG_CMD "QEMU_Hash_Origen" "HashMyFiles SHA256 ""!qc_src!""" "1" "!_QC_TS1!" "!_QC_TS2!" "" ""
)
:: El informe imprime esta variable: sin marcador explicito quedaria un campo
:: SHA256 en blanco, que se lee como "no habia nada que hashear" en vez de como
:: "no se pudo calcular".
if not defined qc_hash_src set "qc_hash_src=NO_CALCULADO"

:: Paso 3: Conversión
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Starting conversion: .!qc_ext! -^> .!qc_out_ext!!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Iniciando conversión: .!qc_ext! -^> .!qc_out_ext!!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_DIM!    Source:  !qc_src!!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_DIM!    Origen:  !qc_src!!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_DIM!    Destination: !qc_output!!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_DIM!    Destino: !qc_output!!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_DIM!    Format: !qc_fmt! -^> raw!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_DIM!    Formato: !qc_fmt! -^> raw!C_RESET!
echo.
call :LOG_EVENT "Iniciando conversion QEMU: !qc_src! -> !qc_output! (!qc_fmt! -> raw)"

call :NEWGUID ACQ_GUID
set "ACQ_CMD=!TEMP!\forensic_cmd_!ACQ_GUID!.tmp"
:: "-t writeback": el defecto de "convert" es "unsafe", que IGNORA los flush. Ante un
:: corte de corriente o un fallo del medio, la imagen queda incompleta y qemu-img
:: devuelve 0 igualmente. La via de adquisicion en caliente ya lo corregia y su informe
:: califica ese defecto de indefendible; esta via, que trabaja sobre un origen estatico
:: y deberia ser la mas rigurosa, corria con el valor peligroso.
:: "-S 0": destino totalmente asignado, sin huecos sparse. No cambia los bytes ni el
:: SHA-256 -no es un argumento de integridad-, pero deja las dos vias coherentes.
:: "-U": apertura compartida declarada de forma explicita, como en la via caliente.
:: NO se usa --salvage aqui a proposito: sobre un origen estatico un error de lectura ES
:: un fallo que debe abortar la conversion, no un hueco que se rellena con ceros.
:: El flujo de errores se captura a archivo para que un fallo de la herramienta no se
:: quede solo en la consola.
:: Los tres archivos de esta conversion llevan el nombre de la imagen delante. Con
:: nombres fijos por carpeta, una segunda conversion en el mismo destino pisaba el
:: informe, los hashes y el log de errores de la primera.
set "qc_errlog=!qc_dest_dir!\!qc_name!_qemu-img_stderr.log"
>"!ACQ_CMD!" echo "!QEMU_IMG!" convert -p -f !qc_fmt! -O raw -U -S 0 -t writeback "!qc_src!" "!qc_output!" 2^>"!qc_errlog!"
call :ACQ_VER TOOLVER_QEMU "!QEMU_IMG!" "--version"
call :ACQUIRE "QEMU_Conversion" "!ACQ_CMD!"
set "_qc_el=!errorlevel!"
if "!_qc_el!"=="2" (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![ABORT] Conversion aborted by the user.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![ABORT] Conversión abortada por el usuario.!C_RESET!
    set "_LE_SRC=!qc_src!"
    set "_LE_RC=!_qc_el!"
    call :LOG_EVENT "Conversion QEMU interrumpida por el operador. La salida puede estar incompleta." "CONVERSION_QEMU" "ABORTADO"
    exit /b 1
)
if !_qc_el! neq 0 (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] ERROR: The conversion failed.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] ERROR: La conversión fallo.!C_RESET!
    set "_LE_SRC=!qc_src!"
    set "_LE_DST=!qc_output!"
    set "_LE_TOOL=qemu-img"
    set "_LE_RC=!_qc_el!"
    call :LOG_EVENT "Conversion QEMU fallida. NO se declara artefacto derivado utilizable." "CONVERSION_QEMU" "ERROR"
    exit /b 1
)

echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Conversion completed successfully.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Conversión completada exitosamente.!C_RESET!
set "_LE_SRC=!qc_src!"
set "_LE_DST=!qc_output!"
set "_LE_TOOL=qemu-img"
set "_LE_RC=!_qc_el!"
if exist "!qc_output!" for %%Z in ("!qc_output!") do set "_LE_SIZE=%%~zZ bytes"
call :LOG_EVENT "ARTEFACTO DERIVADO. El original NO se sustituye ni se modifica: se conserva con su propio hash. Formato de origen !qc_fmt! -> raw." "CONVERSION_QEMU" "EXITO"

:: Paso 4: Verificar destino
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Verifying converted image:!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Verificando imagen convertida:!C_RESET!
:: Mismo criterio que con el origen: -U y sin silenciar el flujo de errores.
"!QEMU_IMG!" info -U "!qc_output!"
echo.

:: Paso 5: Hash SHA256 del destino (OPCIONAL - decisión del operador)
:: El hash del ORIGEN (Paso 2) se mantiene SIEMPRE como control de integridad
:: del proceso; el del destino (la evidencia convertida) es opcional.
set "qc_dst_hashes=!qc_dest_dir!\!qc_name!_destino_hashes.txt"
call :HASH_EVIDENCE FILE "!qc_output!" "" "!qc_dst_hashes!" "QEMU_Destino"

:: Paso 6: Generar reporte de conversión
set "qc_report=!qc_dest_dir!\!qc_name!_conversion_report.txt"
echo ============================================== > "!qc_report!"
echo   REPORTE DE CONVERSION FORENSE (QEMU-IMG) >> "!qc_report!"
echo ============================================== >> "!qc_report!"
echo. >> "!qc_report!"
:: %DATE% %TIME% es hora LOCAL y el resto del framework fecha todo en UTC con :UTCNOW.
:: Mezclar husos dentro del mismo expediente hace que dos artefactos de la misma
:: actuacion parezcan estar en orden distinto del real.
call :UTCNOW _QC_RPT_TS
echo Fecha (UTC):     !_QC_RPT_TS! >> "!qc_report!"
echo Herramienta:     qemu-img (QEMU) >> "!qc_report!"
echo. >> "!qc_report!"
echo --- ORIGEN --- >> "!qc_report!"
echo Archivo:         !qc_src! >> "!qc_report!"
echo Formato:         !qc_fmt! (.!qc_ext!) >> "!qc_report!"
echo Naturaleza:      !qc_src_kind! >> "!qc_report!"
echo Tamano hasheado: !qc_src_size! bytes >> "!qc_report!"
echo SHA256 de ese archivo: !qc_hash_src! >> "!qc_report!"
if "!qc_src_extents!"=="1" echo   ALCANCE: este SHA-256 es del DESCRIPTOR, no del contenido del disco. Los >> "!qc_report!"
if "!qc_src_extents!"=="1" echo   datos viven en los extents y no estan cubiertos por este valor. No debe >> "!qc_report!"
if "!qc_src_extents!"=="1" echo   presentarse como hash del disco de origen ni como verificacion cruzada. >> "!qc_report!"
echo. >> "!qc_report!"
echo --- DESTINO --- >> "!qc_report!"
echo Archivo:         !qc_output! >> "!qc_report!"
echo Formato:         raw (.!qc_out_ext!) >> "!qc_report!"
echo Hash:            ver !qc_dst_hashes! ^(opcional - decision del operador^) >> "!qc_report!"
echo. >> "!qc_report!"
echo --- LINEA DE COMANDO EJECUTADA --- >> "!qc_report!"
echo   "!QEMU_IMG!" convert -p -f !qc_fmt! -O raw -U -S 0 -t writeback "!qc_src!" "!qc_output!" >> "!qc_report!"
echo   -t writeback  cache del destino EXPLICITA. El defecto de "convert" es "unsafe", >> "!qc_report!"
echo                 que ignora los flush: ante un corte la imagen queda incompleta y >> "!qc_report!"
echo                 qemu-img devuelve 0 igualmente. >> "!qc_report!"
echo   -S 0          destino totalmente asignado, sin huecos sparse. No altera los >> "!qc_report!"
echo                 bytes ni el SHA-256: no es un argumento de integridad. >> "!qc_report!"
echo   -U            apertura compartida declarada de forma explicita. >> "!qc_report!"
echo   sin --salvage sobre un origen estatico un error de lectura ES un fallo y debe >> "!qc_report!"
echo                 abortar la conversion, no rellenarse con ceros en silencio. >> "!qc_report!"
echo Flujo de errores de la herramienta: !qc_errlog! >> "!qc_report!"
echo. >> "!qc_report!"
echo --- INFO QEMU-IMG (DESTINO) --- >> "!qc_report!"
"!QEMU_IMG!" info -U "!qc_output!" >> "!qc_report!" 2>&1
echo. >> "!qc_report!"
echo ============================================== >> "!qc_report!"

echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Conversion report saved at:!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Reporte de conversión guardado en:!C_RESET!
echo !C_OK!    !qc_report!!C_RESET!
call :LOG_EVENT "Reporte de conversion generado: !qc_report!"

echo.
echo !C_BORDER!!SUBLINE!!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_OK!  CONVERSION COMPLETED SUCCESSFULLY!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_OK!  CONVERSIÓN COMPLETADA EXITOSAMENTE!C_RESET!
echo !C_BORDER!!SUBLINE!!C_RESET!
exit /b 0

:: =====================================================
:: ACQUIRE - Wrapper DFIR con proteccion CTRL+C
:: Params: %1=descripción  %2=ruta_archivo_cmd_temp
:: Códigos de salida: 0=ok  1=error  2=abortado
:: =====================================================

:ACQUIRE
:: Sin PowerShell no hay wrapper posible: cmd devolvia 9009 al no encontrar
:: powershell.exe y el operador veia el error crudo de cmd seguido de "Error al
:: clonar el disco" / "Error al volcar la memoria", sin ninguna pista de que la
:: causa era la ausencia de PowerShell (XP y Vista de serie no lo traen). Se
:: consulta la capa de capacidades que YA existe (PS_AVAILABLE) y se DEGRADA
:: ejecutando el comando directamente, declarando que se pierde la proteccion de
:: CTRL+C. Degradacion con aviso explicito, no un fallo sin explicacion.
set "ACQ_NOPS_REASON=NOPS"
if not defined PS_AVAILABLE goto ACQUIRE_NO_PS
:: Un PowerShell 1.0 (opcional en Vista) SI existe en el PATH, asi que
:: PS_AVAILABLE queda a 1, pero los tres .ps1 del framework declaran
:: "#Requires -Version 2.0" y ahi el wrapper se niega a arrancar. El operador veia
:: "adquisicion fallida" sin mas. Se comprueba la version y se degrada igual.
if defined PS_VER if !PS_VER! LSS 2 set "ACQ_NOPS_REASON=PSVER"
if defined PS_VER if !PS_VER! LSS 2 goto ACQUIRE_NO_PS
if not exist "!WRAPPER_PS1!" (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] WRAPPER not found: !WRAPPER_PS1!!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] WRAPPER no encontrado: !WRAPPER_PS1!!C_RESET!
    del "%~2" >nul 2>&1
    exit /b 1
)
:: Leer el comando del archivo temporal ANTES de que el wrapper lo elimine (para LOG_CMD)
:: Se usa "set /p" y NO "for /f". La sustitucion de la variable de for ocurre ANTES de
:: la expansion retardada, asi que cualquier "!" del comando se consumia como nombre de
:: variable: con el target compuesto de KAPE (--target !SANS_Triage) el par !...! se
:: comia el target Y el --tdest con su destino, y la cadena de custodia acababa
:: afirmando un comando que no era el ejecutado. Medido: quedaba
::   ... --tsource "C:" --target \Evid Folder" --vhdx "HOST" --quiet
:: "set /p" asigna el dato en crudo, sin expansion: preserva "!", "^" y las
:: redirecciones. Y no tiene el problema del eol de for /f, que se saltaba en silencio
:: cualquier linea que empezara por ';' dejando el campo Comando vacio.
set "_acq_cmd_str="
<"%~2" set /p "_acq_cmd_str="
call :UTCNOW _ACQ_TS_START
call :UTCNOW_SEGS _ACQ_S0
rem CP_ACTIVE es la pagina de codigos que quedo activa en la consola, y por tanto
rem la que uso "echo > archivo" al escribir este archivo de comando. Sin pasarla,
rem el wrapper leia suponiendo la pagina OEM del sistema y cualquier ruta de
rem evidencia con tilde o ene se corrompia: la herramienta recibia una ruta que no
rem existe y la adquisicion fallaba sin explicacion.
powershell -NoProfile -ExecutionPolicy Bypass -File "!WRAPPER_PS1!" -CmdFile "%~2" -Description "%~1" -CmdCodePage "!CP_ACTIVE!" -Lang "!FORENSIC_LANG!"
set "ACQ_EL=!errorlevel!"
:: El wrapper mantiene su contrato 0/1/2 -el 2 significa "abortado" para las ~30
:: llamadas de :ACQUIRE- pero deja el codigo REAL de la herramienta en "<cmdfile>.rc".
:: Sin esto, ewfacquire, ftkimager, dc3dd y qemu-img -que distinguen tipos de fallo por
:: codigo- quedaban todos reducidos a un "1" indistinguible en la cadena de custodia.
:: Se lee con "set /p" para no destruir nada raro que traiga la linea.
set "LOG_CMD_RAWRC="
if exist "%~2.rc" <"%~2.rc" set /p LOG_CMD_RAWRC=
if exist "%~2.rc" del "%~2.rc" >nul 2>&1
rem 99 = el wrapper no pudo compilar sus tipos P/Invoke (.NET inaccesible, politica
rem que bloquea Add-Type). No es un fallo de la adquisicion: el comando NI SE LANZO
rem y el archivo temporal sigue intacto, asi que se repite por la via degradada en
rem vez de dar por fallida una adquisicion que nunca empezo.
if "!ACQ_EL!"=="99" set "ACQ_NOPS_REASON=ADDTYPE"
if "!ACQ_EL!"=="99" goto ACQUIRE_NO_PS
call :UTCNOW _ACQ_TS_END
call :UTCNOW_SEGS _ACQ_S1
del "%~2" >nul 2>&1

:: Purgar cualquier entrada de teclado "fantasma" que haya quedado en el
:: buffer de la consola tras el proceso aislado (herramienta con mucha
:: salida como robocopy sin /NP). Bug conocido de cmd.exe: el siguiente
:: "set /p" del llamador puede leer una línea vacia la primera vez sin
:: que el operador haya escrito nada. "choice" limpia el buffer de
:: entrada al iniciar; /T 0 /D lo hace devolver de inmediato sin bloquear.
choice /c YN /n /t 0 /d Y >nul 2>&1
if "!ACQ_EL!"=="2" (
    echo.
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![ABORT] Acquisition ABORTED by the user.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![ABORT] Adquisición ABORTADA por el usuario.!C_RESET!
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i]     Document in the chain of custody: image may be incomplete.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i]     Documentar en cadena de custodia: imagen puede estar incompleta.!C_RESET!
    echo.
)
rem El comando NO se pasa como argumento: contiene comillas internas y rutas con
rem espacios, que desbalancean la tokenizacion del re-parseo (%~2 recibiria
rem fragmentos con comillas sueltas y los if de :LOG_CMD abortarian TODO el
rem script con "was unexpected at this time"). Se pasa vía variable + centinela.
:: ACQ_TOOL_VER lo fija el modulo que sabe QUE herramienta va a lanzar, y viaja al
:: octavo parametro de :LOG_CMD. Sin version no hay reproducibilidad: dos builds de la
:: misma herramienta pueden comportarse distinto y el expediente no podria atribuir el
:: resultado a ninguna en concreto (ISO/IEC 27037 7, ISO/IEC 27042, NIST SP 800-86 4).
:: Se limpia despues de usarla para que la siguiente adquisicion no herede una version
:: que no es la de su herramienta.
call :LOG_CMD "%~1" @ACQ_CMD_STR "!ACQ_EL!" "!_ACQ_TS_START!" "!_ACQ_TS_END!" "!DEST!" "" "!ACQ_TOOL_VER!"
call :ACQ_JOURNAL "%~1"
set "ACQ_TOOL_VER="
exit /b !ACQ_EL!

:: ---------------------------------------------------------------------------
:: ACQUIRE_NO_PS - Modo degradado sin PowerShell (XP/Vista de serie, o
:: instalaciones donde se ha retirado). Se ejecuta el MISMO comando, pero
:: directamente: el archivo temporal se renombra a .cmd para poder invocarlo con
:: "call" -un .tmp no es ejecutable- y se registra igual en la cadena de
:: custodia. Lo que se pierde, y se dice, es el dialogo de confirmacion de
:: CTRL+C: aqui un CTRL+C puede terminar el proceso por lotes dejando la
:: evidencia a medias, y eso hay que documentarlo si ocurre.
:: ---------------------------------------------------------------------------
:ACQUIRE_NO_PS
rem La causa concreta se dice UNA vez: no es lo mismo "no hay PowerShell" que
rem "hay PowerShell pero es anterior a 2.0" o "Add-Type no puede compilar". Las
rem tres llevan al mismo modo degradado, pero un tercero que lea el diario tiene
rem que poder distinguirlas.
if not "!ACQ_NOPS_WARNED!"=="1" if "!ACQ_NOPS_REASON!"=="PSVER" call :LOG_EVENT "LIMITACION DE ESTE HOST: PowerShell presente pero de version !PS_VER! (anterior a 2.0), que es el minimo que declaran los .ps1 del framework. Las adquisiciones se ejecutan sin el wrapper de proteccion de CTRL+C."
if not "!ACQ_NOPS_WARNED!"=="1" if "!ACQ_NOPS_REASON!"=="ADDTYPE" call :LOG_EVENT "LIMITACION DE ESTE HOST: el wrapper no pudo compilar sus tipos P/Invoke con Add-Type (.NET inaccesible o politica que lo bloquea). Las adquisiciones se ejecutan sin el wrapper de proteccion de CTRL+C."
if not "!ACQ_NOPS_WARNED!"=="1" (
    set "ACQ_NOPS_WARNED=1"
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] No usable PowerShell wrapper on this host: acquisitions run WITHOUT the!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] Sin wrapper de PowerShell utilizable: las adquisiciones se ejecutan SIN la!C_RESET!
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] CTRL+C protection wrapper. A CTRL+C may kill the batch and leave the!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] proteccion de CTRL+C. Un CTRL+C puede matar el proceso por lotes y!C_RESET!
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] evidence half written. Everything else keeps working.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] dejar la evidencia a medias. Todo lo demas sigue funcionando.!C_RESET!
    if "!ACQ_NOPS_REASON!"=="NOPS" call :LOG_EVENT "LIMITACION DE ESTE HOST: no hay PowerShell, asi que las adquisiciones se ejecutan sin el wrapper de proteccion de CTRL+C."
    call :LOG_EVENT "Consecuencia del modo degradado: un CTRL+C durante una adquisicion puede terminar el proceso por lotes y dejar la evidencia incompleta sin dialogo de confirmacion."
)
rem "set /p" y no "for /f" por el mismo motivo que en :ACQUIRE: for destruye los "!"
rem del comando (targets compuestos de KAPE) antes de que se pueda registrar.
set "_acq_cmd_str="
<"%~2" set /p "_acq_cmd_str="
set "_acq_nops_cmd=%~2.cmd"
move /y "%~2" "!_acq_nops_cmd!" >nul 2>&1
if not exist "!_acq_nops_cmd!" (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] The command file could not be prepared: !_acq_nops_cmd!!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] No se pudo preparar el archivo de comando: !_acq_nops_cmd!!C_RESET!
    del "%~2" >nul 2>&1
    exit /b 1
)
call :UTCNOW _ACQ_TS_START
call :UTCNOW_SEGS _ACQ_S0
rem Se invoca en un cmd.exe HIJO, no con "call": los archivos de comando de este
rem framework terminan en "exit 1" / "exit 0" para que el wrapper distinga exito
rem de fallo, y un "exit" sin /b dentro de un "call" mataria el framework
rem completo. En un proceso hijo ese exit es justo lo que queremos: se convierte
rem en el codigo de salida que leemos aqui.
rem /d: sin el AutoRun del registro, igual que el wrapper.
"%COMSPEC%" /d /c "!_acq_nops_cmd!"
set "ACQ_EL=!errorlevel!"
rem En esta via NO hay wrapper que normalice nada: el codigo que se acaba de capturar ES
rem el de la herramienta. Se registra tambien como codigo real para que el expediente
rem diga lo mismo por las dos vias y se pueda distinguir un fallo de otro.
set "LOG_CMD_RAWRC=!ACQ_EL!"
call :UTCNOW _ACQ_TS_END
call :UTCNOW_SEGS _ACQ_S1
del "!_acq_nops_cmd!" >nul 2>&1
call :LOG_CMD "%~1" @ACQ_CMD_STR "!ACQ_EL!" "!_ACQ_TS_START!" "!_ACQ_TS_END!" "!DEST!" "" "!ACQ_TOOL_VER!"
call :ACQ_JOURNAL "%~1"
set "ACQ_TOOL_VER="
exit /b !ACQ_EL!

:: ===========================================================================
:: Pantalla de arranque -- detecta el entorno paso a paso y muestra el
:: resultado de cada verificación. Al terminar quedan definidas las variables
:: de capacidades que consume el resto del framework: WIN_NAME, WIN_NT,
:: WIN_BUILD, WIN_ARCH, IS_ADMIN, PS_AVAILABLE, PS_VER, HAS_WMIC, HAS_ROBOCOPY,
:: HAS_HASHER, HV_ROLE, HAS_HYPERV, HAS_VMWARE, HAS_VBOX, HAS_DOCKER, HAS_WSL,
:: WSL_GEN, FIRMWARE, SECUREBOOT. CP_ACTIVE y ANSI_OK se calculan antes, en la
:: cabecera del script, porque gobiernan la propia escritura en pantalla y en los
:: archivos de comando.
:: ===========================================================================
:STARTUP_SCREEN
cls
echo !C_BORDER!!LINE!!C_RESET!
echo !C_TITLE!   A M B A R D F I R                                                  v!SCRIPT_VERSION!!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_DIM!   Forensic Acquisition Framework  .  Windows Platform!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_DIM!   Framework de Adquisición Forense  .  Plataforma Windows!C_RESET!
echo !C_DIM!   (c) 2026 Euclides Junior Ángeles Alcántara!C_RESET!
echo !C_BORDER!!LINE!!C_RESET!
echo.
set "_bw=0"
set "_bo=0"

if /i "!FORENSIC_LANG!"=="EN" echo !C_ACCENT!  [ System ]!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_ACCENT!  [ Sistema ]!C_RESET!

set "WIN_ARCH=x86"
if /i "%PROCESSOR_ARCHITECTURE%"=="AMD64" set "WIN_ARCH=x64"
if /i "%PROCESSOR_ARCHITECTURE%"=="ARM64" set "WIN_ARCH=ARM64"
if defined PROCESSOR_ARCHITEW6432 set "WIN_ARCH=x64"
set "WIN_NT=" & set "WIN_BUILD=" & set "_majhex=" & set "_minhex=" & set "_maj=" & set "_min=0"
for /f "tokens=3" %%a in ('reg query "HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion" /v CurrentMajorVersionNumber 2^>nul') do set "_majhex=%%a"
for /f "tokens=3" %%a in ('reg query "HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion" /v CurrentMinorVersionNumber 2^>nul') do set "_minhex=%%a"
if defined _majhex set /a _maj=_majhex 2>nul
if defined _minhex set /a _min=_minhex 2>nul
for /f "tokens=3" %%a in ('reg query "HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion" /v CurrentBuildNumber 2^>nul') do set "WIN_BUILD=%%a"
if defined _maj (set "WIN_NT=!_maj!.!_min!") else (for /f "tokens=3" %%a in ('reg query "HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion" /v CurrentVersion 2^>nul') do set "WIN_NT=%%a")
set "WIN_NAME=Windows (desconocido)"
if "!WIN_NT!"=="5.0" set "WIN_NAME=Windows 2000"
if "!WIN_NT!"=="5.1" set "WIN_NAME=Windows XP"
if "!WIN_NT!"=="5.2" set "WIN_NAME=Windows XP x64/2003"
if "!WIN_NT!"=="6.0" set "WIN_NAME=Windows Vista"
if "!WIN_NT!"=="6.1" set "WIN_NAME=Windows 7"
if "!WIN_NT!"=="6.2" set "WIN_NAME=Windows 8"
if "!WIN_NT!"=="6.3" set "WIN_NAME=Windows 8.1"
if "!WIN_NT!"=="10.0" (
    set "WIN_NAME=Windows 10"
    if defined WIN_BUILD if !WIN_BUILD! GEQ 22000 set "WIN_NAME=Windows 11"
)
call :BOOT_ROW OK "Sistema operativo|Operating system" "!WIN_NAME! build !WIN_BUILD!"
set /a _bo+=1
call :BOOT_ROW OK "Arquitectura del procesador|Processor architecture" "!WIN_ARCH!"
set /a _bo+=1

if defined ANSI_OK (
    call :BOOT_ROW OK "Consola con colores ANSI|Console with ANSI colour" ""
    set /a _bo+=1
) else (
    call :BOOT_ROW SKIP "Consola con colores ANSI|Console with ANSI colour" "No soportado - modo monocromo|Not supported, monochrome mode"
)

:: El framework escribe sus textos en UTF-8 y pide la pagina 65001 al arrancar. En
:: Windows XP ese cambio NO surte efecto y en Vista/7/8 lo acepta pero la fuente
:: raster de la consola no puede dibujar los caracteres: los rotulos con tilde
:: salen como basura. No se puede arreglar desde aqui sin renunciar a los acentos
:: en todo el framework, asi que se DECLARA: el operador sabe entonces que lo que
:: ve en pantalla esta degradado y que el problema no es la evidencia.
set "_cpshow=!CP_ACTIVE!"
if not defined CP_ACTIVE set "_cpshow=no legible"
if "!CP_ACTIVE!"=="65001" (
    call :BOOT_ROW OK "Consola en UTF-8 (pagina 65001)|Console in UTF-8 (code page 65001)" ""
    set /a _bo+=1
) else (
    call :BOOT_ROW WARN "Consola en UTF-8 (pagina 65001)|Console in UTF-8 (code page 65001)" "Activa la !_cpshow! - los acentos en pantalla saldran mal|Active page is !_cpshow!, accented text will render wrong"
    set /a _bw+=1
)

:: Misma sonda doble que la auto-elevacion: "net session" depende del servicio
:: Server y da falso negativo si esta detenido, mientras que leer HKU\S-1-5-19
:: solo lo permite un token elevado y no depende de ningun servicio.
set "IS_ADMIN="
net session >nul 2>&1 && set "IS_ADMIN=1"
if not defined IS_ADMIN reg query "HKU\S-1-5-19" >nul 2>&1 && set "IS_ADMIN=1"
if defined IS_ADMIN (
    call :BOOT_ROW OK "Privilegios de administrador|Administrator privileges" "Elevado|Elevated"
    set /a _bo+=1
) else (
    call :BOOT_ROW WARN "Privilegios de administrador|Administrator privileges" "Sin privilegios - limitado|No privileges, limited"
    set /a _bw+=1
)
echo.

if /i "!FORENSIC_LANG!"=="EN" echo !C_ACCENT!  [ Forensic tools ]!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_ACCENT!  [ Herramientas forenses ]!C_RESET!

:: VERSION DE POWERSHELL Y SECURE BOOT, LEIDOS DEL REGISTRO.
::
:: Antes esto lanzaba un proceso de PowerShell para preguntarle su propia version
:: y Confirm-SecureBootUEFI. Medido en este equipo: 1.140 ms, el 9,5% de todo el
:: arranque, para obtener dos datos que el registro ya publica. Las mismas dos
:: lecturas por "reg query" cuestan 32 ms cada una: 22 veces mas rapido.
::
:: Las claves son las que la propia documentacion de Microsoft define:
::   HKLM\SOFTWARE\Microsoft\PowerShell\<N>\PowerShellEngine\PowerShellVersion
::     N=3 cubre PowerShell 3.0 a 5.1 (la rama 3 se reutiliza), N=1 cubre 1.0/2.0.
::   HKLM\SYSTEM\CurrentControlSet\Control\SecureBoot\State\UEFISecureBootEnabled
::     0x1 = activo, 0x0 = inactivo. La clave NO EXISTE en equipos con BIOS
::     heredada, y esa ausencia se traduce a NA, no a "desactivado": son cosas
::     distintas y confundirlas seria afirmar un hecho no observado.
::
:: Se conserva la sonda por PATH para PS_AVAILABLE: es lo que decide si los .ps1
:: del framework pueden ejecutarse, y eso depende del binario, no del registro.
set "PS_AVAILABLE="
set "PS_VER=0"
set "_sb=NA"
for %%P in (powershell.exe) do if not "%%~$PATH:P"=="" set "PS_AVAILABLE=1"
if defined PS_AVAILABLE (
    set "_psreg="
    for /f "tokens=3" %%a in ('reg query "HKLM\SOFTWARE\Microsoft\PowerShell\3\PowerShellEngine" /v PowerShellVersion 2^>nul') do set "_psreg=%%a"
    if not defined _psreg for /f "tokens=3" %%a in ('reg query "HKLM\SOFTWARE\Microsoft\PowerShell\1\PowerShellEngine" /v PowerShellVersion 2^>nul') do set "_psreg=%%a"
    if defined _psreg for /f "tokens=1 delims=." %%m in ("!_psreg!") do set "PS_VER=%%m"
    rem Respaldo: si el registro no publica la version pero el binario existe, se
    rem pregunta a PowerShell. Cuesta lo que costaba antes, pero solo en el equipo
    rem raro donde el registro no lo diga, en vez de en todos.
    if "!PS_VER!"=="0" for /f "usebackq delims=" %%v in (`powershell -NoProfile -Command "$PSVersionTable.PSVersion.Major" 2^>nul`) do set "PS_VER=%%v"
)
set "_sbreg="
for /f "tokens=3" %%a in ('reg query "HKLM\SYSTEM\CurrentControlSet\Control\SecureBoot\State" /v UEFISecureBootEnabled 2^>nul') do set "_sbreg=%%a"
if "!_sbreg!"=="0x1" set "_sb=ON"
if "!_sbreg!"=="0x0" set "_sb=OFF"
:: PS_VER tiene que ser un NUMERO para poder usarse como puerta. Con PowerShell 1.0
:: (opcional en Vista) no existe $PSVersionTable, la salida llega como ";NA" y
:: PS_VER se quedaba con el literal "NA": se mostraba "vNA" y cualquier comparacion
:: numerica posterior daria un resultado arbitrario. Se normaliza y, si no es
:: numero, se declara 1, que es exactamente lo que significa: PowerShell presente
:: pero por debajo del "#Requires -Version 2.0" de los tres .ps1 del framework.
set "_psv_bad="
if not defined PS_VER set "_psv_bad=1"
if defined PS_VER for /f "delims=0123456789" %%x in ("!PS_VER!") do set "_psv_bad=1"
if defined _psv_bad set "PS_VER=1"
if not defined _sb set "_sb=NA"
if defined PS_AVAILABLE if !PS_VER! GEQ 2 (
    call :BOOT_ROW OK "PowerShell" "v!PS_VER!"
    set /a _bo+=1
)
if defined PS_AVAILABLE if !PS_VER! LSS 2 (
    call :BOOT_ROW WARN "PowerShell" "v!PS_VER! - anterior a 2.0: los modulos .ps1 no arrancan|v!PS_VER!, older than 2.0: the .ps1 modules cannot run"
    set /a _bw+=1
)
if not defined PS_AVAILABLE (
    call :BOOT_ROW WARN "PowerShell" "No encontrado - modo degradado|Not found, degraded mode"
    set /a _bw+=1
)

set "HAS_WMIC="
for %%P in (wmic.exe) do if not "%%~$PATH:P"=="" set "HAS_WMIC=1"
if defined HAS_WMIC (
    call :BOOT_ROW OK "WMIC" ""
    set /a _bo+=1
) else (
    call :BOOT_ROW SKIP "WMIC" "No disponible en esta version|Not available on this version"
)

:: robocopy NO viene en Windows XP (era del Resource Kit): es in-box desde Vista.
:: De el dependen la adquisicion logica completa, la copia de configuracion y
:: snapshots de VMware y VirtualBox, y TODAS las copias de Hyper-V. No se sustituye
:: por xcopy: xcopy no preserva ACL ni las tres marcas de tiempo, asi que seria una
:: DEGRADACION forense presentada como equivalencia, y eso no se hace. Se detecta, se
:: dice que modulos quedan fuera, se BLOQUEA la entrada a esos modulos con el motivo
:: en pantalla (:ROBOCOPY_MISSING) y el resto del framework sigue disponible.
set "HAS_ROBOCOPY="
for %%P in (robocopy.exe) do if not "%%~$PATH:P"=="" set "HAS_ROBOCOPY=1"
if defined HAS_ROBOCOPY (
    call :BOOT_ROW OK "Robocopy" ""
    set /a _bo+=1
) else (
    call :BOOT_ROW WARN "Robocopy" "Ausente - sin copia logica ni de VM|Missing: no logical copy, no VM copy"
    set /a _bw+=1
)

:: SONDEO FUNCIONAL DE HashMyFiles, el UNICO motor de hash del framework.
::
:: Aqui habia un sondeo de certutil como via de respaldo. Se retiro por completo:
:: certutil es un binario del EQUIPO ANALIZADO y en un host comprometido puede
:: estar manipulado para devolver un hash falso con apariencia de valido. Eso
:: contamina la cadena de custodia sin dejar rastro y es peor que no tener hash.
:: El juego de herramientas de una adquisicion tiene que ser propio y verificado.
::
:: No basta con que el ejecutable exista: se comprueba FUNCIONALMENTE pidiendole
:: el SHA-256 de este mismo archivo y exigiendo 64 digitos hexadecimales. Un
:: HashMyFiles presente pero incapaz -conmutadores no reconocidos, .cfg que
:: desactiva el algoritmo, sin permiso de escritura para el informe- es
:: indistinguible de uno ausente hasta que ya hay evidencia sobre la mesa. Y ese
:: fallo es SILENCIOSO: la herramienta sale con codigo 0 y el campo vacio.
set "HAS_HASHER="
set "_ct_h="
if not exist "!HMF_EXE!" goto HASHER_CHK_DONE
call :HASH_SHA256 "%~f0" _ct_h
if defined _ct_h set "HAS_HASHER=1"
if not defined HAS_HASHER call :LOG_EVENT "LIMITACION DE ESTE HOST: HashMyFiles esta presente en el arbol de herramientas pero no devolvio un SHA-256 valido en la prueba funcional de arranque. NO se sustituye por certutil ni por ningun binario del equipo analizado. Las adquisiciones de esta sesion quedaran SIN huella criptografica y eso NO puede presentarse como integridad verificada."
:HASHER_CHK_DONE
if defined HAS_HASHER (
    call :BOOT_ROW OK "Motor de hash (HashMyFiles)|Hashing engine (HashMyFiles)" ""
    set /a _bo+=1
) else (
    call :BOOT_ROW WARN "Motor de hash (HashMyFiles)|Hashing engine (HashMyFiles)" "No operativo: la evidencia quedaria SIN hash|Not operational: evidence would be left WITHOUT a hash"
    set /a _bw+=1
)


rem La fila propia de HashMyFiles se retiro: la fila "Motor de hash" de arriba
rem ya informa de su presencia Y de que responda de verdad a la prueba
rem funcional, que es el dato que importa. Dos filas para la misma
rem herramienta descuadraban el recuento de correctos y advertencias.

if exist "!KAPE!" (
    call :BOOT_ROW OK "KAPE (Triaje)|KAPE (triage)" ""
    set /a _bo+=1
) else (
    call :BOOT_ROW SKIP "KAPE (Triaje)|KAPE (triage)" "No disponible|Not available"
)

if exist "!QEMU_IMG!" (
    call :BOOT_ROW OK "QEMU-img" ""
    set /a _bo+=1
) else (
    call :BOOT_ROW SKIP "QEMU-img" "No disponible|Not available"
)

if exist "!WRAPPER_PS1!" (
    call :BOOT_ROW OK "Modulo de control CTRL+C|CTRL+C control module" ""
    set /a _bo+=1
) else (
    call :BOOT_ROW WARN "Modulo de control CTRL+C|CTRL+C control module" "No encontrado|Not found"
    set /a _bw+=1
)
echo.

if /i "!FORENSIC_LANG!"=="EN" echo !C_ACCENT!  [ Hypervisors and containers ]!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_ACCENT!  [ Hipervisores y contenedores ]!C_RESET!

:: sc query vmms (servicio de Hyper-V) es instantaneo; Get-Command Get-VM
:: cargaria el módulo completo de Hyper-V y tarda varios segundos.
:: La sonda estaba DENTRO de "if defined PS_AVAILABLE", pero sc.exe no necesita
:: PowerShell: con PowerShell ausente y el rol presente, HAS_HYPERV quedaba
:: falsamente vacio. Se desacopla y se informa por separado de las dos cosas
:: distintas que son: que el rol este, y que se pueda operar con el. El modulo de
:: Hyper-V SI necesita PowerShell (el modulo Hyper-V es de PowerShell), asi que sin
:: PowerShell se declara presente pero NO operable y no se habilita el modulo: eso
:: es decir la verdad, no ocultar la mitad.
:: "sc query" sale 0 tanto con el servicio EN EJECUCION como DETENIDO: solo un
:: servicio INEXISTENTE da 1060. Con el rol instalado y vmms detenido o
:: deshabilitado, el arranque anunciaba "Hyper-V: Disponible" y luego el modulo
:: decia "No se encontraron maquinas virtuales". Se lee el STATE, que si es
:: accionable para el operador.
set "HAS_HYPERV="
set "HV_ROLE="
set "HV_VMMS_STATE="
for /f "tokens=4" %%A in ('sc query vmms 2^>nul ^| findstr /i /c:"STATE"') do if not defined HV_VMMS_STATE set "HV_VMMS_STATE=%%A"
sc query vmms >nul 2>&1 && set "HV_ROLE=1"
if defined HV_ROLE if defined PS_AVAILABLE set "HAS_HYPERV=1"
if defined HV_ROLE if not defined PS_AVAILABLE (
    call :BOOT_ROW WARN "Hyper-V" "Rol presente pero sin PowerShell no es operable|Role present, not operable without PowerShell"
    set /a _bw+=1
    call :LOG_EVENT "LIMITACION DE ESTE HOST: el rol de Hyper-V esta presente (servicio vmms detectado) pero no hay PowerShell, y todo el gobierno de Hyper-V pasa por su modulo de PowerShell. El modulo de Hyper-V del framework queda deshabilitado: no es un fallo, es una capacidad ausente del sistema."
)
if defined HAS_HYPERV if /i "!HV_VMMS_STATE!"=="RUNNING" (
    call :BOOT_ROW OK "Hyper-V" "Disponible|Available"
    set /a _bo+=1
)
if defined HAS_HYPERV if /i not "!HV_VMMS_STATE!"=="RUNNING" (
    call :BOOT_ROW WARN "Hyper-V" "Rol presente, servicio vmms NO en ejecucion (!HV_VMMS_STATE!)|Role present, vmms service NOT running (!HV_VMMS_STATE!)"
    set /a _bw+=1
)
if not defined HAS_HYPERV if not defined HV_ROLE call :BOOT_ROW SKIP "Hyper-V" "No habilitado|Not enabled"

set "HAS_VMWARE="
:: Mismo problema que se corrigio en HAS_VBOX y por la misma razon: esta deteccion
:: solo miraba el arbol empaquetado y el PATH, mientras :RESOLVE_VMWARE mira
:: ademas %ProgramFiles%\VMware\VMware Workstation y ...\VMware Player. Con
:: Workstation instalado y FUERA del PATH -que es la instalacion por defecto- el
:: arranque y el menu decian "VMware: No detectado" mientras el subsistema
:: funcionaba entero. Ahora las dos derivan de la MISMA cascada.
:: :RESOLVE_VMWARE no imprime nada, no falla nunca y es idempotente.
call :RESOLVE_VMWARE
if defined VMRUN_EXE set "HAS_VMWARE=1"
if defined HAS_VMWARE (
    call :BOOT_ROW OK "VMware" "Detectado|Detected"
    set /a _bo+=1
) else (
    call :BOOT_ROW SKIP "VMware" "No detectado|Not detected"
)

set "HAS_VBOX="
:: Antes esta deteccion solo miraba el arbol empaquetado y el PATH, mientras
:: :RESOLVE_VBOX miraba ademas %ProgramFiles%: las dos podian discrepar. Medido
:: en este equipo (VirtualBox 7.2.12 instalado y FUERA del PATH): el arranque y
:: el menu decian "VirtualBox: No detectado" mientras el modulo funcionaba. Y al
:: contrario, bastaba una copia empaquetada inservible para decir "Detectado".
:: Ahora las dos derivan de la MISMA rutina, que ademas consulta
:: %VBOX_MSI_INSTALL_PATH% y el registro.
call :VBOX_RESOLVE_CORE
if defined VBOX_EXE set "HAS_VBOX=1"
if defined HAS_VBOX (
    call :BOOT_ROW OK "VirtualBox" "Detectado|Detected"
    set /a _bo+=1
) else (
    call :BOOT_ROW SKIP "VirtualBox" "No detectado|Not detected"
)

set "HAS_DOCKER=" & set "DOCKER_EXE="
for %%P in (docker.exe) do if not "%%~$PATH:P"=="" set "HAS_DOCKER=1" & set "DOCKER_EXE=%%~$PATH:P"
if defined HAS_DOCKER (
    call :BOOT_ROW OK "Docker" "Detectado|Detected"
    set /a _bo+=1
) else (
    call :BOOT_ROW SKIP "Docker" "No detectado|Not detected"
)

:: La sonda solo acredita que EXISTE wsl.exe, y wsl.exe esta desde Windows 10 1607
:: con WSL 1. Rotularlo "WSL 2: Disponible" era una afirmacion que el dato no
:: sostiene, y un informe de entorno forense no puede llevar eso. WSL 2 requiere
:: build 18917 o superior, asi que se dice lo que se sabe: que la herramienta esta,
:: y si la build admite WSL 2 o solo WSL 1.
set "HAS_WSL="
for %%P in (wsl.exe) do if not "%%~$PATH:P"=="" set "HAS_WSL=1"
set "WSL_GEN=wsl.exe presente - solo WSL 1 en esta build|wsl.exe present, WSL 1 only on this build"
if defined WIN_BUILD if !WIN_BUILD! GEQ 18917 set "WSL_GEN=wsl.exe presente - el sistema admite WSL 2|wsl.exe present, the system supports WSL 2"
if defined HAS_WSL (
    call :BOOT_ROW OK "WSL" "!WSL_GEN!"
    set /a _bo+=1
) else (
    call :BOOT_ROW SKIP "WSL" "No disponible|Not available"
)

set "HAS_ADB="
if exist "!ADB_EXE!" set "HAS_ADB=1"
if not defined HAS_ADB for %%P in (adb.exe) do if not "%%~$PATH:P"=="" (
    set "HAS_ADB=1"
    set "ADB_EXE=%%~$PATH:P"
)
if defined HAS_ADB (
    call :BOOT_ROW OK "ADB (Android)|ADB (Android)" "Detectado|Detected"
    set /a _bo+=1
) else (
    call :BOOT_ROW SKIP "ADB (Android)|ADB (Android)" "No detectado|Not detected"
)
echo.

if /i "!FORENSIC_LANG!"=="EN" echo !C_ACCENT!  [ Subsystems ]!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_ACCENT!  [ Subsistemas ]!C_RESET!

:: _sb ya fue obtenido en la única llamada a PowerShell de la seccion Herramientas.
:: Si no hubo dato (NA), se cae a bcdedit como deteccion mínima de UEFI.
set "FIRMWARE=BIOS/Legacy"
set "SECUREBOOT=N/D"
if "!_sb!"=="ON"  (set "FIRMWARE=UEFI" & set "SECUREBOOT=Activado")
if "!_sb!"=="OFF" (set "FIRMWARE=UEFI" & set "SECUREBOOT=Desactivado")
if "!_sb!"=="NA" (
    bcdedit /enum {current} 2>nul | findstr /i "winload.efi" >nul 2>&1 && set "FIRMWARE=UEFI"
)
call :BOOT_ROW OK "Firmware / Secure Boot" "!FIRMWARE! - SB: !SECUREBOOT!"
set /a _bo+=1

:: Flag /J de robocopy (I/O sin buffer, ideal para .vhdx/.vmem gigantes): solo
:: existe desde Windows 8 (build 9200). En Win7 se omite o robocopy falla.
set "RBC_J="
if defined WIN_BUILD if !WIN_BUILD! GEQ 9200 set "RBC_J=/J"

call :LOG_INIT

:: IDENTIFICACION DEL CASO, UNA VEZ AL ARRANCAR. Antes solo la rama de FTK Imager
:: pedia caso/evidencia/examinador: dc3dd, dd, ewfacquire, RAM, VMware, VirtualBox,
:: Hyper-V, Docker, ADB y KAPE producian evidencia SIN identificador de caso, y el
:: "quien" se reducia a %USERNAME%, que es una cuenta del sistema y no un examinador
:: identificado. ISO/IEC 27037 7.1.3 exige identificacion unica de cada item.
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_ACCENT!  [ Case identification ]!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_ACCENT!  [ Identificación del caso ]!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_DIM!   Recorded in every chain-of-custody entry. Enter accepts the default.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_DIM!   Consta en cada entrada de la cadena de custodia. Enter acepta el valor por defecto.!C_RESET!
set "FORENSIC_CASE=SIN_CASO"
set "FORENSIC_EVID=SIN_ID"
set "FORENSIC_EXAMINER=%USERNAME%"
if /i "!FORENSIC_LANG!"=="EN" set /p FORENSIC_CASE="!C_PROMPT!   Case # [SIN_CASO]: !C_RESET!"
if /i not "!FORENSIC_LANG!"=="EN" set /p FORENSIC_CASE="!C_PROMPT!   Caso # [SIN_CASO]: !C_RESET!"
if /i "!FORENSIC_LANG!"=="EN" set /p FORENSIC_EVID="!C_PROMPT!   Evidence # [SIN_ID]: !C_RESET!"
if /i not "!FORENSIC_LANG!"=="EN" set /p FORENSIC_EVID="!C_PROMPT!   Evidencia # [SIN_ID]: !C_RESET!"
if /i "!FORENSIC_LANG!"=="EN" set /p FORENSIC_EXAMINER="!C_PROMPT!   Examiner [%USERNAME%]: !C_RESET!"
if /i not "!FORENSIC_LANG!"=="EN" set /p FORENSIC_EXAMINER="!C_PROMPT!   Examinador [%USERNAME%]: !C_RESET!"
if defined FORENSIC_CASE set "FORENSIC_CASE=!FORENSIC_CASE:"=!"
if defined FORENSIC_EVID set "FORENSIC_EVID=!FORENSIC_EVID:"=!"
if defined FORENSIC_EXAMINER set "FORENSIC_EXAMINER=!FORENSIC_EXAMINER:"=!"
if "!FORENSIC_CASE!"=="" set "FORENSIC_CASE=SIN_CASO"
if "!FORENSIC_EVID!"=="" set "FORENSIC_EVID=SIN_ID"
if "!FORENSIC_EXAMINER!"=="" set "FORENSIC_EXAMINER=%USERNAME%"
:: Los tres datos dejan de ser texto suelto dentro del mensaje del diario y
:: pasan a ser la jerarquia real del repositorio. Se llama ANTES del primer
:: asiento para que la propia apertura de sesion quede ya escrita dentro del
:: caso al que pertenece, y no en un log global comun a todos los casos.
call :CASE_REPO
call :LOG_EVENT "SESION INICIADA. Caso: !FORENSIC_CASE! / Evidencia: !FORENSIC_EVID! / Examinador declarado: !FORENSIC_EXAMINER! / Cuenta del sistema: !USERNAME! en !COMPUTERNAME! (!WIN_NAME! !WIN_ARCH!). AMBARDFIR v!SCRIPT_VERSION!."

:: Inventario de herramientas: version y SHA-256 de cada binario de adquisicion.
:: YA NO SE CALCULA AQUI. Se midio que costaba 4.540 ms -el 38% de un arranque de
:: 11.940 ms- interrogando y hasheando 19 binarios que en la mayoria de sesiones
:: no se llegan a usar. Ahora lo genera :TOOL_INVENTORY_ONCE la primera vez que
:: :LOG_CMD va a escribir un asiento, es decir JUSTO ANTES de que exista la
:: primera evidencia. El valor forense es identico: el inventario sigue estando
:: completo y fechado antes de cualquier adquisicion, y sigue referenciado desde
:: cada entrada del diario de comandos. Lo unico que cambia es que no se paga su
:: coste en sesiones donde no se adquiere nada.
set "TI_DONE="

:: LIMITACION DE REGISTRO DECLARADA UNA VEZ POR SESION. Sin PowerShell ni WMIC,
:: :UTCNOW degrada a hora LOCAL. La degradacion es la decision correcta (XP/Vista/7
:: sin hacks), pero la limitacion viajaba solo en un sufijo de un caracter. Aqui
:: queda en el diario global de la sesion, que es lo que un tercero lee.
if not defined PS_AVAILABLE if not defined HAS_WMIC call :LOG_EVENT "LIMITACION DE REGISTRO: este equipo no dispone de PowerShell ni de WMIC, asi que TODAS las marcas de tiempo de esta sesion son HORA LOCAL del host !COMPUTERNAME!, NO UTC, y llevan el sufijo _HORALOCAL_SIN_ZONA. No son comparables directamente con marcas UTC de otros artefactos y esa conversion debe hacerla el analista."
if not defined PS_AVAILABLE if not defined HAS_WMIC if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN!   [i] No PowerShell and no WMIC: every timestamp this session is LOCAL time, not UTC.!C_RESET!
if not defined PS_AVAILABLE if not defined HAS_WMIC if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN!   [i] Sin PowerShell ni WMIC: todas las marcas de esta sesión son hora LOCAL, no UTC.!C_RESET!

:: LIMITACION DE COPIA. Sin robocopy no hay via valida para la adquisicion logica
:: ni para las copias de VMware, VirtualBox e Hyper-V. Se declara aqui, al empezar,
:: y no cuando ya se ha elegido un origen: xcopy NO es un sustituto -no preserva ACL
:: ni las tres marcas de tiempo- y presentarlo como equivalente falsearia el alcance
:: de la copia.
if not defined HAS_ROBOCOPY call :LOG_EVENT "LIMITACION DE ESTE HOST: robocopy.exe no esta disponible (no viene en Windows XP, es in-box desde Vista). Quedan BLOQUEADOS al entrar, con el motivo en pantalla y asiento propio en este diario: la adquisicion logica de archivos y carpetas; la copia del estado guardado .sav y el clon completo de VirtualBox; el volcado de memoria, la reconstruccion de snapshots y el clon completo de VMware; los tres modulos de Hyper-V (memoria, discos y clon completo); y la adquisicion de volumenes de Docker. La adquisicion de disco de VMware y de VirtualBox SI se ejecuta -no depende de robocopy-, pero dentro de ella NO se preservan los archivos de configuracion ni los de snapshots, y cada omision deja su propio asiento. NO se sustituye por xcopy: xcopy no preserva ACL ni las tres marcas de tiempo, asi que no es una copia equivalente y presentarla como tal falsearia el alcance. El resto del framework sigue operativo."
if not defined HAS_ROBOCOPY if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN!   [i] No robocopy on this host: logical acquisition and VM folder copies are unavailable.!C_RESET!
if not defined HAS_ROBOCOPY if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN!   [i] Sin robocopy: no hay adquisición lógica ni copia de carpetas de VM en este equipo.!C_RESET!

:: LIMITACION DE HUELLA. Sin HashMyFiles operativo no hay forma de calcular
:: un hash, y eso NO puede acabar en un informe como "integridad verificada": la
:: evidencia se adquiere igual, pero queda SIN huella y hay que decirlo.
:: La sola presencia del ejecutable NO basta: manda la prueba FUNCIONAL de
:: arranque (HAS_HASHER), porque el fallo de HashMyFiles es silencioso -sale con
:: codigo 0 y el campo del hash vacio-.
set "_hash_none=1"
if defined HAS_HASHER set "_hash_none="
if defined _hash_none call :LOG_EVENT "LIMITACION DE ESTE HOST: HashMyFiles, el unico motor de hash admitido, no esta operativo, asi que NO se puede calcular ninguna huella criptografica en esta sesion. NO se sustituye por certutil ni por ningun binario del equipo analizado: un hasher manipulado devolveria un valor falso con apariencia de valido y contaminaria la cadena de custodia peor que la ausencia de hash. La evidencia se puede adquirir, pero quedara SIN hash: NO debe declararse integridad verificada de nada adquirido en este equipo mientras esta condicion persista."
if defined _hash_none if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR!   [i] HashMyFiles not operational: NO hash can be computed this session.!C_RESET!
if defined _hash_none if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR!   [i] HashMyFiles no operativo: en esta sesión NO se puede calcular ningún hash.!C_RESET!
echo.

echo !C_BORDER!!LINE!!C_RESET!
if !_bw! EQU 0 (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_OK!   [+] Platform ready.   !_bo! components verified.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_OK!   [+] Plataforma lista.   !_bo! componentes verificados.!C_RESET!
) else (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN!   [*] Platform ready with !_bw! warning/s.   !_bo! OK.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN!   [*] Plataforma lista con !_bw! advertencia/s.   !_bo! correctos.!C_RESET!
    set "_BOOT_WARN=1"
)
echo !C_BORDER!!LINE!!C_RESET!
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_DIM!   Press any key to continue to the main menu...!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_DIM!   Presione cualquier tecla para continuar al menú principal...!C_RESET!
pause >nul
cls
exit /b

:BOOT_ROW
:: %1=OK^|WARN^|SKIP^|ERR  %2=etiqueta  %3=detalle
:: Imprime una fila de arranque con icono de estado, etiqueta alineada y detalle.
:: No usa reposicionamiento de cursor (robusto en cmd.exe clasico y moderno).
setlocal enabledelayedexpansion
set "_br_l=%~2"
set "_br_d=%~3"
:: Etiqueta y detalle aceptan el formato "español|english". Se elige el lado
:: según FORENSIC_LANG; si no hay parte inglesa, se reutiliza la espanola.
if /i not "!FORENSIC_LANG!"=="EN" goto BR_ES
for /f "tokens=1,* delims=|" %%a in ("!_br_l!") do if not "%%b"=="" set "_br_l=%%b"
for /f "tokens=1,* delims=|" %%a in ("!_br_d!") do if not "%%b"=="" set "_br_d=%%b"
goto BR_PAD
:BR_ES
for /f "tokens=1 delims=|" %%a in ("!_br_l!") do set "_br_l=%%a"
for /f "tokens=1 delims=|" %%a in ("!_br_d!") do set "_br_d=%%a"
:BR_PAD
:: 34 = la etiqueta mas larga que existe ("Console in UTF-8 (code page 65001)"),
:: asi que ninguna se trunca. Antes el relleno era 42 y sobraban 8 columnas que
:: solo servian para empujar el detalle fuera del lienzo.
set "_br_lbl=!_br_l!                                              "
set "_br_lbl=!_br_lbl:~0,34!"
set "_br_ic=!C_OK![ OK ]!C_RESET!"
if /i "%~1"=="WARN" set "_br_ic=!C_WARN![WARN]!C_RESET!"
if /i "%~1"=="SKIP" set "_br_ic=!C_DIM![ -- ]!C_RESET!"
if /i "%~1"=="ERR"  set "_br_ic=!C_ERR![FAIL]!C_RESET!"
:: El prefijo fijo mide 11 columnas (4 de sangria + 6 del icono + 1 separador).
:: Si etiqueta y detalle no caben juntos, el detalle baja a su propia linea
:: sangrada en vez de recortarse: los detalles largos son justamente los avisos
:: de ausencia o degradacion -los escenarios de XP, Vista y 7- y son los que hay
:: que poder leer enteros. El detalle mas largo que existe mide 61, asi que en
:: dos lineas el maximo es 11+61=72 y nunca desborda.
call :HDRLEN "!_br_d!"
set /a _br_tot=45 + !_hdr_n!
if !_br_tot! LEQ !PANEL_W! goto BR_ONELINE
echo     !_br_ic! !_br_l!
echo            !C_DIM!!_br_d!!C_RESET!
goto BR_DONE
:BR_ONELINE
echo     !_br_ic! !_br_lbl!!C_DIM!!_br_d!!C_RESET!
:BR_DONE
endlocal
exit /b

:: ===========================================================================
:: NORM_SEL - Normaliza un indice de selección quitando ceros a la izquierda.
:: Sin esto, escribir "01" pasa la validación (digitos, >=1, <=count) pero la
:: expansion indirecta busca PREFIJO_01, que no existe -> selección vacia.
:: NO se usa "set /a": interpreta 010 como octal (=8) y falla con 08/09.
:: Uso: call :NORM_SEL nombre_de_variable
:: ===========================================================================
:NORM_SEL
setlocal enabledelayedexpansion
set "_ns=!%~1!"
:NORM_SEL_STRIP
if not "!_ns!"=="" if "!_ns:~0,1!"=="0" set "_ns=!_ns:~1!" & goto NORM_SEL_STRIP
if "!_ns!"=="" set "_ns=0"
endlocal & set "%~1=%_ns%"
exit /b 0

:: ---------------------------------------------------------------------------
:: NEWGUID <var>  -> identificador único para nombres de archivo temporal.
:: Usa PowerShell si esta; si no, fallback portatil (RANDOM + hora).
:: ---------------------------------------------------------------------------
:NEWGUID
setlocal enabledelayedexpansion
set "_g="
if defined PS_AVAILABLE (
    for /f "usebackq delims=" %%g in (`powershell -NoProfile -Command "[guid]::NewGuid().ToString('N')" 2^>nul`) do set "_g=%%g"
)
if not defined _g (
    set "_t=!TIME::=!"
    set "_t=!_t: =!"
    set "_t=!_t:,=!"
    set "_t=!_t:.=!"
    set "_g=!RANDOM!!RANDOM!!_t!"
)
endlocal & set "%~1=%_g%"
exit /b

:: ---------------------------------------------------------------------------
:: UTCNOW <var> [COMPACT]  -> marca de tiempo. Con PowerShell: UTC ISO-8601.
:: Sin PowerShell: hora LOCAL vía WMIC (limitación documentada en el log).
:: ---------------------------------------------------------------------------
:: ===========================================================================
:: UTCNOW - marca de tiempo para la cadena de custodia.
::
:: POR QUE YA NO SE PREGUNTA EL RELOJ EN CADA LLAMADA
:: Cada invocacion lanzaba un proceso de PowerShell solo para leer la hora.
:: Medido en este equipo: 650 ms por llamada, 6 llamadas en el arranque, 3.900 ms
:: -el 32,7% de los 11.940 ms que tardaba en abrir-. Y el coste no era solo del
:: arranque: :LOG_EVENT llama aqui en CADA asiento del diario, asi que toda la
:: sesion pagaba 650 ms por linea registrada.
::
:: Ahora se establece UNA base autoritativa por sesion -con la misma cascada de
:: siempre: PowerShell, luego WMIC, luego hora local- y las marcas siguientes se
:: derivan sumando el tiempo transcurrido segun el reloj local. El transcurrido
:: es el mismo en cualquier huso, asi que sumarlo a una base UTC da UTC.
::
:: PRECISION: identica al segundo. Lo unico que se hereda de la base es el
:: DESFASE con UTC, que no cambia durante una sesion salvo cambio de huso o de
:: horario de verano; si el reloj local retrocede -cruce de medianoche incluido-
:: se vuelve a pedir una base autoritativa en lugar de extrapolar.
::
:: El sufijo sigue viajando DENTRO del dato: Z = UTC real, L = hora local porque
:: solo habia WMIC, y _HORALOCAL_SIN_ZONA cuando no hay ninguna via. Esa
:: degradacion no se toca: es la que permite a un tercero saber que reloj lee.
:: ===========================================================================
:UTCNOW
if not defined _TSB_KIND call :UTCNOW_BASE
if not defined _TSB_KIND goto UTCNOW_CRUDO

setlocal enabledelayedexpansion
call :UTCNOW_SEGS _now
set /a "_dl=_now-_TSB_LOCAL"
endlocal & set "_UTCNOW_DL=%_dl%"

rem Reloj local hacia atras: medianoche, cambio de huso o ajuste del sistema. No
rem se extrapola sobre una base que ya no vale; se pide una base nueva.
if !_UTCNOW_DL! LSS 0 (
    set "_TSB_KIND="
    call :UTCNOW_BASE
    set "_UTCNOW_DL=0"
)

setlocal enabledelayedexpansion
set /a "_tot=_TSB_SEC+_UTCNOW_DL"
set /a "_dd=_tot/86400"
set /a "_ss=_tot%%86400"
set /a "_j=_TSB_JDN+_dd"
rem Numero de dia juliano a fecha civil (algoritmo de Fliegel y Van Flandern).
rem Todo es division entera, que es lo que hace set /a, y los valores intermedios
rem caben de sobra en 32 bits con signo para cualquier fecha razonable.
set /a "_a=_j+32044"
set /a "_b=(4*_a+3)/146097"
set /a "_c=_a-146097*_b/4"
set /a "_d=(4*_c+3)/1461"
set /a "_e=_c-1461*_d/4"
set /a "_m=(5*_e+2)/153"
set /a "_DD=_e-(153*_m+2)/5+1"
set /a "_MM=_m+3-12*(_m/10)"
set /a "_YY=100*_b+_d-4800+_m/10"
set /a "_hh=_ss/3600"
set /a "_mi=(_ss%%3600)/60"
set /a "_se=_ss%%60"
if !_MM! LSS 10 set "_MM=0!_MM!"
if !_DD! LSS 10 set "_DD=0!_DD!"
if !_hh! LSS 10 set "_hh=0!_hh!"
if !_mi! LSS 10 set "_mi=0!_mi!"
if !_se! LSS 10 set "_se=0!_se!"
if /i "%~2"=="COMPACT" (
    set "_ts=!_YY!!_MM!!_DD!_!_hh!!_mi!!_se!!_TSB_KIND!"
) else (
    set "_ts=!_YY!-!_MM!-!_DD!T!_hh!:!_mi!:!_se!!_TSB_KIND!"
)
endlocal & set "%~1=%_ts%"
exit /b

:UTCNOW_CRUDO
rem Sin PowerShell y sin WMIC no hay forma de obtener UTC en batch puro. Se usa
rem hora local y se ETIQUETA COMO TAL: una marca sin zona es indistinguible de
rem una marca UTC mal formada, y quien compare el diario con otros artefactos
rem tiene que poder saber que reloj esta leyendo.
setlocal enabledelayedexpansion
set "_ts=!DATE!_!TIME!"
set "_ts=!_ts: =!"
set "_ts=!_ts!_HORALOCAL_SIN_ZONA"
endlocal & set "%~1=%_ts%"
exit /b

:UTCNOW_SEGS
rem Segundos transcurridos del dia segun el reloj local. %TIME% trae la hora sin
rem cero a la izquierda (" 2:15:29,86"), y un "08" o "09" se interpretaria como
rem octal en set /a, asi que se fuerza base 10 con el prefijo 1 y se resta.
setlocal enabledelayedexpansion
set "_t=%TIME%"
set "_t=!_t: =0!"
set /a "_h=1!_t:~0,2!-100"
set /a "_m=1!_t:~3,2!-100"
set /a "_s=1!_t:~6,2!-100"
set /a "_r=_h*3600+_m*60+_s"
endlocal & set "%~1=%_r%"
exit /b

:UTCNOW_BASE
rem Establece la base de tiempo de la sesion. Se llama UNA vez, o de nuevo si el
rem reloj local retrocede. Registra ademas el instante local en que se tomo, que
rem es contra lo que se mide el transcurrido.
call :UTCNOW_SEGS _TSB_LOCAL
set "_TSB_KIND="
set "_bY=" & set "_bMo=" & set "_bD=" & set "_bH=" & set "_bMi=" & set "_bS="
if defined PS_AVAILABLE (
    for /f "usebackq tokens=1-6 delims=-" %%a in (`powershell -NoProfile -Command "[DateTime]::UtcNow.ToString('yyyy-MM-dd-HH-mm-ss')" 2^>nul`) do (
        set "_bY=%%a" & set "_bMo=%%b" & set "_bD=%%c"
        set "_bH=%%d" & set "_bMi=%%e" & set "_bS=%%f"
    )
    if defined _bS set "_TSB_KIND=Z"
)
if not defined _TSB_KIND if defined HAS_WMIC (
    set "_wdt="
    for /f "skip=1 tokens=1 delims=." %%W in ('wmic os get LocalDateTime 2^>nul') do if not defined _wdt set "_wdt=%%W"
    if defined _wdt (
        set "_bY=!_wdt:~0,4!" & set "_bMo=!_wdt:~4,2!" & set "_bD=!_wdt:~6,2!"
        set "_bH=!_wdt:~8,2!" & set "_bMi=!_wdt:~10,2!" & set "_bS=!_wdt:~12,2!"
        set "_TSB_KIND=L"
    )
)
if not defined _TSB_KIND exit /b 0
rem Fecha civil a numero de dia juliano. El prefijo 1 y el -100 evitan que un mes
rem o un dia con cero a la izquierda se tomen por octal.
set /a "_nY=1!_bY!-10000"
set /a "_nMo=1!_bMo!-100"
set /a "_nD=1!_bD!-100"
set /a "_ja=(14-_nMo)/12"
set /a "_jy=_nY+4800-_ja"
set /a "_jm=_nMo+12*_ja-3"
set /a "_TSB_JDN=_nD+(153*_jm+2)/5+365*_jy+_jy/4-_jy/100+_jy/400-32045"
set /a "_TSB_SEC=(1!_bH!-100)*3600+(1!_bMi!-100)*60+(1!_bS!-100)"
exit /b 0

:: =====================================================
:: SISTEMA DE LOGS FORENSE v3.0  (solo texto plano)
:: - Logs\Forensic_Commands.log : cada comando externo ejecutado (:LOG_CMD)
:: - <DEST>\Forensic_Journal.log : diario de eventos por evidencia (:LOG_EVENT)
:: =====================================================

:LOG_INIT
:: Crea directorio de logs (Script\Logs, dos niveles arriba de Sistema\)
for %%F in ("!SYS_DIR!\..\..\Logs") do set "LOG_DIR=%%~fF"
if not exist "!LOG_DIR!" mkdir "!LOG_DIR!" >nul 2>&1
exit /b


:CASE_REPO
:: Convierte CASO y EVIDENCIA en la jerarquia real del repositorio:
::     Evidencias\<CASO>\Logs\            diario y comandos del caso
::     Evidencias\<CASO>\<EVIDENCIA>\     adquisiciones de ese item
:: Antes los tres datos solo viajaban como texto dentro del mensaje del diario:
:: la evidencia de dos casos distintos caia en las MISMAS carpetas y solo el
:: timestamp las separaba, y Logs\ era global, comun a todos los casos.
::
:: EL EXAMINADOR NO ES UN NIVEL DE CARPETA, y es deliberado. Es metadato de
:: custodia, no contenedor: si un segundo perito verifica el mismo item, un nivel
:: <EXAMINADOR> parte ese item en dos arboles, justo lo contrario de la
:: identificacion unica que exige ISO/IEC 27037 7.1.3. Consta en Caso.txt y en
:: la cabecera de cada asiento del diario, que es donde un tercero lo lee.
set "_cr_case=!FORENSIC_CASE!"
set "_cr_evid=!FORENSIC_EVID!"
call :SANITIZE_SEG _cr_case
call :SANITIZE_SEG _cr_evid
set "_cr_root=!EVID_ROOT!\!_cr_case!"
set "_cr_item=!_cr_root!\!_cr_evid!"
mkdir "!_cr_item!" >nul 2>&1
:: Una sola comprobacion cubre TODO lo que el saneo no puede ver de antemano:
:: comodines, nombres reservados (CON, PRN, AUX), unidad sin espacio o de solo
:: lectura. Si la carpeta no existe despues del mkdir, el nombre no era valido.
if exist "!_cr_item!" goto CR_OK
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![-] Could not create the case folder: !_cr_item!!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![-] No se pudo crear la carpeta del caso: !_cr_item!!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] Falling back to the evidence root: !EVID_ROOT!!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] Se usara la raiz de evidencias: !EVID_ROOT!!C_RESET!
set "DEFAULT_DEST=!EVID_ROOT!"
set "DERIV_DEST=!EVID_ROOT!"
call :LOG_EVENT "Repositorio por caso NO creado: la ruta !_cr_item! no es valida en este volumen (comodines, nombre reservado, permisos o falta de espacio). Se adquiere sobre la raiz !EVID_ROOT!. La trazabilidad del caso queda unicamente en el texto de cada asiento."
exit /b
:CR_OK
mkdir "!_cr_root!\Logs" >nul 2>&1
set "CASE_ROOT=!_cr_root!"
set "DEFAULT_DEST=!_cr_item!"
set "DERIV_DEST=!_cr_item!\Derivados"
if exist "!_cr_root!\Logs" set "LOG_DIR=!_cr_root!\Logs"
:: Ficha del caso. Quien reciba la carpeta debe poder decir de que caso es, quien
:: la abrio y cuando SIN abrir un diario de diez mil lineas.
call :UTCNOW _cr_ts
set "_cr_ficha=!_cr_root!\Caso.txt"
if exist "!_cr_ficha!" goto CR_FICHA
>>"!_cr_ficha!" echo AMBARDFIR v!SCRIPT_VERSION! - FICHA DEL CASO 2>nul
>>"!_cr_ficha!" echo ====================================================== 2>nul
>>"!_cr_ficha!" echo Caso    : !FORENSIC_CASE! 2>nul
>>"!_cr_ficha!" echo Carpeta : !_cr_root! 2>nul
>>"!_cr_ficha!" echo( 2>nul
>>"!_cr_ficha!" echo Sesiones de adquisicion abiertas sobre este caso: 2>nul
:CR_FICHA
>>"!_cr_ficha!" echo [!_cr_ts!] evidencia=!FORENSIC_EVID! examinador=!FORENSIC_EXAMINER! cuenta=!USERNAME! host=!COMPUTERNAME! ruta=!_cr_item! 2>nul
call :LOG_EVENT "Repositorio del caso establecido. Adquisiciones: !_cr_item! - Artefactos derivados: !_cr_item!\Derivados - Diario y comandos: !_cr_root!\Logs - Ficha: !_cr_ficha!. El examinador declarado (!FORENSIC_EXAMINER!) consta en la ficha y en cada asiento, no como nivel de carpeta: un item de evidencia no se duplica por cambiar de perito."
exit /b


:SANITIZE_SEG
:: %1 = NOMBRE de la variable a sanear (se modifica en el sitio). Un caso escrito
:: "2026/01" o "C:2026" crearia un subdirectorio fantasma o saltaria de unidad EN
:: SILENCIO, que es el fallo peligroso: la evidencia acabaria donde nadie la busca
:: y el diario diria otra cosa. Aqui esos separadores se neutralizan; el resto de
:: nombres invalidos los caza el mkdir de :CASE_REPO, que falla de forma ruidosa.
:: SIN setlocal a proposito: devolver el valor con "endlocal & set VAR=%tmp%" lo
:: re-expandiria y romperia con &, ^ o %. Todo se lee con !...!, que no reinterpreta.
set "_s=!%~1!"
set "_s=!_s:\=-!"
set "_s=!_s:/=-!"
set "_s=!_s::=-!"
set "_s=!_s: =_!"
:: MAX_PATH son 260 caracteres y por debajo de este segmento aun cuelgan
:: plataforma, nombre de VM, timestamp y, en un clon completo, el arbol entero de
:: la maquina. 24 caracteres por segmento es el techo que deja margen para eso.
set "_s=!_s:~0,24!"
if not defined _s set "_s=SIN_DATO"
set "%~1=!_s!"
set "_s="
exit /b


:LOG_EVENT
:: Escribe el diario de eventos en texto plano dentro de la carpeta de evidencia.
:: IMPORTANTE: %~1 puede contener parentesis (ej: IDs de contenedor). NO expandir
:: %~1 dentro de un bloque if(...) porque un ")" en el mensaje cierra el bloque
:: prematuramente -> "X was unexpected at this time". Se usa flujo lineal.
set "_le_msg=%~1"
:: Argumentos 2 y 3 OPCIONALES: sin ellos el asiento sale en una linea, igual que
:: siempre. Con ellos sale el bloque estructurado. Las 375 llamadas existentes,
:: que pasan un unico argumento, siguen funcionando sin cambio alguno.
set "_le_op=%~2"
set "_le_res=%~3"
if not defined _le_op set "_le_op=EVENTO"
:: Plataforma y VM vienen del contexto que fija :LOG_CTX al entrar en cada flujo,
:: no de cada llamada: asi no hay que tocar los 375 sitios para ganar los campos.
set "_le_plat=SISTEMA"
set "_le_vm=-"
if defined LOGCTX_PLAT set "_le_plat=!LOGCTX_PLAT!"
if defined LOGCTX_VM set "_le_vm=!LOGCTX_VM!"
call :UTCNOW LGT
:: Un diario que descarta entradas EN SILENCIO no es un registro auditable. Antes,
:: todo evento producido antes de fijar DEST, o con DEST apuntando a algo que ya no
:: existe (unidad extraida, cancelacion temprana, ruta con "!"), desaparecia sin
:: dejar constancia de que habia desaparecido. Y son precisamente los eventos de
:: cancelacion, de fallo de herramienta y de advertencia los que caen en esos
:: momentos. Ahora, si no hay carpeta de evidencia, el evento va al diario GLOBAL
:: de la sesion: se pierde la agrupacion por evidencia, nunca el evento.
if "!DEST!"=="" goto LE_GLOBAL
if not exist "!DEST!" goto LE_GLOBAL
set "_le_file=!DEST!\Forensic_Journal.log"
goto LE_WRITE
:LE_GLOBAL
:: LOG_INIT resuelve LOG_DIR a partir de SYS_DIR. Sin SYS_DIR resolveria una ruta
:: relativa al directorio actual y crearia una carpeta Logs en un sitio arbitrario:
:: se prefiere perder el evento antes que ensuciar el sistema analizado.
if not defined SYS_DIR exit /b
if not defined LOG_DIR call :LOG_INIT
if not exist "!LOG_DIR!" call :LOG_INIT
if not exist "!LOG_DIR!" exit /b
set "_le_file=!LOG_DIR!\Forensic_Journal_Global.log"
:LE_WRITE
:: %~1 puede traer ")" (IDs de contenedor, rutas). Todo el bloque es lineal y usa
:: if de una sola linea: NUNCA if(...) alrededor de !_le_msg!, que cerraria el
:: bloque antes de tiempo -> "X was unexpected at this time".
if defined _le_res goto LE_BLOQUE
>>"!_le_file!" echo [!LGT!] [!COMPUTERNAME! - !USERNAME!] [!_le_plat!] [!_le_vm!] [!_le_op!] !_le_msg! 2>nul
exit /b
:LE_BLOQUE
>>"!_le_file!" echo( 2>nul
>>"!_le_file!" echo [!LGT!] [!COMPUTERNAME! - !USERNAME!] [!_le_plat!] [!_le_vm!] [!_le_op!] [!_le_res!] 2>nul
if defined LOGCTX_UUID >>"!_le_file!" echo     uuid        : !LOGCTX_UUID! 2>nul
if defined _LE_SRC >>"!_le_file!" echo     origen      : !_LE_SRC! 2>nul
if defined _LE_DST >>"!_le_file!" echo     destino     : !_LE_DST! 2>nul
if defined _LE_TOOL >>"!_le_file!" echo     herramienta : !_LE_TOOL! 2>nul
if defined _LE_CMD >>"!_le_file!" echo     comando     : !_LE_CMD! 2>nul
if defined _LE_SIZE >>"!_le_file!" echo     tamano      : !_LE_SIZE! 2>nul
if defined _LE_DUR >>"!_le_file!" echo     duracion    : !_LE_DUR! 2>nul
if defined _LE_RC >>"!_le_file!" echo     codigo      : !_LE_RC! 2>nul
if defined _le_msg >>"!_le_file!" echo     detalle     : !_le_msg! 2>nul
set "_LE_SRC="
set "_LE_DST="
set "_LE_TOOL="
set "_LE_CMD="
set "_LE_SIZE="
set "_LE_DUR="
set "_LE_RC="
exit /b

:LOG_CTX
:: Fija el contexto que encabezara los asientos siguientes. %1=plataforma
:: %2=nombre de VM/contenedor %3=UUID/GUID (opcional).
set "LOGCTX_PLAT=%~1"
set "LOGCTX_VM=%~2"
set "LOGCTX_UUID=%~3"
if not defined LOGCTX_VM set "LOGCTX_VM=-"
exit /b

:ACQ_JOURNAL
:: Asiento de cierre de CUALQUIER adquisicion. No ejecuta ni altera nada: publica
:: al diario datos que :ACQUIRE YA tenia medidos (codigo de salida y las dos marcas
:: de tiempo) y los que el modulo llamador declaro en ACQ_SRC / ACQ_DST, exactamente
:: el mismo patron que ya se usaba para ACQ_TOOL_VER.
set "_aj_res=ERROR"
if "!ACQ_EL!"=="0" set "_aj_res=EXITO"
if "!ACQ_EL!"=="2" set "_aj_res=ABORTADO"
set "_LE_TOOL=!ACQ_TOOL_VER!"
set "_LE_CMD=!_acq_cmd_str!"
set "_LE_RC=!ACQ_EL!"
:: El wrapper reduce todo fallo a 1; el codigo REAL de la herramienta viaja aparte.
if defined LOG_CMD_RAWRC if not "!LOG_CMD_RAWRC!"=="!ACQ_EL!" set "_LE_RC=!ACQ_EL! (codigo real de la herramienta: !LOG_CMD_RAWRC!)"
set "_LE_SRC=!ACQ_SRC!"
set "_LE_DST=!ACQ_DST!"
set "_LE_SIZE="
if defined ACQ_DST if exist "!ACQ_DST!" for %%Z in ("!ACQ_DST!") do set "_LE_SIZE=%%~zZ bytes"
set "_LE_DUR="
if defined _ACQ_S0 if defined _ACQ_S1 call :ACQ_DUR
call :LOG_EVENT "" "%~1" "!_aj_res!"
set "ACQ_SRC="
set "ACQ_DST="
set "_ACQ_S0="
set "_ACQ_S1="
exit /b

:ACQ_DUR
setlocal enabledelayedexpansion
set /a "_d=_ACQ_S1-_ACQ_S0"
if !_d! LSS 0 set /a "_d=0"
set /a "_h=_d/3600"
set /a "_m=(_d%%3600)/60"
set /a "_s=_d%%60"
set "_t=00!_h!"
set "_u=00!_m!"
set "_v=00!_s!"
endlocal & set "_LE_DUR=%_t:~-2%:%_u:~-2%:%_v:~-2%"
exit /b


:: ===========================================================================
:: LOG_CMD - Registro exhaustivo de cada comando externo ejecutado
:: Params: %1=Módulo  %2=ComandoCompleto  %3=ExitCode
::         %4=Timestamp_inicio  %5=Timestamp_fin
::         %6=RutaSalida (opcional)  %7=ArchivoHash (opcional)
:: Escribe una entrada legible en Logs\Forensic_Commands.log (texto plano).
:: ===========================================================================
:LOG_CMD
rem El inventario de herramientas se genera aqui, PEREZOSAMENTE, la primera vez
rem que se va a escribir un asiento de comando. Antes se hacia en el arranque y
rem costaba 4.540 ms medidos a TODA sesion, se adquiriera algo o no. Este es el
rem punto correcto: no hay ninguna entrada del diario de comandos que pueda
rem referenciar el inventario sin que este exista ya.
call :TOOL_INVENTORY_ONCE
set "_lc_module=%~1"
set "_lc_cmd=%~2"
rem Centinela @ACQ_CMD_STR: :ACQUIRE entrega el comando vía variable porque
rem contiene comillas internas que romperian la tokenizacion de argumentos.
if "!_lc_cmd!"=="@ACQ_CMD_STR" set "_lc_cmd=!_acq_cmd_str!"
set "_lc_exit=%~3"
set "_lc_tstart=%~4"
set "_lc_tend=%~5"
set "_lc_out=%~6"
set "_lc_hash=%~7"
:: _lc_ver es OPCIONAL y lo fija el llamador que conoce la version de su herramienta.
:: Se limpia siempre al entrar: si no se limpiara, una entrada sin version heredaria
:: la de la llamada anterior y la cadena de custodia atribuiria una version falsa.
if "%~8"=="" (set "_lc_ver=") else (set "_lc_ver=%~8")
:: LOG_CMD_RAWRC es OPCIONAL y lo fija :ACQUIRE con el codigo REAL que devolvio la
:: herramienta. El campo ExitCode es el del wrapper (0/1/2 normalizado), que no
:: distingue tipos de fallo: ewfacquire, ftkimager, dc3dd y qemu-img si los distinguen
:: por codigo y esa informacion no llegaba al expediente. Se consume y se LIMPIA al
:: entrar, igual que la version: una entrada sin dato no puede heredar el de la anterior
:: y atribuir a esta herramienta un codigo que no es suyo.
set "_lc_rawrc=!LOG_CMD_RAWRC!"
set "LOG_CMD_RAWRC="
:: "echo   !_lc_cmd!" con la variable vacia no imprime una linea en blanco: echo
:: sin argumentos imprime su propio estado ("ECHO is off." o su traduccion), y eso
:: acababa escrito en el campo Comando de la cadena de custodia. Reproducido. Se
:: garantiza contenido: un marcador explicito es defendible, el estado de echo no.
if not defined _lc_cmd set "_lc_cmd=(comando no registrado)"
set "_lc_status=Exito"
if "!_lc_exit!"=="2" set "_lc_status=Cancelado"
if not "!_lc_exit!"=="0" if not "!_lc_exit!"=="2" set "_lc_status=Error"
:: Duración
set "_lc_dur=N/D"
if not "!_lc_tstart!"=="" if not "!_lc_tend!"=="" (
    call :TIMEDIFF _lc_dur "!_lc_tstart!" "!_lc_tend!"
)
:: Entrada legible en Forensic_Commands.log
set "CMD_LOG=!LOG_DIR!\Forensic_Commands.log"
(
    echo.
    echo [!_lc_tstart!]
    echo Módulo    : !_lc_module!
    echo Host      : !COMPUTERNAME!
    echo Usuario   : !USERNAME!
    echo OS        : !WIN_NAME! ^(!WIN_ARCH!^)
    echo Directorio: !CD!
    rem Identificacion del caso en CADA entrada: sin ella una carpeta de evidencia no
    rem se puede vincular a una actuacion concreta (ISO/IEC 27037 7.1.3).
    echo Caso      : !FORENSIC_CASE!
    echo Evidencia : !FORENSIC_EVID!
    echo Examinador: !FORENSIC_EXAMINER!
    echo Comando   :
    echo   !_lc_cmd!
    rem Version y hash de los binarios de adquisicion: sin version un hallazgo no se
    rem puede atribuir al comportamiento de una build concreta ni reproducir, y una
    rem herramienta sustituida en Sistema\herramientas seria indetectable.
    if not "!_lc_ver!"=="" echo Version   : !_lc_ver!
    rem El campo NO se omite nunca cuando falta la version: un hueco silencioso no se
    rem distingue de un olvido del modulo, y quien lea el expediente tiene que ver que
    rem la version no se declaro y por que via buscarla.
    if "!_lc_ver!"=="" echo Version   : no declarada por este modulo - vease Inventario
    echo Inventario: !LOG_DIR!\Herramientas_SHA256.txt
    echo ExitCode  : !_lc_exit!  ^(0=ok 1=error 2=cancelado; normalizado por el wrapper^)
    rem Codigo REAL de la herramienta cuando se ha podido recuperar: es el que permite
    rem distinguir un tipo de fallo de otro en ewfacquire, ftkimager, dc3dd o qemu-img.
    if not "!_lc_rawrc!"=="" echo CodigoReal: !_lc_rawrc!  ^(devuelto por la herramienta^)
    echo Inicio    : !_lc_tstart!
    echo Fin       : !_lc_tend!
    echo Duración  : !_lc_dur!
    echo Estado    : !_lc_status!
    if not "!_lc_out!"=="" echo Salida    : !_lc_out!
    if not "!_lc_hash!"=="" echo HashFile  : !_lc_hash!
    echo -----------------------------------------------------------------
) >> "!CMD_LOG!" 2>nul
exit /b

:: ===========================================================================
:: TOOL_VERSION <var_destino> <ruta_exe> <flag>
:: Devuelve en <var_destino> la primera linea util de la version de la herramienta.
:: Sin version no hay reproducibilidad: una build distinta puede comportarse de otro
:: modo y el informe no podria atribuir el resultado a nada concreto (ISO/IEC 27041
:: 6 y 7; NIST CFTT exige identificar herramienta, version y build).
:: Se EVITA el pipe a findstr: con la ruta del ejecutable entre comillas dentro de un
:: for /f, cmd.exe pierde el pareo de comillas (trampa ya documentada en este
:: proyecto). Se toma la primera linea no vacia y se corta a algo manejable.
:: ===========================================================================
:TOOL_VERSION
setlocal enabledelayedexpansion
set "_tv_exe=%~2"
set "_tv_flag=%~3"
set "_tv_out="
if not exist "!_tv_exe!" goto TV_END
for /f "usebackq delims=" %%L in (`""!_tv_exe!" !_tv_flag!" 2^>^&1`) do if not defined _tv_out set "_tv_out=%%L"
:TV_END
if not defined _tv_out set "_tv_out=version no obtenida"
:: Se acota la longitud: algunas herramientas escupen un parrafo entero de banner y
:: una linea kilometrica en el log de comandos lo vuelve ilegible.
set "_tv_out=!_tv_out:~0,120!"
endlocal & set "%~1=%_tv_out%"
exit /b 0

:: ===========================================================================
:: TOOL_VER_ONCE <var_cache> <ruta_exe> <flag> [etiqueta]
:: Interroga la version de una herramienta UNA sola vez por sesion y la memoriza en
:: <var_cache>. La memorizacion no es cosmetica: hay 32 adquisiciones y sin cache cada
:: una lanzaria otro proceso mas sobre el equipo de analisis solo para releer una
:: cadena que no cambia dentro de la sesion.
:: [etiqueta] se antepone cuando la herramienta no imprime su propio nombre: VBoxManage
:: "--version" devuelve "7.2.12r170512" a secas, y un campo "Version: 7.2.12r170512" en
:: el expediente no identifica a ninguna herramienta.
:: ===========================================================================
:TOOL_VER_ONCE
if defined %~1 exit /b 0
call :TOOL_VERSION %~1 "%~2" "%~3"
if not "%~4"=="" set "%~1=%~4 !%~1!"
exit /b 0

:: ===========================================================================
:: ACQ_VER <var_cache> <ruta_exe> <flag> [etiqueta]
:: Deja en ACQ_TOOL_VER la version que :ACQUIRE entrega a :LOG_CMD. Se llama justo
:: antes de cada "call :ACQUIRE": el campo Version del asiento es obligatorio en este
:: framework -ISO/IEC 27037 7, ISO/IEC 27042, NIST SP 800-86 4 y NIST CFTT exigen
:: identificar herramienta, version y build- y solo el modulo sabe QUE herramienta va
:: a lanzar.
:: NO todas se pueden interrogar, y las que no, llevan en su modulo una cadena literal
:: que dice POR QUE y remite al inventario: DumpIt y WinPmem cargan un driver de kernel
:: al arrancar, kape.exe sin elevacion solo imprime que le faltan privilegios y
:: "adb version" arranca el demonio adb -las tres son alteraciones del host que no se
:: van a provocar por documentar-, y robocopy es in-box de Windows y no publica numero
:: de version propio: su identidad es la build del sistema. En esos casos el SHA-256 de
:: Herramientas_SHA256.txt identifica el binario concreto sin ejecutarlo.
:: ===========================================================================
:ACQ_VER
call :TOOL_VER_ONCE %1 "%~2" "%~3" %4
set "ACQ_TOOL_VER=!%~1!"
exit /b 0

:: ===========================================================================
:: TOOL_INVENTORY - Inventario de herramientas de adquisicion de esta ejecucion.
:: Escribe Logs\Herramientas_SHA256.txt con la version y el SHA-256 de cada binario
:: presente. Ninguna herramienta registraba su version (solo qemu-img), asi que un
:: hallazgo no se podia atribuir a una build ni detectar la sustitucion de un binario
:: en Sistema\herramientas. Se calcula UNA VEZ por sesion y :LOG_CMD lo referencia.
:: ===========================================================================
:TOOL_INVENTORY_ONCE
rem Guarda de idempotencia. :LOG_CMD se invoca en cada adquisicion y el inventario
rem debe escribirse UNA sola vez por sesion: si se regenerara en cada asiento, la
rem marca "Generado UTC" del archivo dejaria de corresponder al instante en que se
rem acredito el juego de herramientas, que es justo lo que el archivo certifica.
if defined TI_DONE exit /b 0
set "TI_DONE=1"
call :TOOL_INVENTORY
exit /b 0

:TOOL_INVENTORY
if not defined LOG_DIR exit /b 0
set "_ti_file=!LOG_DIR!\Herramientas_SHA256.txt"
rem MOTOR DE HASH DEL INVENTARIO. Se usa HashMyFiles solo si la sonda FUNCIONAL de la capa
rem de capacidades lo aprobo (HAS_HASHER). Es el mismo y unico motor que hashea la
rem evidencia: antes habia aqui un respaldo con Get-FileHash del PowerShell del host, que
rem contradecia la propia cabecera -"NO se sustituye por ningun binario del equipo
rem analizado"- y certificaba las herramientas con un motor que la sesion no admite para
rem la evidencia. Si HashMyFiles no responde, el inventario acredita ruta, presencia y
rem version, y lo declara.
set "_ti_eng="
set "_ti_engtxt="
if defined HAS_HASHER set "_ti_eng=HASHMYFILES"
rem El texto del motor NO lleva los signos de menor y mayor de un marcador de argumento:
rem viaja por variables que se expanden tarde y acaba en echo y en :LOG_EVENT, y un
rem caracter de redireccion suelto en ese camino es una trampa que no aporta nada.
if defined HMF_EXE if exist "!HMF_EXE!" set "_ti_engtxt=HashMyFiles SHA256"
call :UTCNOW _ti_ts
>"!_ti_file!" echo ===========================================================================
>>"!_ti_file!" echo  INVENTARIO DE HERRAMIENTAS DE ADQUISICION
>>"!_ti_file!" echo ===========================================================================
>>"!_ti_file!" echo Generado UTC : !_ti_ts!
>>"!_ti_file!" echo Host         : !COMPUTERNAME!    Operador: !USERNAME!
>>"!_ti_file!" echo Caso         : !FORENSIC_CASE!   Evidencia: !FORENSIC_EVID!
>>"!_ti_file!" echo.
>>"!_ti_file!" echo Este archivo acredita QUE binario concreto se uso: la ruta y el SHA-256 son los
>>"!_ti_file!" echo del binario que ESTA EJECUCION resolvio, que puede ser el empaquetado en el
>>"!_ti_file!" echo framework o el instalado en el host; vease la linea Procedencia de cada entrada.
>>"!_ti_file!" echo El SHA-256 permite detectar la sustitucion de un binario y la version permite
>>"!_ti_file!" echo atribuir un resultado al comportamiento de una build determinada.
>>"!_ti_file!" echo Referencias: ISO/IEC 27041 6 y 7; NIST CFTT; ISO/IEC 27037 7.1.6.
if defined _ti_eng >>"!_ti_file!" echo Motor de hash : !_ti_engtxt!
if not defined _ti_eng >>"!_ti_file!" echo.
if not defined _ti_eng >>"!_ti_file!" echo Motor de hash : NINGUNO UTILIZABLE EN ESTE HOST.
if not defined _ti_eng >>"!_ti_file!" echo LIMITACION: en este equipo no hay ninguna via para calcular un SHA-256. El unico
if not defined _ti_eng >>"!_ti_file!" echo motor admitido es HashMyFiles, que viaja en el proyecto, y no respondio a la prueba
if not defined _ti_eng >>"!_ti_file!" echo funcional de arranque. NO se sustituye por certutil ni por ningun otro binario del
if not defined _ti_eng >>"!_ti_file!" echo equipo analizado: un hasher manipulado daria un valor falso con apariencia de
if not defined _ti_eng >>"!_ti_file!" echo valido. Por eso este inventario acredita solo la RUTA, la
if not defined _ti_eng >>"!_ti_file!" echo PRESENCIA y la VERSION de cada herramienta: NO su identidad criptografica. Ningun
if not defined _ti_eng >>"!_ti_file!" echo campo SHA-256 de este archivo contiene un hash, y este inventario NO puede usarse
if not defined _ti_eng >>"!_ti_file!" echo para detectar la sustitucion de un binario.
if not defined _ti_eng call :LOG_EVENT "LIMITACION DE ESTE HOST: el inventario de herramientas no puede calcular ningun SHA-256 porque HashMyFiles, el unico motor admitido, no respondio a la prueba funcional de arranque. NO se sustituye por certutil ni por ningun binario del equipo analizado: un hasher manipulado devolveria un valor falso con apariencia de valido. Herramientas_SHA256.txt acredita ruta, presencia y version de cada binario, pero NO su identidad criptografica: en esta sesion NO se puede detectar la sustitucion de un binario de adquisicion."
>>"!_ti_file!" echo.
rem Solo se INTERROGA la version de utilidades de consola que se sabe que imprimen y
rem terminan. HashMyFiles es una aplicacion GRAFICA: lanzarla aqui abriria una ventana
rem y dejaria el arranque colgado esperando a que el operador la cerrase. Y "adb
rem version" ARRANCA el demonio adb, que es una alteracion del host que no se va a
rem provocar solo por inventariar. Para esos casos basta el SHA-256, que identifica el
rem binario concreto igual de bien y no ejecuta nada.
rem Las herramientas que un resolvedor elige en tiempo de ejecucion se inventarian por
rem su VARIABLE ya resuelta, NUNCA por una ruta fija: VBoxManage, vmrun y
rem vmware-vdiskmanager pueden venir de la instalacion del host, del PATH o del arbol
rem empaquetado, y :VBOX_RESOLVE_CORE pone el empaquetado como ULTIMO recurso a
rem proposito. Hashear la ruta empaquetada mientras se ejecuta la instalada certifica
rem un binario que no es el que produjo la evidencia: es una atestacion falsa en la
rem cadena de custodia y anula la deteccion de sustitucion que este archivo promete.
call :TI_ROW      "dc3dd"               "!BASE_PATH!\Adquisicion\Discos\dc3dd\dc3dd.exe"       "--version"
call :TI_ROW      "dd"                  "!BASE_PATH!\Adquisicion\Discos\dd\dd.exe"             "--version"
call :TI_ROW      "ewfacquire"          "!BASE_PATH!\Adquisicion\Discos\ewf\ewfacquire.exe"    "-V"
call :TI_ROW      "qemu-img"            "!QEMU_IMG!"                                           "--version"
call :TI_ROW      "VBoxManage"          "!VBOX_EXE!"                                           "--version"
call :TI_ROW_HASH "ftkimager"           "!BASE_PATH!\Adquisicion\Discos\ftk\ftkimager.exe"
call :TI_ROW_HASH "7zr"                 "!SEVENZIP!"
call :TI_ROW_HASH "HashMyFiles (GUI)"   "!HMF_EXE!"
call :TI_ROW_HASH "adb"                 "!ADB_EXE!"
call :TI_ROW_HASH "vmrun"               "!VMRUN_EXE!"
call :TI_ROW_HASH "vmware-vdiskmanager" "!VMDK_EXE!"
rem KAPE, DumpIt y WinPmem tampoco se interrogan: kape.exe sin argumentos y sin
rem elevacion solo imprime que le faltan privilegios, y DumpIt/WinPmem cargan un driver
rem de kernel al arrancar, que es precisamente la alteracion que no se va a provocar por
rem inventariar. El SHA-256 identifica el binario igual de bien sin ejecutar nada.
call :TI_ROW_HASH "kape"                "!KAPE!"
call :TI_ROW_HASH "DumpIt (x64)"        "!BASE_PATH!\Volcados\RAM\comae\x64\DumpIt.exe"
call :TI_ROW_HASH "DumpIt (x86)"        "!BASE_PATH!\Volcados\RAM\comae\x86\DumpIt.exe"
call :TI_ROW_HASH "WinPmem (x64)"       "!BASE_PATH!\Volcados\RAM\winpmem\winpmem_mini_x64_rc2.exe"
call :TI_ROW_HASH "WinPmem (x86)"       "!BASE_PATH!\Volcados\RAM\winpmem\winpmem_mini_x86.exe"
>>"!_ti_file!" echo ---------------------------------------------------------------------------
>>"!_ti_file!" echo DEPENDENCIAS RESIDUALES DEL POWERSHELL DEL ANFITRION (no empaquetables)
>>"!_ti_file!" echo ---------------------------------------------------------------------------
>>"!_ti_file!" echo Estos tres modulos son componentes de WINDOWS, no del proyecto: viven en
>>"!_ti_file!" echo %WINDIR%\system32\WindowsPowerShell y llevar una copia portable de PowerShell no
>>"!_ti_file!" echo los sustituye, porque el modulo no viaja con el interprete. Se declaran en vez
>>"!_ti_file!" echo de fingir una portabilidad que no existe (ISO/IEC 27037 7.1.6).
>>"!_ti_file!" echo.
call :TI_ROW_MODULE "Modulo Hyper-V"    "%WINDIR%\system32\WindowsPowerShell\v1.0\Modules\Hyper-V"    "Get-VM, Get-VMSnapshot, Checkpoint-VM, Export-VM, Stop-VM, Save-VM, Start-VM, Set-VM, Get-VHD, Merge-VHD, Set-VHD, Get-VMHardDiskDrive, Get-VMMemory, Remove-VMSnapshot - solo si el operador elige adquisicion Hyper-V"
call :TI_ROW_MODULE "Modulo Storage"    "%WINDIR%\system32\WindowsPowerShell\v1.0\Modules\Storage"     "Get-Disk, Set-Disk, Get-Partition - solo en adquisicion de disco fisico, requiere Windows 8 / Server 2012 o posterior"
call :TI_ROW_MODULE "Modulo SecureBoot" "%WINDIR%\system32\WindowsPowerShell\v1.0\Modules\SecureBoot"  "Confirm-SecureBootUEFI - sondeo informativo de arranque, no condiciona ninguna adquisicion"
>>"!_ti_file!" echo ===========================================================================
rem El asiento no puede prometer hashes que quiza no se calcularon: se dice con que motor
rem se hizo, o que no habia ninguno. Cada campo del archivo dice ademas si su hash es
rem valido o NO CALCULADO, asi que las dos afirmaciones son verificables por un tercero.
if defined _ti_eng call :LOG_EVENT "Inventario de herramientas de adquisicion (version y SHA-256 de cada binario, motor de hash: !_ti_engtxt!) generado en !_ti_file!. Cada entrada de Forensic_Commands.log lo referencia."
if not defined _ti_eng call :LOG_EVENT "Inventario de herramientas de adquisicion (ruta, presencia y version de cada binario, SIN SHA-256 por falta de motor de hash en este host) generado en !_ti_file!. Cada entrada de Forensic_Commands.log lo referencia."
exit /b 0

:: ---------------------------------------------------------------------------
:: TI_ROW  %1 = nombre  %2 = ruta del exe  %3 = flag de version
:: Una herramienta AUSENTE se registra como ausente: el inventario tiene que decir
:: tambien lo que NO estaba disponible en esta ejecucion.
:: ---------------------------------------------------------------------------
:TI_ROW
set "_tir_name=%~1"
set "_tir_exe=%~2"
set "_tir_flag=%~3"
if not defined _tir_exe set "_tir_exe=no resuelta - ni empaquetada, ni instalada en el host, ni en PATH"
if not exist "!_tir_exe!" goto TIR_ABSENT
call :TOOL_VERSION _tir_ver "!_tir_exe!" "!_tir_flag!"
call :TI_ORIGIN "!_tir_exe!"
>>"!_ti_file!" echo [!_tir_name!]
>>"!_ti_file!" echo   Ruta        : !_tir_exe!
>>"!_ti_file!" echo   Procedencia : !_tio_r!
>>"!_ti_file!" echo   Version     : !_tir_ver!
call :TI_SHA256 "!_tir_exe!"
if defined _tih >>"!_ti_file!" echo   SHA-256     : !_tih!
if not defined _tih >>"!_ti_file!" echo   SHA-256     : NO CALCULADO - !_tih_why!
>>"!_ti_file!" echo.
exit /b 0
:TIR_ABSENT
>>"!_ti_file!" echo [!_tir_name!]
>>"!_ti_file!" echo   NO DISPONIBLE en esta ejecucion: !_tir_exe!
>>"!_ti_file!" echo.
exit /b 0

:: ---------------------------------------------------------------------------
:: TI_ROW_HASH  %1 = nombre  %2 = ruta del exe
:: Igual que TI_ROW pero SIN ejecutar la herramienta. Para binarios graficos o que
:: tienen efectos secundarios al invocarlos: el SHA-256 identifica el binario sin
:: necesidad de ejecutarlo, y eso es preferible a tocar el sistema por inventariar.
:: ---------------------------------------------------------------------------
:TI_ROW_HASH
set "_tir_name=%~1"
set "_tir_exe=%~2"
if not defined _tir_exe set "_tir_exe=no resuelta - ni empaquetada, ni instalada en el host, ni en PATH"
if not exist "!_tir_exe!" goto TIR_ABSENT
call :TI_ORIGIN "!_tir_exe!"
>>"!_ti_file!" echo [!_tir_name!]
>>"!_ti_file!" echo   Ruta        : !_tir_exe!
>>"!_ti_file!" echo   Procedencia : !_tio_r!
>>"!_ti_file!" echo   Version     : no se interroga (no se ejecuta el binario en el inventario)
call :TI_SHA256 "!_tir_exe!"
if defined _tih >>"!_ti_file!" echo   SHA-256     : !_tih!
if not defined _tih >>"!_ti_file!" echo   SHA-256     : NO CALCULADO - !_tih_why!
>>"!_ti_file!" echo.
exit /b 0

:: ---------------------------------------------------------------------------
:: TI_ROW_MODULE  %1 = nombre  %2 = ruta esperada del modulo  %3 = motivo/condicion
:: Declara una dependencia RESIDUAL del PowerShell del HOST: un modulo que vive en
:: %WINDIR% y no en el proyecto, por lo que no es empaquetable ni sustituible por una
:: copia portable de PowerShell (el interprete no trae el modulo consigo). No tiene
:: SHA-256 propio en este inventario porque no es un binario unico sino un arbol de
:: Windows: lo que se acredita aqui es su RUTA, su PRESENCIA en este host concreto y
:: el MOTIVO por el que la ejecucion lo necesita, que es lo que exige declarar una
:: limitacion en vez de disimularla (ISO/IEC 27037 7.1.6).
:: ---------------------------------------------------------------------------
:TI_ROW_MODULE
set "_tim_name=%~1"
set "_tim_path=%~2"
set "_tim_motivo=%~3"
>>"!_ti_file!" echo [!_tim_name!]
>>"!_ti_file!" echo   Ruta        : !_tim_path!
if exist "!_tim_path!" >>"!_ti_file!" echo   Presente    : SI, en este host
if not exist "!_tim_path!" >>"!_ti_file!" echo   Presente    : NO en este host - las operaciones que lo requieren no estaran disponibles
>>"!_ti_file!" echo   Procedencia : componente de Windows, no del proyecto - no es portable ni empaquetable
>>"!_ti_file!" echo   Motivo      : !_tim_motivo!
>>"!_ti_file!" echo.
exit /b 0

:: ---------------------------------------------------------------------------
:: TI_ORIGIN  %1 = ruta del exe  ->  deja la procedencia en !_tio_r!
:: POR QUE: el hash solo acredita CUAL binario es, no de DONDE salio, y los
:: resolvedores eligen entre la copia empaquetada y la instalada en el host segun el
:: equipo. La procedencia se DERIVA de la misma ruta que se hasheo, no de una variable
:: paralela, para que no pueda discrepar del binario inventariado.
:: Se compara con reemplazo de cadena y NO con findstr: un pipe dentro de una rutina
:: llamada con call hace que cmd.exe reejecute el .bat en un proceso hijo y escupe
:: "The system cannot find the batch label specified - TI_ORIGIN" en pantalla (medido).
:: %%BASE_PATH%% va con porcentajes a proposito: el termino de busqueda de un reemplazo
:: !var:busca=! se resuelve en la fase de porcentajes, antes de la expansion retardada.
:: El reemplazo de cmd.exe ya ignora mayusculas, asi que no hace falta /i.
:: ---------------------------------------------------------------------------
:TI_ORIGIN
set "_tio_p=%~1"
set "_tio_r=EXTERNA al framework - instalada en el host o alcanzada por PATH"
if not "!_tio_p:%BASE_PATH%=!"=="!_tio_p!" set "_tio_r=EMPAQUETADA en el arbol del framework"
exit /b 0

:: ---------------------------------------------------------------------------
:: TI_SHA256  %1 = ruta del exe  ->  deja el hash VALIDADO en !_tih!, o vacio con la
:: causa en !_tih_why!.
:: POR QUE: el rotulo "SHA-256" es una afirmacion forense, asi que solo puede escribirse
:: lo que se haya comprobado que ES un SHA-256. La salida del motor NUNCA se vuelca al
:: archivo: se captura en variable y se pasa por :IS_SHA256, la misma validacion que se
:: aplica a los hashes de evidencia. El motor devuelve vacio si no pudo calcular, y sin
:: validar el formato cualquier texto suelto pasaria por hash. El caso no es teorico
:: -antivirus que bloquea la lectura del binario, ruta de mas de 260 caracteres-.
:: La rama se elige por el MISMO valor que fija la cabecera (_ti_eng). Cuando se retiro
:: certutil, esta comparacion se quedo en "CERTUTIL" mientras el selector ya escribia
:: "HASHMYFILES": ninguna rama coincidia, el inventario declaraba "no hay motor
:: utilizable" para las 17 herramientas y la cabecera seguia anunciando HashMyFiles.
:: Era una contradiccion DENTRO del archivo que acredita las herramientas, es decir una
:: atestacion falsa en la cadena de custodia, no un fallo cosmetico.
:: ---------------------------------------------------------------------------
:TI_SHA256
set "_tih="
set "_tih_why="
set "_tih_p=%~1"
if not "!_ti_eng!"=="HASHMYFILES" (
    set "_tih_why=no hay motor de hash utilizable en este host, vease la cabecera"
    exit /b 0
)
call :HASH_SHA256 "!_tih_p!" _tih
if defined _tih set "_tih=!_tih: =!"
call :IS_SHA256 _tih
if "!_IS_SHA_OK!"=="1" exit /b 0
set "_tih="
set "_tih_why=el motor de hash de esta sesion -!_ti_engtxt!- no devolvio un SHA-256 valido para este binario: lectura bloqueada por un antivirus, ruta de mas de 260 caracteres o permisos insuficientes"
exit /b 0

:: ===========================================================================
:: TIMEDIFF <var_result> <time_start> <time_end>
:: Calcula diferencia entre dos strings %TIME% (HH:MM:SS.cs) -> HH:MM:SS
:: Funciona sin PowerShell. Si los strings no son timestamps válidos devuelve N/D
:: ===========================================================================
:TIMEDIFF
setlocal enabledelayedexpansion
set "_td_r=N/D"
set "_ts=%~2"
set "_te=%~3"
:: Extraer solo la parte de tiempo si el string es ISO (tomar los 8 chars HH:MM:SS desde pos 11)
:: Soporta formato %TIME% directo (HH:MM:SS.cs) y formato ISO (yyyy-MM-ddTHH:MM:SSZ)
set "_ts_t=!_ts:~11,8!"
set "_te_t=!_te:~11,8!"
if "!_ts_t!"=="" set "_ts_t=!_ts:~0,8!"
if "!_te_t!"=="" set "_te_t=!_te:~0,8!"
:: Validar que tengamos algo con dos puntos
echo "!_ts_t!" | findstr ":" >nul 2>&1
if !errorlevel! neq 0 (endlocal & set "%~1=N/D" & exit /b)
echo "!_te_t!" | findstr ":" >nul 2>&1
if !errorlevel! neq 0 (endlocal & set "%~1=N/D" & exit /b)
:: Convertir a segundos
for /f "tokens=1-3 delims=:" %%A in ("!_ts_t!") do (
    set /a "_sh=1%%A-100" 2>nul
    set /a "_sm=1%%B-100" 2>nul
    set /a "_ss=1%%C-100" 2>nul
)
for /f "tokens=1-3 delims=:" %%A in ("!_te_t!") do (
    set /a "_eh=1%%A-100" 2>nul
    set /a "_em=1%%B-100" 2>nul
    set /a "_es=1%%C-100" 2>nul
)
set /a "_tsec=_sh*3600+_sm*60+_ss" 2>nul
set /a "_esec=_eh*3600+_em*60+_es" 2>nul
:: Dias transcurridos entre las dos fechas. La version anterior solo miraba
:: HH:MM:SS y corregia el cruce de medianoche sumando 86400; despues comprobaba si
:: la diferencia seguia siendo negativa para declarar "mas de 24 h", pero tras la
:: suma eso ya no puede ocurrir: una adquisicion de 25 h quedaba registrada como
:: 01:00:00. Los timestamps ISO de :UTCNOW (yyyy-MM-ddTHH:mm:ssZ, o con L) SI traen
:: la fecha, asi que se usa: dias por numero de dia juliano y la duracion se da
:: con horas sin tope (25:00:00).
set "_td_days="
if "!_ts:~4,1!!_ts:~10,1!!_te:~4,1!!_te:~10,1!"=="-T-T" call :TD_DAYS
if defined _td_days set /a "_diff=_td_days*86400+_esec-_tsec" 2>nul
if defined _td_days if !_diff! lss 0 (endlocal & set "%~1=N/D" & exit /b)
:: Sin fecha -formato %TIME% del ultimo recurso- solo se puede suponer que no pasaron
:: mas de 24 h: una diferencia negativa se toma como cruce de medianoche.
if not defined _td_days set /a "_diff=_esec-_tsec" 2>nul
if not defined _td_days if !_diff! lss 0 set /a "_diff+=86400"
rem El valor devuelto no lleva ">" ni parentesis a proposito: el llamador lo imprime
rem con echo sin comillas y ambos romperian la linea.
set /a "_dh=_diff/3600, _dm=(_diff%%3600)/60, _ds=_diff%%60" 2>nul
set "_dhs=!_dh!" & set "_dms=0!_dm!" & set "_dss=0!_ds!"
if !_dh! lss 10 set "_dhs=0!_dh!"
set "_td_r=!_dhs!:!_dms:~-2!:!_dss:~-2!"
endlocal & set "%~1=%_td_r%"
exit /b

:: TD_DAYS - dias entre las fechas de _ts y _te (yyyy-MM-dd...). Deja _td_days.
:: Numero de dia juliano por Fliegel y Van Flandern, el mismo algoritmo que usa
:: :UTCNOW en sentido inverso; set /a trunca hacia cero, que es lo que el
:: algoritmo espera. El prefijo 1 evita que 08 y 09 se lean como octal.
:TD_DAYS
set /a "_y=1!_ts:~0,4!-10000, _m=1!_ts:~5,2!-100, _d=1!_ts:~8,2!-100" 2>nul
set /a "_j1=_d-32075+1461*(_y+4800+(_m-14)/12)/4+367*(_m-2-(_m-14)/12*12)/12-3*((_y+4900+(_m-14)/12)/100)/4" 2>nul
set /a "_y=1!_te:~0,4!-10000, _m=1!_te:~5,2!-100, _d=1!_te:~8,2!-100" 2>nul
set /a "_j2=_d-32075+1461*(_y+4800+(_m-14)/12)/4+367*(_m-2-(_m-14)/12*12)/12-3*((_y+4900+(_m-14)/12)/100)/4" 2>nul
set /a "_td_days=_j2-_j1" 2>nul
exit /b
