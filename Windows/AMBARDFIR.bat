if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT!VM REANUDA su ejecución ^(RAM restaurada desde el .vmem^): esto es una!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT!active and controlled alteration of the CLONE, document it as such in the chain!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT!alteración activa y controlada del CLON, documentela como tal en la cadena!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT!of custody. Three hash lists were recorded: SOURCE before copying,!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT!de custodia. Se registraron tres listas de hash: ORIGEN antes de!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT!COPY after copying and SOURCE after copying. Compare them file by!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT!copiar, COPIA después de copiar y ORIGEN después de copiar.!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT!file: the framework does NOT compare them automatically.!C_RESET!
