echo !C_BORDER!!LINE!!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Selective forensic copy of files or folders with preservation!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Copia forense selectiva de archivos o carpetas con preservación!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] of NTFS metadata (timestamps, permissions, owner) and hashing.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] de metadatos NTFS (timestamps, permisos, propietario) y hashing.!C_RESET!
