@echo off
setlocal enabledelayedexpansion
break off

:: --- Entorno de ejecucion controlado ---------------------------------------
:: Un host con Git, Cygwin o BusyBox puede tener su bin ANTES que System32 en
:: PATH. Ahi 'find', 'sort' o 'timeout' resuelven a los binarios de Unix, que
:: no entienden la sintaxis de Windows: 'find " files, "' toma el patron como
:: una RUTA, aborta, y el productor de la tuberia muere con "The process tried
:: to write to a nonexistent pipe". Se antepone el directorio del sistema al
:: PATH de ESTE proceso -no se toca el del usuario ni el de la maquina- para
:: que las herramientas del sistema ganen siempre. La procedencia se registra
:: mas adelante en el diario, cuando ya existe.
set "PATH_HEREDADO=%PATH%"
set "WINSYS=%SystemRoot%\System32"
if not exist "%WINSYS%\cmd.exe" set "WINSYS=%WINDIR%\System32"
if exist "%WINSYS%\cmd.exe" set "PATH=%WINSYS%;%SystemRoot%;%WINSYS%\Wbem;%WINSYS%\WindowsPowerShell\v1.0;%PATH%"
:: Rutas absolutas para los sitios donde una sustitucion silenciosa cambiaria
:: el resultado. Si el binario no estuviera, se cae al nombre suelto.
set "_WFIND=%WINSYS%\find.exe"
set "_WFINDSTR=%WINSYS%\findstr.exe"
set "_WSORT=%WINSYS%\sort.exe"
set "_WTIMEOUT=%WINSYS%\timeout.exe"
if not exist "%_WFIND%" set "_WFIND=find"
if not exist "%_WFINDSTR%" set "_WFINDSTR=findstr"
if not exist "%_WSORT%" set "_WSORT=sort"
if not exist "%_WTIMEOUT%" set "_WTIMEOUT=timeout"

:: --- Pagina de códigos UTF-8 ---------------------------------------------
:: Sin esto la consola hereda la pagina OEM del sistema (437 en Windows en
:: ingles), que no tiene ni la ene ni las vocales acentuadas: el menu de
:: idioma mostraba "Español" y los caracteres de dibujo del arbol de discos
:: salian como basura. Se guarda la pagina previa para restaurarla al salir y
:: no dejar alterada una consola que el operador ya tenia abierta.
:: findstr NO entiende UTF-8: ningun patron de busqueda de este script lleva
:: acentos, y se comprobo uno a uno.
set "CP_PREV="
for /f "tokens=2 delims=:" %%a in ('chcp') do set "CP_PREV=%%a"
set "CP_PREV=!CP_PREV: =!"
chcp 65001 >nul 2>&1
:: La pagina que queda REALMENTE activa no es un detalle cosmetico: es la que
:: gobierna con que bytes escribe "echo > archivo". Los archivos de comando que
:: consume el wrapper de CTRL+C llevan rutas de evidencia, y el wrapper las leia
:: suponiendo la pagina OEM del sistema: con la consola en UTF-8 toda ruta con
:: tilde o ene se corrompia ("nino" pasaba a "ni+-o") y la herramienta atacaba
:: una ruta inexistente. Se lee de vuelta en vez de darla por hecha, porque en
:: XP "chcp 65001" no surte efecto y ahi la pagina sigue siendo la OEM.
set "CP_ACTIVE="
for /f "tokens=2 delims=:" %%a in ('chcp') do set "CP_ACTIVE=%%a"
set "CP_ACTIVE=!CP_ACTIVE: =!"
title AMBARDFIR v3.0 - Framework de Adquisicion Forense

:: --- Habilitar Colores ANSI (solo Win10 build 10586+; en Win7/8 la consola ---
:: --- no interpreta VT y los códigos imprimen basura -> se dejan vacios)   ---
set "ANSI_OK="
set "_earlybuild="
for /f "tokens=3" %%a in ('reg query "HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion" /v CurrentBuildNumber 2^>nul') do set "_earlybuild=%%a"
if defined _earlybuild if !_earlybuild! GEQ 10586 set "ANSI_OK=1"
if not defined ANSI_OK goto SKIP_ANSI
:: cmd /d: sin /d el AutoRun del registro se ejecuta en este cmd y su salida se
:: colaria en ESC.
for /F %%a in ('echo prompt $E ^| cmd /d') do set "ESC=%%a"
set "C_TITLE=!ESC![1;36m"
set "C_BORDER=!ESC![36m"
set "C_TEXT=!ESC![0;37m"
set "C_PROMPT=!ESC![1;33m"
set "C_OK=!ESC![1;32m"
set "C_ERR=!ESC![1;31m"
set "C_WARN=!ESC![1;33m"
set "C_ACCENT=!ESC![1;35m"
set "C_DIM=!ESC![0;90m"
set "C_INFO=!ESC![1;34m"
set "C_RESET=!ESC![0m"
:SKIP_ANSI
:: --- Letra de consola y ventana maximizada (solo en el primer proceso; los ---
:: --- relanzamientos heredan la misma ventana ya ajustada)                  ---
:: La sonda de PowerShell se hace AQUI y no se hereda de la capa de capacidades:
:: esa capa vive en :STARTUP_SCREEN, que se llama mucho mas abajo. Sin la sonda,
:: lo primero que veia un operador de XP o de un Vista sin WMF era el error crudo
:: "'powershell' no se reconoce" antes de que existiera interfaz alguna.
:: Las dos cosas -agrandar la letra y maximizar- las hace console_font.ps1 en UNA
:: sola invocacion. Antes se maximizaba con un Add-Type escrito en esta misma linea:
:: Add-Type COMPILA C# en tiempo de ejecucion y eso costaba 571 ms medidos, de modo
:: que dos llamadas separadas pagarian la compilacion dos veces. El script sube la
:: letra a 22 px porque la de serie -16 px- es ilegible en proyector, y comprueba que
:: con ese cuerpo siguen cabiendo las 74 columnas del lienzo antes de dejarlo puesto.
:: Ambas cosas son ESTETICAS: si fallan, sale con codigo 0 y el arranque continua.
if not defined FORENSIC_READY (
    set "_PSMAX="
    for %%P in (powershell.exe) do if not "%%~$PATH:P"=="" set "_PSMAX=1"
    rem Se usa %~dp0 y NO !SYS_DIR!: SYS_DIR se define mas abajo, en la seccion de
    rem rutas, asi que aqui todavia esta vacio. %~dp0 ya termina en barra invertida.
    if defined _PSMAX if exist "%~dp0Sistema\lib\console_font.ps1" powershell -NoProfile -ExecutionPolicy Bypass -File "%~dp0Sistema\lib\console_font.ps1" >nul 2>&1
)

:: --- Geometria de la interfaz ---------------------------------------------
:: El lienzo tiene ancho FIJO. Antes la regla se estiraba a todo el ancho de
:: la consola (LINE_LEN = W_COLS - 1): al maximizar la ventana pasaba de 74 a
:: mas de 200 caracteres mientras los menus seguian pegados al margen
:: izquierdo, de modo que el rotulo quedaba centrado sobre una línea enorme y
:: medio vacia. La pantalla de arranque ya usaba 74 columnas fijas, así que se
:: adopta ese ancho para todo el framework y desaparece la doble regla
:: LINE / BLINE.
set "PANEL_W=74"

set "LINE="
for /l %%i in (1,1,!PANEL_W!) do set "LINE=!LINE!="

:: Separador interior, mas corto a propósito: divide secciones dentro del panel.
set "SUBLINE="
for /l %%i in (1,1,60) do set "SUBLINE=!SUBLINE!-"

:: "|" literal para usar DENTRO de bloques "for/if (...)" con expansion
:: retrasada activa (como el renderizador del listado de VMs, mas abajo).
:: Un "|" escrito directo ahi, aunque se escape con "^", sale duplicado en
:: pantalla ("^^|"): dentro de un bloque parentetizado con delayed expansion,
:: cmd.exe hace una pasada de parseo extra que un solo "^" no sobrevive.
:: Expandir una VARIABLE que ya contiene el caracter evita esa pasada.
set "PIPE=|"

:: --- Centrado de rotulos dentro del lienzo ---
:: Ya NO hay constantes de relleno. Antes habia SEIS (PAD_STR_MAIN, _VOL, _TRI,
:: _ART, _LIST y _VM), cada una calculada para UN ancho de rotulo concreto, y se
:: reutilizaban en mas de veinte rotulos de longitudes muy distintas. Medido:
:: "SOURCE BROWSER" (14) con el relleno de 21 quedaba 21/39 y "ADQUISICIÓN LÓGICA
:: - Archivos/Carpetas (Copia Forense)" (53) con ese mismo relleno sumaba 75 y
:: rompia el marco de 74 columnas. El centrado lo calcula ahora :HDR con la
:: longitud REAL del rotulo que se va a imprimir.

:: =============================================================================
:: SCRIPT FORENSE MODULAR - PROYECTO FINAL (Optimizacion KAPE)
:: =============================================================================

:: --- Verificación y Auto-Elevacion de Privilegios (con degradación elegante) ---
:: "net session" NO es una prueba de administrador fiable: necesita el servicio
:: Server (LanmanServer) en marcha. Con ese servicio detenido -habitual en
:: equipos endurecidos- un operador YA elevado daba negativo, el script se
:: relanzaba con RunAs, el hijo volvia a dar negativo y salia un bucle de
:: peticiones de UAC. Se conserva "net session" como sonda primaria y se anade
:: una segunda que no depende de ningun servicio: leer la rama HKU\S-1-5-19
:: (perfil de Servicio local) solo lo permite un token elevado, y reg.exe existe
:: desde XP. Ademas se marca el intento de elevacion con un argumento, para no
:: pedir UAC mas de una vez por sesion aunque las dos sondas fallen.
set "_ELEV_TRIED="
if /i "%~1"=="/ELEVADO" set "_ELEV_TRIED=1"
set "_ADM="
net session >nul 2>&1 && set "_ADM=1"
if not defined _ADM reg query "HKU\S-1-5-19" >nul 2>&1 && set "_ADM=1"
if not defined _ADM (
    if /i "!FORENSIC_LANG!"=="EN" echo [-] WARNING: Running without Administrator privileges.
    if /i not "!FORENSIC_LANG!"=="EN" echo [-] ADVERTENCIA: Ejecutando sin privilegios de Administrador.
    set "_PSCHK="
    for %%P in (powershell.exe) do if not "%%~$PATH:P"=="" set "_PSCHK=1"
    if defined _ELEV_TRIED set "_PSCHK="
    if defined _PSCHK (
        echo [*] Intentando elevar privilegios automaticamente...
        rem -NoProfile como en el resto del framework. El apostrofo de la ruta se
        rem duplica: una carpeta como "O'Brien" cerraba el literal de PowerShell
        rem y la auto-elevacion fallaba sin explicacion.
        set "_SELF=%~f0"
        powershell -NoProfile -Command "Start-Process -FilePath '!_SELF:'=''!' -ArgumentList '/ELEVADO' -Verb RunAs"
        exit /b
    ) else (
        if not defined _ELEV_TRIED if /i "!FORENSIC_LANG!"=="EN" echo [i] PowerShell not available: cannot self-elevate on this system.
        if not defined _ELEV_TRIED if /i not "!FORENSIC_LANG!"=="EN" echo [i] PowerShell no disponible: no se puede auto-elevar en este sistema.
        if defined _ELEV_TRIED if /i "!FORENSIC_LANG!"=="EN" echo [i] Elevation was already requested once and the token is still not elevated: not asking again.
        if defined _ELEV_TRIED if /i not "!FORENSIC_LANG!"=="EN" echo [i] Ya se pidio elevacion una vez y el token sigue sin ser elevado: no se insiste.
        if /i "!FORENSIC_LANG!"=="EN" echo [i] The disk/RAM acquisition modules require Administrator.
        if /i not "!FORENSIC_LANG!"=="EN" echo [i] Los módulos de adquisición de disco/RAM requieren Administrador.
        if /i "!FORENSIC_LANG!"=="EN" echo [i] Continuing with limited functionality ^(graceful degradation^)...
        if /i not "!FORENSIC_LANG!"=="EN" echo [i] Continuando con funcionalidad limitada ^(degradación elegante^)...
        call :WAIT 3
    )
)

:: --- Configuración de Rutas ---
set "SYS_DIR=%~dp0Sistema"
set "BASE_PATH=!SYS_DIR!\herramientas"
set "KAPE=!BASE_PATH!\Triaje\kape\kape.exe"
:: OpenConsole (terminal moderno, opcional). Se acepta tanto la ruta simple que
:: documenta setup-tools.bat como el subdirectorio versionado que crea el zip
:: oficial de Windows Terminal. Antes se fijaba una version concreta en la ruta,
:: asi que cualquier otra version quedaba ignorada en silencio: el operador
:: colocaba el binario donde dice la guia y el framework no lo encontraba nunca.
set "OPENCONSOLE=!BASE_PATH!\Terminal\OpenConsole.exe"
if not exist "!OPENCONSOLE!" set "OPENCONSOLE="
if not defined OPENCONSOLE for /d %%D in ("!BASE_PATH!\Terminal\terminal-*") do if exist "%%D\OpenConsole.exe" set "OPENCONSOLE=%%D\OpenConsole.exe"

:: --- Herramienta de Hashing (binario según arquitectura del SO) ---
set "_IS_X64="
if /i "%PROCESSOR_ARCHITECTURE%"=="AMD64" set "_IS_X64=1"
if defined PROCESSOR_ARCHITEW6432 set "_IS_X64=1"
if defined _IS_X64 (
    set "HMF_EXE=!BASE_PATH!\Hashes\HashMyFiles\hashmyfiles-x64\HashMyFiles.exe"
) else (
    set "HMF_EXE=!BASE_PATH!\Hashes\HashMyFiles\x32\HashMyFiles.exe"
)
if not exist "!HMF_EXE!" set "HMF_EXE=!BASE_PATH!\Hashes\HashMyFiles\x32\HashMyFiles.exe"

:: --- Versión ---
set "SCRIPT_VERSION=3.0"

:: --- QEMU-IMG ---
set "QEMU_IMG=!BASE_PATH!\Virtualizacion\QEMU\qemu-img.exe"

:: --- Motor de Evaluacion Previa a la Adquisicion (fase de Identificacion) ---
:: Se distribuye como .ps1 y NO se genera en tiempo de ejecucion: asi forma parte
:: del arbol hasheable de la herramienta y un perito contrario puede auditarlo.
set "PREACQ_PS1=!BASE_PATH!\Utilidades\PreAdquisicion-Cifrado.ps1"

:: --- 7-Zip (7zr: solo formato .7z) ---
set "SEVENZIP=!BASE_PATH!\Utilidades\7zip\7zr.exe"

:: --- ADB (Android Debug Bridge - platform-tools) ---
set "ADB_EXE=!BASE_PATH!\platform-tools\adb.exe"

:: --- Wrapper DFIR para proteccion CTRL+C ---
set "WRAPPER_PS1=!SYS_DIR!\lib\forensic_wrapper.ps1"

:: --- Conversor de estado guardado Hyper-V (.vmrs/.bin) a memoria RAW ---
set "HV_RAW_PS1=!SYS_DIR!\lib\hv_savedstate_to_raw.ps1"

:: --- Raiz del repositorio de evidencias (relativa al script) ---
:: EVID_ROOT es la raiz FIJA. DEFAULT_DEST cuelga de ella y :CASE_REPO lo baja a
:: <CASO>\<EVIDENCIA> en cuanto el operador identifica el caso. Hasta entonces
:: conserva este valor, que es el comportamiento historico: si la identificacion
:: falla, se sigue adquiriendo a la raiz en vez de no adquirir nada.
for %%F in ("%~dp0..\Evidencias") do set "EVID_ROOT=%%~fF"
set "DEFAULT_DEST=!EVID_ROOT!"
set "DERIV_DEST=!EVID_ROOT!"

:: --- Secuencia de relanzamiento (terminal moderno + aislamiento CTRL+C) ---
:: Se usa estado por variable de entorno (heredada por procesos hijos) en lugar
:: de argumentos, para sobrevivir a multiples saltos de relanzamiento.
if defined FORENSIC_READY goto AFTER_RELAUNCH

:: 1) Entorno OpenConsole (terminal moderno). Opcional: si no existe, se omite.
:: cmd /c (no /k): al terminar el script la ventana se cierra limpia, sin dejar
:: un prompt de cmd en system32. /d: no se ejecuta el AutoRun del registro
:: (HKCU/HKLM Command Processor), que en un equipo comprometido seria codigo del
:: host corriendo dentro del framework.
if not defined FORENSIC_IN_CONSOLE if exist "!OPENCONSOLE!" (
    echo [*] Iniciando entorno OpenConsole...
    set "FORENSIC_IN_CONSOLE=1"
    "!OPENCONSOLE!" cmd /d /c "%~f0"
    exit /b
)

:: 2) Aislar CTRL+C para evitar el prompt "Terminate batch job (Y/N)?" al abortar.
::    Requiere PowerShell 2.0+. Si no esta disponible -> modo degradado (continua
::    sin aislamiento, el CTRL+C funcionara pero podrá pedir terminar el batch).
set "PS_FOUND="
for %%P in (powershell.exe) do if not "%%~$PATH:P"=="" set "PS_FOUND=1"
if defined PS_FOUND if exist "!SYS_DIR!\lib\launch_noctrlc.ps1" (
    set "FORENSIC_READY=1"
    powershell -NoProfile -ExecutionPolicy Bypass -File "!SYS_DIR!\lib\launch_noctrlc.ps1" -Bat "%~f0"
    if not "!errorlevel!"=="99" exit /b
    if /i "!FORENSIC_LANG!"=="EN" echo [i] CTRL+C isolation not available. Continuing in degraded mode.
    if /i not "!FORENSIC_LANG!"=="EN" echo [i] Aislamiento de CTRL+C no disponible. Continuando en modo degradado.
)
set "FORENSIC_READY=1"

:AFTER_RELAUNCH
if not defined FORENSIC_LANG call :ASK_LANG
call :STARTUP_SCREEN

:MENU_PRINCIPAL
set "HE_MODO="
:: Etiquetas de disponibilidad. Cada línea lleva su propia condicion completa:
:: con "set A & if ... set B" el "&" NO queda sujeto al if previo y la segunda
:: asignacion se ejecutaria siempre, mezclando los idiomas.
set "_tgDK=!C_DIM! (no detectado)!C_RESET!"
set "_tgADB=!C_DIM! (no detectado)!C_RESET!"
if /i "!FORENSIC_LANG!"=="EN" set "_tgDK=!C_DIM! (not detected)!C_RESET!"
if /i "!FORENSIC_LANG!"=="EN" set "_tgADB=!C_DIM! (not detected)!C_RESET!"
if defined HAS_DOCKER set "_tgDK=!C_OK! (disponible)!C_RESET!"
if defined HAS_ADB set "_tgADB=!C_OK! (disponible)!C_RESET!"
if /i "!FORENSIC_LANG!"=="EN" if defined HAS_DOCKER set "_tgDK=!C_OK! (available)!C_RESET!"
if /i "!FORENSIC_LANG!"=="EN" if defined HAS_ADB set "_tgADB=!C_OK! (available)!C_RESET!"

if /i "!FORENSIC_LANG!"=="EN" goto MP_DRAW_EN_CALL
call :MP_DRAW_ES
goto MP_ASK
:MP_DRAW_EN_CALL
call :MP_DRAW_EN

:MP_ASK
set "opt="
if /i "!FORENSIC_LANG!"=="EN" goto MP_ASK_EN
if /i not "!FORENSIC_LANG!"=="EN" set /p opt="!C_PROMPT!Selecciona una opción: !C_RESET!"
goto MP_ASKED
:MP_ASK_EN
set /p opt="!C_PROMPT!Select an option: !C_RESET!"
:MP_ASKED

:: --- Guarda contra entrada agotada ------------------------------------------
:: "set /p" deja la variable INTACTA tanto si stdin esta en EOF como si el
:: operador pulsa Enter a secas: comprobado en cmd.exe, son indistinguibles, no
:: hay forma de separarlos ni con un centinela previo. Consecuencia real medida:
:: si se ejecuta el framework con la entrada canalizada (automatizacion, tarea
:: programada, un fichero que se agota) el menu principal gira indefinidamente
:: imprimiendo "Opcion invalida" -se reprodujo, 23.064 lineas de salida-.
:: Se cuentan las lecturas VACIAS CONSECUTIVAS y a las 25 se sale limpio. Una
:: opcion escrita, aunque sea invalida, reinicia el contador: por eso esto no
:: estorba nunca a quien teclea de verdad, que como mucho se equivoca y vuelve.
if defined opt (
    set "_MP_VACIAS=0"
) else (
    set /a _MP_VACIAS+=1
    if !_MP_VACIAS! geq 25 goto MP_SIN_ENTRADA
)

for /f "delims=0123456789" %%a in ("!opt!") do (
    call :MSG_INVALID
    call :WAIT 2
    goto MENU_PRINCIPAL
)

if "!opt!"=="1" goto MENU_VOLCADO
if "!opt!"=="2" goto MENU_TRIAGE
if "!opt!"=="3" goto MENU_ADQUISICION
if "!opt!"=="4" goto MENU_VM
if "!opt!"=="5" goto MP_SEL_DOCKER
if "!opt!"=="6" goto MP_SEL_ADB
if "!opt!"=="7" goto MENU_WRITEBLOCK
if "!opt!"=="8" goto VER_COMANDOS
if "!opt!"=="9" goto MP_LANG
if "!opt!"=="0" goto SALIR_LIMPIO

call :MSG_INVALID
call :WAIT 2
goto MENU_PRINCIPAL

:: --- Módulos que dependen de un componente externo -------------------------
:MP_SEL_DOCKER
if defined HAS_DOCKER goto MENU_DOCKER
if /i "!FORENSIC_LANG!"=="EN" goto MP_SEL_DOCKER_EN
echo !C_WARN![-] Docker no esta disponible en este sistema.!C_RESET!
echo !C_DIM!    Requiere Docker Desktop/Engine instalado y en el PATH ^(Windows 10/11 x64^).!C_RESET!
goto MP_SEL_DOCKER_LOG
:MP_SEL_DOCKER_EN
echo !C_WARN![-] Docker is not available on this system.!C_RESET!
echo !C_DIM!    Requires Docker Desktop/Engine installed and on PATH ^(Windows 10/11 x64^).!C_RESET!
:MP_SEL_DOCKER_LOG
pause
goto MENU_PRINCIPAL

:MP_SEL_ADB
if defined HAS_ADB goto MENU_ADB
if /i "!FORENSIC_LANG!"=="EN" goto MP_SEL_ADB_EN
echo !C_WARN![-] ADB no esta disponible: no se encontró adb.exe.!C_RESET!
echo !C_DIM!    Coloque platform-tools en Sistema\herramientas\ o agregue adb al PATH.!C_RESET!
goto MP_SEL_ADB_END
:MP_SEL_ADB_EN
echo !C_WARN![-] ADB is not available: adb.exe was not found.!C_RESET!
echo !C_DIM!    Place platform-tools in Sistema\herramientas\ or add adb to PATH.!C_RESET!
:MP_SEL_ADB_END
pause
goto MENU_PRINCIPAL

:MP_LANG
:: El idioma vigente se GUARDA en vez de borrarse: es lo que permite a :ASK_LANG
:: ofrecer "0 = mantener actual" y lo que hace que el aviso de la pantalla de
:: idioma se lea en el idioma que el operador esta usando ahora mismo.
set "_lg_prev=!FORENSIC_LANG!"
call :ASK_LANG
set "_lg_prev="
goto MENU_PRINCIPAL

:: ===========================================================================
:: ASK_LANG - Selección de idioma de la interfaz.
:: El valor se guarda en FORENSIC_LANG, variable de entorno heredada por los
:: procesos hijos, de modo que sobrevive a los dos saltos de relanzamiento
:: (OpenConsole y launch_noctrlc) igual que FORENSIC_READY.
:: Solo afecta al texto en pantalla. Los mensajes escritos en los logs se
:: mantienen en español a propósito, para que un mismo caso no acabe con un
:: registro mezclado si el operador cambia de idioma a mitad de sesión.
:: ===========================================================================
:ASK_LANG
cls
echo !C_BORDER!!LINE!!C_RESET!
echo !C_ACCENT!                            A M B A R D F I R!C_RESET!
echo !C_DIM!                   Forensic Acquisition Framework  v!SCRIPT_VERSION!!C_RESET!
echo !C_BORDER!!LINE!!C_RESET!
echo.
echo !C_TEXT!   1. Español!C_RESET!
echo !C_TEXT!   2. English!C_RESET!
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_DIM!   You can change it later with option 9 of the main menu.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_DIM!   Se puede cambiar luego con la opción 9 del menú principal.!C_RESET!
echo !C_BORDER!!LINE!!C_RESET!
set "_lg="
:: La opcion "mantener el actual" solo se ofrece cuando hay un idioma vigente que
:: conservar: en el arranque no existe todavia. _lg_prev lo fija :MP_LANG.
if defined _lg_prev set /p _lg="!C_PROMPT!Idioma / Language [1=Español  2=English  0=mantener/keep]: !C_RESET!"
if not defined _lg_prev set /p _lg="!C_PROMPT!Idioma / Language [1=Español  2=English]: !C_RESET!"
:: Un 0 devuelve el idioma que ya estaba. Antes el prompt decia solo "[1]" y todo
:: lo que no fuera "2" caia en espanol: quien entraba en el menu de idioma en
:: ingles y pulsaba Enter se quedaba con la interfaz cambiada sin haberlo pedido.
set "_lg_keep="
if defined _lg_prev if "!_lg!"=="0" set "_lg_keep=1"
if defined _lg_keep set "FORENSIC_LANG=!_lg_prev!"
if not defined _lg_keep set "FORENSIC_LANG=ES"
if not defined _lg_keep if "!_lg!"=="2" set "FORENSIC_LANG=EN"
if not defined _lg_keep if /i "!_lg!"=="EN" set "FORENSIC_LANG=EN"
if /i "!FORENSIC_LANG!"=="EN" title AMBARDFIR v3.0 - Forensic Acquisition Framework
if /i "!FORENSIC_LANG!"=="ES" title AMBARDFIR v3.0 - Framework de Adquisicion Forense
exit /b 0

:: --- Salida ordenada -----------------------------------------------------
:: Devuelve la consola a la pagina de códigos que tenia antes de arrancar.
:: exit /b 0 EXPLICITO: "exit /b" a secas devuelve el errorlevel heredado. Si
:: ese valor fuera 99, launch_noctrlc.ps1 lo interpretaria como "el lanzador
:: fallo, continua en modo degradado" y el framework se reiniciaria solo en la
:: misma ventana en vez de cerrarse.
:SALIR_LIMPIO
if defined CP_PREV chcp !CP_PREV! >nul 2>&1
exit /b 0

:MSG_INVALID
if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Invalid option.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Opción inválida.!C_RESET!
exit /b 0

:: ---------------------------------------------------------------------------
:: MP_SIN_ENTRADA - salida ordenada cuando la entrada estandar se ha agotado.
:: Se llega aqui solo desde la guarda del menu principal, tras 25 lecturas
:: vacias consecutivas. No es un error del operador: es el framework
:: reconociendo que nadie esta contestando y cerrandose en vez de girar.
:: ---------------------------------------------------------------------------
:MP_SIN_ENTRADA
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] No input received after 25 attempts: standard input appears to be!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] Sin respuesta tras 25 intentos: la entrada estándar parece estar!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN!    exhausted or redirected. Closing instead of looping.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN!    agotada o redirigida. Se cierra en lugar de seguir girando.!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] This framework is interactive: run it from a console, not from a pipe.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Este framework es interactivo: ejecútelo en una consola, no con la!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT!    entrada canalizada.!C_RESET!
call :LOG_EVENT "Cierre ordenado: 25 lecturas vacias consecutivas en el menu principal. La entrada estandar esta agotada o redirigida. No se ejecuto ninguna adquisicion."
if defined CP_PREV chcp !CP_PREV! >nul 2>&1
exit /b 0

:: ---------------------------------------------------------------------------
:: WAIT <segundos> - pausa breve para que se pueda leer un mensaje. Es
:: puramente cosmetica: no toca la evidencia ni el registro.
:: timeout.exe NO viene en Windows XP (aparece en Vista). El script hacia 46
:: llamadas directas, asi que en XP la sesion se llenaba de "'timeout' no se
:: reconoce" en la consola. Se sondea UNA sola vez si la herramienta existe y,
:: cuando no, se espera con "ping -n" contra el bucle local, que si esta en
:: todas las versiones: es la misma espera medida con otro reloj, no un hack.
:: Si tampoco hubiera ping se sigue sin pausa, porque perder la pausa no cambia
:: el resultado de ninguna adquisicion.
:: ---------------------------------------------------------------------------
:WAIT
if not defined _WAIT_MODE (
    set "_WAIT_MODE=PING"
    for %%P in (timeout.exe) do if not "%%~$PATH:P"=="" set "_WAIT_MODE=TIMEOUT"
)
if "!_WAIT_MODE!"=="TIMEOUT" timeout /t %~1 >nul 2>&1
if not "!_WAIT_MODE!"=="TIMEOUT" call :WAIT_PING %~1
exit /b 0

:WAIT_PING
:: "ping -n N" envia N ecos separados un segundo, de modo que la espera real es
:: N-1 segundos: se suma 1 para que la pausa dure lo que pedia el llamador.
set /a _wp_n=%~1+1
ping -n !_wp_n! 127.0.0.1 >nul 2>&1
exit /b 0

:: ---------------------------------------------------------------------------
:: HDR - Imprime un rotulo CENTRADO en el lienzo de !PANEL_W! columnas.
::   %1 = TITLE ^| ACCENT ^| DIM   (color del rotulo)
::   %2 = texto en ingles         %3 = texto en espanol
:: Sustituye a las seis constantes de relleno fijas que habia antes: cada una
:: estaba calculada para un ancho de rotulo y se usaba en rotulos de todas las
:: longitudes, asi que casi ninguno quedaba centrado y el mas largo desbordaba
:: el marco. Aqui el relleno se deriva de la longitud del rotulo concreto.
:: La longitud la mide :HDRLEN por busqueda binaria, y NO con set /a sobre nada
:: sacado de la cadena: set /a leeria 010 como octal.
:: Si el rotulo no cabe se imprime SIN relleno, pegado al margen izquierdo:
:: desplazarlo solo lo empujaria mas alla del borde.
:: Con la consola en UTF-8 el conteo es por caracteres, asi que las tildes y la
:: ene cuentan 1. En XP, donde "chcp 65001" no surte efecto, cada acento cuenta
:: 2 y el rotulo queda un caracter a la izquierda de su centro: es un desvio
:: inapreciable y nunca desborda, que es la degradacion aceptable aqui.
:: ---------------------------------------------------------------------------
:HDR
set "_hdr_c=!C_TITLE!"
if /i "%~1"=="ACCENT" set "_hdr_c=!C_ACCENT!"
if /i "%~1"=="DIM" set "_hdr_c=!C_DIM!"
set "_hdr_t=%~2"
if /i not "!FORENSIC_LANG!"=="EN" set "_hdr_t=%~3"
call :HDRLEN "!_hdr_t!"
set /a _hdr_p=(!PANEL_W! - !_hdr_n!) / 2
if !_hdr_p! LSS 0 set "_hdr_p=0"
set "_hdr_s="
for /l %%i in (1,1,!_hdr_p!) do set "_hdr_s=!_hdr_s! "
echo !_hdr_c!!_hdr_s!!_hdr_t!!C_RESET!
exit /b 0

:HDRLEN
:: Deja en !_hdr_n! la longitud de %1, por BUSQUEDA BINARIA dentro de un for /l.
:: POR QUE NO SE RECORTA UN CARACTER POR VUELTA: esa version hacia un "goto" por
:: cada caracter, y en cmd.exe un "goto" obliga a localizar la etiqueta recorriendo
:: el .bat. Con este archivo -mas de 15.000 lineas- ese coste domina el arranque.
:: Medido con el MISMO bucle y las MISMAS vueltas, cambiando solo el relleno del
:: archivo: 1.252 ms en un .bat de 20 lineas frente a 66.685 ms en uno de 15.431,
:: 53 veces mas lento SOLO por el tamano. La deteccion de capacidades dibuja unas
:: 20 filas y cada una medía su detalle asi: 12,92 s de los 16 s de arranque.
:: Aqui las vueltas son 13 fijas -cubren hasta 8.191 caracteres, muy por encima
:: del detalle mas largo que existe, 61- y ocurren DENTRO del for /l, sin ningun
:: goto. Mismo resultado, medido: 1.438 ms en el archivo de 15.431 lineas.
:: El for anidado sobre !_hdr_b! existe porque un %%~ no puede indexar con una
:: variable: se materializa el indice como token para poder escribir !cadena:~N,1!.
set "_hdr_r=%~1"
set "_hdr_n=0"
if not defined _hdr_r exit /b 0
for /l %%B in (12,-1,0) do (
    set /a "_hdr_b=_hdr_n | (1<<%%B)"
    for %%T in (!_hdr_b!) do if not "!_hdr_r:~%%T,1!"=="" set "_hdr_n=%%T"
)
set /a _hdr_n+=1
exit /b 0

