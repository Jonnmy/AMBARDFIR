set "adq_opt="
if /i "!FORENSIC_LANG!"=="EN" set /p adq_opt="!C_PROMPT!Select an option: !C_RESET!"
if /i not "!FORENSIC_LANG!"=="EN" set /p adq_opt="!C_PROMPT!Selecciona una opción: !C_RESET!"

for /f "delims=0123456789" %%a in ("!adq_opt!") do (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Invalid option.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Opción inválida.!C_RESET!
    call :WAIT 2
    goto MENU_ADQUISICION
)

if "!adq_opt!"=="0" goto MENU_PRINCIPAL
if "!adq_opt!"=="1" goto ADQ_FISICO
if "!adq_opt!"=="2" goto ADQ_LOGICO
