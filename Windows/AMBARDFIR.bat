:: ===========================================================================
:: WRITE BLOCKER - Bloqueo/Desbloqueo de escritura por software (Set-Disk)
:: Mitigacion de software (atributo readonly del disco). NO equivale a un
:: write blocker fisico; documentar en cadena de custodia.
:: ===========================================================================
:MENU_WRITEBLOCK
set "HE_MODO="
cls
echo !C_BORDER!!LINE!!C_RESET!
rem El rotulo se saca FUERA de la bifurcacion por idioma: :HDR ya elige el texto,
rem asi que repetirlo en las dos ramas solo daba dos sitios donde desincronizarlo.
call :HDR ACCENT "WRITE BLOCKER - WRITE PROTECTION" "WRITE BLOCKER - BLOQUEO DE ESCRITURA"
echo !C_BORDER!!LINE!!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" goto WB_HDR_EN
rem A PARTIR DE AQUI EL IDIOMA NO ES EN: el salto de la linea anterior ya desvio ese
rem caso a :WB_HDR_EN. Las tres condiciones =="EN" que habia intercaladas aqui eran
rem codigo INALCANZABLE -su texto ingles no se imprimia nunca- y sus equivalentes en
rem ingles ya estan, sin condicion, en la rama :WB_HDR_EN. Se dejan echos planos,
rem igual que en esa rama, para que las dos tengan la misma forma.
echo !C_WARN![i] Mitigación por software: marca el disco como solo lectura.!C_RESET!
echo !C_WARN![i] NO equivale a un write blocker físico. Documentar en CoC.!C_RESET!
echo !C_TEXT![i] Protege un disco/USB de evidencia contra escrituras accidentales.!C_RESET!
goto WB_HDR_END
:WB_HDR_EN
rem El rotulo y la regla ya se imprimieron antes de la bifurcacion.
echo !C_WARN![i] Software mitigation: flags the disk as read-only.!C_RESET!
echo !C_WARN![i] NOT equivalent to a hardware write blocker. Record it in the CoC.!C_RESET!
echo !C_TEXT![i] Protects an evidence disk or USB against accidental writes.!C_RESET!
:WB_HDR_END
echo.
if not defined PS_AVAILABLE goto WB_NO_PS
:: Get-Disk/Set-Disk requieren el módulo Storage (Windows 8+); en Win7 no existen.
powershell -NoProfile -Command "if (Get-Command Set-Disk -ErrorAction SilentlyContinue) { exit 0 } else { exit 1 }" >nul 2>&1
if errorlevel 1 goto WB_NO_PS
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT!Physical disks detected:!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT!Discos físicos detectados:!C_RESET!
echo.
powershell -NoProfile -Command "Get-Disk | Sort-Object Number | Format-Table -AutoSize Number, FriendlyName, @{N='Size(GB)';E={[math]::Round($_.Size/1GB,1)}}, BusType, @{N='ReadOnly';E={$_.IsReadOnly}}" 2>nul
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_DIM!  0 = Back to the main menu!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_DIM!  0 = Volver al Menú Principal!C_RESET!
set "wb_num="
if /i "!FORENSIC_LANG!"=="EN" goto WB_ASK_EN
if /i not "!FORENSIC_LANG!"=="EN" set /p wb_num="!C_PROMPT!Número de disco: !C_RESET!"
goto WB_ASKED
:WB_ASK_EN
set /p wb_num="!C_PROMPT!Disk number: !C_RESET!"
:WB_ASKED
if "!wb_num!"=="0" goto MENU_PRINCIPAL
if "!wb_num!"=="" goto MENU_WRITEBLOCK
for /f "delims=0123456789" %%a in ("!wb_num!") do goto WB_BADNUM

:: Nombre único (NEWGUID) para el temporal: un nombre fijo aquí permitiria
:: que dos instancias del framework corriendo a la vez (o el mismo operador
:: abriendolo dos veces) se pisaran el resultado - una instancia mostraria
:: el estado del disco consultado por la OTRA, justo antes de confirmar
:: bloqueo/desbloqueo (bug real detectado en auditoría dinamica).
call :NEWGUID _wb_guid
set "_wb_state_file=!TEMP!\forensic_wbstate_!_wb_guid!.tmp"
powershell -NoProfile -Command "$d=Get-Disk -Number !wb_num! -ErrorAction SilentlyContinue; if($d){Write-Host ('  Disco !wb_num!: '+$d.FriendlyName+'   ReadOnly actual = '+$d.IsReadOnly)}else{Write-Host '  __NOEXISTE__'}" > "!_wb_state_file!" 2>nul
set "wb_state="
for /f "usebackq delims=" %%S in ("!_wb_state_file!") do set "wb_state=%%S"
del "!_wb_state_file!" >nul 2>&1
echo !wb_state! | findstr "__NOEXISTE__" >nul 2>&1
if not errorlevel 1 goto WB_BADNUM
echo.
echo !C_TEXT!!wb_state!!C_RESET!
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT!1. BLOCK writing  [readonly ON]
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT!1. BLOQUEAR escritura  [readonly ON]
if /i "!FORENSIC_LANG!"=="EN" echo 2. UNLOCK writing  [readonly OFF]
if /i not "!FORENSIC_LANG!"=="EN" echo 2. DESBLOQUEAR escritura  [readonly OFF]
if /i "!FORENSIC_LANG!"=="EN" echo 0. Cancel!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo 0. Cancelar!C_RESET!
set "wb_act="
if /i "!FORENSIC_LANG!"=="EN" set /p wb_act="!C_PROMPT!Action: !C_RESET!"
if /i not "!FORENSIC_LANG!"=="EN" set /p wb_act="!C_PROMPT!Acción: !C_RESET!"
if "!wb_act!"=="0" goto MENU_WRITEBLOCK
if "!wb_act!"=="1" goto WB_LOCK
if "!wb_act!"=="2" goto WB_UNLOCK
if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Invalid option.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Opción inválida.!C_RESET!
call :WAIT 2
goto MENU_WRITEBLOCK

:WB_BADNUM
if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Invalid or nonexistent disk number.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Número de disco inválido o inexistente.!C_RESET!
call :WAIT 2
goto MENU_WRITEBLOCK

:WB_NO_PS
if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Requires PowerShell with Get-Disk/Set-Disk cmdlets (Windows 8 or later).!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Requiere PowerShell con cmdlets Get-Disk/Set-Disk (Windows 8 o superior).!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_DIM!    Manual alternative: diskpart ^> select disk N ^> attributes disk set readonly!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_DIM!    Alternativa manual: diskpart ^> select disk N ^> attributes disk set readonly!C_RESET!
call :LOG_EVENT "WriteBlocker no disponible: PowerShell ausente"
pause
goto MENU_PRINCIPAL

:WB_LOCK
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] Disk !wb_num! will be marked as READ-ONLY.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] Se marcara el disco !wb_num! como SOLO LECTURA.!C_RESET!
set "wb_cf="
if /i "!FORENSIC_LANG!"=="EN" set /p wb_cf="!C_PROMPT!Confirm blocking? [Y/N]: !C_RESET!"
if /i not "!FORENSIC_LANG!"=="EN" set /p wb_cf="!C_PROMPT!¿Confirmar el bloqueo? [S/N]: !C_RESET!"
:: El prompt en ingles ofrece [Y/N]; se acepta Y como S.
if /i "!wb_cf!"=="Y" set "wb_cf=S"
if /I not "!wb_cf!"=="S" goto MENU_WRITEBLOCK
powershell -NoProfile -Command "try{Set-Disk -Number !wb_num! -IsReadOnly $true -ErrorAction Stop; exit 0}catch{Write-Host $_.Exception.Message; exit 1}"
set "wb_el=!errorlevel!"
if "!wb_el!"=="0" goto WB_LOCK_OK
if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Could not apply write blocking. Run the framework as Administrator.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] No se pudo bloquear. Ejecute el framework como Administrador.!C_RESET!
call :LOG_EVENT "WriteBlocker: fallo al bloquear disco !wb_num!"
pause
goto MENU_WRITEBLOCK
:WB_LOCK_OK
:: Set-Disk puede devolver 0 sin que el atributo llegue a aplicarse (puentes USB,
:: controladoras de terceros, medios removibles). Se RELEE el estado real antes de
:: afirmar nada: dar por bloqueado un disco sin comprobarlo seria afirmar algo que
:: no se sostiene, y el operador trataria como protegido un disco que no lo esta.
call :WB_READ_STATE
if /I not "!wb_ro!"=="True" goto WB_LOCK_UNCONFIRMED
if /i "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Disk !wb_num! flagged READ-ONLY - checked: IsReadOnly=True.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Disco !wb_num! marcado SOLO LECTURA - comprobado: IsReadOnly=True.!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Identity: !wb_id!!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Identidad: !wb_id!!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] Software mitigation inside the Windows storage stack. NOT equivalent!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] Mitigación por software en la pila de almacenamiento de Windows. NO!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] to a hardware write blocker: it does not prevent writes at driver!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] equivale a un write blocker físico: no impide escrituras a nivel de!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] level, from another operating system, or firmware activity.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] driver, desde otro sistema operativo ni actividad de firmware.!C_RESET!
:: La limitacion viajaba SOLO en pantalla. Se escribe al diario para que quede en
:: el registro permanente: una limitacion conocida que no consta en la cadena de
:: custodia es una limitacion que el informe no puede declarar.
call :LOG_EVENT "WriteBlocker: disco !wb_num! [!wb_id!] marcado solo lectura - COMPROBADO releyendo IsReadOnly=True. LIMITACION: mitigacion por software en la pila de almacenamiento de Windows, NO equivale a un write blocker fisico; no impide escrituras a nivel de driver, desde otro sistema operativo ni actividad de firmware."
pause
goto MENU_WRITEBLOCK

:WB_LOCK_UNCONFIRMED
if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Set-Disk reported success but IsReadOnly is still [!wb_ro!]: the!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Set-Disk devolvió éxito pero IsReadOnly sigue en [!wb_ro!]: el!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] blocking is NOT established. Do NOT treat this disk as protected.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] bloqueo NO está acreditado. NO trate este disco como protegido.!C_RESET!
call :LOG_EVENT "WriteBlocker: disco !wb_num! [!wb_id!] - Set-Disk devolvio exito pero la relectura da IsReadOnly=!wb_ro!: bloqueo NO acreditado. El disco NO debe tratarse como protegido."
pause
goto MENU_WRITEBLOCK

:WB_UNLOCK
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] Writing will be enabled on disk !wb_num!.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] Se habilitara la escritura en el disco !wb_num!.!C_RESET!
set "wb_cf="
if /i "!FORENSIC_LANG!"=="EN" set /p wb_cf="!C_PROMPT!Confirm unlock? [Y/N]: !C_RESET!"
if /i not "!FORENSIC_LANG!"=="EN" set /p wb_cf="!C_PROMPT!¿Confirmar el desbloqueo? [S/N]: !C_RESET!"
:: El prompt en ingles ofrece [Y/N]; se acepta Y como S.
if /i "!wb_cf!"=="Y" set "wb_cf=S"
if /I not "!wb_cf!"=="S" goto MENU_WRITEBLOCK
powershell -NoProfile -Command "try{Set-Disk -Number !wb_num! -IsReadOnly $false -ErrorAction Stop; exit 0}catch{Write-Host $_.Exception.Message; exit 1}"
set "wb_el=!errorlevel!"
if "!wb_el!"=="0" goto WB_UNLOCK_OK
if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Could not unlock. Run the framework as Administrator.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] No se pudo desbloquear. Ejecute el framework como Administrador.!C_RESET!
call :LOG_EVENT "WriteBlocker: fallo al desbloquear disco !wb_num!"
pause
goto MENU_WRITEBLOCK
:WB_UNLOCK_OK
:: Mismo criterio que en el bloqueo: se relee el atributo. Un desbloqueo que se
:: anuncia sin comprobar deja al operador creyendo que puede escribir donde no
:: puede, y la entrada de cadena de custodia afirmaria un cambio que no ocurrio.
call :WB_READ_STATE
if /I "!wb_ro!"=="True" goto WB_UNLOCK_UNCONFIRMED
if /i "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Disk !wb_num! read-only flag removed - checked: IsReadOnly=!wb_ro!.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Disco !wb_num! sin marca de solo lectura - comprobado: IsReadOnly=!wb_ro!.!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Identity: !wb_id!!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Identidad: !wb_id!!C_RESET!
call :LOG_EVENT "WriteBlocker: disco !wb_num! [!wb_id!] DESBLOQUEADO - COMPROBADO releyendo IsReadOnly=!wb_ro!. A partir de este instante el medio admite escrituras de la pila de almacenamiento de Windows."
pause
goto MENU_WRITEBLOCK

:WB_UNLOCK_UNCONFIRMED
if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Set-Disk reported success but IsReadOnly is still True: the change!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Set-Disk devolvió éxito pero IsReadOnly sigue en True: el cambio!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] did NOT take effect. The disk stays flagged read-only.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] NO surtió efecto. El disco sigue marcado como solo lectura.!C_RESET!
call :LOG_EVENT "WriteBlocker: disco !wb_num! [!wb_id!] - Set-Disk devolvio exito pero la relectura da IsReadOnly=True: el desbloqueo NO surtio efecto."
pause
goto MENU_WRITEBLOCK

:: ---------------------------------------------------------------------------
:: WB_READ_STATE - Relee el estado REAL del disco !wb_num! desde el sistema.
:: Devuelve !wb_ro! (True/False/DESCONOCIDO) y !wb_id! (modelo, serie y bus).
:: El NUMERO de disco no es un identificador estable entre reinicios ni
:: reconexiones: sin modelo, numero de serie y tipo de bus la entrada de cadena
:: de custodia no identifica el objeto sobre el que realmente se actuo.
:: Se vuelca a archivo temporal en vez de usar for /f con acentos graves porque
:: es el patron ya probado en este modulo y no depende del pareo de comillas.
:: ---------------------------------------------------------------------------
:WB_READ_STATE
set "wb_ro=DESCONOCIDO"
set "wb_id=identidad no obtenida"
call :NEWGUID _wb_vguid
set "_wb_vfile=!TEMP!\forensic_wbverif_!_wb_vguid!.tmp"
powershell -NoProfile -Command "$d=Get-Disk -Number !wb_num! -ErrorAction SilentlyContinue; if($d){Write-Host ('RO='+$d.IsReadOnly); Write-Host ('ID='+$d.FriendlyName+' / SN='+$d.SerialNumber+' / Bus='+$d.BusType)}" > "!_wb_vfile!" 2>nul
if not exist "!_wb_vfile!" exit /b
for /f "usebackq tokens=1* delims==" %%A in ("!_wb_vfile!") do if "%%A"=="RO" set "wb_ro=%%B"
for /f "usebackq tokens=1* delims==" %%A in ("!_wb_vfile!") do if "%%A"=="ID" set "wb_id=%%B"
del "!_wb_vfile!" >nul 2>&1
exit /b

:: ===========================================================================
:: VER_COMANDOS - Muestra el registro completo de comandos ejecutados
:: Cada comando externo (dd, ftkimager, winpmem, robocopy, docker cp...) queda
:: registrado integro por :LOG_CMD en Forensic_Commands.log.
:: ===========================================================================
:VER_COMANDOS
cls
echo !C_BORDER!!LINE!!C_RESET!
call :HDR ACCENT "EXECUTED COMMAND LOG" "REGISTRO DE COMANDOS EJECUTADOS"
echo !C_BORDER!!LINE!!C_RESET!
set "CMD_LOG=!LOG_DIR!\Forensic_Commands.log"
if not exist "!CMD_LOG!" goto VER_COMANDOS_VACIO
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Every command executed is recorded in full.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Cada comando ejecutado queda registrado integro (código completo).!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_DIM!    File: !CMD_LOG!!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_DIM!    Archivo: !CMD_LOG!!C_RESET!
echo !C_BORDER!!LINE!!C_RESET!
type "!CMD_LOG!"
echo !C_BORDER!!LINE!!C_RESET!
if defined DEST (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Event journal of the last evidence: !DEST!\Forensic_Journal.log!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Diario de eventos de la última evidencia: !DEST!\Forensic_Journal.log!C_RESET!
) else (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Per-evidence event journal: Forensic_Journal.log inside each destination folder.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Diario de eventos por evidencia: Forensic_Journal.log dentro de cada carpeta de destino.!C_RESET!
)
pause
goto MENU_PRINCIPAL
:VER_COMANDOS_VACIO
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![-] No commands recorded in this session yet.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![-] Aún no hay comandos registrados en esta sesión.!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_DIM!    The log fills up as acquisitions or copies run.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_DIM!    El registro se llena al ejecutar adquisiciones o copias.!C_RESET!
pause
goto MENU_PRINCIPAL


:MENU_VOLCADO
set "HE_MODO="
cls
echo !C_BORDER!!LINE!!C_RESET!
call :HDR TITLE "RAM MEMORY ACQUISITION" "ADQUISICIÓN DE MEMORIA RAM"
echo !C_BORDER!!LINE!!C_RESET!
:: --- Privilegios: SIN elevacion NINGUNA de las tres herramientas puede funcionar ---
:: DumpIt y WinPmem leen la memoria fisica cargando un driver en modo kernel, y cargar
:: un driver exige el privilegio SeLoadDriverPrivilege, que solo tiene un token
:: elevado. Sin el, el driver no se registra y no hay volcado: no existe modo
:: degradado que produzca una imagen parcial utilizable.
:: La compuerta va ANTES de listar las herramientas, no despues de elegir una: las
:: tres dependen de lo mismo, asi que ofrecer un menu donde toda opcion falla solo
:: hace perder tiempo al operador y ensucia el diario con intentos fallidos.
:: Es una limitacion del ENTORNO (control de cuentas de usuario), no de las
:: herramientas, y como tal se declara.
if not defined IS_ADMIN (
    echo.
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] RAM acquisition requires Administrator privileges and this session does NOT have them.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] La adquisición de RAM exige privilegios de Administrador y esta sesión NO los tiene.!C_RESET!
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] DumpIt and WinPmem read physical memory through a kernel-mode driver, and!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] DumpIt y WinPmem leen la memoria física mediante un driver en modo kernel, y!C_RESET!
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] loading a driver is not possible without elevation. No dump can be produced.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] cargar un driver no es posible sin elevación. No se puede obtener ningún volcado.!C_RESET!
    if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Re-run the framework as Administrator to use this module.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Vuelva a abrir el framework como Administrador para usar este módulo.!C_RESET!
    call :LOG_EVENT "Volcado de RAM NO ejecutado: la sesion no tiene privilegios de Administrador. DumpIt y WinPmem necesitan cargar un driver en modo kernel para leer la memoria fisica, y eso exige un token elevado (SeLoadDriverPrivilege). No se intento ninguna de las tres herramientas porque las tres dependen de la misma condicion. Limitacion del entorno, no de las herramientas."
    echo.
    pause
    goto MENU_PRINCIPAL
)
echo !C_TEXT!1. Comae Toolkit (DumpIt)
echo 2. WinPmem (x64)
echo 3. WinPmem (x86)
if /i "!FORENSIC_LANG!"=="EN" echo 0. Back to Main Menu!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo 0. Volver al Menú Principal!C_RESET!
echo !C_BORDER!!LINE!!C_RESET!
set "vol_opt="
if /i "!FORENSIC_LANG!"=="EN" set /p vol_opt="!C_PROMPT!Select an option: !C_RESET!"
if /i not "!FORENSIC_LANG!"=="EN" set /p vol_opt="!C_PROMPT!Selecciona una opción: !C_RESET!"

for /f "delims=0123456789" %%a in ("!vol_opt!") do (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Invalid option.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Opción inválida.!C_RESET!
    call :WAIT 2
    goto MENU_VOLCADO
)

if "!vol_opt!"=="0" goto MENU_PRINCIPAL

if "!vol_opt!"=="1" (
    set "RAM_TOOL=DumpIt"
    goto CONFIG_VOLCADO
)
if "!vol_opt!"=="2" (
    set "RAM_TOOL=WinPmem64"
    goto CONFIG_VOLCADO
)
if "!vol_opt!"=="3" (
    set "RAM_TOOL=WinPmem86"
    goto CONFIG_VOLCADO
)

if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Invalid option.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Opción inválida.!C_RESET!
call :WAIT 2
goto MENU_VOLCADO

:: ---------------------------------------------------------------------------
:: RAM_DEST_SYSDRIVE - Avisa si DEST esta en la unidad del sistema analizado.
:: Resultado en !_rds_back! (1 = volver a pedir el destino). Subrutina PLANA.
:: ---------------------------------------------------------------------------
:RAM_DEST_SYSDRIVE
set "_rds_back=0"
if "!DEST:~0,2!"=="\\" exit /b 0
if /i not "!DEST:~0,1!"=="%SystemDrive:~0,1%" exit /b 0
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] The destination is on the SYSTEM drive of the machine being examined ^(%SystemDrive%^).!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] El destino está en la unidad del SISTEMA analizado ^(%SystemDrive%^).!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] A dump as large as the RAM would overwrite its unallocated space.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] Un volcado del tamaño de la RAM sobrescribiría su espacio no asignado.!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Use external media whenever possible.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] Use un medio externo siempre que sea posible.!C_RESET!
set "_rds_yn="
if /i "!FORENSIC_LANG!"=="EN" set /p _rds_yn="!C_PROMPT!Write the dump there anyway? [Y/N]: !C_RESET!"
if /i not "!FORENSIC_LANG!"=="EN" set /p _rds_yn="!C_PROMPT!¿Escribir el volcado ahí de todos modos? [S/N]: !C_RESET!"
if /i "!_rds_yn!"=="Y" set "_rds_yn=S"
if /i "!_rds_yn!"=="S" goto RDS_ACCEPT
set "_rds_back=1"
exit /b 0
:RDS_ACCEPT
call :LOG_EVENT "Destino del volcado de RAM en la unidad del sistema analizado (!DEST!), aceptado expresamente por el operador. Consecuencia: el volcado sobrescribe espacio no asignado de esa unidad."
exit /b 0

:RAM_TOOL_MISSING
:: Falta el binario de volcado. Se dice EXACTAMENTE eso y con la ruta, en vez de dejar
:: que el fallo aparezca luego disfrazado de problema de permisos o de arquitectura.
echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] The !RAM_TOOL! executable was not found at:!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] No se encontró el ejecutable de !RAM_TOOL! en:!C_RESET!
echo     !RAM_EXE!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] Nothing was run. Check the Sistema\herramientas tree of the framework.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] No se ha ejecutado nada. Revise el árbol Sistema\herramientas del framework.!C_RESET!
call :LOG_EVENT "Volcado de RAM NO iniciado: falta el ejecutable de !RAM_TOOL! en !RAM_EXE!. No se ha tocado el sistema analizado."
echo.
pause
goto MENU_VOLCADO

:CONFIG_VOLCADO
:: El binario se resuelve y se COMPRUEBA antes de pedir nada. Las herramientas de disco
:: ya validaban su existencia (:TOOL_FAIL) pero las de memoria se lanzaban a ciegas: si
:: faltaba el ejecutable, el fallo se detectaba solo por la ausencia del volcado y el
:: mensaje resultante hablaba de arquitectura y de permisos, nunca de "no se encontro el
:: ejecutable". El operador perseguia una causa equivocada.
set "_dumpit_arch=x64"
if /i "%PROCESSOR_ARCHITECTURE%"=="ARM64" set "_dumpit_arch=ARM64"
if not defined _IS_X64 if /i not "%PROCESSOR_ARCHITECTURE%"=="ARM64" set "_dumpit_arch=x86"
set "RAM_EXE="
if "!RAM_TOOL!"=="DumpIt" set "RAM_EXE=!BASE_PATH!\Volcados\RAM\comae\!_dumpit_arch!\DumpIt.exe"
if "!RAM_TOOL!"=="WinPmem64" set "RAM_EXE=!BASE_PATH!\Volcados\RAM\winpmem\winpmem_mini_x64_rc2.exe"
if "!RAM_TOOL!"=="WinPmem86" set "RAM_EXE=!BASE_PATH!\Volcados\RAM\winpmem\winpmem_mini_x86.exe"
if not exist "!RAM_EXE!" goto RAM_TOOL_MISSING
echo.
:CONFIG_VOLCADO_ASK
:: Formato de prompt unico del framework: se dice el valor por defecto Y como
:: cancelar. Sin el "0" este prompt era una trampa: si :VALIDATE_DEST_DIR nunca
:: aceptaba la ruta -unidad de red caida, medio protegido contra escritura- el
:: bucle no tenia salida y el operador solo podia romperlo con CTRL+C.
set "DEST=!DEFAULT_DEST!"
if /i "!FORENSIC_LANG!"=="EN" set /p DEST="!C_PROMPT!Destination path [Enter = !DEFAULT_DEST!] (0=cancel): !C_RESET!"
if /i not "!FORENSIC_LANG!"=="EN" set /p DEST="!C_PROMPT!Ruta de destino [Enter = !DEFAULT_DEST!] (0=cancelar): !C_RESET!"
if defined DEST set "DEST=!DEST:"=!"
rem DEST se VACIA al cancelar: dejarlo en "0" haria que :LOG_EVENT buscara una
rem carpeta de evidencia llamada "0" en vez de escribir en el diario global.
if "!DEST!"=="0" set "DEST=" & goto MENU_VOLCADO
if "!DEST!"=="" set "DEST=!DEFAULT_DEST!"
call :VALIDATE_DEST_DIR "!DEST!"
if not "!_VD_OK!"=="1" goto CONFIG_VOLCADO_ASK
:: Un volcado de RAM pesa lo mismo que la memoria del equipo. Escribirlo en la unidad
:: del sistema que se analiza sobrescribe su espacio no asignado -evidencia que un
:: analisis posterior del disco ya no podra recuperar-. No se bloquea, porque en un
:: triaje urgente puede no haber otro medio, pero se avisa y la decision se registra.
call :RAM_DEST_SYSDRIVE
if "!_rds_back!"=="1" goto CONFIG_VOLCADO_ASK

set "MEM_NAME=memdump.raw"
if /i "!FORENSIC_LANG!"=="EN" set /p MEM_NAME="!C_PROMPT!File name (default memdump.raw): !C_RESET!"
if /i not "!FORENSIC_LANG!"=="EN" set /p MEM_NAME="!C_PROMPT!Nombre del archivo (por defecto memdump.raw): !C_RESET!"
if defined MEM_NAME set "MEM_NAME=!MEM_NAME:"=!"
if "!MEM_NAME!"=="" set "MEM_NAME=memdump.raw"

set "DEST=!DEST!\Host\Volcado"
if not exist "!DEST!" mkdir "!DEST!" 2>nul
if not exist "!DEST!" (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Could not create the destination folder: !DEST!!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] No se pudo crear la carpeta de destino: !DEST!!C_RESET!
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] Verify write permissions and that the drive has space.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] Verifica permisos de escritura y que la unidad tenga espacio.!C_RESET!
    pause
    goto CONFIG_VOLCADO_ASK
)

echo.
if /i "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Starting RAM dump with !RAM_TOOL!...!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TITLE![*] Iniciando volcado de RAM con !RAM_TOOL!...!C_RESET!
:: La adquisicion de RAM en Windows exige cargar un driver de kernel. Eso MODIFICA
:: el sistema analizado. Es una alteracion necesaria e inevitable, pero callarla
:: seria presentar una adquisicion no intrusiva que no lo es: se declara en
:: pantalla y en el diario antes de tocar nada.
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] !RAM_TOOL! loads a kernel driver: this acquisition MODIFIES the!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] !RAM_TOOL! carga un driver de kernel: esta adquisición MODIFICA el!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] analysed system. A necessary, minimal and documented alteration.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] sistema analizado. Alteración necesaria, mínima y documentada.!C_RESET!
call :LOG_EVENT "Iniciando volcado de RAM con !RAM_TOOL! en !DEST!"
call :LOG_EVENT "ALTERACION DEL SISTEMA EN VIVO, necesaria y declarada: !RAM_TOOL! carga un driver de kernel en !COMPUTERNAME! para leer la memoria fisica. Sin ese driver no hay acceso a la RAM desde el espacio de usuario. La huella queda en el sistema analizado."
call :NEWGUID ACQ_GUID
set "ACQ_CMD=!TEMP!\forensic_cmd_!ACQ_GUID!.tmp"
set "RAM_EL=0"
if "!RAM_TOOL!"=="DumpIt" (
    rem RAM_EXE y _dumpit_arch se resolvieron y comprobaron en :CONFIG_VOLCADO.
    rem
    rem /NOLYTICS: DumpIt ENVIA telemetria de uso a Comae Technologies desde la maquina
    rem investigada mientras se adquiere. Su propia ayuda lo declara ("Does not send any
    rem usage analytics information to Comae Technologies") y el binario lleva dentro el
    rem endpoint y el Content-Type de la peticion. Trafico de red no documentado generado
    rem desde el sistema bajo analisis hacia un tercero: contradice la minimizacion de la
    rem huella (ISO/IEC 27037) y no constaba en ninguna parte del expediente. Se desactiva.
    rem
    rem /NOCOMPRESS: la compresion es AUTOMATICA en hosts con mas de 32 GB de RAM salvo que
    rem se diga lo contrario ("Automatic if the memory is above 32GBs, unless stated
    rem otherwise"). Con /Q no se pregunta nada, asi que en un equipo grande la salida no
    rem era el RAW que este modulo espera: el renombrado no encontraba nada y saltaba el
    rem mensaje genérico "Hubo un error o el proceso fue interrumpido" sin decir la causa.
    rem Se fuerza sin comprimir para que /TYPE RAW signifique lo que dice.
    rem
    rem /NOJSON NO se pasa a proposito: ese sidecar es la metadata de procedencia que este
    rem modulo conserva a continuacion y que ISO/IEC 27041 pide para reproducir el
    rem procedimiento. Suprimirlo seria perder expediente, no ganar limpieza.
    >"!ACQ_CMD!" echo "!RAM_EXE!" /Q /NOLYTICS /NOCOMPRESS /O "!DEST!\!MEM_NAME!" /TYPE RAW
    set "ACQ_TOOL_VER=DumpIt - no interrogada: carga un driver de kernel al arrancar; identificacion por SHA-256 en Herramientas_SHA256.txt"
    call :ACQUIRE "DumpIt - Volcado RAM RAW" "!ACQ_CMD!"
    set "RAM_EL=!errorlevel!"
    for %%F in ("!MEM_NAME!") do set "BASE_NAME=%%~nF"
    rem El sidecar .json que emite DumpIt es metadata de PROCEDENCIA de la
    rem adquisicion: version de la herramienta, marcas de tiempo, rangos de
    rem memoria fisica y parametros del volcado. Es exactamente el material que
    rem ISO/IEC 27041 exige para reproducir el procedimiento, asi que NO se
    rem destruye por consistencia estetica: se conserva junto al volcado.
    if exist "!DEST!\!BASE_NAME!.json" move /Y "!DEST!\!BASE_NAME!.json" "!DEST!\!MEM_NAME!_DumpIt_metadata.json" >nul 2>nul
    if exist "!DEST!\!MEM_NAME!_DumpIt_metadata.json" call :LOG_EVENT "Metadata de procedencia de DumpIt preservada (version de la herramienta, rangos de memoria y parametros del volcado): !DEST!\!MEM_NAME!_DumpIt_metadata.json"
    rem DumpIt fuerza la extension .bin. El renombrado se REGISTRA: el nombre del
    rem artefacto que produjo la herramienta no es el que queda en disco, y un
    rem tercero tiene que poder seguir esa correspondencia en el diario.
    set "_ram_renamed=0"
    if exist "!DEST!\!BASE_NAME!.bin" set "_ram_renamed=1"
    if exist "!DEST!\!BASE_NAME!.bin" move /Y "!DEST!\!BASE_NAME!.bin" "!DEST!\!MEM_NAME!" >nul 2>nul
    if "!_ram_renamed!"=="1" call :LOG_EVENT "Volcado renombrado por consistencia de extension: !BASE_NAME!.bin -> !MEM_NAME! (contenido sin modificar)"
)
if "!RAM_TOOL!"=="WinPmem64" (
    rem Sin "-w": ese conmutador habilita la ESCRITURA en la memoria fisica. Su ausencia
    rem es deliberada y no debe añadirse nunca en un contexto forense.
    >"!ACQ_CMD!" echo "!RAM_EXE!" "!DEST!\!MEM_NAME!"
    set "ACQ_TOOL_VER=WinPmem x64 - no interrogada: carga un driver de kernel al arrancar; identificacion por SHA-256 en Herramientas_SHA256.txt"
    call :ACQUIRE "WinPmem x64 - Volcado RAM" "!ACQ_CMD!"
    set "RAM_EL=!errorlevel!"
)
if "!RAM_TOOL!"=="WinPmem86" (
    >"!ACQ_CMD!" echo "!RAM_EXE!" "!DEST!\!MEM_NAME!"
    set "ACQ_TOOL_VER=WinPmem x86 - no interrogada: carga un driver de kernel al arrancar; identificacion por SHA-256 en Herramientas_SHA256.txt"
    call :ACQUIRE "WinPmem x86 - Volcado RAM" "!ACQ_CMD!"
    set "RAM_EL=!errorlevel!"
)

:: Si el usuario ABORTO la adquisición (código 2 del wrapper) -> Menu Principal
if "!RAM_EL!"=="2" (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![ABORT] Dump aborted by the user. Returning to the Main Menu.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![ABORT] Volcado abortado por el usuario. Volviendo al Menú Principal.!C_RESET!
    call :LOG_EVENT "Volcado de RAM abortado por el usuario (CTRL+C)."
    pause
    goto MENU_PRINCIPAL
)

:: Verificar que el volcado existe
if not exist "!DEST!\!MEM_NAME!" (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] There was an error or the process was interrupted.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] Hubo un error o el proceso fue interrumpido.!C_RESET!
    call :LOG_EVENT "Error: Fallo o interrupcion durante el volcado de RAM."
    pause
    goto MENU_PRINCIPAL
)

:: Verificar que el volcado no es un archivo vacio (WinPmem/DumpIt pueden crear archivo y salir con 0 al fallar)
set "_ram_filesize=0"
for %%F in ("!DEST!\!MEM_NAME!") do set "_ram_filesize=%%~zF"
if "!_ram_filesize!"=="0" (
    if /i "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] The dump is an empty file: the tool created the file but wrote no data.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_ERR![-] El volcado es un archivo vacio: la herramienta creo el archivo pero no escribio datos.!C_RESET!
    if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] Possible cause: WinPmem x86 on x64 system, driver not loaded, or insufficient permissions.!C_RESET!
    if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] Causa posible: WinPmem x86 en sistema x64, driver no cargado, o permisos insuficientes.!C_RESET!
    del "!DEST!\!MEM_NAME!" >nul 2>&1
    rem Sin este asiento el fallo solo quedaba en pantalla: el diario no decia que
    rem hubo un intento ni por que no hay volcado. Texto sin parentesis: va dentro
    rem de un bloque.
    call :LOG_EVENT "Error: !RAM_TOOL! termino pero el volcado tenia 0 bytes - driver no cargado, arquitectura equivocada o permisos. Archivo vacio eliminado para no dejar una evidencia falsa."
    pause
    goto MENU_PRINCIPAL
)

:: Un volcado truncado tiene exactamente el mismo aspecto que uno completo: el
:: unico control que habia era "tamano distinto de cero". Se contrasta contra la
:: RAM que el sistema declara y se REGISTRA LA CIFRA, no una conclusion: siempre
:: falta algo por los rangos reservados de MMIO, y esa diferencia la interpreta
:: el analista, no el framework.
call :GET_SYSTEM_RAM
if /i "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Dump finished: !_ram_filesize! bytes written.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_OK![+] Volcado finalizado: !_ram_filesize! bytes escritos.!C_RESET!
if "!_ram_installed!"=="0" goto RAMCHK_UNKNOWN
if /i "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] RAM reported by the system: !_ram_installed! bytes.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_TEXT![i] RAM que declara el sistema: !_ram_installed! bytes.!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] A gap is normal (reserved MMIO ranges). A LARGE gap may mean a!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] Una diferencia es normal (rangos reservados de MMIO). Una diferencia!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] truncated dump: compare both figures before relying on it.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] GRANDE puede indicar un volcado truncado: contraste ambas cifras.!C_RESET!
call :LOG_EVENT "Volcado de RAM: !_ram_filesize! bytes capturados / !_ram_installed! bytes de RAM declarada por el sistema. La diferencia es esperable por rangos reservados de MMIO; se registra la cifra y la interpretacion queda para el analisis."
goto RAMCHK_END
:RAMCHK_UNKNOWN
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] Installed RAM could not be read: dump completeness NOT contrasted.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] No se pudo leer la RAM instalada: la completitud del volcado NO se!C_RESET!
if /i "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] Record the physical RAM of the host manually in the case file.!C_RESET!
if /i not "!FORENSIC_LANG!"=="EN" echo !C_WARN![i] ha contrastado. Anote la RAM física del equipo en el expediente.!C_RESET!
call :LOG_EVENT "LIMITACION: no se pudo obtener la RAM declarada por el sistema (sin WMIC ni PowerShell utilizable). El volcado de !_ram_filesize! bytes queda SIN contrastar contra la memoria fisica del host."
:RAMCHK_END
:: Marca de sesion para el guardian de orden de volatilidad de :ADQ_SRC_STATE: si
:: hay volcado de RAM, imagenar el disco despues ya sigue el orden de RFC 3227.
set "RAM_DUMP_DONE=1"
call :LOG_EVENT "Volcado de RAM completado: !DEST!\!MEM_NAME!"

:: Verificación de integridad OPCIONAL (decisión del operador)
call :HASH_EVIDENCE FILE "!DEST!\!MEM_NAME!" "" "!DEST!\!MEM_NAME!_hashes.txt" "VolcadoRAM"
pause
goto MENU_VOLCADO

:MENU_ADQUISICION
set "HE_MODO="
